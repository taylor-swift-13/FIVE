   219	From PidAlternatingAttempt001 Require Import Proof.
   220	Lemma execute_reference:forall m gh ret r iz r' jz,
   221	 AlternatingInput m gh ret r 1 1(Int.repr iz) ->
   222	 Mem.range_perm m gh 0 84 Cur Writable ->PrivateBlocks gh ret ->
   223	 -4096<=r'<=4096 ->
   224	 zclamp integral_limit(Int.signed(Int.repr iz)+1*(1*r'/64))=jz ->
   225	 exists q mf,
   226	 ReferenceStore gh m r' q /\
   227	 AlternatingInput q gh ret r' 1 1(Int.repr iz) /\
   228	 NormalCall gh ret true q mf /\
   229	 AlternatingInput mf gh ret r' 1 1(Int.repr jz) /\
   230	 Mem.range_perm mf gh 0 84 Cur Writable.
   231	Proof.
   232	 intros m gh ret r iz r' jz INPUT WRITE PRIVATE RR CALC.
   233	 destruct(prepare_reference_store m gh ret r r' 1 1(Int.repr iz)RR INPUT WRITE PRIVATE)
   234	 as(q&STORE&ENV&IQ&WQ).
   235	 destruct(normal_call_exists q gh ret(input_good _ _ _ _ _ _ _ IQ))as[mf CALL].
   236	 destruct(returned_input q mf gh ret r' 1 1(Int.repr iz)RR ltac:(lia)ltac:(lia)IQ WQ PRIVATE CALL)
   237	 as[iy[IF WF]].
   238	 destruct(original_call_integral_exact q mf gh ret r' 1 1(Int.repr iz)RR ltac:(lia)ltac:(lia)IQ CALL)
   239	 as[j[LOAD SIGN]].
   240	 assert(EQ:iy=j)by(eapply integral_unique;[exact(input_integral _ _ _ _ _ _ _ IF)|exact LOAD]).

def config():
    spec = importlib.util.spec_from_file_location("pid_build_configuration", OLD_CONFIGURATION)
    obj = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(obj)
    pairs = list(obj.LOADPATHS)
    pairs.extend([("paparazzi/relations/pid_measurement_robustness/problem","PidMeasurementProblem"),("paparazzi/relations/pid_measurement_robustness/attempts/001","PidMeasurementAttempt001")])
    pairs.extend([
        ("paparazzi/relations/pid_alternating_bias/problem", "PidAlternatingProblem"),
        ("paparazzi/relations/pid_alternating_bias/attempts/001", "PidAlternatingAttempt001"),
    ])
    pairs.extend([
        (relative(PROBLEM), "PidInputOrderProblem"),
        (relative(ATTEMPT), "PidInputOrderAttempt001"),
    ])
    if len({prefix for _, prefix in pairs}) != len(pairs):
        raise ValueError("Duplicate logical namespace")
    return pairs


def module(path, pairs):
    path = Path(path).resolve()
    candidates = [
        (len(str(ROOT / directory)), directory, prefix)
        for directory, prefix in pairs
        if path.is_relative_to(ROOT / directory)
    ]
    if not candidates:
        raise ValueError("No explicit namespace for " + str(path))
    _, directory, prefix = max(candidates)
    return prefix + "." + ".".join(path.relative_to(ROOT / directory).with_suffix("").parts)


def problem():
    status = json.loads((PROBLEM / "status.json").read_text())
    expected = [goal for goal, _ in GOALS]
    if status.get("requested_goals") != expected:
        raise ValueError("Canonical requested goals differ from the exact checker bindings")
    return {
