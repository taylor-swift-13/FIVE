281-Theorem ground_different_integrals_nonvacuity : GroundNonvacuityGoal.
282-Proof.
283- destruct canonical_input_nonvacuity as(gh&ret&a&unused&dx&dy&PAIR&REST).
284- pose proof(proj1 PAIR)as GOOD.
285- destruct(inputgood_core_initial_data a gh ret GOOD)as[D _].
286- destruct(actual_global_variable_binding S._guidance_pid_trim_att_integrator S.v_guidance_pid_trim_att_integrator ltac:(vm_compute;reflexivity))as[bi[SI VI]].
287- assert(EI:bi=cid_i _ _ D)by(pose proof(cid_i_symbol _ _ D);congruence);subst bi.
288- set(ix:=cid_ix _ _ D);set(iy:=cid_iy _ _ D).
289- assert(OLD:old_integrals a ix iy).
290- { unfold old_integrals,load_global;rewrite(cid_i_symbol _ _ D);split;[exact(cid_integral_x _ _ D)|exact(cid_integral_y _ _ D)]. }
291- assert(FRESH:exists fresh,-100000000<=Int.signed fresh<=100000000 /\ix<>fresh).
292- { destruct(Int.eq_dec ix Int.zero)as[EQ|NE].
293-   - exists Int.one;split;[change(-100000000<=1<=100000000);lia|subst ix;rewrite EQ;discriminate].
294-   - exists Int.zero;split;[rewrite Int.signed_zero;lia|exact NE]. }
295- destruct FRESH as[fresh[BOUND DIFF]].
296- assert(VA:Mem.valid_access a Mint32(cid_i _ _ D)0 Writable).
297- { apply scalar_access_inside with(n:=8);[exact(cid_i_writable _ _ D)|lia|cbn;lia|exists 0;reflexivity]. }
298- destruct(Mem.valid_access_store a Mint32(cid_i _ _ D)0(Vint fresh)VA)as[b STORE].
299: assert(GOODB:InputGood b gh ret)by(eapply inputgood_store_integral_x;[exact GOOD|exact(cid_i_symbol _ _ D)|exact VI|exact BOUND|exact STORE]).
300- assert(NEW:old_integrals b fresh iy).
301- { unfold old_integrals,load_global;rewrite(cid_i_symbol _ _ D);split.
302-   - exact(Mem.load_store_same _ _ _ _ _ _ STORE).
303-   - change(Mem.load Mint32 b(cid_i _ _ D)4=Some(Vint iy)).
304-     rewrite(Mem.load_store_other _ _ _ _ _ _ STORE Mint32(cid_i _ _ D)4)by(right;right;cbn;lia);exact(cid_integral_y _ _ D). }
305- assert(FRAME:same_except_integrals_and_return ret a b).
306- { split;[rewrite(Mem.nextblock_store _ _ _ _ _ _ STORE);reflexivity|];split.
307-   - intros blk ofs k pm;split;intro P;[eapply Mem.perm_store_1|eapply Mem.perm_store_2];eauto.
308-   - intros blk ofs NT NR;rewrite(Mem.loadbytes_store_other _ _ _ _ _ _ STORE blk ofs 1);[reflexivity|].
309-     destruct(peq blk(cid_i _ _ D))as[EQ|NE];[subst blk;right;right|left;exact NE].
310-     assert(NRANGE:~0<=ofs<8)by(intro R;apply NT;split;[exact(cid_i_symbol _ _ D)|exact R]).
311-     cbn;lia. }
312- assert(BASE:GroundBasePair gh ret a b)by(exact(conj GOOD(conj GOODB FRAME))).
313- exists gh,ret,a,b,ix,iy,fresh,iy;split;[exact(conj BASE(conj OLD NEW))|];split;[exact DIFF|].
314- exact(constructed_ground gh ret a b BASE).
315-Qed.
