From Stdlib Require Import Reals ZArith Lia Lra Psatz.
From Flocq.Core Require Import Core.
From Flocq.Prop Require Import Relative.
From Flocq.IEEE754 Require Import Binary.
From compcert Require Import Floats.
Open Scope R_scope.
Local Instance prec24 : Prec_gt_0 24 := eq_refl.

Definition r32 (x : float32) : R := B2R 24 128 x.
Definition finite (x : float32) : Prop := is_finite 24 128 x = true.
Definition RN (x : R) : R := round radix2 (FLT_exp (-149) 24) ZnearestE x.
Definition u : R := bpow radix2 (-24).
Definition eta : R := bpow radix2 (-150).

Lemma RN_error : forall x, Rabs (RN x - x) <= u * Rabs x + eta.
Proof.
  intro x.
  destruct (error_N_FLT radix2 (-149) 24 ltac:(lia) (fun z => negb (Z.even z)) x)
    as [e [d [He [Hd [Hed Hr]]]]].
  change (RN x = x * (1 + e) + d) in Hr.
  assert (Hu : /2 * bpow radix2 (-24 + 1) = u).
  { rewrite bpow_plus. change (/2 * (u * 2) = u). field. }
  assert (Hdeta : /2 * bpow radix2 (-149) = eta).
  { unfold eta. change (-149)%Z with ((-150)+1)%Z.
    rewrite bpow_plus. change (/2 * (bpow radix2 (-150) * 2) = bpow radix2 (-150)). field. }
  change (Rabs e <= /2 * bpow radix2 (-24 + 1)) in He.
  rewrite Hu in He. rewrite Hdeta in Hd.
  rewrite Hr. replace (x * (1 + e) + d - x) with (x * e + d) by ring.
  eapply Rle_trans; [apply Rabs_triang|].
  rewrite Rabs_mult. pose proof (Rabs_pos x); nra.
Qed.

Lemma RN_le : forall x y, x <= y -> RN x <= RN y.
Proof. intros x y H. unfold RN. apply round_le; auto with typeclass_instances. Qed.

Lemma RN_fix_generic : forall x,
  generic_format radix2 (FLT_exp (-149) 24) x -> RN x = x.
Proof. intros x H. unfold RN. apply round_generic; auto with typeclass_instances. Qed.

Lemma RN_abs_bound_pow : forall x k, (-149 <= k)%Z ->
  Rabs x <= bpow radix2 k -> Rabs (RN x) <= bpow radix2 k.
Proof.
  intros x k Hk Hx. unfold RN.
  apply abs_round_le_generic; auto with typeclass_instances.
  apply generic_format_bpow. unfold FLT_exp. lia.
Qed.

Lemma RN_abs_le_2 : forall x, Rabs x <= 2 -> Rabs (RN x) <= 2.
Proof. intro x. change 2 with (bpow radix2 1). apply RN_abs_bound_pow. lia. Qed.

Lemma RN_abs_le_8 : forall x, Rabs x <= 8 -> Rabs (RN x) <= 8.
Proof. intro x. change 8 with (bpow radix2 3). apply RN_abs_bound_pow. lia. Qed.

Lemma RN_safe : forall x, Rabs x <= 8 ->
  Rlt_bool (Rabs (RN x)) (bpow radix2 128) = true.
Proof.
  intros x Hx. apply Rlt_bool_true.
  eapply Rle_lt_trans; [apply RN_abs_le_8; exact Hx|].
  change 8 with (bpow radix2 3). apply bpow_lt. lia.
Qed.

Lemma u_value : u = /16777216.
Proof. reflexivity. Qed.
Lemma eta_value : eta = /1427247692705959881058285969449495136382746624.
Proof. reflexivity. Qed.

Lemma add_finite_real : forall x y, finite x -> finite y ->
  Rabs (r32 x + r32 y) <= 8 ->
  finite (Float32.add x y) /\ r32 (Float32.add x y) = RN (r32 x + r32 y).
Proof.
  intros x y Fx Fy Hxy.
  pose proof (Bplus_correct 24 128 eq_refl eq_refl Float32.binop_nan BinarySingleNaN.mode_NE x y Fx Fy) as H.
  pose proof (RN_safe _ Hxy) as Hb.
  unfold RN, r32 in Hb.
  change (FLT_exp (-149) 24) with (SpecFloat.fexp 24 128) in Hb.
  change ZnearestE with (BinarySingleNaN.round_mode BinarySingleNaN.mode_NE) in Hb.
  rewrite Hb in H.
  destruct H as [Hr [Hf Hs]]. split; assumption.
Qed.

Lemma sub_finite_real : forall x y, finite x -> finite y ->
  Rabs (r32 x - r32 y) <= 8 ->
  finite (Float32.sub x y) /\ r32 (Float32.sub x y) = RN (r32 x - r32 y).
Proof.
  intros x y Fx Fy Hxy.
  pose proof (Bminus_correct 24 128 eq_refl eq_refl Float32.binop_nan BinarySingleNaN.mode_NE x y Fx Fy) as H.
  pose proof (RN_safe _ Hxy) as Hb.
  unfold RN, r32 in Hb.
  change (FLT_exp (-149) 24) with (SpecFloat.fexp 24 128) in Hb.
  change ZnearestE with (BinarySingleNaN.round_mode BinarySingleNaN.mode_NE) in Hb.
  rewrite Hb in H.
  destruct H as [Hr [Hf Hs]]. split; assumption.
Qed.

Lemma mul_finite_real : forall x y, finite x -> finite y ->
  Rabs (r32 x * r32 y) <= 8 ->
  finite (Float32.mul x y) /\ r32 (Float32.mul x y) = RN (r32 x * r32 y).
Proof.
  intros x y Fx Fy Hxy.
  pose proof (Bmult_correct 24 128 eq_refl eq_refl Float32.binop_nan BinarySingleNaN.mode_NE x y) as H.
  pose proof (RN_safe _ Hxy) as Hb.
  unfold RN, r32 in Hb.
  change (FLT_exp (-149) 24) with (SpecFloat.fexp 24 128) in Hb.
  change ZnearestE with (BinarySingleNaN.round_mode BinarySingleNaN.mode_NE) in Hb.
  rewrite Hb in H.
  destruct H as [Hr [Hf Hs]]. split; [|exact Hr].
  unfold finite in Fx,Fy. rewrite Fx,Fy in Hf. exact Hf.
Qed.

Lemma div_finite_real : forall x y, finite x -> finite y -> r32 y <> 0 ->
  Rabs (r32 x / r32 y) <= 8 ->
  finite (Float32.div x y) /\ r32 (Float32.div x y) = RN (r32 x / r32 y).
Proof.
  intros x y Fx Fy Hy Hxy.
  pose proof (Bdiv_correct 24 128 eq_refl eq_refl Float32.binop_nan BinarySingleNaN.mode_NE x y Hy) as H.
  pose proof (RN_safe _ Hxy) as Hb.
  unfold RN, r32 in Hb.
  change (FLT_exp (-149) 24) with (SpecFloat.fexp 24 128) in Hb.
  change ZnearestE with (BinarySingleNaN.round_mode BinarySingleNaN.mode_NE) in Hb.
  rewrite Hb in H.
  destruct H as [Hr [Hf Hs]]. split; [|exact Hr].
  unfold finite in Fx. rewrite Fx in Hf. exact Hf.
Qed.
From Stdlib Require Import Reals ZArith Lia Lra Psatz.
From Flocq.Core Require Import Core.
From Flocq.IEEE754 Require Import Binary.
From compcert Require Import Floats.
From FiveLowpassRoundoffSupport Require Export FloatBounds.
Open Scope R_scope.
Local Instance prec24 : Prec_gt_0 24 := eq_refl.

Lemma RN_safe_large : forall x, Rabs x <= 8388608 ->
  Rlt_bool (Rabs (RN x)) (bpow radix2 128) = true.
Proof.
 intros x H;apply Rlt_bool_true.
 eapply Rle_lt_trans;[apply(RN_abs_bound_pow x 23);[lia|exact H]|].
 change 8388608 with (bpow radix2 23);apply bpow_lt;lia.
Qed.
Lemma add_real_large : forall x y, finite x -> finite y ->
 Rabs(r32 x+r32 y)<=8388608 ->
 finite(Float32.add x y) /\ r32(Float32.add x y)=RN(r32 x+r32 y).
Proof.
 intros x y Fx Fy Hxy.
 pose proof(Bplus_correct 24 128 eq_refl eq_refl Float32.binop_nan BinarySingleNaN.mode_NE x y Fx Fy)as H.
 pose proof(RN_safe_large _ Hxy)as Hb.
 unfold RN,r32 in Hb.
 change (FLT_exp (-149) 24)with(SpecFloat.fexp 24 128)in Hb.
 change ZnearestE with(BinarySingleNaN.round_mode BinarySingleNaN.mode_NE)in Hb.
 rewrite Hb in H;destruct H as[Hr[Hf Hs]];auto.
Qed.
Lemma RN_abs_le_one : forall x,Rabs x<=1->Rabs(RN x)<=1.
Proof. intros x H;change 1 with(bpow radix2 0);apply RN_abs_bound_pow;[lia|exact H]. Qed.
Lemma unit_product : forall a x,finite a->finite x->Rabs(r32 a)<=1->Rabs(r32 x)<=1->
 finite(Float32.mul a x) /\ Rabs(r32(Float32.mul a x))<=1 /\
 Rabs(r32(Float32.mul a x)-r32 a*r32 x)<=u+eta.
Proof.
 intros a x Fa Fx Ha Hx.
 assert(H:Rabs(r32 a*r32 x)<=1).
 { rewrite Rabs_mult;pose proof(Rabs_pos(r32 a));pose proof(Rabs_pos(r32 x));nra. }
 destruct(mul_finite_real a x Fa Fx ltac:(lra))as[F R].
 split;[exact F|];rewrite R;split;[apply RN_abs_le_one;exact H|].
 pose proof(RN_error(r32 a*r32 x));pose proof(bpow_gt_0 radix2 (-24));unfold u in *;nra.
Qed.
Lemma add_small_error : forall x y k,finite x->finite y->0<=k<=1048576->
 Rabs(r32 x+r32 y)<=4*k+4->
 finite(Float32.add x y) /\
 Rabs(r32(Float32.add x y)-(r32 x+r32 y))<=u*(4*k+4)+eta /\
 Rabs(r32(Float32.add x y)-(r32 x+r32 y))<=1/3.
Proof.
 intros x y k Fx Fy Hk Hxy.
 destruct(add_real_large x y Fx Fy ltac:(lra))as[F R].
 split;[exact F|];rewrite R;pose proof(RN_error(r32 x+r32 y))as E.
 rewrite u_value,eta_value in *.
 assert(E':Rabs(RN(r32 x+r32 y)-(r32 x+r32 y))<= /16777216*(4*k+4)+/1427247692705959881058285969449495136382746624)by nra.
 split;[exact E'|];eapply Rle_trans;[exact E'|];lra.
Qed.
