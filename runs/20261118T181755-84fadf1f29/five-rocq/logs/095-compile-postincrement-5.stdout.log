1 focused goal (shelved: 2)
  
  ge : genv
  Q : val -> mem -> Prop
  f : function
  id : positive
  k : cont
  e : PTree.tree (block * type)
  m : mem
  b : block
  z : Z
  mf : mem
  RANGE : 0 <= z < 16383
  ENV : e ! id = Some (b, short_type)
  LOAD : Mem.load Mint16signed m b 0 = Some (Vint (Int.repr z))
  STORE : Mem.store Mint16signed m b 0 (Vint (Int.repr (z + 1))) = Some mf
  END : total ge Q (State f Sskip k e mf)
  ADD :
    sem_binary_operation ge Oadd (Vint (Int.repr z)) short_type
      (Vint Int.one) type_int32s m =
    Some (Vint (Int.repr (z + 1)))
  CAST :
    sem_cast (Vint (Int.repr (z + 1))) type_int32s short_type m =
    Some (Vint (Int.repr (z + 1)))
  ASSIGN :
    do_assign_loc ge quiet short_type m b Ptrofs.zero Full
      (Vint (Int.repr (z + 1))) =
    Some (quiet, E0, mf, Vint (Int.repr (z + 1)))
  ============================
  map (expr_final_state f (Kdo k) e)
    (incontext
       (fun x : expr =>
        Ecomma x (Eval (Vint (Int.repr z)) short_type) short_type)
       (if type_eq short_type short_type
        then
         match
           sem_cast (Vint (Int.repr (z + 1))) (incrdecr_type short_type)
             short_type m
         with
         | Some v =>
             match
               do_assign_loc ge quiet short_type m b Ptrofs.zero Full v
             with
             | Some (_, t, m', v') =>
                 topred (Rred "red_assign" (Eval v' short_type) m' t)
             | None => stuck
             end
         | None => stuck
         end
        else stuck)) =
  [TR ?rule E0 ?next]
