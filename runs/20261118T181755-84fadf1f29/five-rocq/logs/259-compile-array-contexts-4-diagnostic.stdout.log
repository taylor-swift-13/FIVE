Chars 4578 - 4587 [Unshelve.] 0. secs (0.u,0.s)
AL-LIST-LEFT
((fix array_expr (a : expr) : Prop :=
    array_head ge elem ids a /\
    match a with
    | Econdition a0 b c _ => array_expr a0 /\ array_expr b /\ array_expr c
    | Ebinop _ a0 b _ | Eseqand a0 b _ | Eseqor a0 b _ | 
      Eassign a0 b _ | Eassignop _ a0 b _ _ | Ecomma a0 b _ =>
        array_expr a0 /\ array_expr b
    | Ecall a0 args _ => array_expr a0 /\ array_exprlist args
    | Ebuiltin _ _ args _ => array_exprlist args
    | Efield a0 _ _ | Evalof a0 _ | Ederef a0 _ | 
      Eaddrof a0 _ | Eunop _ a0 _ | Ecast a0 _ | Epostincr _ a0 _ |
      Eparen a0 _ _ => array_expr a0
    | _ => True
    end
  with array_exprlist (args : exprlist) : Prop :=
    match args with
    | Enil => True
    | Econs a rest => array_expr a /\ array_exprlist rest
    end
  for
  array_expr) (C a'))
