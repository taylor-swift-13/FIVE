  Events.extcall_properties (Events.inline_assembly_sem id sg) sg
FunctionalExtensionality.functional_extensionality_dep :
  forall (A : Type) (B : A -> Type) (f g : forall x : A, B x),
  (forall x : A, f x = g x) -> f = g
Events.external_functions_sem :
  String.string -> AST.signature -> Events.extcall_sem
Events.external_functions_properties :
  forall (id : String.string) (sg : AST.signature),
  Events.extcall_properties (Events.external_functions_sem id sg) sg
Classical_Prop.classic : forall P : Prop, P \/ ~ P
