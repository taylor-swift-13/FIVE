                                   Int.sign_ext 16
                                     (Int.repr (Int64.unsigned n))
                               | Unsigned =>
                                   Int.zero_ext 16
                                     (Int.repr (Int64.unsigned n))
                               end
                           | I32 => Int.repr (Int64.unsigned n)
                           | IBool =>
                               if
                                Int.eq (Int.repr (Int64.unsigned n)) Int.zero
                               then Int.zero
                               else Int.one
                           end)
                  | _ => None
                  end
              | cast_case_l2f si1 =>
                  match w with
                  | Vlong i => Some (Vfloat (cast_long_float si1 i))
                  | _ => None
                  end
              | cast_case_l2s si1 =>
                  match w with
                  | Vlong i => Some (Vsingle (cast_long_single si1 i))
                  | _ => None
                  end
              | cast_case_f2l si2 =>
                  match w with
                  | Vfloat f =>
                      match cast_float_long si2 f with
                      | Some i => Some (Vlong i)
                      | None => None
                      end
                  | _ => None
                  end
              | cast_case_s2l si2 =>
                  match w with
                  | Vsingle f =>
                      match cast_single_long si2 f with
                      | Some i => Some (Vlong i)
                      | None => None
                      end
                  | _ => None
                  end
              | cast_case_i2bool =>
                  match w with
                  | Vint n =>
                      Some
                        (Vint
                           (if Int.eq n Int.zero then Int.zero else Int.one))
                  | _ => None
                  end
              | cast_case_l2bool =>
                  match w with
                  | Vlong n =>
                      Some
                        (Vint
                           (if Int64.eq n Int64.zero
                            then Int.zero
                            else Int.one))
                  | Vptr b ofs =>
                      if negb true
                      then None
                      else
                       if Mem.weak_valid_pointer m b (Ptrofs.unsigned ofs)
                       then Some Vone
                       else None
                  | _ => None
                  end
              | cast_case_f2bool =>
                  match w with
                  | Vfloat f =>
                      Some
                        (Vint
                           (if Floats.Float.cmp Ceq f Floats.Float.zero
                            then Int.zero
                            else Int.one))
                  | _ => None
                  end
              | cast_case_s2bool =>
                  match w with
                  | Vsingle f =>
                      Some
                        (Vint
                           (if Floats.Float32.cmp Ceq f Floats.Float32.zero
                            then Int.zero
                            else Int.one))
                  | _ => None
                  end
              | cast_case_struct id1 id2 | cast_case_union id1 id2 =>
                  match w with
                  | Vptr _ _ => if ident_eq id1 id2 then Some w else None
                  | _ => None
                  end
              | cast_case_void => Some w
              | cast_case_default => None
              end
          | None => None
          end
      | None => None
      end
  | None => None
  end".

