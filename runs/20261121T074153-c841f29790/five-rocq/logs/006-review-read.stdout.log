FILE paparazzi/models/float_mat_inv_2d/rocq/support/TraceInputs.v SHA256 8da28338229b201b6be37c472402e65a70458132e4e6df1997920bd293db07d8
1: From Stdlib Require Import List ZArith.
2: From compcert Require Import Integers Floats Values.
3: From FiveInv2Case Require Import Contract.
4: Import ListNotations.
5: Local Open Scope Z_scope.
6: Definition trace_input_words:list Z := [4272023241;1066696119;15406124;1877109524].
7: Definition trace_input(i:Z):float32:=Float32.of_bits(Int.repr(nth(Z.to_nat i)trace_input_words 0)).
8: Definition trace_output_words:list Z := [2147483648;0;0;0].
9: Definition initial_fixture(i:Z):float32:=Float32.of_bits(Int.repr(if Z.eq_dec i 0 then 1099431936 else if Z.eq_dec i 3 then 1099431936 else 0)).
10: Definition initial_guarded(_:Z):float32:=Float32.of_bits Int.zero.
11: Theorem original_arbitrary_trace_kernel:Result trace_input=Vint Int.zero /\Float32.to_bits(Det trace_input)=Int.repr 4286578688 /\
12:  map(fun i=>Float32.to_bits(Output trace_input i))[0;1;2;3]=map Int.repr trace_output_words.
13: Proof. vm_compute;repeat split;reflexivity. Qed.
14: Theorem original_initial_fixture_words:map(fun i=>Float32.to_bits(initial_fixture i))[0;1;2;3]=map Int.repr[1099431936;0;0;1099431936].
15: Proof. vm_compute;reflexivity. Qed.
16: Print Assumptions original_arbitrary_trace_kernel.

