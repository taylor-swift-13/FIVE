
FILE paparazzi/models/float_mat_inv_2d/rocq/support/Observer.v SHA256 da86c593e4f9353a79dc09a218b3c45577d3c493fcbdb1d50232e8a19b163f6f
1: From Stdlib Require Import List ZArith Lia.
2: From compcert Require Import Coqlib Integers Floats AST Values Memory Memdata Events Globalenvs.
3: From FiveMatInv3Case Require Import MatrixMemory.
4: From FiveInv2Case Require Import Memcpy16.
5: Import ListNotations.
6: Local Open Scope Z_scope.
7: Lemma append_cut:forall(A:Type)(a b c d:list A),length a=length c->a++b=c++d->a=c /\b=d.
8: Proof. intros A a;induction a as[|x a IH];intros b c d LEN EQ;destruct c as[|y c];simpl in LEN;try discriminate.
9:  - simpl in EQ;auto.
10:  - simpl in EQ;injection EQ as XY EQ;subst y;destruct(IH b c d ltac:(lia)EQ)as[-> ->];auto. Qed.
11: Lemma same_bytes_cell:forall m1 b1 m2 b2 bytes z,
12:  Mem.loadbytes m1 b1 0 16=Some bytes->Mem.loadbytes m2 b2 0 16=Some bytes->0<=z->z+4<=16->
13:  Mem.loadbytes m1 b1 z 4=Mem.loadbytes m2 b2 z 4.
14: Proof.
15:  intros m1 b1 m2 b2 bytes z A B Z LIMIT.
16:  replace 16 with(z+(16-z))in A,B by lia.
17:  destruct(Mem.loadbytes_split _ _ _ _ _ _ A ltac:(lia)ltac:(lia))as[a[rest[RA[RR EA]]]].
18:  destruct(Mem.loadbytes_split _ _ _ _ _ _ B ltac:(lia)ltac:(lia))as[c[tail[RC[RT EC]]]].
19:  assert(L:length a=length c)by(erewrite(Mem.loadbytes_length _ _ _ _ _ RA),(Mem.loadbytes_length _ _ _ _ _ RC);reflexivity).
20:  destruct(append_cut _ a rest c tail L ltac:(congruence))as[_ EQ];subst tail.
21:  replace(0+z)with z in RR,RT by lia.
22:  replace(16-z)with(4+(12-z))in RR,RT by lia.
23:  destruct(Mem.loadbytes_split _ _ _ _ _ _ RR ltac:(lia)ltac:(lia))as[d[ds[RD[RDS ED]]]].
24:  destruct(Mem.loadbytes_split _ _ _ _ _ _ RT ltac:(lia)ltac:(lia))as[f[fs[RF[RFS EF]]]].
25:  assert(L':length d=length f)by(erewrite(Mem.loadbytes_length _ _ _ _ _ RD),(Mem.loadbytes_length _ _ _ _ _ RF);reflexivity).
26:  destruct(append_cut _ d ds f fs L' ltac:(congruence))as[EQ _];subst f;congruence.
27: Qed.
28: Lemma memcpy_word_observation:forall m src dst mf bytes f,
29:  Mem.loadbytes m src 0 16=Some bytes->Mem.storebytes m dst 0 bytes=Some mf->
30:  (forall i,0<=i<4->Mem.loadbytes m src(4*i)4=Some(encode_val Mfloat32(Vsingle(f i))))->
31:  forall i,0<=i<4->Mem.load Mint32 mf dst(4*i)=Some(Vint(Float32.to_bits(f i))).
32: Proof.
33:  intros m src dst mf bytes f RD ST CELLS i I.
34:  pose proof(Mem.loadbytes_length _ _ _ _ _ RD)as LEN;change(length bytes=16%nat)in LEN.
35:  pose proof(Mem.loadbytes_storebytes_same _ _ _ _ _ ST)as ALL;rewrite LEN in ALL;change(Mem.loadbytes mf dst 0 16=Some bytes)in ALL.
36:  pose proof(same_bytes_cell m src mf dst bytes(4*i)RD ALL ltac:(lia)ltac:(lia))as EQ.
37:  assert(C:Mem.loadbytes mf dst(4*i)4=Some(encode_val Mfloat32(Vsingle(f i))))by(rewrite <-EQ;apply CELLS;exact I).
38:  pose proof(Mem.loadbytes_load Mint32 mf dst(4*i)_ C ltac:(change(4|4*i);exists i;lia))as LOAD.
39:  pose proof(decode_encode_val_general(Vsingle(f i))Mfloat32 Mint32)as DE.
40:  change(decode_val Mint32(encode_val Mfloat32(Vsingle(f i)))=Vint(Float32.to_bits(f i)))in DE;rewrite DE in LOAD;exact LOAD.
41: Qed.
42: Print Assumptions memcpy_word_observation.

