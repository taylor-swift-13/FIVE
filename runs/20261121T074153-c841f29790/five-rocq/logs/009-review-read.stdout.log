19:  */
20: 
21: 
22: #include <stdbool.h>
23: #include <math.h>
24: 
25: /* Explicit standard-library binding to the CompCert/CBMC intrinsic. */
26: #define fabsf __builtin_fabsf
27: 
28: bool float_mat_inv_2d(float inv_out[4], const float mat_in[4])
29: {
30:   float det = mat_in[0] * mat_in[3] - mat_in[1] * mat_in[2];
31: 
32:   if (fabsf(det) < 1e-4) { return 1; } //not invertible
33: 
34:   inv_out[0] =  mat_in[3] / det;
35:   inv_out[1] = -mat_in[1] / det;
36:   inv_out[2] = -mat_in[2] / det;
37:   inv_out[3] =  mat_in[0] / det;
38: 
39:   return 0; //return success
40: }

FILE paparazzi/models/float_mat_inv_3d/rocq/support/Contract.v SHA256 53dfdbef18fe3558afe17849b11b85a2e84bde204a67807f167dc9429a3e629b
1: From Stdlib Require Import List ZArith.
2: From compcert Require Import Integers Floats AST Values Memory Memdata.
3: From FiveMatInv3Case Require Export MatrixMemory Scalar.
4: Import ListNotations.
5: Definition Args(bo bi:block)(po pi:ptrofs):list val:=[Vptr bo po;Vptr bi pi].
6: Definition FunctionalPre(args:list val)(m:mem):Prop:=exists bo bi po pi f,args=Args bo bi po pi /\ bo<>bi /\ WriteRegion m bo po 9 /\ Reads m bi pi 9 f.
7: Definition Frame(m mf:mem)(bo:block)(po:ptrofs):Prop:=forall b z n,Mem.valid_block m b->b<>bo \/ z+n<=Ptrofs.unsigned po \/ Ptrofs.unsigned po+36<=z->Mem.loadbytes mf b z n=Mem.loadbytes m b z n.
8: Definition OutputBytes(m mf:mem)(bo:block)(po:ptrofs)(f:Z->float32):Prop:=
9:  if Accept f then forall i,0<=i<9->Mem.loadbytes mf bo(Ptrofs.unsigned po+4*i)4=Some(encode_val Mfloat32(Vsingle(Output f i)))
10:  else Mem.loadbytes mf bo(Ptrofs.unsigned po)36=Mem.loadbytes m bo(Ptrofs.unsigned po)36.
11: Definition OldBlocks(m mf:mem):Prop:=forall b,Mem.valid_block m b->Mem.valid_block mf b.
12: Definition OldAccess(m mf:mem):Prop:=forall ch b z p,Mem.valid_block m b->Mem.valid_access m ch b z p->Mem.valid_access mf ch b z p.

FILE paparazzi/models/float_mat_inv_2d/rocq/support/Contract.v SHA256 8e480aaa8e22be371d8ddfc38c79dfa98ab1115d5918da0871a935553dbfe627
1: From Stdlib Require Import List ZArith.
2: From compcert Require Import Integers Floats AST Values Memory Memdata Csem Smallstep.
3: From FiveMatInv3Case Require Import MatrixMemory.
4: Import ListNotations.
5: Local Open Scope Z_scope.
6: Definition Det(f:Z->float32):float32 := Float32.sub(Float32.mul(f 0)(f 3))(Float32.mul(f 1)(f 2)).
7: Definition Reject(f:Z->float32):bool := Float.cmp Clt(Float.of_single(Float32.abs(Det f)))(Float.of_bits(Int64.repr 4547007122018943789)).
8: Definition Result(f:Z->float32):val := Vint(if Reject f then Int.one else Int.zero).
9: Definition Output(f:Z->float32)(i:Z):float32 :=
10:  if Z.eq_dec i 0 then Float32.div(f 3)(Det f) else
11:  if Z.eq_dec i 1 then Float32.div(Float32.neg(f 1))(Det f) else
12:  if Z.eq_dec i 2 then Float32.div(Float32.neg(f 2))(Det f) else Float32.div(f 0)(Det f).
13: Definition Outputs(f:Z->float32):list(Z*float32):=[(0,Output f 0);(1,Output f 1);(2,Output f 2);(3,Output f 3)].
14: Definition Args(bo bi:block)(po pi:ptrofs):list val := [Vptr bo po;Vptr bi pi].
15: Definition Inputs(m:mem)(bo bi:block)(po pi:ptrofs)(f:Z->float32):Prop :=
16:  bo<>bi /\ WriteRegion m bo po 4 /\ Reads m bi pi 4 f.
17: Definition Precondition(args:list val)(m:mem):Prop := exists bo bi po pi f,args=Args bo bi po pi /\ Inputs m bo bi po pi f.
18: Definition Frame(m mf:mem)(bo:block)(po:ptrofs):Prop := forall b z n,Mem.valid_block m b->
19:  b<>bo \/ z+n<=Ptrofs.unsigned po \/ Ptrofs.unsigned po+16<=z ->Mem.loadbytes mf b z n=Mem.loadbytes m b z n.
20: Definition Encoded(f:Z->float32):list memval :=
21:  encode_val Mfloat32(Vsingle(Output f 0))++encode_val Mfloat32(Vsingle(Output f 1))++
22:  encode_val Mfloat32(Vsingle(Output f 2))++encode_val Mfloat32(Vsingle(Output f 3)).
23: Definition Post(m mf:mem)(bo bi:block)(po pi:ptrofs)(f:Z->float32):Prop :=
24:  WriteRegion mf bo po 4 /\ Reads mf bi pi 4 f /\ Frame m mf bo po /\
25:  (forall b,Mem.valid_block m b->Mem.valid_block mf b) /\
26:  (Mem.loadbytes mf bo(Ptrofs.unsigned po)16=
27:  if Reject f then Mem.loadbytes m bo(Ptrofs.unsigned po)16 else Some(Encoded f)) /\
28:  (forall ch b z perm,Mem.valid_block m b->Mem.valid_access m ch b z perm->Mem.valid_access mf ch b z perm).

FILE paparazzi/models/float_mat_inv_3d/rocq/support/Memcpy36.v SHA256 159db849b1ef40e3dca410aadae160e4f75f2d772ae1df1c792ab9983a2bbbe4
1: From Stdlib Require Import List ZArith Lia.
2: From compcert Require Import Coqlib Integers Floats AST Values Memory Memdata Events Globalenvs.
3: Import ListNotations.
4: Local Open Scope Z_scope.
5: Record CopyPre(m:mem)(src dst:block):Prop := {
6:  copy_separated:src<>dst;
7:  copy_readable:Mem.range_perm m src 0 36 Cur Readable;
8:  copy_writable:Mem.range_perm m dst 0 36 Cur Writable
9: }.
10: Record MemcpySafety(m:mem)(src dst:block):Prop := {
11:  pointer_1:src<>dst;
12:  pointer_arithmetic_1:Mem.valid_pointer m src 0=true;
13:  pointer_arithmetic_2:Mem.weak_valid_pointer m dst 36=true;
14:  pointer_2:dst<>src;
15:  pointer_arithmetic_3:Mem.valid_pointer m dst 0=true;
16:  pointer_arithmetic_4:Mem.weak_valid_pointer m src 36=true;
17:  precondition_1:src<>dst \/ 0+36<=0 \/0+36<=0;
18:  precondition_2:Mem.range_perm m src 0 36 Cur Readable;
19:  precondition_3:Mem.range_perm m dst 0 36 Cur Writable
20: }.
21: Definition CopyFrame(m mf:mem)(dst:block):Prop :=forall b ofs n,
22:  b<>dst \/ofs+n<=0 \/36<=ofs ->Mem.loadbytes mf b ofs n=Mem.loadbytes m b ofs n.
23: Lemma copy_pre_safety:forall m src dst,CopyPre m src dst->MemcpySafety m src dst.
24: Proof.
25:  intros m src dst[NE RD WR];constructor;auto.
26:  - apply Mem.valid_pointer_nonempty_perm;eapply Mem.perm_implies;[apply RD;lia|constructor].
27:  - apply Mem.weak_valid_pointer_spec;right;apply Mem.valid_pointer_nonempty_perm;eapply Mem.perm_implies;[apply WR;change(0<=36-1<36);lia|constructor].
28:  - apply Mem.valid_pointer_nonempty_perm;eapply Mem.perm_implies;[apply WR;lia|constructor].
29:  - apply Mem.weak_valid_pointer_spec;right;apply Mem.valid_pointer_nonempty_perm;eapply Mem.perm_implies;[apply RD;change(0<=36-1<36);lia|constructor].
30: Qed.
31: Theorem copy36_exact:forall se m src dst,CopyPre m src dst->
32:  exists mf bytes,MemcpySafety m src dst /\Mem.loadbytes m src 0 36=Some bytes /\length bytes=36%nat /\
33:  Mem.storebytes m dst 0 bytes=Some mf /\
34:  extcall_memcpy_sem 36 1 se[Vptr dst Ptrofs.zero;Vptr src Ptrofs.zero]m E0 Vundef mf /\
35:  Mem.loadbytes mf dst 0 36=Some bytes /\CopyFrame m mf dst.
36: Proof.
37:  intros se m src dst P;destruct(Mem.range_perm_loadbytes m src 0 36(copy_readable _ _ _ P))as[bytes READ].
38:  pose proof(Mem.loadbytes_length _ _ _ _ _ READ)as LEN;change(length bytes=36%nat)in LEN.
39:  assert(W:Mem.range_perm m dst 0(0+Z.of_nat(length bytes))Cur Writable)by(rewrite LEN;exact(copy_writable _ _ _ P)).
40:  destruct(Mem.range_perm_storebytes _ _ _ _ W)as[mf STORE].
41:  exists mf,bytes;split;[apply copy_pre_safety;exact P|];split;[exact READ|];split;[exact LEN|];split;[exact STORE|];split.
42:  - econstructor;try rewrite Ptrofs.unsigned_zero;try exact READ;try exact STORE;try(left;reflexivity);try lia;try(exists 36;reflexivity);try(intros;exists 0;reflexivity);left;exact(copy_separated _ _ _ P).
43:  - split.
44:    + pose proof(Mem.loadbytes_storebytes_same _ _ _ _ _ STORE)as H;rewrite LEN in H;exact H.
45:    + intros b ofs n OUT;destruct(zle n 0).
46:      * repeat rewrite Mem.loadbytes_empty by assumption;reflexivity.
47:      * eapply Mem.loadbytes_storebytes_other;[exact STORE|lia|];rewrite LEN;exact OUT.
48: Qed.
49: Lemma copy36_preserves_pre:forall m mf changed src dst bytes,
50:  Mem.storebytes m changed 0 bytes=Some mf->src<>changed->dst<>changed->CopyPre m src dst->CopyPre mf src dst.
51: Proof. intros m mf changed src dst bytes ST SC DC[NE RD WR];constructor;auto.
52:  - intros z B;eapply Mem.perm_storebytes_1;[exact ST|apply RD;exact B].
53:  - intros z B;eapply Mem.perm_storebytes_1;[exact ST|apply WR;exact B]. Qed.
54: Theorem two_copy36_exact:forall se m sa da sb db,
55:  CopyPre m sa da->CopyPre m sb db->sb<>da->db<>da->
56:  exists ma mb ba bb,MemcpySafety m sa da /\MemcpySafety ma sb db /\
57:  Mem.loadbytes m sa 0 36=Some ba /\Mem.loadbytes ma sb 0 36=Some bb /\
58:  Mem.storebytes m da 0 ba=Some ma /\Mem.storebytes ma db 0 bb=Some mb /\
59:  extcall_memcpy_sem 36 1 se[Vptr da Ptrofs.zero;Vptr sa Ptrofs.zero]m E0 Vundef ma /\
60:  extcall_memcpy_sem 36 1 se[Vptr db Ptrofs.zero;Vptr sb Ptrofs.zero]ma E0 Vundef mb /\
61:  Mem.loadbytes mb da 0 36=Some ba /\Mem.loadbytes mb db 0 36=Some bb /\
62:  CopyFrame m ma da /\CopyFrame ma mb db.
63: Proof.
64:  intros se m sa da sb db PA PB SD DD.
65:  destruct(copy36_exact se m sa da PA)as[ma[ba[SAFEA[RA[LA[SA[CA[BA FA]]]]]]]].
66:  assert(PB':CopyPre ma sb db)by(eapply copy36_preserves_pre;eauto).
67:  destruct(copy36_exact se ma sb db PB')as[mb[bb[SAFEB[RB[LB[SB[CB[BB FB]]]]]]]].
68:  exists ma,mb,ba,bb;split;[exact SAFEA|];split;[exact SAFEB|];split;[exact RA|];split;[exact RB|];split;[exact SA|];split;[exact SB|];split;[exact CA|];split;[exact CB|];split.
69:  - rewrite(FB da 0 36 ltac:(left;congruence));exact BA.
70:  - split;[exact BB|];split;assumption.
71: Qed.

