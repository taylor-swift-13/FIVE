22: #include <stdbool.h>
23: #include <math.h>
24: #include <float.h>
25: 
26: /* Explicit standard-library binding to the CompCert/CBMC intrinsic. */
27: #define fabs __builtin_fabs
28: 
29: bool float_mat_inv_3d(float inv_out[3][3], const float mat_in[3][3])
30: {
31:   const float m00 = mat_in[1][1] * mat_in[2][2] - mat_in[1][2] * mat_in[2][1];
32:   const float m10 = mat_in[0][1] * mat_in[2][2] - mat_in[0][2] * mat_in[2][1];
33:   const float m20 = mat_in[0][1] * mat_in[1][2] - mat_in[0][2] * mat_in[1][1];
34:   const float m01 = mat_in[1][0] * mat_in[2][2] - mat_in[1][2] * mat_in[2][0];
35:   const float m11 = mat_in[0][0] * mat_in[2][2] - mat_in[0][2] * mat_in[2][0];
36:   const float m21 = mat_in[0][0] * mat_in[1][2] - mat_in[0][2] * mat_in[1][0];
37:   const float m02 = mat_in[1][0] * mat_in[2][1] - mat_in[1][1] * mat_in[2][0];
38:   const float m12 = mat_in[0][0] * mat_in[2][1] - mat_in[0][1] * mat_in[2][0];
39:   const float m22 = mat_in[0][0] * mat_in[1][1] - mat_in[0][1] * mat_in[1][0];
40:   const float det = mat_in[0][0] * m00 - mat_in[1][0] * m10 + mat_in[2][0] * m20;
41:   if (fabs(det) > FLT_EPSILON) {
42:     inv_out[0][0] =  m00 / det;
43:     inv_out[1][0] = -m01 / det;
44:     inv_out[2][0] =  m02 / det;
45:     inv_out[0][1] = -m10 / det;
46:     inv_out[1][1] =  m11 / det;
47:     inv_out[2][1] = -m12 / det;
48:     inv_out[0][2] =  m20 / det;
49:     inv_out[1][2] = -m21 / det;
50:     inv_out[2][2] =  m22 / det;
51:     return 0;
52:   }
53:   return 1;
54: }

FILE paparazzi/models/float_mat_inv_2d/prepare/source/float_mat_inv_2d.c SHA256 5ff0fbc7d7284628788464d5b8d505756da59d0cddba3b97afe2a7c8d25b85e4
