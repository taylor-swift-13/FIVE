9: Definition BaseWords:list Z:=[1065353216;2147483648;0;2147483648;1065353216;2147483648;0;2147483648;1065353216].
10: Definition LargeWords:list Z:=[0;2147483648;0;2147483648;0;2147483648;0;2147483648;0].
11: Definition WordBridge:Prop:=forall m src dst mf bytes f,
12:  Mem.loadbytes m src 0 36=Some bytes->Mem.storebytes m dst 0 bytes=Some mf->
13:  (forall i,0<=i<9->Mem.loadbytes m src(4*i)4=Some(encode_val Mfloat32(Vsingle(f i))))->
14:  forall i,0<=i<9->Mem.load Mint32 mf dst(4*i)=Some(Vint(Float32.to_bits(f i))).
15: Lemma word_bridge:WordBridge.
16: Proof. exact memcpy_word_observation. Qed.
17: Definition Assert1:Prop:=forall m bo bi po pi f,bo<>bi->WriteRegion m bo po 9->Reads m bi pi 9 f->forall t v mf,
18:  star Csem.step Execution.ge(Execution.entry(Args bo bi po pi)m)t(Returnstate v Kstop mf)->v=Vint Int.zero \/v=Vint Int.one.
19: Lemma assertion1:Assert1.
20: Proof. intros m bo bi po pi f NE W RD t v mf PATH;destruct(FiveMatInv3Functional.Proof.all_normal_observations m bo bi po pi f NE W RD t v mf PATH)as[-> POST];unfold Status;destruct(Accept f);auto. Qed.
21: Definition Assert2:Prop:=forall m bo bi po pi f,bo<>bi->WriteRegion m bo po 9->Reads m bi pi 9 f->forall t v mf,
22:  star Csem.step Execution.ge(Execution.entry(Args bo bi po pi)m)t(Returnstate v Kstop mf)->
23:  Mem.loadbytes mf bo(Ptrofs.unsigned po-4)4=Mem.loadbytes m bo(Ptrofs.unsigned po-4)4 /\
24:  Mem.loadbytes mf bo(Ptrofs.unsigned po+36)4=Mem.loadbytes m bo(Ptrofs.unsigned po+36)4.
25: Lemma assertion2:Assert2.
26: Proof. intros m bo bi po pi f NE W RD t v mf PATH;destruct(FiveMatInv3Functional.Proof.all_normal_observations m bo bi po pi f NE W RD t v mf PATH)as[V[BYTES[FR REST]]].
27:  split;apply FR;try exact(writable_valid m bo po 9 ltac:(lia)W);[right;left|right;right];lia. Qed.
28: Definition Assert3:=FixedOutcome base3(Vint Int.zero).
29: Lemma assertion3:Assert3.
30: Proof. apply fixed_outcome;exact(proj1 base3_kernel). Qed.
31: Definition Assert4:Prop:=Assert3 /\words3 base3=map Int.repr BaseWords /\WordBridge.
32: Lemma assertion4:Assert4.
33: Proof. split;[exact assertion3|];split;[exact(proj2(proj2 base3_kernel))|exact word_bridge]. Qed.
34: Definition Assert5:=FixedOutcome small3(Vint Int.one).
35: Lemma assertion5:Assert5.
36: Proof. apply fixed_outcome;exact(proj1 small3_kernel). Qed.
37: Lemma small_rejects:Accept small3=false.
38: Proof. pose proof(proj1 small3_kernel)as H;unfold Status in H;destruct(Accept small3);[discriminate|reflexivity]. Qed.
39: Definition Assert6:Prop:=(forall m bo bi po pi,bo<>bi->WriteRegion m bo po 9->Reads m bi pi 9 small3->forall t v mf,
40:  star Csem.step Execution.ge(Execution.entry(Args bo bi po pi)m)t(Returnstate v Kstop mf)->
41:  Mem.loadbytes mf bo(Ptrofs.unsigned po)36=Mem.loadbytes m bo(Ptrofs.unsigned po)36) /\
42:  (forall m1 b1 m2 b2 bytes z,Mem.loadbytes m1 b1 0 36=Some bytes->Mem.loadbytes m2 b2 0 36=Some bytes->0<=z->z+4<=36->Mem.loadbytes m1 b1 z 4=Mem.loadbytes m2 b2 z 4).
43: Lemma assertion6:Assert6.
