FILE paparazzi/models/float_mat_inv_2d/rocq/support/ExactReplay.v SHA256 59fc26062ca97af130a499d30174eed240e188b2137fe93914d09bb7a05f42d3
1: From Stdlib Require Import List ZArith Lia.
2: From compcert Require Import Integers Floats AST Values Memory Events Csem Smallstep.
3: From FiveGuidanceEntry Require Import StackCleanup.
4: From FiveMatInv3Case Require Import MatrixMemory GuardWitness PairExtend.
5: From FiveInv2Case Require Import Contract Replay TraceInputs.
6: From FiveMatrixInverseSupport Require Import Kernels.
7: Import ListNotations.
8: Local Open Scope Z_scope.
9: Lemma extension_reads:forall m0 m,LoadPreserved m0 m->forall b p n f,0<n->Reads m0 b p n f->Reads m b p n f.
10: Proof. intros m0 m KEEP b p n f N RD;pose proof(reads_valid m0 b p n f N RD)as V;destruct RD as[AL[NW L]];repeat split;auto;intros i B;rewrite KEEP by exact V;apply L;exact B. Qed.
11: Lemma extension_writable:forall m0 m,AccessPreserved m0 m->forall b p n,WriteRegion m0 b p n->WriteRegion m b p n.
12: Proof. intros m0 m KEEP b p n[AL[NW RP]];split;[exact AL|];split;[exact NW|];eapply range_perm_access_preserved_block;[intros ch ofs perm VA;exact(KEEP ch b ofs perm VA)|exact RP]. Qed.
13: Lemma extension_inputs:forall m0 m,LoadPreserved m0 m->AccessPreserved m0 m->forall bo bi po pi f,Inputs m0 bo bi po pi f->Inputs m bo bi po pi f.
14: Proof. intros m0 m L A bo bi po pi f[NE[W RD]];split;[exact NE|];split;[eapply extension_writable;eauto|eapply extension_reads;eauto;lia]. Qed.
15: Lemma extension_guarded:forall m0 m,LoadPreserved m0 m->AccessPreserved m0 m->forall bo bi f,Guarded 4 m0 bo bi f->Guarded 4 m bo bi f.
16: Proof. intros m0 m L A bo bi f[NE[W[RD[OLD[BE AF]]]]].
17:  pose proof(writable_valid m0 bo(Ptrofs.repr 4)4 ltac:(lia)W)as V.
18:  split;[exact NE|];split;[eapply extension_writable;eauto|];split;[eapply extension_reads;eauto;lia|];split;[eapply extension_reads;eauto;lia|].
19:  split;[rewrite L by exact V;exact BE|rewrite L by exact V;exact AF]. Qed.
20: Definition InitializedLayout(m:mem)(og ig ob ib os is0 ol il:block):Prop:=
21:  Guarded 4 m og ig trace_input /\Inputs m ob ib Ptrofs.zero Ptrofs.zero base2 /\Inputs m os is0 Ptrofs.zero Ptrofs.zero small2 /\Inputs m ol il Ptrofs.zero Ptrofs.zero large2 /\
22:  Reads m ob Ptrofs.zero 4 initial_fixture /\Reads m os Ptrofs.zero 4 initial_fixture /\Reads m ol Ptrofs.zero 4 initial_fixture /\Separate og ig ob ib os is0 ol il.
23: Theorem initialized_layout_inhabited:exists m og ig ob ib os is0 ol il,InitializedLayout m og ig ob ib os is0 ol il.
24: Proof.
25:  destruct(matrix4_guarded trace_input)as[m0[og[ig GG]]].
26:  pose proof GG as[NG[WG[RG RESTG]]].
27:  pose proof(writable_valid m0 og(Ptrofs.repr 4)4 ltac:(lia)WG)as VG0.
28:  destruct(pair4_extend m0 base2 initial_fixture)as[m1[ob[ib[NB[WB[RB[OB[FOB[FIB[B1[L1[A1 V1]]]]]]]]]]]].
29:  assert(IB1:Inputs m1 ob ib Ptrofs.zero Ptrofs.zero base2)by(split;[exact NB|];split;[exact WB|exact RB]).
30:  pose proof(writable_valid m1 ob Ptrofs.zero 4 ltac:(lia)WB)as VB1.
31:  pose proof(V1 og VG0)as VG1.
32:  destruct(pair4_extend m1 small2 initial_fixture)as[m2[os[is0[NS[WS[RS[OS[FOS[FIS[B2[L2[A2 V2]]]]]]]]]]]].
33:  assert(IS2:Inputs m2 os is0 Ptrofs.zero Ptrofs.zero small2)by(split;[exact NS|];split;[exact WS|exact RS]).
34:  pose proof(writable_valid m2 os Ptrofs.zero 4 ltac:(lia)WS)as VS2.
35:  pose proof(V2 og VG1)as VG2;pose proof(V2 ob VB1)as VB2.
36:  destruct(pair4_extend m2 large2 initial_fixture)as[m3[ol[il[NL[WL[RL[OL[FOL[FIL[B3[L3[A3 V3]]]]]]]]]]]].
37:  assert(IL3:Inputs m3 ol il Ptrofs.zero Ptrofs.zero large2)by(split;[exact NL|];split;[exact WL|exact RL]).
38:  exists m3,og,ig,ob,ib,os,is0,ol,il;unfold InitializedLayout;split.
39:  - eapply extension_guarded;[exact L3|exact A3|];eapply extension_guarded;[exact L2|exact A2|];eapply extension_guarded;eauto.
40:  - split.
41:  + eapply extension_inputs;[exact L3|exact A3|];eapply extension_inputs;eauto.
42:  + split.
43:  * eapply extension_inputs;eauto.
44:  * split;[exact IL3|];split.
45:  -- eapply extension_reads;[exact L3|lia|];eapply extension_reads;eauto;lia.
46:  -- split;[eapply extension_reads;eauto;lia|];split;[exact OL|].
47:  constructor;intro EQ;subst;first[exact(FOB VG0)|exact(FIB VG0)|exact(FOS VG1)|exact(FIS VG1)|exact(FOL VG2)|exact(FIL VG2)|exact(FOS VB1)|exact(FIS VB1)|exact(FOL VB2)|exact(FIL VB2)|exact(FOL VS2)|exact(FIL VS2)].
48: Qed.
49: Definition TraceNonempty:Prop:=exists m og ig ob ib os is0 ol il ma mb mc md,
50:  InitializedLayout m og ig ob ib os is0 ol il /\
51:  NormalCall m og ig(Ptrofs.repr 4)Ptrofs.zero trace_input ma/\Post m ma og ig(Ptrofs.repr 4)Ptrofs.zero trace_input/\
52:  NormalCall ma ob ib Ptrofs.zero Ptrofs.zero base2 mb/\Post ma mb ob ib Ptrofs.zero Ptrofs.zero base2/\
53:  NormalCall mb os is0 Ptrofs.zero Ptrofs.zero small2 mc/\Post mb mc os is0 Ptrofs.zero Ptrofs.zero small2/\
54:  NormalCall mc ol il Ptrofs.zero Ptrofs.zero large2 md/\Post mc md ol il Ptrofs.zero Ptrofs.zero large2.
55: Theorem original_trace_nonempty:TraceNonempty.
56: Proof. destruct initialized_layout_inhabited as[m[og[ig[ob[ib[os[is0[ol[il LAYOUT]]]]]]]]].
57:  pose proof LAYOUT as[GG[IB[IS[IL[OB[OS[OL SEP]]]]]]].
58:  pose proof GG as[NE[W[RD OTHER]]];assert(IG:Inputs m og ig(Ptrofs.repr 4)Ptrofs.zero trace_input)by(split;[exact NE|];split;[exact W|exact RD]).
59:  destruct(original_trace_four_calls m og ig ob ib os is0 ol il IG IB IS IL SEP)as[ma[mb[mc[md CALLS]]]].
60:  exists m,og,ig,ob,ib,os,is0,ol,il,ma,mb,mc,md;split;assumption. Qed.
61: Print Assumptions initialized_layout_inhabited.
62: Print Assumptions original_trace_nonempty.

