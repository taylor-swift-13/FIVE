9: Local Open Scope Z_scope.
10: Definition CopyGuard(k:nat):Prop:=forall m src dst,CopyPre m src dst->
11:  match k with
12:  |0%nat=>forall order:Prop,~(src=dst/\order)
13:  |1%nat=>Mem.valid_pointer m src 0=true
14:  |2%nat=>Mem.weak_valid_pointer m dst 16=true
15:  |3%nat=>forall order:Prop,~(dst=src/\order)
16:  |4%nat=>Mem.valid_pointer m dst 0=true
17:  |5%nat=>Mem.weak_valid_pointer m src 16=true
18:  |6%nat=>src<>dst \/0+16<=0\/0+16<=0
19:  |7%nat=>Mem.range_perm m src 0 16 Cur Readable
20:  |_=>Mem.range_perm m dst 0 16 Cur Writable end.
21: Definition CaseStatus(f:Z->float32)(expected:val):Prop:=forall m bo bi po pi,Inputs m bo bi po pi f->forall t result mf,
22:  star Csem.step Execution.ge(Execution.entry(Args bo bi po pi)m)t(Returnstate result Kstop mf)->result=expected.
23: Definition CaseWords(f:Z->float32)(words:list Z):Prop:=forall m bo bi pi,Inputs m bo bi Ptrofs.zero pi f->forall t result mf,
24:  star Csem.step Execution.ge(Execution.entry(Args bo bi Ptrofs.zero pi)m)t(Returnstate result Kstop mf)->forall dst bytes obs,
25:  Mem.loadbytes mf bo 0 16=Some bytes->Mem.storebytes mf dst 0 bytes=Some obs->
26:  map(fun i=>Mem.load Mint32 obs dst(4*i))[0;1;2;3]=map(fun w=>Some(Vint(Int.repr w)))words.
27: Definition CasePreserves(f:Z->float32):Prop:=forall m bo bi po pi,Inputs m bo bi po pi f->forall t result mf,
28:  star Csem.step Execution.ge(Execution.entry(Args bo bi po pi)m)t(Returnstate result Kstop mf)->
29:  Mem.loadbytes mf bo(Ptrofs.unsigned po)16=Mem.loadbytes m bo(Ptrofs.unsigned po)16.
30: Definition Assertion1:Prop:=forall m bo bi po pi f,Inputs m bo bi po pi f->forall t result mf,
31:  star Csem.step Execution.ge(Execution.entry(Args bo bi po pi)m)t(Returnstate result Kstop mf)->result=Vint Int.zero\/result=Vint Int.one.
32: Definition Assertion2:Prop:=forall m bo bi pi f before after,Inputs m bo bi(Ptrofs.repr 4)pi f->
33:  Mem.load Mint32 m bo 0=Some(Vint before)->Mem.load Mint32 m bo 20=Some(Vint after)->forall t result mf,
34:  star Csem.step Execution.ge(Execution.entry(Args bo bi(Ptrofs.repr 4)pi)m)t(Returnstate result Kstop mf)->
35:  Frame m mf bo(Ptrofs.repr 4)/\Mem.load Mint32 mf bo 0=Some(Vint before)/\Mem.load Mint32 mf bo 20=Some(Vint after).
