FILE paparazzi/models/float_mat_inv_2d/rocq/support/RecheckSupport.v SHA256 9a481e620f883655d9d5c751df678b61ab3ea3a992d4ae75236c046487143a43
1: From Stdlib Require Import List ZArith Lia.
2: From compcert Require Import Coqlib Integers Floats AST Values Memory Memdata Events Ctypes Csem Smallstep.
3: From FiveShared.verification Require Import Obligations.
4: From FiveMatInv3Case Require Import MatrixMemory.
5: From FivePprzFloatMatInv2d Require Import Execution.
6: From FiveInv2Case Require Import Contract Call MemoryEffects Body Memcpy16 Observer TraceInputs.
7: Import ListNotations.
8: Local Open Scope Z_scope.
9: Record AddressFacts(m:mem)(b:block)(p:ptrofs)(i:Z)(perm:permission):Prop:={
10:  address_nonnull:Vptr b(Ptrofs.add p(Ptrofs.repr(4*i)))<>Vnullptr;
11:  address_live:Mem.valid_block m b;
12:  address_typed:Mem.valid_access m Mfloat32 b(Ptrofs.unsigned p+4*i)perm;
13:  address_nowrap:Ptrofs.unsigned(Ptrofs.add p(Ptrofs.repr(4*i)))=Ptrofs.unsigned p+4*i;
14:  address_bounds:0<=i<4
15: }.
16: Definition SourceGuards(i:Z)(output:bool):Prop :=forall m bo bi po pi f,Inputs m bo bi po pi f->0<=i<4->
17:  no_error Execution.ge(Execution.entry(Args bo bi po pi)m)/\
18:  if output then AddressFacts m bo po i Writable else AddressFacts m bi pi i Readable.
19: Theorem source_guards:forall i output,SourceGuards i output.
20: Proof. intros i output m bo bi po pi f IN B;destruct(call_summary m bo bi po pi f IN)as[mf[PATH[POST[SAFE ALL]]]];split;[exact SAFE|].
21:  destruct IN as[NE[W RD]];destruct output;constructor;try discriminate;try exact B.
22:  - exact(writable_valid m bo po 4 ltac:(lia)W).
23:  - eapply writable_access;eauto.
24:  - eapply index_pointer;[exact(proj1(proj2 W))|exact B].
25:  - exact(reads_valid m bi pi 4 f ltac:(lia)RD).
26:  - eapply Mem.load_valid_access;exact(proj2(proj2 RD)i B).
27:  - eapply index_pointer;[exact(proj1(proj2 RD))|exact B]. Qed.
28: Lemma same_bytes_cell_at:forall m1 b1 base1 m2 b2 base2 bytes z,
29:  Mem.loadbytes m1 b1 base1 16=Some bytes->Mem.loadbytes m2 b2 base2 16=Some bytes->0<=z->z+4<=16->
30:  Mem.loadbytes m1 b1(base1+z)4=Mem.loadbytes m2 b2(base2+z)4.
31: Proof. intros m1 b1 base1 m2 b2 base2 bytes z A B Z LIMIT.
32:  replace 16 with(z+(16-z))in A,B by lia.
33:  destruct(Mem.loadbytes_split _ _ _ _ _ _ A ltac:(lia)ltac:(lia))as[a[rest[RA[RR EA]]]].
34:  destruct(Mem.loadbytes_split _ _ _ _ _ _ B ltac:(lia)ltac:(lia))as[c[tail[RC[RT EC]]]].
35:  assert(L:length a=length c)by(erewrite(Mem.loadbytes_length _ _ _ _ _ RA),(Mem.loadbytes_length _ _ _ _ _ RC);reflexivity).
36:  destruct(append_cut _ a rest c tail L ltac:(congruence))as[_ EQ];subst tail.
37:  replace(16-z)with(4+(12-z))in RR,RT by lia.
38:  destruct(Mem.loadbytes_split _ _ _ _ _ _ RR ltac:(lia)ltac:(lia))as[d[ds[RD[RDS ED]]]].
39:  destruct(Mem.loadbytes_split _ _ _ _ _ _ RT ltac:(lia)ltac:(lia))as[f[fs[RF[RFS EF]]]].
40:  assert(L':length d=length f)by(erewrite(Mem.loadbytes_length _ _ _ _ _ RD),(Mem.loadbytes_length _ _ _ _ _ RF);reflexivity).
41:  destruct(append_cut _ d ds f fs L' ltac:(congruence))as[EQ _];subst f;congruence. Qed.
42: Lemma successful_post_cells:forall m mf bo bi po pi f,Post m mf bo bi po pi f->Reject f=false->forall i,0<=i<4->
43:  Mem.loadbytes mf bo(Ptrofs.unsigned po+4*i)4=Some(encode_val Mfloat32(Vsingle(Output f i))).
44: Proof. intros m mf bo bi po pi f POST REJ i B.
45:  destruct POST as[W[RD[FR[VB[BY AC]]]]];rewrite REJ in BY.
46:  destruct(Mem.alloc Mem.empty 0 16)as[ma br]eqn:AL.
47:  assert(WR:WriteRegion ma br Ptrofs.zero 4).
48:  { unfold WriteRegion;rewrite Ptrofs.unsigned_zero;split;[exists 0;lia|];split;[change(16<=18446744073709551616);lia|intros z R;eapply Mem.perm_implies;[eapply Mem.perm_alloc_2;[exact AL|lia]|constructor]]. }
49:  destruct(writes_exist(Outputs f)ma br Ptrofs.zero 4 WR(output_bounds f))as[mr WS].
50:  assert(BR:Branch ma br Ptrofs.zero f mr)by(unfold Branch;rewrite REJ;exact WS).
51:  pose proof(branch_bytes ma br Ptrofs.zero f mr BR)as REF;rewrite REJ,Ptrofs.unsigned_zero in REF.
52:  pose proof(same_bytes_cell_at mf bo(Ptrofs.unsigned po)mr br 0(Encoded f)(4*i)BY REF ltac:(lia)ltac:(lia))as EQ.
53:  rewrite EQ;replace(0+4*i)with(Ptrofs.unsigned Ptrofs.zero+4*i)by(rewrite Ptrofs.unsigned_zero;lia).
54:  eapply writes_bytes;[exact WS|apply output_nodup|].
55:  assert(C:i=0\/i=1\/i=2\/i=3)by lia;destruct C as [-> | [-> | [-> | ->]]];unfold Outputs;repeat first[left;reflexivity|right]. Qed.
56: Theorem successful_copy_words:forall m mf bo bi pi f dst bytes obs,
57:  Post m mf bo bi Ptrofs.zero pi f->Reject f=false->Mem.loadbytes mf bo 0 16=Some bytes->Mem.storebytes mf dst 0 bytes=Some obs->
58:  forall i,0<=i<4->Mem.load Mint32 obs dst(4*i)=Some(Vint(Float32.to_bits(Output f i))).
59: Proof. intros m mf bo bi pi f dst bytes obs POST REJ READ STORE i B;eapply memcpy_word_observation;[exact READ|exact STORE| |exact B].
60:  intros j J;replace(4*j)with(Ptrofs.unsigned Ptrofs.zero+4*j)by(rewrite Ptrofs.unsigned_zero;lia);eapply successful_post_cells;eauto. Qed.
61: Theorem post_preserves_other_inputs:forall m mf bo bi po pi f out input outp inp g,
62:  Post m mf bo bi po pi f->Inputs m out input outp inp g->out<>bo->input<>bo->Inputs mf out input outp inp g.
63: Proof. intros m mf bo bi po pi f out input outp inp g[W[RD[FR[VB[BY AC]]]]][NE[WO RI]]OO IO;split;[exact NE|];split.
64:  - destruct WO as[AL[NW RP]];repeat split;auto;intros z B.
65:    assert(V:Mem.valid_block m out)by(eapply(writable_valid m out outp 4 ltac:(lia));repeat split;eauto).
66:    assert(VA:Mem.valid_access m Mint8unsigned out z Writable)by(split;[intros off R;apply RP;cbn[size_chunk]in R;lia|change(1|z);exists z;lia]).
67:    pose proof(AC Mint8unsigned out z Writable V VA)as[PF ALIGN];apply PF;cbn[size_chunk];lia.
68:  - destruct RI as[AL[NW L]];repeat split;auto;intros i B.
69:    destruct(Mem.load_loadbytes Mfloat32 m input(Ptrofs.unsigned inp+4*i)(Vsingle(g i))(L i B))as[bytes[LB DE]].
70:    assert(VI:Mem.valid_block m input)by(eapply(reads_valid m input inp 4 g ltac:(lia));repeat split;eauto).
71:    assert(LBF:Mem.loadbytes mf input(Ptrofs.unsigned inp+4*i)4=Some bytes)by(rewrite FR by(auto);exact LB).
72:    pose proof(Mem.loadbytes_load Mfloat32 mf input(Ptrofs.unsigned inp+4*i)bytes LBF ltac:(change(4|Ptrofs.unsigned inp+4*i);destruct AL as[k K];exists(k+i);lia))as LF;rewrite <-DE in LF;exact LF.
73: Qed.
74: Print Assumptions source_guards.
75: Print Assumptions successful_copy_words.
76: 
77: Theorem frame_load_kept:forall m mf bo po b ofs ch v,Frame m mf bo po->Mem.valid_block m b->
78:  (b<>bo\/ofs+size_chunk ch<=Ptrofs.unsigned po\/Ptrofs.unsigned po+16<=ofs)->Mem.load ch m b ofs=Some v->Mem.load ch mf b ofs=Some v.
79: Proof. intros m mf bo po b ofs ch v FR VB OUT LD.
80:  destruct(Mem.load_loadbytes ch m b ofs v LD)as[bytes[LB DE]].
81:  assert(LBF:Mem.loadbytes mf b ofs(size_chunk ch)=Some bytes)by(rewrite FR by assumption;exact LB).
82:  pose proof(Mem.load_valid_access _ _ _ _ _ LD)as[RP AL].
83:  pose proof(Mem.loadbytes_load ch mf b ofs bytes LBF AL)as LF;rewrite <-DE in LF;exact LF. Qed.

FILE paparazzi/models/float_mat_inv_3d/rocq/support/RecheckSupport.v SHA256 1d6a05b885d568d58e61293a462c3b547eacd77480fdae72739bbd4d34cc51c9
1: From Stdlib Require Import List String ZArith Lia.
2: From compcert Require Import Coqlib Integers Floats AST Values Memory Memdata Events Globalenvs Ctypes Csem Smallstep.
3: From FiveShared.verification Require Import Obligations.
4: From FivePprzFloatMatInv3d Require Import Execution.
5: From FiveMatInv3Case Require Import Contract MatrixMemory Scalar Call Memcpy36 Observer TraceInputs.
6: From FiveMatrixInverseSupport Require Import Kernels Witness.
7: Require FiveMatInv3NoError.Spec FiveMatInv3NoError.Proof FiveMatInv3Functional.Spec FiveMatInv3Functional.Proof.
8: Import ListNotations.
9: Local Open Scope Z_scope.
10: Lemma valid_cell_live:forall m ch b z p,Mem.valid_access m ch b z p->size_chunk ch=4->perm_order p Nonempty->
11:  Mem.valid_pointer m b z=true /\Mem.weak_valid_pointer m b(z+4)=true.
12: Proof. intros m ch b z p[RP AL]SZ PO;split.
13:  - apply Mem.valid_pointer_nonempty_perm;eapply Mem.perm_implies;[apply RP;rewrite SZ;lia|exact PO].
14:  - apply Mem.weak_valid_pointer_spec;right;apply Mem.valid_pointer_nonempty_perm;eapply Mem.perm_implies;[apply RP;rewrite SZ;lia|exact PO]. Qed.
15: Definition SourceGuards:Prop:=FiveMatInv3NoError.Spec.NoError /\
16:  forall m bo bi po pi f,bo<>bi->WriteRegion m bo po 9->Reads m bi pi 9 f->
17:  Mem.valid_block m bo /\Mem.valid_block m bi /\
18:  forall r c,0<=r<3->0<=c<3->0<=3*r+c<9 /\
19:  Mem.valid_access m Mfloat32 bi(Ptrofs.unsigned pi+4*(3*r+c))Readable /\
20:  Mem.valid_access m Mfloat32 bo(Ptrofs.unsigned po+4*(3*r+c))Writable /\
21:  Mem.valid_pointer m bi(Ptrofs.unsigned pi+4*(3*r+c))=true /\
22:  Mem.weak_valid_pointer m bi(Ptrofs.unsigned pi+4*(3*r+c)+4)=true /\
23:  Mem.valid_pointer m bo(Ptrofs.unsigned po+4*(3*r+c))=true /\
24:  Mem.weak_valid_pointer m bo(Ptrofs.unsigned po+4*(3*r+c)+4)=true.
25: Theorem source_guards:SourceGuards.
26: Proof. split;[exact FiveMatInv3NoError.Proof.no_error_proved|].
27:  intros m bo bi po pi f NE W R;split;[exact(writable_valid m bo po 9 ltac:(lia)W)|];split;[exact(reads_valid m bi pi 9 f ltac:(lia)R)|].
28:  intros r c RR CC;assert(B:0<=3*r+c<9)by lia.
29:  pose proof(Mem.load_valid_access _ _ _ _ _(proj2(proj2 R)(3*r+c)B))as RI.
30:  pose proof(writable_access m bo po 9(3*r+c)W B)as WO.
31:  destruct(valid_cell_live _ _ _ _ _ RI eq_refl ltac:(constructor))as[RL RE].
32:  destruct(valid_cell_live _ _ _ _ _ WO eq_refl ltac:(constructor))as[WL WE].
33:  split;[exact B|];split;[exact RI|];split;[exact WO|];auto.
34: Qed.
35: Inductive CopyKind:=SameForward|SourceLive|DestinationEndLive|SameReverse|DestinationLive|SourceEndLive|NoOverlap|ReadableSource|WritableDestination.
36: Definition CopyGuard(m:mem)(src dst:block)(kind:CopyKind):Prop:=forall(order1 order2:Prop),match kind with
37:  |SameForward=>(True /\~(dst<>src))->False
38:  |SourceLive=>(True /\~(dst<>src))->Mem.valid_pointer m src 0=true
39:  |DestinationEndLive=>(True /\~(dst<>src))->Mem.weak_valid_pointer m dst 36=true
40:  |SameReverse=>~(dst<>src \/order1)->False
41:  |DestinationLive=>~(dst<>src \/order1)->Mem.valid_pointer m dst 0=true
42:  |SourceEndLive=>~(dst<>src \/order1)->Mem.weak_valid_pointer m src 36=true
43:  |NoOverlap=>(dst<>src \/order1)\/order2
44:  |ReadableSource=>Mem.range_perm m src 0 36 Cur Readable
45:  |WritableDestination=>Mem.range_perm m dst 0 36 Cur Writable end.
46: Lemma copy_safety_guard:forall m src dst kind,MemcpySafety m src dst->CopyGuard m src dst kind.
47: Proof. intros m src dst kind S a b;destruct S;destruct kind;cbn;tauto. Qed.
48: Definition CopyClaim(kind:CopyKind):Prop:=forall se m src dst,CopyPre m src dst->
49:  exists mf bytes,MemcpySafety m src dst /\Mem.loadbytes m src 0 36=Some bytes /\
50:  Mem.storebytes m dst 0 bytes=Some mf /\extcall_memcpy_sem 36 1 se[Vptr dst Ptrofs.zero;Vptr src Ptrofs.zero]m E0 Vundef mf /\
51:  Mem.loadbytes mf dst 0 36=Some bytes /\CopyFrame m mf dst /\CopyGuard m src dst kind.
52: Theorem copy_claim:forall kind,CopyClaim kind.
53: Proof. intros kind se m src dst P;destruct(copy36_exact se m src dst P)as[mf[bytes[S[R[L[ST[CALL[BYTES FR]]]]]]]].
54:  exists mf,bytes;split;[exact S|];split;[exact R|];split;[exact ST|];split;[exact CALL|];split;[exact BYTES|];split;[exact FR|];apply copy_safety_guard;exact S. Qed.
55: Definition FixedOutcome(f:Z->float32)(status:val):Prop:=
56:  (forall m bo bi po pi,bo<>bi->WriteRegion m bo po 9->Reads m bi pi 9 f->
57:  exists mf,(exists t,star Csem.step Execution.ge(Execution.entry(Args bo bi po pi)m)t(Returnstate status Kstop mf))/\FiveMatInv3Functional.Spec.Post m mf bo bi po pi f) /\
58:  (forall m bo bi po pi,bo<>bi->WriteRegion m bo po 9->Reads m bi pi 9 f->forall t v mf,
59:  star Csem.step Execution.ge(Execution.entry(Args bo bi po pi)m)t(Returnstate v Kstop mf)->v=status /\FiveMatInv3Functional.Spec.Post m mf bo bi po pi f).
60: Lemma fixed_outcome:forall f status,Status f=status->FixedOutcome f status.
61: Proof. intros f status EQ;split.
62:  - intros m bo bi po pi NE W RD;rewrite <-EQ;apply FiveMatInv3Functional.Proof.normal_call;assumption.
63:  - intros m bo bi po pi NE W RD t v mf PATH;rewrite <-EQ;eapply FiveMatInv3Functional.Proof.all_normal_observations;eauto. Qed.
64: Definition InitPairs(old:Z->float32):list(Z*float32):=[(0,old 0);(1,old 1);(2,old 2);(3,old 3);(4,old 4);(5,old 5);(6,old 6);(7,old 7);(8,old 8)].
65: Definition Initialized(m:mem)(bo bi:block)(f old:Z->float32):Prop:=bo<>bi /\WriteRegion m bo Ptrofs.zero 9 /\Reads m bi Ptrofs.zero 9 f /\
66:  forall i,0<=i<9->Mem.loadbytes m bo(4*i)4=Some(encode_val Mfloat32(Vsingle(old i))).
67: Lemma initialized_exists:forall f old,exists m bo bi,Initialized m bo bi f old.
68: Proof.
69:  intros f old;destruct(matrix9_inhabited f)as[mi[bo[bi[NE[WO RI]]]]].
70:  destruct(writes_exist(InitPairs old)mi bo Ptrofs.zero 9 WO)as[m WR].
71:  { intros i x IN;unfold InitPairs in IN;cbn in IN;repeat destruct IN as[IN|IN];try contradiction;inversion IN;lia. }
72:  exists m,bo,bi;split;[exact NE|];split;[eapply writes_writable;[exact WR|exact WO]|];split.
73:  - eapply writes_reads_other;[exact WR|exact RI|congruence].
74:  - intros i I;replace(4*i)with(Ptrofs.unsigned Ptrofs.zero+4*i)by(rewrite Ptrofs.unsigned_zero;lia);eapply writes_bytes;[exact WR|unfold InitPairs;repeat constructor;simpl;intuition discriminate|].
75:    assert(i=0\/i=1\/i=2\/i=3\/i=4\/i=5\/i=6\/i=7\/i=8)by lia;repeat destruct H as[H|H];subst i;unfold InitPairs;repeat(first[left;reflexivity|right]).
76: Qed.
77: Definition CallReplay(f old:Z->float32)(status:val):Prop:=exists m bo bi mf t,
78:  Initialized m bo bi f old /\star Csem.step Execution.ge(Execution.entry(Args bo bi Ptrofs.zero Ptrofs.zero)m)t(Returnstate status Kstop mf) /\
79:  FiveMatInv3Functional.Spec.Post m mf bo bi Ptrofs.zero Ptrofs.zero f.
80: Theorem call_replay:forall f old status,Status f=status->CallReplay f old status.
81: Proof. intros f old status EQ;destruct(initialized_exists f old)as[m[bo[bi[NE[W[R CELLS]]]]]].
82:  destruct(FiveMatInv3Functional.Proof.normal_call m bo bi Ptrofs.zero Ptrofs.zero f NE W R)as[mf[[t PATH]POST]].
83:  exists m,bo,bi,mf,t;split;[split;[exact NE|];split;[exact W|];split;[exact R|exact CELLS]|];split;[rewrite <-EQ;exact PATH|exact POST]. Qed.
84: Definition OldFixed(i:Z):float32:=Diag3(Float32.of_bits(Int.repr 1099431936))i.
85: Definition OldArbitrary(_:Z):float32:=Float32.zero.
86: Theorem original_calls_replay:
87:  CallReplay arbitrary_0 OldArbitrary(Vint Int.one) /\CallReplay arbitrary_1 OldArbitrary(Vint Int.one) /\
88:  CallReplay base3 OldFixed(Vint Int.zero) /\CallReplay small3 OldFixed(Vint Int.one) /\CallReplay large3 OldFixed(Vint Int.zero).
89: Proof. repeat split;apply call_replay.
90:  - unfold Status;rewrite arbitrary_rejects_0;reflexivity.
91:  - unfold Status;rewrite arbitrary_rejects_1;reflexivity.
92:  - exact(proj1 base3_kernel).
93:  - exact(proj1 small3_kernel).
94:  - exact(proj1 large3_kernel).
95: Qed.
96: Print Assumptions source_guards.
97: Print Assumptions copy_claim.
98: Print Assumptions original_calls_replay.
