FILE examples/models/sum3/rocq/cbmc_recheck/problem/Spec.v SHA256 1f1045772bcd04c924ed1685e9d84dfbdd70db8dfb298b981c2ee8cd0e87bb99
1: From Stdlib Require Import ZArith.
2: From compcert Require Import Integers Floats Values Csem Smallstep.
3: From FiveSum3Proof Require Import SourceInvariant.
4: 
5: Definition ResultBitsGoal : Prop := forall m t v mf,
6:  star Csem.step sum3_ge
7:    (sum3_start (Vsingle (Float32.of_bits (Int.repr 1266679808)))
8:                (Vsingle (Float32.of_bits (Int.repr 1065353216)))
9:                (Vsingle (Float32.of_bits (Int.repr 3414163456))) m)
10:    t (Returnstate v Kstop mf) ->
11:  exists f, v = Vsingle f /\ Float32.to_bits f = Int.zero.
12: 
13: From Stdlib Require Import List ZArith.
14: From compcert Require Import Coqlib Maps Integers Floats AST Values Memory Memdata Events Globalenvs Ctypes Cop Csyntax Csyntaxdefs Csem Smallstep.
15: From FiveSum3Proof Require Import SourceInvariant.
16: Import ListNotations.
17: Local Open Scope Z_scope.
18: 
19: Definition bits_id : ident := 9001%positive.
20: Definition bits_env (bb:block) : env := PTree.set bits_id (bb,tuint) empty_env.
21: Definition bits_assertion : expr :=
22:  Ebinop Oeq (Evalof (Evar bits_id tuint) tuint) (Eval (Vint Int.zero) tuint) tint.
23: 
24: (** The two objects are the final two locals in main. All preceding locals and
25:     arbitrary caller memory are included in m. Allocations precede both calls. *)
26: Inductive HarnessPrefix (m:mem) (a b c:float32) : block -> block -> mem -> val -> Prop :=
27: | harness_prefix : forall mr br mh bb t1 v1 m1 t2 v2 m2,
28:  Mem.alloc m 0 4 = (mr,br) -> Mem.alloc mr 0 4 = (mh,bb) ->
29:  star Csem.step sum3_ge (sum3_start (Vsingle a)(Vsingle b)(Vsingle c) mh) t1 (Returnstate v1 Kstop m1) ->
30:  star Csem.step sum3_ge
31:   (sum3_start (Vsingle(Float32.of_bits(Int.repr 1266679808)))
32:    (Vsingle(Float32.of_bits(Int.repr 1065353216)))
33:    (Vsingle(Float32.of_bits(Int.repr 3414163456))) m1) t2 (Returnstate v2 Kstop m2) ->
34:  HarnessPrefix m a b c br bb m2 v2.
35: 
36: (** CBMC's library uses internal pointer guards. Their portable memory-safety
37:     content is object separation, live base/one-past pointers, and region
38:     permissions; no C order is imposed between unrelated CompCert blocks. *)
39: Record MemcpySafety (m:mem) (br bb:block) : Prop := {
40:  memcpy_pointer_1 : br <> bb;
41:  memcpy_pointer_arithmetic_1 : Mem.valid_pointer m br 0 = true;
42:  memcpy_pointer_arithmetic_2 : Mem.weak_valid_pointer m bb 4 = true;
43:  memcpy_pointer_2 : bb <> br;
44:  memcpy_pointer_arithmetic_3 : Mem.valid_pointer m bb 0 = true;
45:  memcpy_pointer_arithmetic_4 : Mem.weak_valid_pointer m br 4 = true;
46:  main_precondition_instance_1 : br <> bb \/ 0+4 <= 0 \/ 0+4 <= 0;
47:  main_precondition_instance_2 : Mem.range_perm m br 0 4 Cur Readable;
48:  main_precondition_instance_3 : Mem.range_perm m bb 0 4 Cur Writable
49: }.
50: Definition ByteObservation (br bb:block) (m:mem) (v:val) : Prop :=
51:  exists stored copied bytes,
52:  Mem.store Mfloat32 m br 0 v = Some stored /\
53:  MemcpySafety stored br bb /\
54:  Mem.loadbytes stored br 0 4 = Some bytes /\
55:  bytes = encode_val Mfloat32 v /\
56:  extcall_memcpy_sem 4 1 (Genv.to_senv (Csem.genv_genv sum3_ge)) [Vptr bb Ptrofs.zero;Vptr br Ptrofs.zero] stored E0 Vundef copied /\
57:  Mem.loadbytes copied bb 0 4 = Some bytes /\
58:  Mem.load Mint32 copied bb 0 = Some(Vint Int.zero) /\
59:  star Csem.step sum3_ge
60:   (ExprState sum3_function bits_assertion Kstop (bits_env bb) copied) E0
61:   (ExprState sum3_function (Eval (Vint Int.one) tint) Kstop (bits_env bb) copied).
62: Definition FullHarnessGoal : Prop := forall m (a b c:float32) br bb mf v,
63:  HarnessPrefix m a b c br bb mf v -> ByteObservation br bb mf v.
