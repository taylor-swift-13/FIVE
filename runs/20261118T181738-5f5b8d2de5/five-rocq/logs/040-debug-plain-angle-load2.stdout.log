1 goal
  
  ge : genv
  b : block
  m : mem
  a : int
  LOAD : Mem.load Mint32 m b 0 = Some (Vint a)
  ============================
  match
    match access_mode tint with
    | By_value chunk =>
        if type_is_volatile tint
        then do_volatile_load ge quiet_world chunk m b Ptrofs.zero
        else
         match Mem.loadv chunk m (Vptr b Ptrofs.zero) with
         | Some v => Some (quiet_world, E0, v)
         | None => None
         end
    | By_nothing => None
    | _ => Some (quiet_world, E0, Vptr b Ptrofs.zero)
    end
  with
  | Some (_, _, v) => Some v
  | None => None
  end = Some (Vint a)
