63: Lemma guard_value:forall e bpo bpi bo bi po pi f m,
64:  Core e bpo bpi bo bi po pi f(Updated(PTree.empty float32)(LocalResults f))m->
65:  pure_rval Execution.ge e m Guard=Some(Val.of_bool(Accept f)).
66: Proof.
67:  intros e bpo bpi bo bi po pi f m C.
68:  assert(D:pure_rval Execution.ge e m(Local Source._det)=Some(Vsingle(Det f))).
69:  { eapply known_value;[exact(core_known _ _ _ _ _ _ _ _ _ _ C)|reflexivity]. }
70:  change(match(match pure_rval Execution.ge e m(Local Source._det)with Some v=>sem_unary_operation Oabsfloat v tfloat m|None=>None end)with Some v=>sem_binary_operation Execution.ge Ogt v tdouble(Vsingle(Float32.of_bits(Int.repr 872415232)))tfloat m|None=>None end=Some(Val.of_bool(Accept f))).
