
FILE paparazzi/models/float_mat_inv_3d/rocq/cbmc_recheck/attempts/001/check.py SHA256 4f56f1561116b285b89fb4d989a40de9bcd569f41efd94350f294a692a7f3e68
1: #!/usr/bin/env python3
2: """Rebuild the frozen project closure and certify all exact requested goals."""
3: from pathlib import Path
4: import argparse,importlib.util,json
5: root=Path(__file__).resolve().parents[7]
6: attempt=Path(__file__).resolve().parent
7: parser=argparse.ArgumentParser();parser.add_argument('--record-run');args=parser.parse_args()
8: spec=importlib.util.spec_from_file_location('five_matrix_checker',root/'paparazzi/report/quat_rotation_paths/evidence_tools.py')
9: checker=importlib.util.module_from_spec(spec);spec.loader.exec_module(checker)
10: config=json.loads((attempt/'checker-config.json').read_text());config['root']=str(root)
11: if not args.record_run:config.pop('build',None)
12: print(json.dumps(checker.check(config,record_run=args.record_run),indent=2))

