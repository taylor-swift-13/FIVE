72: Definition one:float32:=Float32.of_bits(Int.repr 1065353216).
73: Definition small:float32:=Float32.of_bits(Int.repr 998244352).
74: Definition big2:float32:=Float32.of_bits(Int.repr 1904214016).
75: Definition big3:float32:=Float32.of_bits(Int.repr 1484783616).
76: Definition base2:=Diag2 one.
77: Definition small2:=Diag2 small.
78: Definition large2:=Diag2 big2.
79: Definition base3:=Diag3 one.
80: Definition small3:=Diag3 small.
81: Definition large3:=Diag3 big3.
82: Definition words2(f:Z->float32):list int:=map(fun i=>Float32.to_bits(D2.Output f i))[0;1;2;3].
83: Definition words3(f:Z->float32):list int:=map(fun i=>Float32.to_bits(D3.Output f i))[0;1;2;3;4;5;6;7;8].
84: Lemma base2_kernel:D2.Result base2=Vint Int.zero /\
85:  Float32.to_bits(D2.Det base2)=Int.repr 1065353216 /\
86:  words2 base2=map Int.repr[1065353216;2147483648;2147483648;1065353216].
87: Proof. vm_compute;repeat split;reflexivity. Qed.
88: Lemma small2_kernel:D2.Result small2=Vint Int.one /\
89:  Float32.to_bits(D2.Det small2)=Int.repr 931135488.
90: Proof. vm_compute;split;reflexivity. Qed.
91: Lemma large2_kernel:D2.Result large2=Vint Int.zero /\
92:  Float32.to_bits(D2.Det large2)=Int.repr 2139095040 /\
93:  words2 large2=map Int.repr[0;2147483648;2147483648;0].
94: Proof. vm_compute;repeat split;reflexivity. Qed.
95: Lemma base3_kernel:D3.Status base3=Vint Int.zero /\
96:  Float32.to_bits(D3.Det base3)=Int.repr 1065353216 /\
97:  words3 base3=map Int.repr[1065353216;2147483648;0;2147483648;1065353216;2147483648;0;2147483648;1065353216].
98: Proof. vm_compute;repeat split;reflexivity. Qed.
99: Lemma small3_kernel:D3.Status small3=Vint Int.one /\
100:  Float32.to_bits(D3.Det small3)=Int.repr 864026624.
101: Proof. vm_compute;split;reflexivity. Qed.
102: Lemma large3_kernel:D3.Status large3=Vint Int.zero /\
103:  Float32.to_bits(D3.Det large3)=Int.repr 2139095040 /\
104:  words3 large3=map Int.repr[0;2147483648;0;2147483648;0;2147483648;0;2147483648;0].
105: Proof. vm_compute;repeat split;reflexivity. Qed.
106: Definition residual2(f:Z->float32):float32:=Float32.sub(Float32.mul(f 0)(D2.Output f 0))one.
107: Definition residual3(f:Z->float32):float32:=Float32.sub(Float32.mul(f 0)(D3.Output f 0))one.
108: Lemma large2_residual:Float32.to_bits(residual2 large2)=Int.repr 3212836864.
109: Proof. vm_compute;reflexivity. Qed.
110: Lemma large3_residual:Float32.to_bits(residual3 large3)=Int.repr 3212836864.
111: Proof. vm_compute;reflexivity. Qed.
112: Lemma RefuteScaleStatus2:D2.Result base2<>D2.Result small2.
113: Proof. vm_compute;discriminate. Qed.
114: Lemma RefuteScaleStatus3:D3.Status base3<>D3.Status small3.
115: Proof. vm_compute;discriminate. Qed.
116: Definition SmallResidual(r:float32):bool:=
117:  (Float32.cmp Cgt r(Float32.of_bits(Int.repr 3204448256)) &&
118:  Float32.cmp Clt r(Float32.of_bits(Int.repr 1056964608)))%bool.
119: Lemma RefuteLargeResidual2:D2.Result large2=Vint Int.zero /\SmallResidual(residual2 large2)=false.
120: Proof. vm_compute;split;reflexivity. Qed.
121: Lemma RefuteLargeResidual3:D3.Status large3=Vint Int.zero /\SmallResidual(residual3 large3)=false.
122: Proof. vm_compute;split;reflexivity. Qed.
123: Print Assumptions base2_kernel.
