13: Lemma free_list_preserves_old : forall P m l mf,
14:  (forall b lo hi, In (b,lo,hi) l -> forall ofs, ~ P b ofs) ->
15:  Mem.free_list m l = Some mf -> Mem.unchanged_on P m mf.
16: Proof.
17:  intros P m l; revert m; induction l as [|[[b lo] hi] tl IH]; intros m mf F E.
18:  - simpl in E; inversion E; apply Mem.unchanged_on_refl.
19:  - simpl in E; destruct(Mem.free m b lo hi) as [mx|] eqn:FR; try discriminate.
20:    eapply Mem.unchanged_on_trans.
21:    + eapply Mem.free_unchanged_on; [exact FR|]. intros; eapply F; left; reflexivity.
22:    + eapply IH; [|exact E]. intros; eapply F; right;exact H.
23: Qed.
