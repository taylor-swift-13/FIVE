138: Lemma result_step : forall s t s' result,
139:  execution_invariant s -> state_eval sum3_ge s = Some result ->
140:  Csem.step sum3_ge s t s' -> state_eval sum3_ge s' = Some result.
141: Proof.
142:  intros s t s' result [SOURCE [NORMAL [old OLD]]] EVAL STEP.
143:  destruct STEP as [ES|SS].
144:  - destruct s as [f stmt k e m|f a k e m|fd args k m|v k m|]; try solve[inversion ES].
145:    exact (normal_estep_forward sum3_ge f a k e m t s' result SOURCE NORMAL EVAL ES).
146:  - rewrite <- (normal_sstep_denotation _ _ _ _ SOURCE NORMAL SS); exact EVAL.
147: Qed.
