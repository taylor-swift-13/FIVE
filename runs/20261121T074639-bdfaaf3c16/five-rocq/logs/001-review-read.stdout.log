87:    erewrite Mem.load_store_other by(exact SB||(left;exact DAB)).
88:    erewrite Mem.load_store_same by exact SA;reflexivity. }
89:  assert(LB:Mem.load Mfloat32 m0 bb 0=Some(Vsingle b)).
90:  { erewrite Mem.load_store_other by(exact SC||(left;exact DBC)).
91:    erewrite Mem.load_store_same by exact SB;reflexivity. }
92:  assert(LC:Mem.load Mfloat32 m0 bc 0=Some(Vsingle c)).
93:  { erewrite Mem.load_store_same by exact SC;reflexivity. }
94:  assert(BODY:stmt_eval sum3_ge e tfloat(fn_body sum3_function)m0=
95:   Some(Nreturn(Vsingle(Float32.add(Float32.add a b)c)),m0)).
96:  { apply return_single;[reflexivity|].
97:    eapply pure_single_add;[reflexivity|reflexivity| |].
98:    - eapply pure_single_add;[reflexivity|reflexivity| |];eapply read_parameter;eauto.
99:    - eapply read_parameter;eauto. }
100:  assert(KEEP:forall chunk bx ofs p,Mem.valid_access ma chunk bx ofs p ->
101:   Mem.valid_access m0 chunk bx ofs p).
102:  { intros chunk bx ofs p ACCESS.
103:    eapply Mem.store_valid_access_1;[exact SC|].
104:    eapply Mem.store_valid_access_1;[exact SB|].
105:    eapply Mem.store_valid_access_1;[exact SA|exact ACCESS]. }
106:  destruct(free_frame_exists m0 ba bb bc DAB DAC DBC
107:   (KEEP _ _ _ _ WA)(KEEP _ _ _ _ WB)(KEEP _ _ _ _ WC))as [mf FREE].
108:  assert(FRESH: forall b, In b [ba;bb;bc] -> ~ Mem.valid_block m b).
109:  { intros bx IN V; simpl in IN; destruct IN as [EQ|[EQ|[EQ|[]]]]; subst bx.
110:    - exact(Mem.fresh_block_alloc _ _ _ _ _ AA V).
111:    - apply(Mem.fresh_block_alloc _ _ _ _ _ AB); eapply Mem.valid_block_alloc; eauto.
112:    - apply(Mem.fresh_block_alloc _ _ _ _ _ AC); eapply Mem.valid_block_alloc; [exact AB|]. eapply Mem.valid_block_alloc; eauto. }
113:  assert(UNCH:Mem.unchanged_on (fun b _ => Mem.valid_block m b) m mf).
114:  { eapply Mem.unchanged_on_trans; [eapply Mem.alloc_unchanged_on;exact AA|].
115:    eapply Mem.unchanged_on_trans; [eapply Mem.alloc_unchanged_on;exact AB|].
116:    eapply Mem.unchanged_on_trans; [eapply Mem.alloc_unchanged_on;exact AC|].
117:    eapply Mem.unchanged_on_trans; [eapply Mem.store_unchanged_on;[exact SA|intros; eapply FRESH; simpl;auto]|].
118:    eapply Mem.unchanged_on_trans; [eapply Mem.store_unchanged_on;[exact SB|intros; eapply FRESH; simpl;auto]|].
119:    eapply Mem.unchanged_on_trans; [eapply Mem.store_unchanged_on;[exact SC|intros; eapply FRESH; simpl;auto]|].
120:    eapply free_list_preserves_old; [|exact FREE].
121:    intros bx lo hi IN ofs.
122:    unfold blocks_of_env, frame_env in IN; vm_compute in IN.
123:    repeat destruct IN as [IN|IN]; try contradiction; inversion IN; subst; eapply FRESH; simpl; auto. }
124:  exists mf; split; [|exact UNCH].
125:  cbn [state_eval sum3_start].
126:  rewrite(do_alloc_variables_complete sum3_ge _ _ _ _ _ ALLOC).
127:  rewrite(sem_bind_parameters_complete sum3_ge quiet_world _ _ _ _ _ BIND).
128:  change((match stmt_eval sum3_ge e tfloat(fn_body sum3_function)m0 with
129:  |Some(out,mx)=>cont_eval sum3_ge e tfloat Kstop out mx|None=>None end)=
130:  Some(Vsingle(Float32.add(Float32.add a b)c),mf)).
131:  rewrite BODY.
132:  change((match Mem.free_list m0(blocks_of_env sum3_ge(frame_env ba bb bc)) with
133:  |Some mx=>Some(Vsingle(Float32.add(Float32.add a b)c),mx)|None=>None end)=
134:  Some(Vsingle(Float32.add(Float32.add a b)c),mf)).
135:  rewrite FREE;reflexivity.
136: Qed.
