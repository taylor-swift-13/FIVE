166:  unfold RecheckSpec.ResultBitsGoal.
167:  intros m t v mf PATH.
168:  pose proof (sum3_return_value _ _ _ _ _ _ _ PATH) as EQ.
169:  exists sum3_concrete_model; split; [exact EQ|apply sum3_concrete_bits].
170: Qed.
