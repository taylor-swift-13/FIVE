216: Lemma bits_assertion_steps : forall bb m,
217:  Mem.load Mint32 m bb 0 = Some(Vint Int.zero) ->
218:  star Csem.step sum3_ge
219:   (ExprState sum3_function bits_assertion Kstop(bits_env bb)m) E0
220:   (ExprState sum3_function(Eval(Vint Int.one)tint)Kstop(bits_env bb)m).
221: Proof.
222:  intros bb m LOAD; unfold bits_assertion.
223:  eapply star_step with
224:  (s2:=ExprState sum3_function
225:  (Ebinop Oeq (Evalof(Eloc bb Ptrofs.zero Full tuint)tuint)(Eval(Vint Int.zero)tuint)tint)
226:  Kstop(bits_env bb)m)(t1:=E0)(t2:=E0).
227:  - left; eapply step_lred with(C:=fun a=>Ebinop Oeq(Evalof a tuint)(Eval(Vint Int.zero)tuint)tint).
228:    + apply red_var_local; unfold bits_env;apply PTree.gss.
229:    + apply ctx_binop_left;apply ctx_rvalof;apply ctx_top.
230:  - eapply star_step with
231:  (s2:=ExprState sum3_function(Ebinop Oeq(Eval(Vint Int.zero)tuint)(Eval(Vint Int.zero)tuint)tint)
232:  Kstop(bits_env bb)m)(t1:=E0)(t2:=E0).
233:    + left; eapply step_rred with(C:=fun a=>Ebinop Oeq a(Eval(Vint Int.zero)tuint)tint).
234:      * apply red_rvalof; eapply deref_loc_value;[reflexivity|reflexivity|].
235:        unfold Mem.loadv;rewrite Ptrofs.unsigned_zero;rewrite zle_true;[exact LOAD|change(4<=18446744073709551616);lia].
236:      * apply ctx_binop_left;apply ctx_top.
237:    + eapply star_step with(t1:=E0)(t2:=E0).
238:      * left; eapply step_rred with(C:=fun a=>a);[apply red_binop;reflexivity|apply ctx_top].
239:      * constructor.
240:      * reflexivity.

FILE paparazzi/models/float_mat_inv_3d/rocq/support/GuardWitness.v SHA256 0c9d7d015eb5a95969fc5dc620dd696ca6e76c96a4ab96452825294dc869ad75
1: From Stdlib Require Import List ZArith Lia.
2: From compcert Require Import Coqlib Integers Floats AST Values Memory Memdata.
3: From FiveMatInv3Case Require Import MatrixMemory.
4: From FiveMatrixInverseSupport Require Import Witness.
5: Require FiveInv2Case.Contract.
6: Import ListNotations.
7: Local Open Scope Z_scope.
8: Definition GuardValue(n i:Z):float32:=if Z.eqb i 0 then Float32.of_bits(Int.repr 305419896) else if Z.eqb i(n+1)then Float32.of_bits(Int.repr 2596069104)else Float32.zero.
9: Definition Guarded(n:Z)(m:mem)(bo bi:block)(f:Z->float32):Prop:=bo<>bi /\WriteRegion m bo(Ptrofs.repr 4)n /\Reads m bi Ptrofs.zero n f /\Reads m bo(Ptrofs.repr 4)n(fun _=>Float32.zero) /\
10:  Mem.load Mint32 m bo 0=Some(Vint(Int.repr 305419896)) /\Mem.load Mint32 m bo(4*n+4)=Some(Vint(Int.repr 2596069104)).
11: Lemma guarded_extend:forall n xs m0 bi f,
12:  (n=4\/n=9)->Reads m0 bi Ptrofs.zero n f->
13:  (forall i x,In(i,x)xs->0<=i<n+2)->NoDup(map fst xs)->(forall i,0<=i<n+2->In(i,GuardValue n i)xs)->
14:  exists m bo,Guarded n m bo bi f.
15: Proof.
16:  intros n xs m0 bi f N RD RANGE ND COVER.
17:  assert(POS:0<n)by(destruct N as[-> | ->];lia).
18:  pose proof(reads_valid m0 bi Ptrofs.zero n f POS RD)as VI.
19:  destruct(Mem.alloc m0 0(4*(n+2)))as[ma bo]eqn:A.
20:  assert(NE:bo<>bi)by(intro EQ;subst bo;exact(Mem.fresh_block_alloc _ _ _ _ _ A VI)).
21:  assert(W:WriteRegion ma bo Ptrofs.zero(n+2)).
22:  { unfold WriteRegion;rewrite Ptrofs.unsigned_zero;split;[exists 0;lia|];split.
23:  - change Ptrofs.modulus with 18446744073709551616;destruct N as[-> | ->];lia.
24:  - intros z Z;eapply Mem.perm_implies;[eapply Mem.perm_alloc_2;[exact A|exact Z]|constructor]. }
25:  assert(RA:Reads ma bi Ptrofs.zero n f).
26:  { destruct RD as[AL[NW R]];split;[exact AL|];split;[exact NW|];intros i I;erewrite Mem.load_alloc_unchanged;[apply R;exact I|exact A|exact VI]. }
27:  destruct(writes_exist xs ma bo Ptrofs.zero(n+2)W RANGE)as[m WR].
28:  assert(WF:WriteRegion m bo Ptrofs.zero(n+2))by(eapply writes_writable;[exact WR|exact W]).
29:  assert(RF:Reads m bi Ptrofs.zero n f)by(eapply writes_reads_other;[exact WR|exact RA|congruence]).
30:  assert(CELLS:forall i,0<=i<n+2->Mem.loadbytes m bo(4*i)4=Some(encode_val Mfloat32(Vsingle(GuardValue n i)))).
31:  { intros i I;replace(4*i)with(Ptrofs.unsigned Ptrofs.zero+4*i)by(rewrite Ptrofs.unsigned_zero;lia);eapply writes_bytes;[exact WR|exact ND|apply COVER;exact I]. }
32:  assert(OUTW:WriteRegion m bo(Ptrofs.repr 4)n).
33:  { destruct WF as[_[NW RP]];rewrite Ptrofs.unsigned_zero in NW,RP;unfold WriteRegion;change((4|4)/\4+4*n<=Ptrofs.modulus/\Mem.range_perm m bo 4(4+4*n)Cur Writable).
34:  split;[exists 1;lia|];split;[lia|intros z Z;apply RP;lia]. }
35:  assert(OUTR:Reads m bo(Ptrofs.repr 4)n(fun _=>Float32.zero)).
