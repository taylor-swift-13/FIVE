26:  exists mf, state_eval sum3_ge (sum3_start (Vsingle a) (Vsingle b) (Vsingle c) m) = Some (Vsingle (Float32.add (Float32.add a b) c), mf) /\ Mem.unchanged_on (fun b _ => Mem.valid_block m b) m mf.
