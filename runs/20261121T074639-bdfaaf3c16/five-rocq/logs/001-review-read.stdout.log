43:    rewrite EQ in V;exact(Mem.fresh_block_alloc _ _ _ _ _ AB V). }
44:  assert(DAC:ba<>bc).
45:  { intro EQ;pose proof(Mem.valid_new_block _ _ _ _ _ AA)as V.
46:    pose proof(Mem.valid_block_alloc _ _ _ _ _ AB ba V)as V'.
47:    rewrite EQ in V';exact(Mem.fresh_block_alloc _ _ _ _ _ AC V'). }
48:  assert(DBC:bb<>bc).
49:  { intro EQ;pose proof(Mem.valid_new_block _ _ _ _ _ AB)as V.
50:    rewrite EQ in V;exact(Mem.fresh_block_alloc _ _ _ _ _ AC V). }
51:  assert(WA:Mem.valid_access ma Mfloat32 ba 0 Freeable).
52:  { eapply Mem.valid_access_alloc_other;[exact AC|].
53:    eapply Mem.valid_access_alloc_other;[exact AB|].
54:    eapply Mem.valid_access_alloc_same;[exact AA|lia|change(0+4<=4);lia|exists 0;reflexivity]. }
55:  assert(WB:Mem.valid_access ma Mfloat32 bb 0 Freeable).
56:  { eapply Mem.valid_access_alloc_other;[exact AC|].
57:    eapply Mem.valid_access_alloc_same;[exact AB|lia|change(0+4<=4);lia|exists 0;reflexivity]. }
58:  assert(WC:Mem.valid_access ma Mfloat32 bc 0 Freeable).
59:  { eapply Mem.valid_access_alloc_same;[exact AC|lia|change(0+4<=4);lia|exists 0;reflexivity]. }
