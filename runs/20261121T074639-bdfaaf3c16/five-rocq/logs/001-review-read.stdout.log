149: Theorem sum3_return_value : forall m (a b c:float32) t v mf,
150:  star Csem.step sum3_ge (sum3_start (Vsingle a) (Vsingle b) (Vsingle c) m) t (Returnstate v Kstop mf) ->
151:  v = Vsingle (Float32.add (Float32.add a b) c).
152: Proof.
153:  intros m a b c t v mf PATH.
154:  destruct (typed_entry_result m a b c) as [expected [INIT UNCH]].
155:  assert (INV: execution_invariant (sum3_start (Vsingle a) (Vsingle b) (Vsingle c) m)) by apply typed_entry_establishes_invariant.
156:  assert (END: state_eval sum3_ge (Returnstate v Kstop mf) =
157:               Some (Vsingle (Float32.add (Float32.add a b) c), expected)).
158:  { revert INIT INV; induction PATH; intros INIT INV; auto.
159:    apply IHPATH; [eapply result_step; eauto | eapply invariant_preserved; eauto]. }
160:  cbn [state_eval] in END; inversion END; reflexivity.
161: Qed.
162: Print Assumptions sum3_return_value.
