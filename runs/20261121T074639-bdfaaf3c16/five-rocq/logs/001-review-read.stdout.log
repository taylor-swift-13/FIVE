187: Lemma invariant_return_exists : forall s,
188:  Acc (FiveShared.verification.Obligations.successor sum3_ge) s -> execution_invariant s ->
189:  exists t v mf, star Csem.step sum3_ge s t (Returnstate v Kstop mf).
190: Proof.
191:  intros s ACCESS; induction ACCESS as [s ACCESS IH]; intros INV.
192:  destruct(invariant_progress _ INV) as [[v[mf EQ]]|[t[next STEP]]].
193:  - subst s; exists E0,v,mf; constructor.
194:  - destruct(IH next (ex_intro _ t STEP) (invariant_preserved _ _ _ INV STEP)) as [tr[v[mf PATH]]].
195:    exists(t**tr),v,mf; eapply star_step; [exact STEP|exact PATH|reflexivity].
196: Qed.
197: Theorem arbitrary_call_returns : forall m (a b c:float32),
198:  exists t v mf,star Csem.step sum3_ge (sum3_start(Vsingle a)(Vsingle b)(Vsingle c)m)t(Returnstate v Kstop mf).
199: Proof.
200:  intros; apply invariant_return_exists.
201:  - apply source_accessible; split;reflexivity.
202:  - apply typed_entry_establishes_invariant.
203: Qed.
204: Theorem harness_prefix_exists : forall m (a b c:float32),
205:  exists br bb mf v, HarnessPrefix m a b c br bb mf v.
206: Proof.
207:  intros; destruct(Mem.alloc m 0 4) as [mr br] eqn:AR.
208:  destruct(Mem.alloc mr 0 4) as [mh bb] eqn:AB.
209:  destruct(arbitrary_call_returns mh a b c)as[t1[v1[m1 P1]]].
210:  destruct(arbitrary_call_returns m1
211:  (Float32.of_bits(Int.repr 1266679808)) (Float32.of_bits(Int.repr 1065353216))
212:  (Float32.of_bits(Int.repr 3414163456)))as[t2[v2[m2 P2]]].
213:  exists br,bb,m2,v2; econstructor;eauto.
214: Qed.
