173: Theorem sum3_preserves_caller_frame : forall m (a b c:float32) t v mf,
174:  star Csem.step sum3_ge (sum3_start (Vsingle a) (Vsingle b) (Vsingle c) m) t (Returnstate v Kstop mf) ->
175:  Mem.unchanged_on (fun b _ => Mem.valid_block m b) m mf.
176: Proof.
177:  intros m a b c t v mf PATH.
178:  destruct(typed_entry_result m a b c) as [expected [INIT UNCH]].
179:  assert(INV:execution_invariant(sum3_start(Vsingle a)(Vsingle b)(Vsingle c)m)) by apply typed_entry_establishes_invariant.
180:  assert(END:state_eval sum3_ge(Returnstate v Kstop mf)=Some(Vsingle(Float32.add(Float32.add a b)c),expected)).
181:  { revert INIT INV; induction PATH; intros INIT INV; auto.
182:    apply IHPATH; [eapply result_step;eauto|eapply invariant_preserved;eauto]. }
183:  cbn[state_eval] in END; inversion END; subst; exact UNCH.
184: Qed.
