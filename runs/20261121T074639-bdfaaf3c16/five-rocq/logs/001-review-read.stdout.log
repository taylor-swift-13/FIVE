66:  assert(WCW:Mem.valid_access m2 Mfloat32 bc 0 Writable).
67:  { eapply Mem.store_valid_access_1;[exact SB|].
68:    eapply Mem.store_valid_access_1;[exact SA|];eapply Mem.valid_access_freeable_any;exact WC. }
69:  destruct(Mem.valid_access_store m2 Mfloat32 bc 0(Vsingle c)WCW)as [m0 SC].
70:  assert(BIND:bind_parameters sum3_ge e ma(fn_params sum3_function)
71:    [Vsingle a;Vsingle b;Vsingle c]m0).
72:  { change(bind_parameters sum3_ge e ma
73:     [(Source._a,tfloat);(Source._b,tfloat);(Source._c,tfloat)]
74:     [Vsingle a;Vsingle b;Vsingle c]m0).
75:    eapply bind_parameters_cons with(m1:=m1);[exact EA| |].
76:    - eapply assign_loc_value;[reflexivity|reflexivity|].
77:      change(Mem.store Mfloat32 ma ba 0(Vsingle a)=Some m1);exact SA.
78:    - eapply bind_parameters_cons with(m1:=m2);[exact EB| |].
79:      + eapply assign_loc_value;[reflexivity|reflexivity|].
80:        change(Mem.store Mfloat32 m1 bb 0(Vsingle b)=Some m2);exact SB.
81:      + eapply bind_parameters_cons with(m1:=m0);[exact EC| |].
82:        * eapply assign_loc_value;[reflexivity|reflexivity|].
83:          change(Mem.store Mfloat32 m2 bc 0(Vsingle c)=Some m0);exact SC.
