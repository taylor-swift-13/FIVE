632-(** The size of an union is the max of the sizes of its members. *)
633-
634-Fixpoint sizeof_union (env: composite_env) (ms: members) : Z :=
635-  match ms with
636-  | nil => 0
637-  | m :: ms => Z.max (sizeof env (type_member m)) (sizeof_union env ms)
638-  end.
