376:Lemma context_compose:
377-  forall k2 k3 C2, context k2 k3 C2 ->
378-  forall k1 C1, context k1 k2 C1 ->
379-  context k1 k3 (fun x => C2(C1 x))
380-with contextlist_compose:
381-  forall k2 C2, contextlist k2 C2 ->
382-  forall k1 C1, context k1 k2 C1 ->
383-  contextlist k1 (fun x => C2(C1 x)).
384-Proof.
629:Definition sizeof_struct (env: composite_env) (m: members) : Z :=
630-  bytes_of_bits (bitsizeof_struct env 0 m).
