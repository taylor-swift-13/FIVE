
FILE paparazzi/relations/guidance_mode/support/allorder/PureDenotation.v SHA256 12456231c9097b3ccc26fdf1c8f1972aff42755d24eef28c76b1e460a590c317
1: From Coq Require Import Bool List ZArith.
2: From compcert Require Import Coqlib Errors Maps Integers Floats AST Values Memory Events Globalenvs Determinism Ctypes Cop Csyntax Csem Cexec Cstrategy Smallstep.
3: From FiveGuidanceSemantics Require Import SemanticsSupport.
4: From FiveGuidanceAllOrder Require Import PureSyntax.
5: Import ListNotations.
6: 
7: (** This denotation is used to establish uniqueness of normal executions.
8:     Execution remains the complete error-preserving operational model. *)
9: Definition quiet_world: world := World (fun _ _ => None) (fun _ _ _ => None) (fun _ _ _ _ => None).
10: 
11: Section DENOTATION.
12: Variable ge: genv.
13: Variable e: env.
14: Variable m: mem.
15: 
16: Fixpoint pure_rval (a: expr): option val :=
17:   match a with
18:   | Eval v _ => Some v
19:   | Evalof l ty =>
20:       if type_eq ty (typeof l) then
21:       match pure_lval l with
22:       | Some (b,ofs,bf) =>
23:           match Cexec.do_deref_loc ge quiet_world ty m b ofs bf with
24:           | Some (_,_,v) => Some v | None => None end
25:       | None => None end else None
26:   | Eaddrof l _ =>
27:       match pure_lval l with Some (b,ofs,Full) => Some (Vptr b ofs) | _ => None end
28:   | Eunop op a _ =>
29:       match pure_rval a with Some v => sem_unary_operation op v (typeof a) m | None => None end
30:   | Ebinop op a b _ =>
31:       match pure_rval a, pure_rval b with
32:       | Some v, Some w => sem_binary_operation ge op v (typeof a) w (typeof b) m
33:       | _,_ => None end
34:   | Ecast a ty =>
35:       match pure_rval a with Some v => sem_cast v (typeof a) ty m | None => None end
36:   | Esizeof ty _ => Some (Vptrofs (Ptrofs.repr (sizeof ge ty)))
37:   | Ealignof ty _ => Some (Vptrofs (Ptrofs.repr (alignof ge ty)))
38:   | _ => None
39:   end
40: with pure_lval (a: expr): option (block * ptrofs * bitfield) :=
41:   match a with
42:   | Eloc b ofs bf _ => Some (b,ofs,bf)
43:   | Evar id ty =>
44:       match PTree.get id e with
45:       | Some (b,ty') => if type_eq ty ty' then Some (b,Ptrofs.zero,Full) else None
46:       | None => match Genv.find_symbol ge id with Some b => Some (b,Ptrofs.zero,Full) | None => None end end
47:   | Ederef a _ =>
48:       match pure_rval a with Some (Vptr b ofs) => Some (b,ofs,Full) | _ => None end
49:   | Efield a id _ =>
50:       match pure_rval a with
51:       | Some (Vptr b ofs) =>
52:           match typeof a with
53:           | Tstruct sid _ =>
54:               match PTree.get sid (genv_cenv ge) with
55:               | Some co => match field_offset ge id (co_members co) with
56:                 | OK (delta,bf) => Some (b,Ptrofs.add ofs (Ptrofs.repr delta),bf)
57:                 | _ => None end
58:               | None => None end
59:           | Tunion sid _ =>
60:               match PTree.get sid (genv_cenv ge) with
61:               | Some co => match union_field_offset ge id (co_members co) with
62:                 | OK (delta,bf) => Some (b,Ptrofs.add ofs (Ptrofs.repr delta),bf)
63:                 | _ => None end
64:               | None => None end
65:           | _ => None end
66:       | _ => None end
67:   | _ => None
68:   end.
69: 
70: Definition pure_eq (k: kind) (a b: expr): Prop :=
71:   match k with RV => pure_rval a = pure_rval b | LV => pure_lval a = pure_lval b end.
72: 
73: Lemma context_type_eq:
74:   forall from to C, context from to C -> forall a b,
75:   typeof a = typeof b -> typeof (C a) = typeof (C b).
76: Proof. induction 1; simpl; intros; auto. Qed.
77: 
78: Lemma pure_context_congr:
79:   forall from to C, context from to C -> forall a b,
80:   typeof a = typeof b -> pure_eq from a b -> pure_eq to (C a) (C b).
81: Proof.
82:   induction 1; simpl; intros a b HT HE; auto;
83:     try (rewrite (IHcontext a b HT HE); reflexivity);
84:     try (rewrite (context_type_eq _ _ _ H a b HT), (IHcontext a b HT HE); reflexivity).
85: Qed.
86: 
87: End DENOTATION.
88: 
89: Lemma simple_context_hole:
90:   forall from to C, context from to C -> forall a,
91:   simple (C a) = true -> simple a = true.
92: Proof.
93:   induction 1; simpl; intros a HA; core_unpack; try discriminate; eauto.
94: Qed.
95: 
96: Lemma pure_lred:
97:   forall ge e a m a' m', lred ge e a m a' m' ->
98:   m' = m /\ typeof a' = typeof a /\ simple a' = true /\
99:   pure_lval ge e m a = pure_lval ge e m a'.
100: Proof.
101:   intros ge e a m a' m' H; inversion H; subst; simpl; repeat split; auto;
102:     try rewrite H0; try rewrite H1; try rewrite H2; try rewrite dec_eq_true; auto.
103: Qed.
104: 
105: Lemma pure_rred:
106:   forall ge e a m t a' m', simple a = true -> rred ge a m t a' m' ->
107:   m' = m /\ t = E0 /\ typeof a' = typeof a /\ simple a' = true /\
108:   pure_rval ge e m a = pure_rval ge e m a'.
109: Proof.
110:   intros ge e a m t a' m' HA HR; inversion HR; subst; simpl in HA; core_unpack; try discriminate;

