147: Lemma pure_not_stuck : forall ge e m a v,
148:  simple a=true -> pure_rval ge e m a=Some v -> Csem.not_stuck ge e a m.
149: Proof.
150:  intros ge e m a v S EV k C sub CT EQ; subst a.
151:  pose proof (proj1 (pure_eval_big _ ge e m S) _ EV) as BIG.
152:  destruct k.
153:  - destruct (big_context_hole _ _ _ CT sub ge e m S ltac:(unfold big_defined; eauto))
154:    as [b[ofs[bf L]]]. exact (proj2(big_immediate ge e m) _ _ _ _ L).
155:  - destruct (big_context_hole _ _ _ CT sub ge e m S ltac:(unfold big_defined; eauto))
156:    as [w R]. exact (proj1(big_immediate ge e m) _ _ R).
157: Qed.
158: 
159: Lemma simple_immediate : forall ge e m a,
160:  simple a=true -> pure_rval ge e m a<>None -> imm_safe ge e RV a m.
161: Proof.
162:  intros ge e m a S D. destruct (pure_rval ge e m a) eqn:E; [|contradiction].
163:  eapply (proj1(big_immediate ge e m)); eapply(proj1(pure_eval_big _ ge e m S)); eauto.
164: Qed.
