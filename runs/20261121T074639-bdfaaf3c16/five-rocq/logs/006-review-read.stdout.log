129: Definition big_defined (ge:genv) (e:env) (m:mem) (k:kind) (a:expr) : Prop :=
130:  match k with
131:  | RV=>exists v,eval_simple_rvalue ge e m a v
132:  | LV=>exists b ofs bf,eval_simple_lvalue ge e m a b ofs bf end.
133: 
134: Lemma big_context_hole : forall from to C,
135:  context from to C -> forall a ge e m,
136:  simple(C a)=true -> big_defined ge e m to (C a) -> big_defined ge e m from a.
137: Proof.
138:  induction 1; intros a0 ge e m SIMPLE BIG; simpl in SIMPLE; core_unpack; try discriminate; auto;
139:  unfold big_defined in BIG; repeat match goal with B:exists _,_ |- _=>destruct B end;
140:  match goal with
141:  | B:eval_simple_rvalue _ _ _ _ _ |- _=>inversion B; subst
142:  | B:eval_simple_lvalue _ _ _ _ _ _ _ |- _=>inversion B; subst
143:  end;
144:  eapply IHcontext; eauto; unfold big_defined; eauto.
145: Qed.
