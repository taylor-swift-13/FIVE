46: Definition literal (k:kind) (a:expr) : bool :=
47:  match k,a with RV,Eval _ _ | LV,Eloc _ _ _ _=>true | _,_=>false end.
48: 
49: Lemma lift_immediate : forall ge e m from to C a,
50:  context from to C -> literal from a=false -> imm_safe ge e from a m ->
51:  imm_safe ge e to (C a) m.
52: Proof.
53:  intros ge e m from to C a CT NL IS; inversion IS; subst; try discriminate.
54:  - eapply imm_safe_lred with (C:=fun x=>C(C0 x)); eauto using Cstrategy.context_compose.
55:  - eapply imm_safe_rred with (C:=fun x=>C(C0 x)); eauto using Cstrategy.context_compose.
56:  - eapply imm_safe_callred with (C:=fun x=>C(C0 x)); eauto using Cstrategy.context_compose.
57: Qed.
58: 
59: Lemma literal_r_inv : forall a, literal RV a=true -> exists v ty,a=Eval v ty.
60: Proof. destruct a; simpl; intros; try discriminate; eauto. Qed.
61: Lemma literal_l_inv : forall a, literal LV a=true -> exists b ofs bf ty,a=Eloc b ofs bf ty.
62: Proof. destruct a; simpl; intros; try discriminate; eauto. Qed.
63: 
64: Ltac invert_literal_eval :=
65:  repeat match goal with
66:  | H:eval_simple_rvalue _ _ _ (Eval _ _) _ |- _ => inversion H; subst; clear H
67:  | H:eval_simple_lvalue _ _ _ (Eloc _ _ _ _) _ _ _ |- _ => inversion H; subst; clear H
68:  end.
69: Lemma big_immediate : forall ge e m,
70:  (forall a v,eval_simple_rvalue ge e m a v -> imm_safe ge e RV a m) /\
71:  (forall a b ofs bf,eval_simple_lvalue ge e m a b ofs bf -> imm_safe ge e LV a m).
72: Proof.
73:  intros ge e m; apply eval_simple_rvalue_lvalue_ind; intros.
74:  - constructor.
75:  - destruct (literal LV l) eqn:LIT.
76:    + destruct (literal_l_inv _ LIT) as [bl[ol[bfl[tl LITERAL_EQ]]]]; subst l.
77:      invert_literal_eval; cbn [typeof] in *; subst. eapply imm_safe_rred with (C:=fun x=>x); [|constructor].
78:      eapply red_rvalof; eauto.
79:    + eapply lift_immediate with (from:=LV) (C:=fun x=>Evalof x ty); eauto.
80:      constructor; constructor.
81:  - destruct (literal LV l) eqn:LIT.
82:    + destruct (literal_l_inv _ LIT) as [bl[ol[bfl[tl LITERAL_EQ]]]]; subst l.
83:      invert_literal_eval; cbn [typeof] in *; subst. eapply imm_safe_rred with (C:=fun x=>x); [|constructor].
84:      constructor.
85:    + eapply lift_immediate with (from:=LV) (C:=fun x=>Eaddrof x ty); eauto.
86:      constructor; constructor.
87:  - destruct (literal RV r1) eqn:LIT.
88:    + destruct (literal_r_inv _ LIT) as [vr[tr LITERAL_EQ]]; subst r1.
89:      invert_literal_eval; cbn [typeof] in *; subst. eapply imm_safe_rred with (C:=fun x=>x); [|constructor].
90:      econstructor; eassumption.
91:    + eapply lift_immediate with (from:=RV) (C:=fun x=>Eunop op x ty); eauto.
92:      constructor; constructor.
93:  - destruct (literal RV r1) eqn:L1.
94:    + destruct (literal_r_inv _ L1) as [vr[tr LITERAL_EQ]]; subst r1. invert_literal_eval; cbn [typeof] in *; subst.
95:      destruct (literal RV r2) eqn:L2.
96:      * destruct (literal_r_inv _ L2) as [vr2[tr2 LITERAL_EQ2]]; subst r2. invert_literal_eval; cbn [typeof] in *; subst.
97:        eapply imm_safe_rred with (C:=fun x=>x); [|constructor]. econstructor; eassumption.
98:      * eapply lift_immediate with (from:=RV) (C:=fun x=>Ebinop op _ x ty); eauto.
99:        constructor; constructor.
100:    + eapply lift_immediate with (from:=RV) (C:=fun x=>Ebinop op x r2 ty); eauto.
101:      constructor; constructor.
102:  - destruct (literal RV r1) eqn:LIT.
103:    + destruct (literal_r_inv _ LIT) as [vr[tr LITERAL_EQ]]; subst r1. invert_literal_eval; cbn [typeof] in *; subst.
104:      eapply imm_safe_rred with (C:=fun x=>x); [|constructor]. econstructor; eassumption.
105:    + eapply lift_immediate with (from:=RV) (C:=fun x=>Ecast x ty); eauto.
106:      constructor; constructor.
107:  - eapply imm_safe_rred with (C:=fun x=>x); [|constructor]. constructor.
108:  - eapply imm_safe_rred with (C:=fun x=>x); [|constructor]. constructor.
109:  - constructor.
110:  - eapply imm_safe_lred with (C:=fun x=>x); [|constructor]. econstructor; eassumption.
111:  - eapply imm_safe_lred with (C:=fun x=>x); [|constructor]. eapply red_var_global; eauto.
112:  - destruct (literal RV r) eqn:LIT.
113:    + destruct (literal_r_inv _ LIT) as [vr[tr LITERAL_EQ]]; subst r. invert_literal_eval; cbn [typeof] in *; subst.
114:      eapply imm_safe_lred with (C:=fun x=>x); [|constructor]. constructor.
115:    + eapply lift_immediate with (from:=RV) (C:=fun x=>Ederef x ty); eauto.
116:      constructor; constructor.
117:  - destruct (literal RV r) eqn:LIT.
118:    + destruct (literal_r_inv _ LIT) as [vr[tr LITERAL_EQ]]; subst r. invert_literal_eval; cbn [typeof] in *; subst.
119:      eapply imm_safe_lred with (C:=fun x=>x); [|constructor]. eapply red_field_struct; eauto.
120:    + eapply lift_immediate with (from:=RV) (C:=fun x=>Efield x f ty); eauto.
121:      constructor; constructor.
122:  - destruct (literal RV r) eqn:LIT.
123:    + destruct (literal_r_inv _ LIT) as [vr[tr LITERAL_EQ]]; subst r. invert_literal_eval; cbn [typeof] in *; subst.
124:      eapply imm_safe_lred with (C:=fun x=>x); [|constructor]. eapply red_field_union; eauto.
125:    + eapply lift_immediate with (from:=RV) (C:=fun x=>Efield x f ty); eauto.
126:      constructor; constructor.
127: Qed.
