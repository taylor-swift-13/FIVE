166: Lemma flat_split : forall a,flat_expr a=true ->
167:  simple a=true \/ exists l r ty,a=Eassign l r ty /\ simple l=true /\ simple r=true.
168: Proof.
169:  destruct a; simpl; intros H; try discriminate; try(left;assumption).
170:  right; exists a1,a2,ty; apply andb_true_iff in H; tauto.
171: Qed.
172: 
173: Lemma flat_immediate : forall ge e m a v m',
174:  flat_expr a=true -> flat_eval ge e m a=Some(v,m') -> imm_safe ge e RV a m.
175: Proof.
176:  intros ge e m a v m' FL E.
177:  destruct (flat_split _ FL) as [S|[l[r[ty[EQ[SL SR]]]]]].
178:  - rewrite (flat_eval_simple ge e m a S) in E.
179:    eapply simple_immediate; eauto. destruct(pure_rval ge e m a); congruence.
180:  - subst a. unfold flat_eval in E. option_cases E; inversion E; subst.

FILE paparazzi/relations/guidance_mode/support/allorder/PureSyntax.v SHA256 7fdc277e6a599060ef73566b0de1eab17f6a23567d5c9cee3def648dfa022492
1: From Coq Require Import Bool List ZArith.
2: From compcert Require Import Coqlib Maps Integers Floats AST Values Memory Events Globalenvs Determinism Ctypes Cop Csyntax Csem Cexec Smallstep.
3: From FiveGuidanceSemantics Require Import SemanticsSupport.
4: Import ListNotations.
5: 
6: (** These predicates constrain syntax only.  Values, argument lists, memories,
7:     allocation, initialization, alignment and permissions remain arbitrary. *)
8: Definition nv (ty: type) := negb (type_is_volatile ty).
9: Fixpoint core_expr (a: expr): bool :=
10:   match a with
11:   | Eval _ ty | Evar _ ty | Eloc _ _ _ ty => nv ty
12:   | Efield a _ ty | Evalof a ty | Ederef a ty | Eaddrof a ty
13:   | Eunop _ a ty | Ecast a ty | Eparen a _ ty => nv ty && core_expr a
14:   | Ebinop _ a b ty | Eassign a b ty => nv ty && core_expr a && core_expr b
15:   | _ => false
16:   end.
17: Fixpoint core_stmt (s: statement): bool :=
18:   match s with
19:   | Sskip | Sreturn None => true
20:   | Sdo a | Sreturn (Some a) => core_expr a
21:   | Ssequence a b => core_stmt a && core_stmt b
22:   | Sifthenelse a b c => core_expr a && core_stmt b && core_stmt c
23:   | _ => false
24:   end.
25: Fixpoint core_cont (k: cont): bool :=
26:   match k with
27:   | Kstop => true
28:   | Kseq s k => core_stmt s && core_cont k
29:   | _ => false
30:   end.
31: Definition core_expr_cont (k: cont): bool :=
32:   match k with Kdo k | Kreturn k => core_cont k
33:  | Kifthenelse a b k => core_stmt a && core_stmt b && core_cont k
34:  | _ => false end.
35: 
36: Ltac core_unpack := repeat match goal with H: _ && _ = true |- _ =>
37:   apply andb_true_iff in H; let A := fresh "CORE" in let B := fresh "CORE" in destruct H as [A B] end.
38: Ltac core_build := repeat match goal with |- _ && _ = true => apply andb_true_iff; split end.
39: 
40: Lemma core_expr_no_builtin:
41:   forall a, core_expr a = true -> no_builtin a = true.
42: Proof.
43:   induction a; simpl; intros H; core_unpack; try discriminate; core_build; eauto.
44: Qed.
45: 
46: Lemma core_context_hole:
47:   forall from to C, context from to C -> forall a,
48:   core_expr (C a) = true -> core_expr a = true.
49: Proof.
50:   induction 1; simpl; intros a HA; core_unpack; try discriminate; eauto.
51: Qed.
52: 
53: Lemma core_context_replace:
54:   forall from to C, context from to C -> forall a b,
55:   core_expr (C a) = true -> core_expr b = true -> core_expr (C b) = true.
56: Proof.
57:   induction 1; simpl; intros a b HA HB; core_unpack; try discriminate;
58:     core_build; eauto.
59: Qed.
60: 
61: Lemma core_lred:
62:   forall ge e a m a' m', core_expr a = true -> lred ge e a m a' m' -> core_expr a' = true.
63: Proof.
64:   intros ge e a m a' m' HA HR; inversion HR; subst; simpl in *; core_unpack; auto.
65: Qed.
66: 
67: Lemma deref_loc_silent:
68:   forall ge ty m b ofs bf t v, nv ty = true -> deref_loc ge ty m b ofs bf t v -> t = E0.
69: Proof.
70:   intros ge ty m b ofs bf t v NV HR; unfold nv in NV; apply negb_true_iff in NV.
