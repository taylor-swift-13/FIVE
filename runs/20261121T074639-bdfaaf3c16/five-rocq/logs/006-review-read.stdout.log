1: From Stdlib Require Import Bool List ZArith Lia.
2: From compcert Require Import Coqlib Errors Maps Integers Floats AST Values Memory Events Globalenvs Ctypes Cop Csyntax Csem Cexec Cstrategy Smallstep.
3: From FiveGuidanceSemantics Require Import SemanticsSupport.
4: From FiveGuidanceAllOrder Require Import PureSyntax.
5: From FiveGuidanceAllOrder Require Import PureDenotation.
6: Import ListNotations.
7: 
8: Ltac option_cases E :=
9:  repeat match type of E with
10:  | context [match ?x with _ => _ end] =>
11:    let EQ := fresh "EQ" in destruct x eqn:EQ; try discriminate
12:  end.
13: 
14: Lemma pure_eval_big : forall a ge e m,
15:  simple a=true ->
16:  (forall v, pure_rval ge e m a=Some v -> eval_simple_rvalue ge e m a v) /\
17:  (forall b ofs bf, pure_lval ge e m a=Some(b,ofs,bf) -> eval_simple_lvalue ge e m a b ofs bf).
18: Proof.
19:  induction a; intros ge e m SIMPLE; simpl in SIMPLE; core_unpack; try discriminate;
20:  repeat match goal with
21:  | IH: forall ge e m, simple ?a=true -> _ /\ _ |- _ =>
22:    let R:=fresh "RV" in let L:=fresh "LV" in
23:    pose proof (IH ge e m ltac:(assumption)) as [R L]; clear IH
24:  end;
25:  split; intros; cbn [pure_rval pure_lval] in H; try discriminate.
26:  - inversion H; subst; constructor.
27:  - option_cases H; inversion H; subst; eauto using esl_var_local, esl_var_global.
28:  - option_cases H; inversion H; subst; eauto using esl_field_struct, esl_field_union.
29:  - option_cases H; inversion H; subst.
30:    match goal with D: do_deref_loc _ _ _ _ _ _ _ = Some _ |- _ =>
31:     destruct (do_deref_loc_sound _ _ _ _ _ _ _ _ _ _ D) as [DR PT]
32:    end.
33:    assert (SIL: t = E0) by (eapply deref_loc_silent; eauto; unfold nv; congruence).
34:    subst t. econstructor; eauto; try (symmetry; assumption).
35:    apply negb_true_iff; assumption.
36:  - option_cases H; inversion H; subst; eauto using esl_deref.
37:  - option_cases H; inversion H; subst; eauto using esr_addrof.
38:  - option_cases H; eauto using esr_unop.
39:  - option_cases H; eauto using esr_binop.
40:  - option_cases H; eauto using esr_cast.
41:  - inversion H; subst; constructor.
42:  - inversion H; subst; constructor.
43:  - inversion H; subst; constructor.
44: Qed.
