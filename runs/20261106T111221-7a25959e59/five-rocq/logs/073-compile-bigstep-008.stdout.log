1 goal
  
  ge : genv
  e : env
  a, b : statement
  m, mf : mem
  H : exec_stmt ge e m (Ssequence a b) E0 mf Out_normal
  t1 : trace
  m1 : mem
  t2 : trace
  H5 : exec_stmt ge e m a t1 m1 Out_normal
  H8 : exec_stmt ge e m1 b t2 mf Out_normal
  H4 : t1 ** t2 = E0
  ============================
  exists ma : mem,
    exec_stmt ge e m a (t1 ** t2) ma Out_normal /\
    exec_stmt ge e ma b (t1 ** t2) mf Out_normal
