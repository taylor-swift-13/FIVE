
FILE paparazzi/models/stateGetSpeedEcef_f/rocq/support/Original.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib AST Integers Floats Values Memory Memdata Events Globalenvs Maps Ctypes Cop Csyntax Csyntaxdefs Csem Cexec Smallstep.
From FiveShared.verification Require Import Obligations.
From FiveGuidanceAllOrder Require Import PureSyntax PureDenotation AtomicDenotation CallfreeExecution PhaseComposition PureIfShell FactorShell.
From StateSpeedSetterSupport Require Import MemoryFacts Certificates.
From StateSpeedGetterSupport Require Import Setup Layout Body Calculation StoreEffects ZeroCallShell Certificates.
Require StateSpeedGetterSupport.GetterSource.
Import ListNotations.
Open Scope Z_scope.
Module SC:=StateSpeedSetterSupport.Certificates.
Module GC:=StateSpeedGetterSupport.Certificates.
Module GS:=StateSpeedGetterSupport.GetterSource.
Module SE:=StateSpeedGetterSupport.StoreEffects.
Local Opaque ge E.ge.
Lemma returned_pointer_value:forall m sb,
 Genv.find_symbol ge S._state=Some sb->
 pure_rval ge empty_env m(Eaddrof(Efield state_address S._ecef_speed_f(Tstruct S._EcefCoor_f noattr))(tptr(Tstruct S._EcefCoor_f noattr)))=Some(Vptr sb(Ptrofs.repr 328)).
Proof.
 intros m sb SYM.
 change((match pure_lval ge empty_env m(Efield state_address S._ecef_speed_f(Tstruct S._EcefCoor_f noattr))with Some(b,ofs,Full)=>Some(Vptr b ofs)|_=>None end)=Some(Vptr sb(Ptrofs.repr 328))).
 rewrite(state_field_address empty_env m sb S._ecef_speed_f(Tstruct S._EcefCoor_f noattr)328 eq_refl SYM float_layout);reflexivity.
Qed.
Lemma return_state_defined:forall m sb,
 Genv.find_symbol ge S._state=Some sb->
 normal_state(State S.f_stateGetSpeedEcef_f getter_return Kstop empty_env m)=true /\call_names(State S.f_stateGetSpeedEcef_f getter_return Kstop empty_env m) /\state_eval ge(State S.f_stateGetSpeedEcef_f getter_return Kstop empty_env m)=Some(Vptr sb(Ptrofs.repr 328),m).
Proof.
 intros m sb SYM;split;[reflexivity|];split;[exact I|].
 eapply GC.return_evaluates;[apply returned_pointer_value;exact SYM|reflexivity|reflexivity].
Qed.
Theorem original_certificate:forall m m1 m2 m3 mf sb x y z,
 Genv.find_symbol ge S._state=Some sb->Mem.load Mint16unsigned m sb 280=Some(Vint Int.one)->
 Mem.load Mint32 m sb 296=Some(Vint x)->Mem.load Mint32 m sb 300=Some(Vint y)->Mem.load Mint32 m sb 304=Some(Vint z)->
 Mem.store Mfloat32 m sb 328(Vsingle(decode x))=Some m1->Mem.store Mfloat32 m1 sb 332(Vsingle(decode y))=Some m2->
 Mem.store Mfloat32 m2 sb 336(Vsingle(decode z))=Some m3->Mem.store Mint16unsigned m3 sb 280(Vint(Int.repr 33))=Some mf->
 exists P,certificate ge P(Returnstate(Vptr sb(Ptrofs.repr 328))Kstop mf) /\P(E.entry[]m).
Proof.
 intros m m1 m2 m3 mf sb x y z SYM STATUS X Y ZS STX STY STZ STS.
 destruct GS.calc_lookup as[bf[FS FF]].
 change(Genv.find_symbol ge S._stateCalcSpeedEcef_f=Some bf)in FS.
 change(Genv.find_funct ge(Vptr bf Ptrofs.zero)=Some(Internal S.f_stateCalcSpeedEcef_f))in FF.
 set(k:=Kseq getter_return Kstop).
 set(base:=Kcall S.f_stateGetSpeedEcef_f empty_env(fun q=>q)tvoid(Kdo k)).
 destruct(original_calculation_certificate m m1 m2 m3 mf sb x y z base I SYM STATUS X Y ZS STX STY STZ STS)as[CP[CC CI]].
 set(CALLINV:=ZeroCallShell.invariant empty_env S.f_stateGetSpeedEcef_f k S._stateCalcSpeedEcef_f bf m Vundef mf CP).
 assert(CALLCERT:certificate ge CALLINV(State S.f_stateGetSpeedEcef_f Sskip k empty_env mf)).
 { apply ZeroCallShell.call_certificate with(callee:=Internal S.f_stateCalcSpeedEcef_f);[reflexivity|exact FS|exact FF|reflexivity|exact CC|exact CI]. }
 assert(CALLI:CALLINV(State S.f_stateGetSpeedEcef_f getter_call k empty_env m)).
 { left;rewrite getter_call_shape;reflexivity. }
 set(TAILINV:=fun s=>normal_state s=true /\call_names s /\state_eval ge s=Some(Vptr sb(Ptrofs.repr 328),mf)).
 pose proof(SC.evaluator_certificate ge(Vptr sb(Ptrofs.repr 328))mf)as TAILCERT.
 assert(TAILI:TAILINV(State S.f_stateGetSpeedEcef_f getter_return Kstop empty_env mf)).
 { exact(return_state_defined mf sb SYM). }
 pose proof(chain_certificate ge CALLINV TAILINV _ _ _ CALLCERT TAILCERT(SC.skip_seq_unique ge S.f_stateGetSpeedEcef_f getter_return Kstop empty_env mf)TAILI)as CTC.
 set(IFINV:=PureIfShell.invariant ge S.f_stateGetSpeedEcef_f empty_env k m getter_condition getter_call Sskip(Vint Int.one)true).
 assert(IFCERT:certificate ge IFINV(State S.f_stateGetSpeedEcef_f getter_call k empty_env m)).
 { apply PureIfShell.if_certificate;[reflexivity|apply getter_condition_value with(sb:=sb);[reflexivity|exact SYM|exact STATUS]|reflexivity]. }
 pose proof(GC.join_certificate ge IFINV(fun s=>CALLINV s \/TAILINV s)_ _ IFCERT CTC(or_introl CALLI))as ICC.
 assert(IFI:IFINV(State S.f_stateGetSpeedEcef_f getter_first k empty_env m))by(left;reflexivity).
 set(BODYINV:=fun s=>s=State S.f_stateGetSpeedEcef_f(fn_body S.f_stateGetSpeedEcef_f)Kstop empty_env m \/IFINV s \/CALLINV s \/TAILINV s).
 assert(BC:certificate ge BODYINV(Returnstate(Vptr sb(Ptrofs.repr 328))Kstop mf)).
 { unfold BODYINV;eapply SC.prepend_certificate;[exact ICC|left;exact IFI|].
   change(unique_transition ge(State S.f_stateGetSpeedEcef_f(Ssequence getter_first getter_return)Kstop empty_env m)(State S.f_stateGetSpeedEcef_f getter_first(Kseq getter_return Kstop)empty_env m));apply SC.sequence_unique. }
 exists(fun s=>s=E.entry[]m \/BODYINV s);split.
 - eapply SC.prepend_certificate;[exact BC|left;reflexivity|apply GC.empty_function_unique;reflexivity].
 - left;reflexivity.
Qed.
Print Assumptions original_certificate.
Lemma source_path_silent:forall args m t reached,
 star Csem.step ge(E.entry args m)t reached->t=E0.
Proof.
 intros args m t reached PATH;pose proof(GS.entry_source args m)as INIT.
 revert INIT;induction PATH;intros INV;[reflexivity|].
 destruct(GS.source_step_invariant _ _ _ INV H)as[TT NEXT].
 rewrite H0,TT,(IHPATH NEXT);reflexivity.
Qed.
Lemma four_stores_result:forall m m1 m2 m3 mf sb x y z,
 Mem.store Mfloat32 m sb 328(Vsingle(decode x))=Some m1->Mem.store Mfloat32 m1 sb 332(Vsingle(decode y))=Some m2->
 Mem.store Mfloat32 m2 sb 336(Vsingle(decode z))=Some m3->Mem.store Mint16unsigned m3 sb 280(Vint(Int.repr 33))=Some mf->
 GetterResult m mf sb x y z.
Proof.
 intros m m1 m2 m3 mf sb x y z X Y ZS ST.
 assert(WORDS:Mem.load Mfloat32 mf sb 328=Some(Vsingle(decode x)) /\Mem.load Mfloat32 mf sb 332=Some(Vsingle(decode y)) /\Mem.load Mfloat32 mf sb 336=Some(Vsingle(decode z)) /\Mem.load Mint16unsigned mf sb 280=Some(Val.load_result Mint16unsigned(Vint(Int.repr 33)))).
 { eapply SE.four_store_words;eauto;lia. }
 destruct WORDS as[RX[RY[RZ RS]]];constructor;try assumption.
 - change(Mem.loadbytes mf sb 328 12=Some(SE.vector_bytes(decode x)(decode y)(decode z)));eapply SE.four_store_bytes;eauto;lia.
 - intros;eapply SE.four_store_permissions;eauto.
 - intros b ofs n N MISS;eapply SE.four_store_frame;eauto;lia.
Qed.
Theorem original_normal_result:forall m sb x y z,
 InputGood m sb x y z->exists mf,NormalCall m mf sb /\GetterResult m mf sb x y z /\ (forall t v mf2,star Csem.step ge(E.entry[]m)t(Returnstate v Kstop mf2)->v=Vptr sb(Ptrofs.repr 328) /\mf2=mf).
Proof.
 intros m sb x y z[SYM[WR[STATUS[X[Y ZS]]]]].
 destruct(SE.four_stores_exist 328(Int.repr 33)m sb(decode x)(decode y)(decode z)ltac:(lia)ltac:(lia)ltac:(exists 82;reflexivity)WR)as[mf[m1[m2[m3[STX[STY[STZ STS]]]]]]].
 destruct(original_certificate m m1 m2 m3 mf sb x y z SYM STATUS X Y ZS STX STY STZ STS)as[P[CERT PI]].
 destruct(SC.certificate_has_return ge P _ _ CERT PI(GS.all_successor_termination[]m))as[t PATH].
 pose proof(source_path_silent[]m t _ PATH)as TT;subst t.
 exists mf;split;[exact PATH|];split;[eapply four_stores_result;eauto|].
 intros t v mf2 PATH2;eapply certificate_normal_unique;eauto.
Qed.
Theorem original_no_error:forall m sb x y z,
 InputGood m sb x y z->no_error ge(E.entry[]m).
Proof.
 intros m sb x y z[SYM[WR[STATUS[X[Y ZS]]]]].
 destruct(SE.four_stores_exist 328(Int.repr 33)m sb(decode x)(decode y)(decode z)ltac:(lia)ltac:(lia)ltac:(exists 82;reflexivity)WR)as[mf[m1[m2[m3[STX[STY[STZ STS]]]]]]].
 destruct(original_certificate m m1 m2 m3 mf sb x y z SYM STATUS X Y ZS STX STY STZ STS)as[P[CERT PI]].
 assert(STOP:nostep Csem.step ge(Returnstate(Vptr sb(Ptrofs.repr 328))Kstop mf)).
 { intros tr next[ES|SS];inversion ES||inversion SS. }
 intros t reached PATH[NR NS].
 destruct(certificate_no_error ge P _ _ CERT PI STOP t reached PATH)as[EQ|[tr[next STEP]]].
 - subst reached;apply NR;exists(Vptr sb(Ptrofs.repr 328)),mf;reflexivity.
 - exact(NS tr next STEP).
Qed.
Print Assumptions original_normal_result.
Print Assumptions original_no_error.


FILE paparazzi/models/stateGetSpeedEcef_f/rocq/support/Layout.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Errors Maps AST Integers Floats Values Memory Events Globalenvs Ctypes Cop Csyntax Csyntaxdefs Csem Cexec.
From FiveGuidanceAllOrder Require Import PureDenotation AtomicDenotation.
From StateSpeedSetterSupport Require Import MemoryFacts.
From StateSpeedGetterSupport Require Import Setup.
Import ListNotations.
Open Scope Z_scope.
Definition layout:=field_layout(genv_cenv ge).
Lemma status_layout:layout S._State S._speed_status=Some(280,Full).
Proof. unfold layout,ge,E.ge,Csem.globalenv;cbv beta iota zeta delta[genv_cenv];reflexivity. Qed.
Lemma ned_layout:layout S._State S._ned_speed_i=Some(296,Full).
Proof. unfold layout,ge,E.ge,Csem.globalenv;cbv beta iota zeta delta[genv_cenv];reflexivity. Qed.
Lemma float_layout:layout S._State S._ecef_speed_f=Some(328,Full).
Proof. unfold layout,ge,E.ge,Csem.globalenv;cbv beta iota zeta delta[genv_cenv];reflexivity. Qed.
Lemma ned_axes:layout S._NedCoor_i S._x=Some(0,Full) /\layout S._NedCoor_i S._y=Some(4,Full) /\layout S._NedCoor_i S._z=Some(8,Full).
Proof. unfold layout,ge,E.ge,Csem.globalenv;cbv beta iota zeta delta[genv_cenv];repeat split;reflexivity. Qed.
Lemma float_axes:layout S._EcefCoor_f S._x=Some(0,Full) /\layout S._EcefCoor_f S._y=Some(4,Full) /\layout S._EcefCoor_f S._z=Some(8,Full).
Proof. unfold layout,ge,E.ge,Csem.globalenv;cbv beta iota zeta delta[genv_cenv];repeat split;reflexivity. Qed.
Local Opaque ge E.ge.
Lemma field_address:forall e m base sid attrs axis ty b start delta,
 typeof base=Tstruct sid attrs->pure_rval ge e m base=Some(Vptr b(Ptrofs.repr start))->
 layout sid axis=Some(delta,Full)->pure_lval ge e m(Efield base axis ty)=Some(b,Ptrofs.repr(start+delta),Full).
Proof. intros;eapply struct_field_layout;eauto. Qed.
Lemma global_state_address:forall e m sb,
 e!S._state=None->Genv.find_symbol ge S._state=Some sb->pure_rval ge e m state_address=Some(Vptr sb Ptrofs.zero).
Proof. intros;apply global_struct_address;assumption. Qed.
Lemma state_field_address:forall e m sb axis ty delta,
 e!S._state=None->Genv.find_symbol ge S._state=Some sb->layout S._State axis=Some(delta,Full)->
 pure_lval ge e m(Efield state_address axis ty)=Some(sb,Ptrofs.repr delta,Full).
Proof.
 intros e m sb axis ty delta NONE SYM LAYOUT;replace delta with(0+delta)at 2 by lia.
 eapply field_address with(start:=0)(delta:=delta);[reflexivity|apply global_state_address;assumption|exact LAYOUT].
Qed.
Lemma vector_base_address:forall e m sb sid field start,
 e!S._state=None->Genv.find_symbol ge S._state=Some sb->layout S._State field=Some(start,Full)->
 pure_rval ge e m(vector_address sid field)=Some(Vptr sb(Ptrofs.repr start)).
Proof. intros;eapply struct_copy_value;[reflexivity|apply state_field_address;assumption]. Qed.
Lemma ned_word_value:forall e m sb axis delta i,
 e!S._state=None->Genv.find_symbol ge S._state=Some sb->layout S._NedCoor_i axis=Some(delta,Full)->0<=delta<=8->
 Mem.load Mint32 m sb(296+delta)=Some(Vint i)->pure_rval ge e m(ned_word axis)=Some(Vint i).
Proof.
 intros e m sb axis delta i NONE SYM AX RANGE LOAD;unfold ned_word.
 eapply pure_scalar;[reflexivity|reflexivity|reflexivity| | | |exact LOAD].
 - eapply field_address;[reflexivity|apply vector_base_address;[exact NONE|exact SYM|exact ned_layout]|exact AX].
 - change(0<=296+delta<=18446744073709551615);lia.
 - change(296+delta+4<=18446744073709551616);lia.
Qed.
Lemma float_axis_address:forall e m sb axis delta,
 e!S._state=None->Genv.find_symbol ge S._state=Some sb->layout S._EcefCoor_f axis=Some(delta,Full)->
 pure_lval ge e m(float_lvalue axis)=Some(sb,Ptrofs.repr(328+delta),Full).
Proof.
 intros e m sb axis delta NONE SYM AX;unfold float_lvalue.
 eapply field_address;[reflexivity|apply vector_base_address;[exact NONE|exact SYM|exact float_layout]|exact AX].
Qed.
Lemma status_value:forall e m sb i,
 e!S._state=None->Genv.find_symbol ge S._state=Some sb->Mem.load Mint16unsigned m sb 280=Some(Vint i)->
 pure_rval ge e m status_read=Some(Vint i).
Proof.
 intros e m sb i NONE SYM LOAD;unfold status_read.
 eapply pure_scalar;[reflexivity|reflexivity|reflexivity| | | |exact LOAD].
 - apply state_field_address;[exact NONE|exact SYM|exact status_layout].
 - change(0<=280<=18446744073709551615);lia.
 - change(280+2<=18446744073709551616);lia.
Qed.
Lemma status_one_tests:forall e m sb,
 e!S._state=None->Genv.find_symbol ge S._state=Some sb->Mem.load Mint16unsigned m sb 280=Some(Vint Int.one)->
 pure_rval ge e m(status_test 5)=Some(Vint Int.zero) /\pure_rval ge e m(status_test 0)=Some(Vint Int.one).
Proof.
 intros e m sb NONE SYM LOAD;pose proof(status_value e m sb Int.one NONE SYM LOAD)as WORD.
 unfold status_test;split;eapply pure_binary;[eapply pure_binary;[exact WORD|reflexivity|reflexivity]|reflexivity|reflexivity|eapply pure_binary;[exact WORD|reflexivity|reflexivity]|reflexivity|reflexivity].
Qed.
Lemma getter_condition_value:forall e m sb,
 e!S._state=None->Genv.find_symbol ge S._state=Some sb->Mem.load Mint16unsigned m sb 280=Some(Vint Int.one)->
 pure_rval ge e m getter_condition=Some(Vint Int.one).
Proof.
 intros e m sb NONE SYM LOAD;pose proof(proj1(status_one_tests e m sb NONE SYM LOAD))as TEST.
 change((match pure_rval ge e m(status_test 5)with Some v=>sem_unary_operation Onotbool v tint m|None=>None end)=Some(Vint Int.one));rewrite TEST;reflexivity.
Qed.
Lemma denominator_value:forall e m,pure_rval ge e m denominator=Some(Vint(Int.repr 524288)).
Proof. reflexivity. Qed.
Lemma conversion_value:forall e m sb axis delta i,
 e!S._state=None->Genv.find_symbol ge S._state=Some sb->layout S._NedCoor_i axis=Some(delta,Full)->0<=delta<=8->
 Mem.load Mint32 m sb(296+delta)=Some(Vint i)->pure_rval ge e m(conversion axis)=Some(Vsingle(decode i)).
Proof.
 intros e m sb axis delta i NONE SYM AX RANGE LOAD.
 pose proof(ned_word_value e m sb axis delta i NONE SYM AX RANGE LOAD)as WORD.
 unfold conversion;eapply pure_binary with(va:=Vsingle(Float32.of_int i))(vb:=Vint(Int.repr 524288));[|apply denominator_value|reflexivity].
 change((match pure_rval ge e m(ned_word axis)with Some v=>sem_cast v tint tfloat m|None=>None end)=Some(Vsingle(Float32.of_int i))).
 rewrite WORD;reflexivity.
Qed.
Print Assumptions conversion_value.
Print Assumptions status_one_tests.


FILE paparazzi/relations/guidance_mode/support/allorder/CallfreeExecution.v
From Stdlib Require Import Bool List ZArith.
From compcert Require Import Coqlib Errors Maps Integers Floats AST Values Memory Events Globalenvs Determinism Ctypes Cop Csyntax Csem Cexec Cstrategy Smallstep.
From FiveGuidanceAllOrder Require Import PureSyntax PureDenotation PureProgress AtomicDenotation AtomicProgress.
Import ListNotations.
Inductive normal_outcome := Nnormal | Nreturn (v:val).

Fixpoint stmt_eval (ge:genv) (e:env) (ret:type) (s:statement) (m:mem): option (normal_outcome * mem) :=
  match s with
  | Sskip => Some (Nnormal,m)
  | Sdo a => match atomic_eval ge e m a with Some (_,m') => Some (Nnormal,m') | None => None end
  | Ssequence s1 s2 =>
      match stmt_eval ge e ret s1 m with
      | Some (Nnormal,m') => stmt_eval ge e ret s2 m'
      | Some (Nreturn v,m') => Some (Nreturn v,m')
      | None => None end
  | Sifthenelse a s1 s2 =>
      match pure_rval ge e m a with
      | Some v => match bool_val v (typeof a) m with
        | Some b => stmt_eval ge e ret (if b then s1 else s2) m
        | None => None end
      | None => None end
  | Sreturn None => Some (Nreturn Vundef,m)
  | Sreturn (Some a) =>
      match pure_rval ge e m a with
      | Some v => match sem_cast v (typeof a) ret m with
          | Some v' => Some (Nreturn v',m) | None => None end
      | None => None end
  | _ => None
  end.

Fixpoint cont_eval (ge:genv) (e:env) (ret:type) (k:cont) (out:normal_outcome) (m:mem): option (val*mem) :=
  match out with
  | Nreturn v => match Mem.free_list m (blocks_of_env ge e) with Some m' => Some (v,m') | None => None end
  | Nnormal =>
      match k with
      | Kstop => match Mem.free_list m (blocks_of_env ge e) with Some m' => Some (Vundef,m') | None => None end
      | Kseq s k =>
          match stmt_eval ge e ret s m with
          | Some (out,m') => cont_eval ge e ret k out m' | None => None end
      | _ => None end
  end.

Lemma cont_eval_return:
  forall ge e ret k v m,
  cont_eval ge e ret k (Nreturn v) m =
  match Mem.free_list m (blocks_of_env ge e) with Some m' => Some (v,m') | None => None end.
Proof. destruct k; reflexivity. Qed.

Definition state_eval (ge:genv) (S:Csem.state): option (val*mem) :=
  match S with
  | State f s k e m =>
      match stmt_eval ge e (fn_return f) s m with
      | Some (out,m') => cont_eval ge e (fn_return f) k out m' | None => None end
  | ExprState f a k e m =>
      match k with
      | Kdo k => match atomic_eval ge e m a with
          | Some (_,m') => cont_eval ge e (fn_return f) k Nnormal m' | None => None end
      | Kifthenelse s1 s2 k =>
          match pure_rval ge e m a with
          | Some v => match bool_val v (typeof a) m with
            | Some b => match stmt_eval ge e (fn_return f) (if b then s1 else s2) m with
              | Some (out,m') => cont_eval ge e (fn_return f) k out m'
              | None => None end
            | None => None end
          | None => None end
      | Kreturn k =>
          match pure_rval ge e m a with
          | Some v => match sem_cast v (typeof a) (fn_return f) m with
              | Some v' => cont_eval ge e (fn_return f) k (Nreturn v') m | None => None end
          | None => None end
      | _ => None end
  | Callstate (Internal f) args k m =>
      match Cexec.do_alloc_variables ge empty_env m (fn_params f ++ fn_vars f) with
      | (e,m') => match Cexec.sem_bind_parameters ge quiet_world e m' (fn_params f) args with
          | Some m'' => match stmt_eval ge e (fn_return f) (fn_body f) m'' with
              | Some (out,m''') => cont_eval ge e (fn_return f) k out m''' | None => None end
          | None => None end end
  | Returnstate v Kstop m => Some (v,m)
  | _ => None
  end.

Fixpoint normal_stmt (s:statement): bool :=
  match s with
  | Sskip | Sreturn None => true
  | Sdo a => atomic_expr a
  | Sreturn (Some a) => simple a
  | Ssequence s1 s2 => normal_stmt s1 && normal_stmt s2
  | Sifthenelse a s1 s2 => simple a && normal_stmt s1 && normal_stmt s2
  | _ => false end.
Fixpoint normal_cont (k:cont): bool :=
  match k with Kstop => true | Kseq s k => normal_stmt s && normal_cont k | _ => false end.
Definition normal_state (S:Csem.state): bool :=
  match S with
  | State _ s k _ _ => normal_stmt s && normal_cont k
  | ExprState _ a (Kdo k) _ _ => atomic_expr a && normal_cont k
  | ExprState _ a (Kreturn k) _ _ => simple a && normal_cont k
  | ExprState _ a (Kifthenelse s1 s2 k) _ _ => simple a && normal_stmt s1 && normal_stmt s2 && normal_cont k
  | ExprState _ _ _ _ _ => false
  | Callstate (Internal f) _ Kstop _ => normal_stmt (fn_body f)
  | Returnstate _ Kstop _ | Stuckstate => true
  | _ => false end.

Lemma normal_cont_call:
  forall k, normal_cont k = true -> call_cont k = Kstop.
Proof. induction k; simpl; intros H; core_unpack; try discriminate; auto. Qed.
Lemma normal_cont_is_call:
  forall k, normal_cont k = true -> is_call_cont k -> k = Kstop.
Proof. destruct k; simpl; intros; try discriminate; tauto. Qed.


Lemma normal_estep_forward: forall ge f a k e m t next result,
 normal_state(ExprState f a k e m)=true ->
 state_eval ge(ExprState f a k e m)=Some result ->
 Csem.estep ge(ExprState f a k e m)t next ->
 normal_state next=true /\ state_eval ge next=Some result.
Proof.
 intros ge f a k e m t next result NORMAL EV STEP.
 destruct k;simpl in NORMAL;try discriminate;core_unpack.
 - cbn[state_eval] in EV.
   destruct(atomic_eval ge e m a) as [[v mf]|]eqn:AE;try discriminate.
   destruct(atomic_defined_estep ge f a (Kdo k) e m t next v mf ltac:(assumption) AE STEP)
    as [a'[m'[EQ[TT[SI DEN]]]]];subst next.
   split;[simpl;core_build;auto|cbn[state_eval];rewrite DEN;exact EV].
 - assert(NS:Csem.not_stuck ge e a m).
   { cbn[state_eval] in EV;destruct(pure_rval ge e m a)eqn:PV;try discriminate;eapply pure_not_stuck;eauto. }
   match goal with SI:simple a=true |- _=>
   destruct(simple_estep ge f a (Kifthenelse s s0 k)e m t next SI STEP)
    as [BAD|[a'[EQ[TY[SA DEN]]]]] end.
   + subst next;inversion STEP;subst.
     exfalso;match goal with N:~imm_safe _ _ _ _ _,CT:Csem.context _ _ _ |- _=>
      apply N;apply(NS _ _ _ CT eq_refl) end.
   + subst next;split;[simpl;core_build;auto|].
     cbn[state_eval] in *;rewrite DEN,<-TY in EV;exact EV.
 - assert(NS:Csem.not_stuck ge e a m).
   { cbn[state_eval] in EV;destruct(pure_rval ge e m a)eqn:PV;try discriminate;eapply pure_not_stuck;eauto. }
   match goal with SI:simple a=true |- _=>
   destruct(simple_estep ge f a (Kreturn k)e m t next SI STEP)
    as [BAD|[a'[EQ[TY[SA DEN]]]]] end.
   + subst next;inversion STEP;subst.
     exfalso;match goal with N:~imm_safe _ _ _ _ _,CT:Csem.context _ _ _ |- _=>
      apply N;apply(NS _ _ _ CT eq_refl) end.
   + subst next;split;[simpl;core_build;auto|].
     cbn[state_eval] in *;rewrite DEN,<-TY in EV;exact EV.
Qed.
Lemma normal_sstep_preserved:
  forall ge S t S', normal_state S = true -> Csem.sstep ge S t S' -> normal_state S' = true.
Proof.
  intros ge S t S' NORMAL STEP; inversion STEP; subst; simpl in NORMAL;
    repeat match goal with H: _ /\ _ |- _ => destruct H end;
    core_unpack; try discriminate; simpl; core_build; auto.
  - destruct b; simpl; core_build; auto.
  - rewrite (normal_cont_call _ NORMAL); reflexivity.
  - rewrite (normal_cont_call _ NORMAL); reflexivity.
  - assert (HK: k = Kstop) by (eapply normal_cont_is_call; eauto). subst; reflexivity.
  - destruct k;simpl in NORMAL;try discriminate;exact NORMAL.
  - destruct k;simpl in NORMAL;try discriminate;reflexivity.
Qed.

Lemma normal_sstep_denotation:
  forall ge S t S', normal_state S = true -> Csem.sstep ge S t S' ->
  state_eval ge S = state_eval ge S'.
Proof.
  intros ge S t S' NORMAL STEP; inversion STEP; subst; simpl in NORMAL;
    repeat match goal with H: _ /\ _ |- _ => destruct H end;
    core_unpack; try discriminate; simpl; auto.
  - destruct (atomic_eval ge e m x) as [[v mx]|]; reflexivity.
  - destruct (stmt_eval ge e (fn_return f) s1 m) as [[out mx]|]; simpl; auto.
    destruct out; try rewrite cont_eval_return; reflexivity.
  - destruct (pure_rval ge e m a) as [v|]; simpl; auto.
    destruct (bool_val v (typeof a) m); reflexivity.
  - match goal with H:bool_val _ _ _=Some _ |- _ => rewrite H end; reflexivity.
  - rewrite (normal_cont_call _ NORMAL), cont_eval_return. simpl.
    match goal with H: Mem.free_list _ _ = Some _ |- _ => rewrite H end; reflexivity.
  - destruct (pure_rval ge e m x) as [v|]; simpl; auto.
    destruct (sem_cast v (typeof x) (fn_return f) m); reflexivity.
  - rewrite (normal_cont_call _ NORMAL).
    match goal with H: sem_cast _ _ _ _ = Some _ |- _ => rewrite H end.
    rewrite cont_eval_return. simpl. match goal with H: Mem.free_list _ _ = Some _ |- _ => rewrite H end; reflexivity.
  - assert (HK: k = Kstop) by (eapply normal_cont_is_call; eauto). subst; simpl.
    match goal with H: Mem.free_list _ _ = Some _ |- _ => rewrite H end; reflexivity.
  - match goal with A: alloc_variables ge _ _ _ _ _ |- _ =>
      rewrite (do_alloc_variables_complete ge _ _ _ _ _ A) end.
    match goal with B: bind_parameters ge _ _ _ _ _ |- _ =>
      rewrite (sem_bind_parameters_complete ge quiet_world _ _ _ _ _ B) end.
    reflexivity.
Qed.


Lemma normal_estep_backward: forall ge f a k e m t next,
 normal_state(ExprState f a k e m)=true ->
 Csem.estep ge(ExprState f a k e m)t next ->
 normal_state next=true /\
 forall result,state_eval ge next=Some result ->
 state_eval ge(ExprState f a k e m)=Some result.
Proof.
 intros ge f a k e m t next NORMAL STEP.
 destruct k;simpl in NORMAL;try discriminate;core_unpack.
 - match goal with AT:atomic_expr a=true |- _=>
   destruct(atomic_estep ge f a (Kdo k)e m t next AT STEP)
    as [BAD|[a'[m'[EQ[TT[SI DEN]]]]]] end.
   + subst;split;[reflexivity|simpl;discriminate].
   + subst;split;[simpl;core_build;auto|].
     cbn[state_eval];rewrite DEN;auto.
 - match goal with SI:simple a=true |- _=>
   destruct(simple_estep ge f a (Kifthenelse s s0 k)e m t next SI STEP)
    as [BAD|[a'[EQ[TY[SA DEN]]]]] end.
   + subst;split;[reflexivity|simpl;discriminate].
   + subst;split;[simpl;core_build;auto|].
     cbn[state_eval];rewrite DEN,<-TY;auto.
 - match goal with SI:simple a=true |- _=>
   destruct(simple_estep ge f a (Kreturn k)e m t next SI STEP)
    as [BAD|[a'[EQ[TY[SA DEN]]]]] end.
   + subst;split;[reflexivity|simpl;discriminate].
   + subst;split;[simpl;core_build;auto|].
     cbn[state_eval];rewrite DEN,<-TY;auto.
Qed.
Theorem normal_step_backward: forall ge S t next,
 normal_state S=true -> Csem.step ge S t next ->
 normal_state next=true /\
 forall result,state_eval ge next=Some result -> state_eval ge S=Some result.
Proof.
 intros ge S t next NORMAL [ES|SS].
 - destruct S;inversion ES;subst;eapply normal_estep_backward;eauto.
 - split;[eapply normal_sstep_preserved;eauto|].
   rewrite(normal_sstep_denotation _ _ _ _ NORMAL SS);auto.
Qed.
Theorem all_order_normal_correspondence: forall ge S t v mf,
 normal_state S=true ->
 star Csem.step ge S t(Returnstate v Kstop mf) ->
 state_eval ge S=Some(v,mf).
Proof.
 intros ge S t v mf NORMAL PATH.
 remember(Returnstate v Kstop mf)as FINAL.
 revert NORMAL;induction PATH;intros NORMAL;subst.
 - reflexivity.
 - destruct(normal_step_backward _ _ _ _ NORMAL H)as [NN BACK].
   apply BACK;apply IHPATH;auto.
Qed.
Print Assumptions all_order_normal_correspondence.

Definition call_names(s:Csem.state):Prop :=
 match s with
 | Callstate(Internal f)_ _ _=>list_norepet(var_names(fn_params f)++var_names(fn_vars f))
 | _=>True end.
Lemma normal_no_callred: forall ge f a k e m from C sub fd args ty,
 normal_state(ExprState f a k e m)=true ->
 context from RV C -> a=C sub -> callred ge sub m fd args ty -> False.
Proof.
 intros ge f a k e m from C sub fd args ty NORMAL CT EQ CR;subst a.
 destruct k;simpl in NORMAL;try discriminate;core_unpack.
 - pose proof(atomic_context_hole _ _ _ CT sub ltac:(assumption))as BAD.
   inversion CR;subst;discriminate.
 - pose proof(simple_context_hole _ _ _ CT sub ltac:(assumption))as BAD.
   inversion CR;subst;discriminate.
 - pose proof(simple_context_hole _ _ _ CT sub ltac:(assumption))as BAD.
   inversion CR;subst;discriminate.
Qed.
Lemma normal_step_names: forall ge S t next,
 normal_state S=true -> call_names S -> Csem.step ge S t next -> call_names next.
Proof.
 intros ge S t next NORMAL NAMES [ES|SS].
 - inversion ES;subst;simpl;auto.
   exfalso;eapply normal_no_callred;eauto.
 - inversion SS;subst;simpl;auto.
Qed.
Lemma normal_step_forward: forall ge S t next result,
 normal_state S=true -> state_eval ge S=Some result -> Csem.step ge S t next ->
 normal_state next=true /\ state_eval ge next=Some result.
Proof.
 intros ge S t next result NORMAL EV [ES|SS].
 - destruct S;inversion ES;subst;eapply normal_estep_forward;eauto.
 - split;[eapply normal_sstep_preserved;eauto|].
   rewrite <-(normal_sstep_denotation _ _ _ _ NORMAL SS);exact EV.
Qed.
Definition execution_invariant(ge:genv)(s:Csem.state):Prop :=
 normal_state s=true /\ call_names s /\ exists result,state_eval ge s=Some result.
Definition normal_return(s:Csem.state):Prop :=exists v m,s=Returnstate v Kstop m.
Lemma invariant_preserved: forall ge s t next,
 execution_invariant ge s -> Csem.step ge s t next -> execution_invariant ge next.
Proof.
 intros ge s t next [N[CN[r EV]]] STEP.
 destruct(normal_step_forward _ _ _ _ _ N EV STEP)as [NN EN].
 split;[exact NN|]. split;[exact(normal_step_names ge s t next N CN STEP)|exists r;exact EN].
Qed.
Lemma immediate_has_step: forall ge f a k e m,
 literal RV a=false -> imm_safe ge e RV a m ->
 exists t next,Csem.step ge(ExprState f a k e m)t next.
Proof.
 intros ge f a k e m NL IS;inversion IS;subst;try discriminate.
 - eexists;eexists;left;eapply step_lred;eauto.
 - eexists;eexists;left;eapply step_rred;eauto.
 - eexists;eexists;left;eapply Csem.step_call;eauto.
Qed.
Theorem invariant_progress : forall ge s,
 execution_invariant ge s -> normal_return s \/ exists t s',Csem.step ge s t s'.
Proof.
 intros ge s [NORMAL[NAMES[result EVAL]]].
 destruct s as [f stmt k e m|f a k e m|fd args k m|v k m|];
 cbn [normal_state] in NORMAL; try discriminate.
 - core_unpack.
   destruct stmt; cbn [normal_stmt] in *; core_unpack;try discriminate.
   + destruct k; cbn [normal_cont] in *;core_unpack;try discriminate.
     * cbn [state_eval stmt_eval cont_eval] in EVAL.
       destruct(Mem.free_list m (blocks_of_env ge e))eqn:FREE;try discriminate.
       right; eexists;eexists;right;eapply step_skip_call;[exact I|exact FREE].
     * right;eexists;eexists;right;eapply step_skip_seq.
   + right;eexists;eexists;right;eapply step_do_1.
   + right;eexists;eexists;right;eapply step_seq.
   + right;eexists;eexists;right;eapply step_ifthenelse_1.
   + destruct o as [a|].
     * right;eexists;eexists;right;eapply step_return_1.
     * cbn [state_eval stmt_eval] in EVAL. rewrite cont_eval_return in EVAL.
       destruct(Mem.free_list m (blocks_of_env ge e))eqn:FREE;try discriminate.
       right;eexists;eexists;right;eapply step_return_0;exact FREE.
 - 
   destruct k; cbn [normal_state] in NORMAL;try discriminate;core_unpack.
   + destruct(literal RV a)eqn:LIT.
     * destruct(literal_r_inv _ LIT)as [v[ty EQ]];subst a.
       right;eexists;eexists;right;eapply step_do_2.
     * right;eapply immediate_has_step;eauto.
       cbn [state_eval] in EVAL;destruct(atomic_eval ge e m a)as [[v mx]|]eqn:EV;
       try discriminate;pose proof(atomic_not_stuck _ _ _ _ _ _ ltac:(eassumption) EV) as NS;exact(NS RV (fun x=>x) a (ctx_top RV) eq_refl).
   + destruct(literal RV a)eqn:LIT.
     * destruct(literal_r_inv _ LIT)as [v[ty EQ]];subst a.
       cbn [state_eval pure_rval typeof] in EVAL.
       destruct(bool_val v ty m)eqn:BOOL;try discriminate.
       right;eexists;eexists;right;eapply step_ifthenelse_2;exact BOOL.
     * right;eapply immediate_has_step;eauto.
       cbn [state_eval] in EVAL;destruct(pure_rval ge e m a)eqn:EV;try discriminate.
       eapply simple_immediate;eauto;congruence.
   + destruct(literal RV a)eqn:LIT.
     * destruct(literal_r_inv _ LIT)as [v[ty EQ]];subst a.
       change((match sem_cast v ty (fn_return f) m with
        | Some v2=>cont_eval ge e (fn_return f) k (Nreturn v2) m
        | None=>None end)=Some result) in EVAL.
       destruct(sem_cast v ty (fn_return f) m)eqn:CAST;try discriminate.
       rewrite cont_eval_return in EVAL.
       destruct(Mem.free_list m (blocks_of_env ge e))eqn:FREE;try discriminate.
       right;eexists;eexists;right;eapply step_return_2;eauto.
     * right;eapply immediate_has_step;eauto.
       cbn [state_eval] in EVAL;destruct(pure_rval ge e m a)eqn:EV;try discriminate.
       eapply simple_immediate;eauto;congruence.
 - destruct fd;try discriminate. destruct k;try discriminate.
   cbn [state_eval] in EVAL.
   destruct(do_alloc_variables ge empty_env m
    (fn_params f++fn_vars f))as [e ma]eqn:ALLOC.
   destruct(sem_bind_parameters ge quiet_world e ma
    (fn_params f) args)eqn:BIND;try discriminate.
   right;eexists;eexists;right;eapply step_internal_function.
   + exact NAMES.
   + pose proof(do_alloc_variables_sound ge
      (fn_params f++fn_vars f) empty_env m)as A.
     rewrite ALLOC in A;exact A.
   + eapply sem_bind_parameters_sound;exact BIND.
 - destruct k;try discriminate;left;unfold normal_return;eauto.
Qed.


Theorem reachable_invariant: forall ge initial t reached,
 execution_invariant ge initial ->
 star Csem.step ge initial t reached -> execution_invariant ge reached.
Proof.
 intros ge initial t reached INV PATH;revert INV;induction PATH;intros INV;auto.
 apply IHPATH;eapply invariant_preserved;eauto.
Qed.

(** A constructive normal execution discharges the denotation premise.  Syntax,
    rather than an assumed safety predicate, ensures all alternate operand orders
    preserve the same denotation. *)
Theorem normal_witness_certifies_all_orders: forall ge initial tw v mf,
 normal_state initial=true -> call_names initial ->
 star Csem.step ge initial tw(Returnstate v Kstop mf) ->
 (forall t reached,star Csem.step ge initial t reached ->
   normal_return reached \/ exists tr next,Csem.step ge reached tr next) /\
 (forall t v' mf',star Csem.step ge initial t(Returnstate v' Kstop mf') ->
   v'=v /\ mf'=mf).
Proof.
 intros ge initial tw v mf NORMAL NAMES WITNESS.
 pose proof(all_order_normal_correspondence ge initial tw v mf NORMAL WITNESS)as DEN.
 assert(INV:execution_invariant ge initial).
 { split;auto;split;auto;exists(v,mf);exact DEN. }
 split.
 - intros t reached PATH;apply invariant_progress.
   eapply reachable_invariant;eauto.
 - intros t v' mf' PATH.
   pose proof(all_order_normal_correspondence ge initial t v' mf' NORMAL PATH)as DEN'.
   rewrite DEN in DEN';inversion DEN';auto.
Qed.
Corollary normal_witness_excludes_all_errors: forall ge initial tw v mf,
 normal_state initial=true -> call_names initial ->
 star Csem.step ge initial tw(Returnstate v Kstop mf) ->
 forall t reached,star Csem.step ge initial t reached ->
 ~(~normal_return reached /\ nostep Csem.step ge reached).
Proof.
 intros ge initial tw v mf NORMAL NAMES WIT t reached PATH[NR STOP].
 destruct(proj1(normal_witness_certifies_all_orders ge initial tw v mf NORMAL NAMES WIT)
   t reached PATH)as [DONE|[tr[next STEP]]].
 - contradiction.
 - exact(STOP tr next STEP).
Qed.
Print Assumptions normal_witness_certifies_all_orders.
Print Assumptions normal_witness_excludes_all_errors.


FILE paparazzi/relations/state_speed_ecef_provenance/support/SourceComparison.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib AST Integers Floats Values Memory Memdata Events Globalenvs Csem Smallstep.
From StateSpeedSetterSupport Require Import MemoryFacts.
From StateSpeedMemory Require Import MemoryLayout Protocol.
Require StateSpeedSetNedISupport.Original StateSpeedSetEcefISupport.Original StateSpeedGetterSupport.Original.
Import ListNotations.
Open Scope Z_scope.
Module NO:=StateSpeedSetNedISupport.Original.
Module EO:=StateSpeedSetEcefISupport.Original.
Module GO:=StateSpeedGetterSupport.Original.
Module ML:=StateSpeedMemory.MemoryLayout.
Lemma load_transfer:forall ch m mf b ofs v,
 Mem.load ch m b ofs=Some v->Mem.loadbytes mf b ofs(size_chunk ch)=Mem.loadbytes m b ofs(size_chunk ch)->Mem.load ch mf b ofs=Some v.
Proof.
 intros ch m mf b ofs v LOAD FRAME.
 destruct(Mem.load_loadbytes _ _ _ _ _ LOAD)as[bytes[READ VALUE]];rewrite VALUE;apply Mem.loadbytes_load.
 - rewrite FRAME;exact READ.
 - exact(proj2(Mem.load_valid_access _ _ _ _ _ LOAD)).
Qed.
Lemma ned_symbol:forall sb,Genv.find_symbol G.ge G.S._state=Some sb->Genv.find_symbol N.ge N.S._state=Some sb.
Proof. intros sb SYM;change(Genv.find_symbol ML.NE.ge ML.N._state=Some sb);rewrite(proj1 ML.common_state_symbols);exact SYM. Qed.
Lemma ecef_symbol:forall sb,Genv.find_symbol G.ge G.S._state=Some sb->Genv.find_symbol EI.ge EI.S._state=Some sb.
Proof. intros sb SYM;change(Genv.find_symbol ML.EE.ge ML.E._state=Some sb);rewrite(proj2 ML.common_state_symbols);exact SYM. Qed.
Lemma ned_frame_load:forall m mf sb src x y z ch b ofs v,
 N.SetterResult m mf sb src x y z->Mem.load ch m b ofs=Some v->
 (forall i,ofs<=i<ofs+size_chunk ch->~N.writes sb b i)->Mem.load ch mf b ofs=Some v.
Proof.
 intros m mf sb src x y z ch b ofs v RESULT LOAD MISS;eapply load_transfer;[exact LOAD|].
 eapply(N.result_frame _ _ _ _ _ _ _ RESULT);[eapply loaded_valid;exact LOAD|pose proof(size_chunk_pos ch);lia|exact MISS].
Qed.
Lemma ecef_frame_load:forall m mf sb src x y z ch b ofs v,
 EI.SetterResult m mf sb src x y z->Mem.load ch m b ofs=Some v->
 (forall i,ofs<=i<ofs+size_chunk ch->~EI.writes sb b i)->Mem.load ch mf b ofs=Some v.
Proof.
 intros m mf sb src x y z ch b ofs v RESULT LOAD MISS;eapply load_transfer;[exact LOAD|].
 eapply(EI.result_frame _ _ _ _ _ _ _ RESULT);[eapply loaded_valid;exact LOAD|pose proof(size_chunk_pos ch);lia|exact MISS].
Qed.
Lemma getter_frame_load:forall m mf sb x y z ch b ofs v,
 G.GetterResult m mf sb x y z->Mem.load ch m b ofs=Some v->
 (forall i,ofs<=i<ofs+size_chunk ch->~G.write_byte sb b i)->Mem.load ch mf b ofs=Some v.
Proof.
 intros m mf sb x y z ch b ofs v RESULT LOAD MISS;eapply load_transfer;[exact LOAD|].
 eapply(G.result_frame _ _ _ _ _ _ RESULT);[pose proof(size_chunk_pos ch);lia|exact MISS].
Qed.
Lemma initial_ned_input:forall m sb ns es nx ny nz ex ey ez,
 ProtocolInput m sb ns es nx ny nz ex ey ez->N.InputGood m sb ns accepted_id nx ny nz.
Proof.
 intros m sb ns es nx ny nz ex ey ez P;destruct P as[SYM WR FILTER NS ES NV EV].
 constructor;[apply ned_symbol;exact SYM|exact WR|exact FILTER|exact NS|exact NV].
Qed.
Lemma ecef_input_after_ned:forall m mn sb ns es nx ny nz ex ey ez,
 ProtocolInput m sb ns es nx ny nz ex ey ez->N.SetterResult m mn sb ns nx ny nz->EI.InputGood mn sb es accepted_id ex ey ez.
Proof.
 intros m mn sb ns es nx ny nz ex ey ez P RN;destruct P as[SYM WR FILTER NS ES NV EV].
 assert(SVALID:Mem.valid_block m sb)by(eapply(range_valid _ _ 656 Writable);[lia|exact WR]).
 constructor.
 - apply ecef_symbol;exact SYM.
 - intros ofs RANGE;apply(proj1(N.result_permissions _ _ _ _ _ _ _ RN sb ofs Cur Writable SVALID));apply WR;exact RANGE.
 - eapply ned_frame_load;[exact RN|exact FILTER|].
   intros i I[EQ W];unfold N.destination_offset in W;cbn[size_chunk]in I;lia.
 - exact ES.
 - destruct EV as[A[B C]];repeat split;eapply ned_frame_load;try exact RN;try eassumption.
   all:intros i I[EQ W];apply ES;exact EQ.
Qed.
Lemma getter_input_after_ecef:forall m mn me sb ns es nx ny nz ex ey ez,
 EI.InputGood mn sb es accepted_id ex ey ez->N.SetterResult m mn sb ns nx ny nz->EI.SetterResult mn me sb es ex ey ez->
 Genv.find_symbol G.ge G.S._state=Some sb->G.InputGood me sb nx ny nz.
Proof.
 intros m mn me sb ns es nx ny nz ex ey ez INPUT RN RE SYM.
 assert(WR:Mem.range_perm mn sb 0 656 Cur Writable)by exact(EI.state_writable _ _ _ _ _ _ _ INPUT).
 assert(SVALID:Mem.valid_block mn sb)by(eapply(range_valid _ _ 656 Writable);[lia|exact WR]).
 split;[exact SYM|];split.
 - intros ofs RANGE;apply(proj1(EI.result_permissions _ _ _ _ _ _ _ RE sb ofs Cur Writable SVALID));apply WR;exact RANGE.
 - split;[exact(EI.result_status _ _ _ _ _ _ _ RE)|].
   split;[|split];eapply ecef_frame_load;[exact RE|exact(N.result_x _ _ _ _ _ _ _ RN)| |exact RE|exact(N.result_y _ _ _ _ _ _ _ RN)| |exact RE|exact(N.result_z _ _ _ _ _ _ _ RN)|].
   all:intros i I[EQ W];unfold EI.destination_offset in W;cbn[size_chunk]in I;lia.
Qed.
Lemma observed_getter_result:forall m mf sb nx ny nz,
 G.GetterResult m mf sb nx ny nz->observe_bits mf sb=Some(bits_of nx ny nz).
Proof.
 intros m mf sb nx ny nz RESULT;unfold observe_bits,bits_of.
 rewrite(G.result_x _ _ _ _ _ _ RESULT),(G.result_y _ _ _ _ _ _ RESULT),(G.result_z _ _ _ _ _ _ RESULT);reflexivity.
Qed.
Theorem actual_protocol:forall m sb ns es nx ny nz ex ey ez,
 ProtocolInput m sb ns es nx ny nz ex ey ez->exists mn me mf,ProtocolRun m mn me mf sb ns es nx ny nz ex ey ez /\observe_bits mf sb=Some(bits_of nx ny nz).
Proof.
 intros m sb ns es nx ny nz ex ey ez INPUT.
 pose proof(initial_ned_input m sb ns es nx ny nz ex ey ez INPUT)as NINPUT.
 destruct(NO.original_normal_result m sb ns accepted_id nx ny nz NINPUT)as[mn[NORMALN[RN UN]]].
 pose proof(ecef_input_after_ned m mn sb ns es nx ny nz ex ey ez INPUT RN)as EINPUT.
 destruct(EO.original_normal_result mn sb es accepted_id ex ey ez EINPUT)as[me[NORMALE[RE UE]]].
 pose proof(getter_input_after_ecef m mn me sb ns es nx ny nz ex ey ez EINPUT RN RE(input_symbol _ _ _ _ _ _ _ _ _ _ INPUT))as GINPUT.
 destruct(GO.original_normal_result me sb nx ny nz GINPUT)as[mf[NORMALG[RG UG]]].
 exists mn,me,mf;split;[|eapply observed_getter_result;exact RG].
 destruct GINPUT as[GSYM[GWR[GSTATUS[GX[GY GZ]]]]].
 constructor.
 - exact NORMALN.
 - exact NORMALE.
 - exact NORMALG.
 - exact RN.
 - exact RE.
 - exact RG.
 - exact GX.
 - exact GY.
 - exact GZ.
 - eapply getter_frame_load;[exact RG|exact(EI.result_x _ _ _ _ _ _ _ RE)|].
   intros i I[EQ W];cbn[size_chunk]in I;lia.
 - eapply getter_frame_load;[exact RG|exact(EI.result_y _ _ _ _ _ _ _ RE)|].
   intros i I[EQ W];cbn[size_chunk]in I;lia.
 - eapply getter_frame_load;[exact RG|exact(EI.result_z _ _ _ _ _ _ _ RE)|].
   intros i I[EQ W];cbn[size_chunk]in I;lia.
Qed.
Print Assumptions actual_protocol.


FILE paparazzi/models/stateSetSpeedEcef_i/rocq/support/Original.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib AST Integers Values Memory Events Globalenvs Maps Ctypes Csyntax Csyntaxdefs Csem Smallstep.
From FiveShared.verification Require Import Obligations.
From FiveGuidanceAllOrder Require Import PureSyntax CallfreeExecution PhaseComposition.
From StateSpeedSetterSupport Require Import MemoryFacts StoreEffects Certificates GuardShell.
From StateSpeedSetEcefISupport Require Import Setup Layout Body Parameters Termination.
From StateSpeedSetEcefIExecutionProblem Require Import Closure.
Import ListNotations.
Open Scope Z_scope.
Local Opaque ge E.ge.

Lemma original_trace_empty:forall args m t reached,
 star Csem.step ge(E.entry args m)t reached ->t=E0.
Proof.
 intros args m t reached PATH;pose proof(Closure.entry_source args m)as INIT.
 revert INIT;induction PATH;intros INIT;[reflexivity|].
 destruct(Closure.source_step_invariant _ _ _ INIT H)as[TT NEXT].
 specialize(IHPATH NEXT);subst t1 t2;cbn in *;congruence.
Qed.

Theorem original_certificate:forall m sb src id x y z,
 InputGood m sb src id x y z ->
 exists mf P,certificate ge P(Returnstate Vundef Kstop mf) /\
 P(E.entry(Args id src)m) /\SetterResult m mf sb src x y z.
Proof.
 intros m sb src id x y z GOOD.
 pose proof GOOD as[SYMBOL W FILTER SRC WORDS].
 assert(VS:Mem.valid_block m sb)by(eapply(range_valid m sb 656 Writable);[lia|exact W]).
 assert(VI:Mem.valid_block m src)by(destruct WORDS as[A[B C]];eapply loaded_valid;exact A).
 destruct(parameters_exist m id src)as(e&m0&bi&bp&TRACE&WI&WP&DIST&PTR).
 assert(ENV:e=parameter_env bi bp)by(destruct TRACE as(a&b&c&A&B&C&D&E);exact E).
 destruct(parameter_lookups bi bp)as[IDLOOK[LOOK NONE]].
 rewrite<-ENV in IDLOOK,LOOK,NONE.
 pose proof(parameter_input_good m id src e m0 bi bp TRACE sb x y z GOOD)as GOOD0.
 destruct GOOD0 as[SYMBOL0 W0 FILTER0 SRC0 WORDS0].
 destruct(parameter_fresh m id src e m0 bi bp TRACE sb VS)as[SBI SBP].
 assert(BP:bp<>sb)by congruence.
 destruct(four_stores_exist destination_offset(Int.repr selected_status)m0 sb x y z
 ltac:(unfold destination_offset;lia)ltac:(unfold destination_offset;lia)
 ltac:(unfold destination_offset;exists 71;reflexivity)W0)as[mb[m1[m2[m3[X[Y[ZS ST]]]]]]].
 pose proof(body_evaluates e m0 m1 m2 m3 mb sb bp src x y z NONE SYMBOL0 LOOK BP SRC0 PTR WORDS0 X Y ZS ST)as BODY.
 assert(WIF:Mem.valid_access mb Mint16unsigned bi 0 Freeable).
 { eapply Mem.store_valid_access_1;[exact ST|];eapply Mem.store_valid_access_1;[exact ZS|].
   eapply Mem.store_valid_access_1;[exact Y|];eapply Mem.store_valid_access_1;[exact X|exact WI]. }
 assert(WPF:Mem.valid_access mb Mptr bp 0 Freeable).
 { eapply Mem.store_valid_access_1;[exact ST|];eapply Mem.store_valid_access_1;[exact ZS|].
   eapply Mem.store_valid_access_1;[exact Y|];eapply Mem.store_valid_access_1;[exact X|exact WP]. }
 destruct(release_parameters m id src e m0 bi bp TRACE mb WIF WPF)as[mf[FREE[LOAD[BYTES PERM]]]].
 pose proof(body_defined e m0 mb mf BODY FREE)as BODYINV.
 set(Q:=fun s=>normal_state s=true /\call_names s /\state_eval ge s=Some(Vundef,mf)).
 assert(QC:certificate ge Q(Returnstate Vundef Kstop mf))by(apply evaluator_certificate).
 assert(QI:Q(State f copy_body Kstop e m0))by exact BODYINV.
 destruct(accepted_tests e m0 sb NONE SYMBOL0 FILTER0)as[A0 B1].
 pose proof(guard_false_certificate ge f e m0(Kseq copy_body Kstop)(Sreturn None)Sskip
 first_test second_test third_test eq_refl eq_refl A0 eq_refl eq_refl B1)as GC.
 pose proof(guard_false_initial ge f e m0(Kseq copy_body Kstop)(Sreturn None)Sskip first_test second_test third_test)as GI.
 set(R:=guard_false_invariant ge f e m0(Kseq copy_body Kstop)(Sreturn None)Sskip first_test second_test third_test).
 assert(RC:certificate ge(fun s=>R s \/Q s)(Returnstate Vundef Kstop mf)).
 { eapply chain_certificate;[exact GC|exact QC|apply skip_seq_unique|exact QI]. }
 assert(RI:(fun s=>R s \/Q s)(State f guard(Kseq copy_body Kstop)e m0))by(left;exact GI).
 pose proof(prepend_certificate ge(fun s=>R s \/Q s)(Returnstate Vundef Kstop mf)
 (State f(Ssequence guard copy_body)Kstop e m0)(State f guard(Kseq copy_body Kstop)e m0)
 RC RI(sequence_unique ge f guard copy_body Kstop e m0))as SC.
 assert(SI:(fun s=>s=State f(Ssequence guard copy_body)Kstop e m0 \/R s \/Q s)
 (State f(Ssequence guard copy_body)Kstop e m0))by(left;reflexivity).
 pose proof(parameter_step m id src e m0 bi bp TRACE)as ENTRY;rewrite source_body in ENTRY.
 pose proof(prepend_certificate ge _ (Returnstate Vundef Kstop mf)
 (E.entry(Args id src)m)(State f(Ssequence guard copy_body)Kstop e m0)SC SI ENTRY)as FINAL.
 exists mf,(fun s=>s=E.entry(Args id src)m \/s=State f(Ssequence guard copy_body)Kstop e m0 \/R s \/Q s).
 split;[exact FINAL|];split;[left;reflexivity|].
 assert(COPY:Mem.load Mint32 mb sb destination_offset=Some(Vint x) /\
 Mem.load Mint32 mb sb(destination_offset+4)=Some(Vint y) /\
 Mem.load Mint32 mb sb(destination_offset+8)=Some(Vint z) /\
 Mem.load Mint16unsigned mb sb 280=Some(Vint(Int.repr selected_status))).
 { exact(four_store_words destination_offset(Int.repr selected_status)m0 m1 m2 m3 mb sb x y z
   ltac:(unfold destination_offset;lia)X Y ZS ST). }
 destruct COPY as[CX[CY[CZ CS]]].
 assert(BC:Mem.loadbytes mb sb destination_offset 12=Some(typed_bytes x y z)).
 { eapply four_store_bytes;[unfold destination_offset;lia|exact X|exact Y|exact ZS|exact ST]. }
 assert(IC:VecRead mb src x y z).
 { eapply four_store_input;[exact X|exact Y|exact ZS|exact ST|exact SRC0|exact WORDS0]. }
 assert(SPERM:forall b ofs k p,Mem.perm m0 b ofs k p<->Mem.perm mb b ofs k p).
 { intros;eapply four_store_permissions;[exact X|exact Y|exact ZS|exact ST]. }
 constructor.
 - rewrite(LOAD Mint32 sb destination_offset VS);exact CX.
 - rewrite(LOAD Mint32 sb(destination_offset+4)VS);exact CY.
 - rewrite(LOAD Mint32 sb(destination_offset+8)VS);exact CZ.
 - rewrite(LOAD Mint16unsigned sb 280 VS);exact CS.
 - rewrite(BYTES sb destination_offset 12 VS);exact BC.
 - destruct IC as[IX[IY IZ]];unfold VecRead;repeat split;rewrite LOAD by exact VI;assumption.
 - intros b ofs k p VB.
   pose proof(parameter_permissions m id src e m0 bi bp TRACE b ofs k p VB)as PM.
   split;intro P.
   + apply(proj1(PERM b ofs k p VB));apply(proj1(SPERM b ofs k p));apply(proj1 PM);exact P.
   + apply(proj2 PM);apply(proj2(SPERM b ofs k p));apply(proj2(PERM b ofs k p VB));exact P.
 - intros b ofs n VB N MISS;rewrite(BYTES b ofs n VB).
   rewrite(four_store_frame destination_offset(Int.repr selected_status)m0 m1 m2 m3 mb sb x y z
   ltac:(unfold destination_offset;lia)X Y ZS ST b ofs n N MISS).
   exact(parameter_bytes_frame m id src e m0 bi bp TRACE b ofs n VB).
Qed.

Theorem original_normal_result:forall m sb src id x y z,
 InputGood m sb src id x y z ->exists mf,
 NormalCall id src m mf /\SetterResult m mf sb src x y z /\
 (forall mf',NormalCall id src m mf' ->mf'=mf).
Proof.
 intros m sb src id x y z GOOD;destruct(original_certificate m sb src id x y z GOOD)as(mf&P&CERT&INIT&POST).
 destruct(certificate_has_return ge P(Returnstate Vundef Kstop mf)(E.entry(Args id src)m)CERT INIT
 (all_successor_termination(Args id src)m))as[t PATH].
 pose proof(original_trace_empty _ _ _ _ PATH)as TT;subst t.
 exists mf;split;[exact PATH|];split;[exact POST|].
 intros mf' CALL;exact(proj2(certificate_normal_unique ge P Vundef mf(E.entry(Args id src)m)CERT INIT E0 Vundef mf' CALL)).
Qed.
Theorem original_no_error:forall m sb src id x y z,
 InputGood m sb src id x y z ->Obligations.no_error ge(E.entry(Args id src)m).
Proof.
 intros m sb src id x y z GOOD;destruct(original_certificate m sb src id x y z GOOD)as(mf&P&CERT&INIT&POST).
 unfold Obligations.no_error;intros t reached PATH[NR STOP].
 assert(TERMINAL:nostep Csem.step ge(Returnstate Vundef Kstop mf)).
 { intros tr next[ES|SS];inversion ES||inversion SS. }
 destruct(certificate_no_error ge P _ _ CERT INIT TERMINAL t reached PATH)as[EQ|[tr[next STEP]]].
 - subst reached;apply NR;exists Vundef,mf;reflexivity.
 - exact(STOP tr next STEP).
Qed.
Print Assumptions original_normal_result.
Print Assumptions original_no_error.


FILE examples/models/sum3/rocq/cbmc_recheck/attempts/002/check.py
#!/usr/bin/env python3
from pathlib import Path
import shutil,subprocess,hashlib,json,sys
root=Path(__file__).resolve().parents[7]
attempt=Path(__file__).resolve().parent
case=root/'examples/models/sum3'
build=Path(sys.argv[1]).resolve()
build.mkdir(parents=True,exist_ok=True)
model=build/'model'; proof=build/'proof'; shared=build/'shared'
model.mkdir(exist_ok=True); proof.mkdir(exist_ok=True)
inputs={}
def copy(src,dst):
 dst.parent.mkdir(parents=True,exist_ok=True)
 shutil.copyfile(src,dst)
 inputs[str(src.relative_to(root))]=hashlib.sha256(src.read_bytes()).hexdigest()
for f in ['Source.v','Execution.v','proof/Precondition.v','proof/Obligations.v']:
 copy(case/'align/model'/f,model/f)
for f in ['SourceInvariant','PureProgress','Invariant','Entry','Functional']:
 copy(case/'rocq/support'/(f+'.v'),proof/(f+'.v'))
copy(case/'rocq/support/NormalCorrespondence.v',proof/'support/NormalCorrespondence.v')
copy(case/'rocq/cbmc_recheck/problem/Spec.v',proof/'RecheckSpec.v')
copy(case/'rocq/cbmc_recheck/problem/FullSpec.v',proof/'FullSpec.v')
copy(case/'rocq/no_error/problem/Spec.v',proof/'NoErrorSpec.v')
copy(case/'rocq/termination/problem/Spec.v',proof/'TerminationSpec.v')
copy(case/'rocq/termination/attempts/001/Proof.v',proof/'Termination.v')
copy(attempt/'Proof.v',proof/'Proof.v')
for src in (root/'shared').rglob('*.v'):
 copy(src,shared/src.relative_to(root/'shared'))
(build/'compiled-inputs.json').write_text(json.dumps(inputs,indent=2)+'\n')
flags=['-Q',str(model),'FiveSum3','-Q',str(proof),'FiveSum3Proof','-Q',str(shared),'FiveShared']
order=[shared/'pure_semantics/SemanticsSupport.v',shared/'verification/Obligations.v',model/'Source.v',model/'Execution.v',model/'proof/Precondition.v',model/'proof/Obligations.v',proof/'SourceInvariant.v',proof/'support/NormalCorrespondence.v',proof/'PureProgress.v',proof/'Invariant.v',proof/'Entry.v',proof/'Functional.v',proof/'RecheckSpec.v',proof/'NoErrorSpec.v',proof/'TerminationSpec.v',proof/'Termination.v',proof/'FullSpec.v',proof/'Proof.v']
for src in order:
 subprocess.run(['rocq','compile',*flags,str(src)],cwd=root,check=True)
subprocess.run(['rocq','check','-silent',*flags,'FiveSum3Proof.Proof'],cwd=root,check=True)
print('Current-model Csem result and bit theorem compiled and independently checked.')

