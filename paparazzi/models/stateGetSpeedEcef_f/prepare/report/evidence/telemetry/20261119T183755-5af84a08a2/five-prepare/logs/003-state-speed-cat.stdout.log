def functions_in(data):
 stack=[parser.parse(data).root_node]; found=[]
 while stack:
  node=stack.pop(); stack.extend(node.children)
  if node.type=='function_definition':
   d=node.child_by_field_name('declarator')
   while d and d.type!='identifier':d=d.child_by_field_name('declarator')
   if d:found.append((data[d.start_byte:d.end_byte].decode(),node.start_byte,node.end_byte))
 return found
