  with tempfile.TemporaryDirectory(prefix='paparazzi-rebind-') as td:
   temp=Path(td); c=run.command([m['tool']['path'],*m['cpp_arguments'],'-E',str(p/m['source']['path'])],'refresh-identical-header-paths',60,cwd=m['cpp_cwd'])
   (temp/'preprocessed.i').write_bytes((run.folder/c['stdout']).read_bytes())
   run.command([m['tool']['path'],'-csyntax','-o',str(temp/'Source.v'),str(temp/'preprocessed.i')],'check-header-path-refresh-ast',60,cwd=m['cpp_cwd'])
   assert normalized_ast((temp/'Source.v').read_text())==normalized_ast((destination/'Source.v').read_text()), 'AST changed; full regeneration required'
   m['preprocessing_path_refresh']={'previous_sha256':m['files']['preprocessed.i']['sha256'],'reason':'Header copies now resolve in complete overlay; refreshed preprocessing only after complete normalized AST byte equality'}
   shutil.copy2(temp/'preprocessed.i',destination/'preprocessed.i');m['files']['preprocessed.i']['sha256']=sha(destination/'preprocessed.i');save(manifest,m)
  return audit(manifest)
