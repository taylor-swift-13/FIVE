    22	/** @file firmwares/rotorcraft/guidance/guidance_h_ref.h
    23	 *  Reference generation for horizontal guidance.
    24	 *
    25	 */
    26	
    27	#ifndef GUIDANCE_H_REF_H
    28	#define GUIDANCE_H_REF_H
    29	
    30	#include "inttypes.h"
    31	#include "math/pprz_algebra.h"
    32	#include "math/pprz_algebra_int.h"
    33	#include "math/pprz_algebra_float.h"
    34	#include "generated/airframe.h"
    35	#include "math/pprz_algebra_float.h"
    36	
    37	/** Default speed saturation */
    38	#ifndef GUIDANCE_H_REF_MAX_SPEED
    39	#define GUIDANCE_H_REF_MAX_SPEED 5.
    40	#endif
    41	
    42	/** Current maximum speed for waypoint navigation.
    43	 * Defaults to #GUIDANCE_H_REF_MAX_SPEED
    44	 */
    45	extern float gh_max_speed;
    46	
    47	/** Accel saturation.
    48	 * tanf(RadOfDeg(30.))*9.81 = 5.66
    49	 */
    50	#ifndef GUIDANCE_H_REF_MAX_ACCEL
    51	#define GUIDANCE_H_REF_MAX_ACCEL 5.66
    52	#endif
    53	
    54	/** fixedpoint representation: Q26.37 will give a range of
    55	 * 67e3 km and a resolution of 1.5e-11 m. At a rate of 500Hz,
    56	 * a ref speed of 7.3e-9 m/s could still update the position.
    57	 */
    58	#define GH_POS_REF_FRAC 37
    59	
    60	struct GuidanceHRef {
    61	  /** Reference model acceleration.
    62	   * in meters/sec2 (output)
    63	   */
    64	  struct FloatVect2 accel;
    65	
    66	  /** Reference model speed.
    67	   * in meters/sec
    68	   * accuracy 0.0000076 , range 16384m/s
    69	   */
    70	  struct FloatVect2 speed;
    71	
    72	  /** Reference model position.
    73	   * in meters
    74	   * with fixedpoint representation: Q37.26
    75	   */
    76	  struct Int64Vect2 pos;
    77	
    78	  float tau;    ///< first order time constant
    79	  float omega;  ///< second order model natural frequency
    80	  float zeta;   ///< second order model damping
    81	
    82	  /** Current maximum speed for waypoint navigation.
    83	   * Defaults to #GUIDANCE_H_REF_MAX_SPEED
    84	   */
    85	  float max_speed;
    86	
    87	  /*
    88	   * internal variables
    89	   */
    90	  float zeta_omega;
    91	  float omega_2;
    92	  float inv_tau;
    93	
    94	  /** Integration timestep
    95	   */
    96	  float dt;
    97	};
    98	
    99	extern struct GuidanceHRef gh_ref;
   100	
   101	extern void gh_ref_init(void);
   102	extern void gh_set_ref(struct Int32Vect2 pos, struct FloatVect2 speed, struct FloatVect2 accel);
   103	extern void gh_update_ref_from_pos_sp(struct Int32Vect2 pos_sp);
   104	extern void gh_update_ref_from_speed_sp(struct FloatVect2 speed_sp);
   105	extern void gh_update_ref_from_accel_sp(struct FloatVect2 accel_sp);
   106	
   107	/**
   108	 * Set a new maximum speed for waypoint navigation.
   109	 * @param max_speed speed saturation in m/s
   110	 * @return new maximum speed
   111	 */
   112	extern float gh_set_max_speed(float max_speed);
   113	
   114	extern float gh_set_tau(float tau);
   115	extern float gh_set_omega(float omega);
   116	extern float gh_set_zeta(float zeta);
   117	
   118	#endif /* GUIDANCE_H_REF_H */
