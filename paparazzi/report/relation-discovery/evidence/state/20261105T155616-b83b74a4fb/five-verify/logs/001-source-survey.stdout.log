    } else if (bit_is_set(state.speed_status, SPEED_ECEF_I)) {
      enu_of_ecef_vect_i(&state.enu_speed_i, &state.ned_origin_i, &state.ecef_speed_i);
    } else if (bit_is_set(state.speed_status, SPEED_ECEF_F)) {
