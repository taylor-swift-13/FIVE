20 /** @file low_pass_zoh_filter.h
21  *  @brief A first order low pass filter using Zero Order Hold (ZOH) discretization.
22  */
23 
24 #ifndef LOW_PASS_ZOH_FILTER_H
25 #define LOW_PASS_ZOH_FILTER_H
26 
27 #include "std.h"
28 #include "math/pprz_algebra_int.h"
29 
30 
31 /**
32  * @brief Zero Order Hold (ZOH) discrete first order low pass filter structure.
33  *
34  * This structure represents a first order low pass filter implemented using
35  * the Zero Order Hold (ZOH) method for discretization. It maintains the necessary
36  * state for filtering operations.
37  */
38 struct FirstOrderZOHLowPass {
39   float discrete_time_constant;
40   float last_in;
41   float last_out;
42 };
43 
44 /**
45  * @brief Init first order ZOH low pass filter.
46  *
47  * The ZOH discretization method is used to convert a continuous-time first order
48  * low pass filter into its discrete-time equivalent which matches the continuous-time
49  * behavior at the sampling instants exactly when holding the input constant between samples.
50  *
51  * @param[out] filter first order ZOH low pass filter structure
52  * @param[in] tau time constant of the first order low pass filter [s]
53  * @param[in] sample_time sampling period of the signal [s]
54  * @param[in] value initial value of the filter
55  */
56 static inline void init_first_order_zoh_low_pass(struct FirstOrderZOHLowPass *filter, const float tau,
57     const float sample_time,
58     float value)
59 {
60   filter->discrete_time_constant = exp(-sample_time / tau);
61   filter->last_in = value;
62   filter->last_out = value;
63 }
64 
65 /**
66  * @brief Update first order ZOH low pass filter state with a new value.
67  *
68  * @param[in,out] filter first order ZOH low pass filter structure
69  * @param[in] value new input value of the filter
70  * @return new filtered value
71  */
72 static inline float update_first_order_zoh_low_pass(struct FirstOrderZOHLowPass *filter, const float value)
73 {
74   float out = (1.0f - filter->discrete_time_constant) * value + filter->discrete_time_constant * filter->last_out;
75   filter->last_in = value;
76   filter->last_out = out;
77   return out;
78 }
79 
80 /**
81  * @brief Reset the first order ZOH low-pass filter to a specific value.
82  *
83  * @param[in,out] filter first order ZOH low pass filter structure
84  * @param[in] value Value to reset the filter to
85  * @return The reset value
86  */
87 static inline float reset_first_order_zoh_low_pass(struct FirstOrderZOHLowPass *filter, const float value)
88 {
89   filter->last_in = value;
90   filter->last_out = value;
91   return value;
92 }
93 
94 /**
95  * @brief Get current value of the first order ZOH low pass filter.
96  *
97  * @param[in] filter first order ZOH low pass filter structure
98  * @return current value of the filter
99  */
100 static inline float get_first_order_zoh_low_pass(const struct FirstOrderZOHLowPass *filter)
101 {
102   return filter->last_out;
103 }
104 
105 /** @brief Update time constant (tau parameter) for first order ZOH low pass filter
106  * @param[in,out] filter first order ZOH low pass filter structure
107  * @param[in] tau time constant of the  first order low pass filter [s]
108  * @param[in] sample_time sampling period of the signal [s]
109  */
110 static inline void update_first_order_zoh_low_pass_tau(struct FirstOrderZOHLowPass *filter, const float tau,
111     const float sample_time)
112 {
113   filter->discrete_time_constant = exp(-sample_time / tau);
114 }
115 
116 #endif // LOW_PASS_ZOH_FILTER_H
