22 /** @file filters/low_pass_filter.h
23  *  @brief Simple first order low pass filter with bilinear transform
24  *
25  * @FIXME: INT and FLOAT implementations are inconsistent, tau and cut_off freq are mixed.
26  *         Suggestion: Change everything to freq.
27  *
28  */
29 
30 #ifndef LOW_PASS_FILTER_H
31 #define LOW_PASS_FILTER_H
32 
33 #include "std.h"
34 #include "math/pprz_algebra_int.h"
35 
36 #define INT32_FILT_FRAC  8
37 
38 /** First order low pass filter structure.
39  *
40  * using bilinear z transform
41  */
42 struct FirstOrderLowPass {
43   float time_const;
44   float last_in;
45   float last_out;
46 };
47 
48 /** Init first order low pass filter.
49  *
50  * Laplace transform in continious time:
51  *            1
52  * H(s) = ---------
53  *        1 + tau*s
54  *
55  * @param filter first order low pass filter structure
56  * @param tau time constant of the first order low pass filter
57  * @param sample_time sampling period of the signal
58  * @param value initial value of the filter
59  */
60 static inline void init_first_order_low_pass(struct FirstOrderLowPass *filter, float tau, const float sample_time,
61     float value)
62 {
63   filter->last_in = value;
64   filter->last_out = value;
65   filter->time_const = 2.0f * tau / sample_time;
66 }
67 
68 /** Update first order low pass filter state with a new value.
69  *
70  * @param filter first order low pass filter structure
71  * @param value new input value of the filter
72  * @return new filtered value
73  */
74 static inline float update_first_order_low_pass(struct FirstOrderLowPass *filter, const float value)
75 {
76   float out = (value + filter->last_in + (filter->time_const - 1.0f) * filter->last_out) / (1.0f + filter->time_const);
77   filter->last_in = value;
78   filter->last_out = out;
79   return out;
80 }
81 
82 /**
83  * @brief Reset the first order low-pass filter to a specific value.
84  *
85  * @param filter first order low pass filter structure
86  * @param value Value to reset the filter to
87  * @return The reset value
88  */
89 static inline float reset_first_order_low_pass(struct FirstOrderLowPass *filter, const float value)
90 {
91   filter->last_in = value;
92   filter->last_out = value;
93   return value;
94 }
95 
96 /** Get current value of the first order low pass filter.
97  *
98  * @param filter first order low pass filter structure
99  * @return current value of the filter
100  */
101 static inline float get_first_order_low_pass(const struct FirstOrderLowPass *filter)
102 {
103   return filter->last_out;
104 }
105 
106 /** Update time constant (tau parameter) for first order low pass filter
107  *
108  * @param filter first order low pass filter structure
109  * @param tau time constant of the first order low pass filter
110  * @param sample_time sampling period of the signal
111  */
112 static inline void update_first_order_low_pass_tau(struct FirstOrderLowPass *filter, const float tau,
113     const float sample_time)
114 {
115   filter->time_const = 2.0f * tau / sample_time;
116 }
117 
118 /** Second order low pass filter structure.
119  *
120  * using biquad filter with bilinear z transform
121  *
122  * http://en.wikipedia.org/wiki/Digital_biquad_filter
123  * http://www.earlevel.com/main/2003/03/02/the-bilinear-z-transform
124  *
125  * Laplace continious form:
126  *
127  *                 1
128  * H(s) = -------------------
129  *        s^2/w^2 + s/w*Q + 1
130  *
131  *
132  * Polynomial discrete form:
133  *
134  *        b0 + b1 z^-1 + b2 z^-2
135  * H(z) = ----------------------
136  *        a0 + a1 z^-1 + a2 z^-2
137  *
138  * with:
139  *  a0 = 1
140  *  a1 = 2*(K^2 - 1) / (K^2 + K/Q + 1)
141  *  a2 = (K^2 - K/Q + 1) / (K^2 + K/Q + 1)
142  *  b0 = K^2 / (K^2 + K/Q + 1)
143  *  b1 = 2*b0
144  *  b2 = b0
145  *  K = tan(pi*Fc/Fs) ~ pi*Fc/Fs = Ts/(2*tau)
146  *  Fc: cutting frequency
147  *  Fs: sampling frequency
148  *  Ts: sampling period
149  *  tau: time constant (tau = 1/(2*pi*Fc))
150  *  Q: gain at cutoff frequency
151  *
152  * Note that b[0]=b[2], so we don't need to save b[2]
153  */
154 struct SecondOrderLowPass {
155   float a[2]; ///< denominator gains
156   float b[2]; ///< numerator gains
157   float i[2]; ///< input history
158   float o[2]; ///< output history
159 };
160 
161 
162 /** Init second order low pass filter.
163  *
164  * @param filter second order low pass filter structure
165  * @param tau time constant of the second order low pass filter
166  * @param Q Q value of the second order low pass filter
167  * @param sample_time sampling period of the signal
168  * @param value initial value of the filter
169  */
170 static inline void init_second_order_low_pass(struct SecondOrderLowPass *filter, const float tau, const float Q,
171     const float sample_time,
172     float value)
173 {
174   float K = tanf(sample_time / (2.0f * tau));
175   float poly = K * K + K / Q + 1.0f;
176   filter->a[0] = 2.0f * (K * K - 1.0f) / poly;
177   filter->a[1] = (K * K - K / Q + 1.0f) / poly;
178   filter->b[0] = K * K / poly;
179   filter->b[1] = 2.0f * filter->b[0];
180   filter->i[0] = filter->i[1] = filter->o[0] = filter->o[1] = value;
181 }
182 
183 /**
184  * @brief Reset the second order low-pass filter to a specific value.
185  *
186  * @param filter second order low pass filter structure
187  * @param value Value to reset the filter to
188  * @return The reset value
189  */
190 static inline float reset_second_order_low_pass(struct SecondOrderLowPass *filter, const float value)
191 {
192   filter->i[0] = filter->i[1] = filter->o[0] = filter->o[1] = value;
193   return value;
194 }
195 
196 /** Update second order low pass filter state with a new value.
197  *
198  * @param filter second order low pass filter structure
199  * @param value new input value of the filter
200  * @return new filtered value
201  */
202 static inline float update_second_order_low_pass(struct SecondOrderLowPass *filter, const float value)
203 {
204   float out = filter->b[0] * value
205               + filter->b[1] * filter->i[0]
206               + filter->b[0] * filter->i[1]
207               - filter->a[0] * filter->o[0]
208               - filter->a[1] * filter->o[1];
209   filter->i[1] = filter->i[0];
210   filter->i[0] = value;
211   filter->o[1] = filter->o[0];
212   filter->o[0] = out;
213   return out;
214 }
215 
216 /** Get current value of the second order low pass filter.
217  *
218  * @param filter second order low pass filter structure
219  * @return current value of the filter
220  */
221 static inline float get_second_order_low_pass(const struct SecondOrderLowPass *filter)
222 {
223   return filter->o[0];
224 }
225 
226 struct SecondOrderLowPass_int {
227   int32_t a[2]; ///< denominator gains
228   int32_t b[2]; ///< numerator gains
229   int32_t i[2]; ///< input history
230   int32_t o[2]; ///< output history
231   int32_t loop_gain; ///< loop gain
232 };
233 
234 /** Init second order low pass filter(fixed point version).
235  *
236  * @param filter second order low pass filter structure
237  * @param cut_off Cutoff frequency of the filter with -3dB
238  * @param Q Q value of the second order low pass filter
239  * @param sample_time sampling period of the signal
240  * @param value initial value of the filter
241  */
242 static inline void init_second_order_low_pass_int(struct SecondOrderLowPass_int *filter, const float cut_off,
243     const float Q,
244     float sample_time, int32_t value)
245 {
246   struct SecondOrderLowPass filter_temp;
247   float tau = 7.0f / (44.0f * cut_off);
248   float K = sample_time / (2.0f * tau);
249   float poly = K * K + K / Q + 1.0f;
250   float loop_gain_f;
251 
252   filter_temp.a[0] = 2.0f * (K * K - 1.0f) / poly;
253   filter_temp.a[1] = (K * K - K / Q + 1.0f) / poly;
254   filter_temp.b[0] = K * K / poly;
255   filter_temp.b[1] = 2.0f * filter_temp.b[0];
256   loop_gain_f = 1.0f / filter_temp.b[0];
257 
258   filter->a[0] = BFP_OF_REAL((filter_temp.a[0] * loop_gain_f), INT32_FILT_FRAC);
259   filter->a[1] = BFP_OF_REAL((filter_temp.a[1] * loop_gain_f), INT32_FILT_FRAC);
260   filter->b[0] = BFP_OF_REAL(1, INT32_FILT_FRAC);
261   filter->b[1] = 2 * filter->b[0];
262   filter->i[0] = filter->i[1] = filter->o[0] = filter->o[1] = value;
263   filter->loop_gain = BFP_OF_REAL(loop_gain_f, INT32_FILT_FRAC);
264 }
265 
266 /** Update second order low pass filter state with a new value(fixed point version).
267  *
268  * @param filter second order low pass filter structure
269  * @param value new input value of the filter
270  * @return new filtered value
271  */
272 static inline int32_t update_second_order_low_pass_int(struct SecondOrderLowPass_int *filter, const int32_t value)
273 {
274   int32_t out = filter->b[0] * value
275                 + filter->b[1] * filter->i[0]
276                 + filter->b[0] * filter->i[1]
277                 - filter->a[0] * filter->o[0]
278                 - filter->a[1] * filter->o[1];
279 
280   filter->i[1] = filter->i[0];
281   filter->i[0] = value;
282   filter->o[1] = filter->o[0];
283   filter->o[0] = out / (filter->loop_gain);
284   return filter->o[0];
285 }
286 
287 /** Get current value of the second order low pass filter(fixed point version).
288  *
289  * @param filter second order low pass filter structure
290  * @return current value of the filter
291  */
292 static inline int32_t get_second_order_low_pass_int(const struct SecondOrderLowPass_int *filter)
293 {
294   return filter->o[0];
295 }
296 
297 /** Second order Butterworth low pass filter.
298  */
299 typedef struct SecondOrderLowPass Butterworth2LowPass;
300 
301 /** Init a second order Butterworth filter.
302  *
303  * based on the generic second order filter
304  * with Q = 0.7071 = 1/sqrt(2)
305  *
306  * http://en.wikipedia.org/wiki/Butterworth_filter
307  *
308  * @param filter second order Butterworth low pass filter structure
309  * @param tau time constant of the second order low pass filter
310  * @param sample_time sampling period of the signal
311  * @param value initial value of the filter
312  */
313 static inline void init_butterworth_2_low_pass(Butterworth2LowPass *filter, const float tau, const float sample_time,
314     const float value)
315 {
316   init_second_order_low_pass((struct SecondOrderLowPass *)filter, tau, 0.7071, sample_time, value);
317 }
318 
319 /** Update second order Butterworth low pass filter state with a new value.
320  *
321  * @param filter second order Butterworth low pass filter structure
322  * @param value new input value of the filter
323  * @return new filtered value
324  */
325 static inline float update_butterworth_2_low_pass(Butterworth2LowPass *filter, const float value)
326 {
327   return update_second_order_low_pass((struct SecondOrderLowPass *)filter, value);
328 }
329 
330 /**
331  * @brief Reset a Butterworth low-pass filter to a specific value.
332  *
333  * @param[out] filter Butterworth2LowPass filter instance to reset.
334  * @param[in] value Value to reset the filter to.
335  * @return The reset value.
336  */
