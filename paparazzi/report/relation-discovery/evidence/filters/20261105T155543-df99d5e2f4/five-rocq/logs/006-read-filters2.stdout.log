39 struct FirstOrderLowPassVect3 {
40   struct FirstOrderLowPass x;
41   struct FirstOrderLowPass y;
42   struct FirstOrderLowPass z;
43 };
44 
45 /**
46  * @brief Initialize a set of first order low-pass filters to zero for 3D vector data.
47  *
48  * @param[out] filter Struct containing first order low-pass filters for x, y, z components.
49  * @param[in] omega Cut-off frequencies for the filters (rad/s).
50  * @param[in] dt Sampling time interval (seconds).
51  */
52 static inline void init_first_order_low_pass_vect3(struct FirstOrderLowPassVect3 *filter,
53     const struct FloatVect3 *omega, const float dt)
54 {
55   init_first_order_low_pass(&filter->x, 1.0f / omega->x, dt, 0.0f);
56   init_first_order_low_pass(&filter->y, 1.0f / omega->y, dt, 0.0f);
57   init_first_order_low_pass(&filter->z, 1.0f / omega->z, dt, 0.0f);
58 }
59 
60 /**
61  * @brief Retrieve the filtered output from 3D vector first order low-pass filters.
62  *
63  * @param[in] filter Struct containing first order low-pass filters for x, y, z components.
64  * @return FloatVect3 struct containing the filtered output values.
65  */
66 static inline struct FloatVect3 get_first_order_low_pass_vect3(const struct FirstOrderLowPassVect3 *filter)
67 {
68   struct FloatVect3 output;
69   output.x = get_first_order_low_pass(&filter->x);
70   output.y = get_first_order_low_pass(&filter->y);
71   output.z = get_first_order_low_pass(&filter->z);
72   return output;
73 }
74 
75 /**
76  * @brief Retrieve the filtered output from 3D vector first order low-pass filters.
77  *
78  * @param[in] filter Struct containing first order low-pass filters for x, y, z components.
79  * @return FloatRates struct containing the filtered output rate values.
80  */
81 static inline struct FloatRates get_first_order_low_pass_rates(const struct FirstOrderLowPassVect3 *filter)
82 {
83   struct FloatRates output;
84   output.p = get_first_order_low_pass(&filter->x);
85   output.q = get_first_order_low_pass(&filter->y);
86   output.r = get_first_order_low_pass(&filter->z);
87   return output;
88 }
89 
90 /**
91  * @brief Update 3D vector first order low-pass filters with new input data.
92  *
93  * @param[in,out] filter Struct containing first order low-pass filters for x, y, z components.
94  * @param[in] input Pointer to FloatVect3 struct containing new input data.
95  */
96 static inline struct FloatVect3 update_first_order_low_pass_vect3(struct FirstOrderLowPassVect3 *filter,
97     const struct FloatVect3 *input)
98 {
99   update_first_order_low_pass(&filter->x, input->x);
100   update_first_order_low_pass(&filter->y, input->y);
101   update_first_order_low_pass(&filter->z, input->z);
102   return get_first_order_low_pass_vect3(filter);
103 }
104 
105 /**
106  * @brief Update 3D vector first order low-pass filters with new rate input data.
