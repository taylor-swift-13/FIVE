108  * @param[in,out] filter Struct containing first order low-pass filters for x, y, z components.
109  * @param[in] input Pointer to FloatRates struct containing new input rate data.
110  */
111 static inline struct FloatRates update_first_order_low_pass_rates(struct FirstOrderLowPassVect3 *filter,
112     const struct FloatRates *input)
113 {
114   update_first_order_low_pass(&filter->x, input->p);
115   update_first_order_low_pass(&filter->y, input->q);
116   update_first_order_low_pass(&filter->z, input->r);
117   return get_first_order_low_pass_rates(filter);
118 }
