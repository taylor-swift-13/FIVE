21 /** @file filters/pid.h
22  *  @brief Several forms of PID controllers
23  *
24  */
25 
26 #ifndef PID_H
27 #define PID_H
28 
29 /** Simple PID structure
30  *  floating point
31  *
32  * u_k = Kp * e_k + Kd * (e_k - e_k-1) / dt + Ki * (sum (e_k * dt))
33  *
34  * with:
35  *  u = outputs
36  *  e = inputs
37  *  Kp = proportional gain
38  *  Kd = derivative gain
39  *  Ki = integral gain
40  *  dt = time since last input
41  */
42 struct PID_f {
43   float u;        ///< output
44   float e[2];     ///< input
45   float sum;      ///< integral of input
46   float g[3];     ///< controller gains (Kp, Kd, Ki)
47   float max_sum;  ///< windup protection, max of Ki * sum(e_k * dt)
48 };
49 
50 static inline void init_pid_f(struct PID_f *pid, float Kp, float Kd, float Ki, float max_sum)
51 {
52   *pid = (struct PID_f) {
53     0.f,
54     { 0.f , 0.f },
55     0.f,
56     { Kp, Kd, Ki },
57     max_sum
58   };
59 }
60 
61 /** Update PID with a new value and return new command.
62  *
63  * @param pid pointer to PID structure
64  * @param value new input value of the PID
65  * @param dt time since last input (in seconds)
66  * @return new output command
67  */
68 static inline float update_pid_f(struct PID_f *pid, float value, float dt)
69 {
70   pid->e[1] = pid->e[0];
71   pid->e[0] = value;
72   float integral = pid->g[2] * (pid->sum + value);
73   if (integral > pid->max_sum) {
74     integral = pid->max_sum;
75   } else if (integral < -pid->max_sum) {
76     integral = -pid->max_sum;
77   } else {
78     pid->sum += value;
79   }
80   pid->u = pid->g[0] * pid->e[0] + pid->g[1] * (pid->e[0] - pid->e[1]) / dt + integral;
81   return pid->u;
82 }
83 
84 /** Get current value of the PID command.
85  *
86  * @param pid pointer to PID structure
87  * @return current value of PID command
88  */
89 static inline float get_pid_f(struct PID_f *pid)
90 {
91   return pid->u;
92 }
93 
94 /** Reset PID struture, gains left unchanged.
95  *
96  * @param pid pointer to PID structure
97  */
98 static inline void reset_pid_f(struct PID_f *pid)
99 {
100   pid->u = 0.f;
101   pid->e[0] = 0.f;
102   pid->e[1] = 0.f;
103   pid->sum = 0.f;
104 }
105 
106 /** Set gains of the PID struct.
107  *
108  * @param pid pointer to PID structure
109  * @param Kp proportional gain
110  * @param Kd derivative gain
111  * @param Ki integral gain
112  */
113 static inline void set_gains_pid_f(struct PID_f *pid, float Kp, float Kd, float Ki)
114 {
115   pid->g[0] = Kp;
116   pid->g[1] = Kd;
117   pid->g[2] = Ki;
118 }
119 
120 /** Set integral part, can be used to reset.
121  *  The new sum of errors is calculated from current gains and bounds.
122  *
123  * @param pid pointer to PID structure
124  * @param value integral part of the PID control, 0. will reset it
125  */
126 static inline void set_integral_pid_f(struct PID_f *pid, float value)
127 {
128   float integral = value;
129   if (integral < -pid->max_sum) {
130     integral = -pid->max_sum;
131   } else if (integral > pid->max_sum) {
132     integral = pid->max_sum;
133   }
134   if (fabsf(pid->g[2]) < 1e-6) {
135     pid->sum = 0.f; // integral gain is too low, prevent division by zero, just reset sum
136   } else {
137     pid->sum = integral / pid->g[2];
138   }
139 }
140 
141 
142 
143 /** Distcrete time PID structure.
144  *  floating point, fixed frequency.
145  *
146  * u_k = u_k-1 + a * e_k  + b * e_k-1 + c * e_k-2
147  *
148  * with:
149  *  u = outputs
150  *  e = inputs
151  *  a = Kp + Ki Ts/2 + Kd/Ts
152  *  b = -Kp + Ki Ts/2 - 2 Kd/Ts
153  *  c = Kd/Ts
154  *  Kp = proportional gain
155  *  Kd = derivative gain
156  *  Ki = integral gain
157  *  Ts = sampling frequency
158  *
159  */
160 struct PID_df {
161   float u[2]; ///< output
162   float e[3]; ///< input
163   float g[3]; ///< controller gains
164 };
165 
166 /** Init PID struct.
167  *
168  * @param pid pointer to PID structure
169  * @param Kp proportional gain
170  * @param Kd derivative gain
171  * @param Ki integral gain
172  * @param Ts sampling time
173  */
174 static inline void init_pid_df(struct PID_df *pid, float Kp, float Kd, float Ki, float Ts)
175 {
176   *pid = (struct PID_df) {
177     { 0.f, 0.f },
178     { 0.f ,0.f , 0.f },
179     { Kp + Ki * Ts / 2.f + Kd / Ts,
180      -Kp + Ki * Ts / 2.f - 2.f * Kd / Ts,
181       Kd / Ts }
182   };
183 }
184 
185 /** Update PID with a new value and return new command.
186  *
187  * @param pid pointer to PID structure
188  * @param value new input value of the PID
189  * @return new output command
190  */
191 static inline float update_pid_df(struct PID_df *pid, float value)
192 {
193   pid->e[2] = pid->e[1];
194   pid->e[1] = pid->e[0];
195   pid->e[0] = value;
196   pid->u[1] = pid->u[0];
197   pid->u[0] = pid->u[1] + pid->g[0] * pid->e[0] + pid->g[1] * pid->e[1] + pid->g[2] * pid->e[2];
198   return pid->u[0];
199 }
200 
201 /** Get current value of the PID command.
202  *
203  * @param pid pointer to PID structure
204  * @return current value of PID command
205  */
206 static inline float get_pid_df(struct PID_df *pid)
207 {
208   return pid->u[0];
209 }
210 
211 /** Reset PID struture, gains left unchanged.
212  *
213  * @param pid pointer to PID structure
214  */
215 static inline void reset_pid_df(struct PID_df *pid)
216 {
217   pid->u[0] = 0.f;
218   pid->u[1] = 0.f;
219   pid->e[0] = 0.f;
220   pid->e[1] = 0.f;
221   pid->e[2] = 0.f;
222 }
223 
224 /** Set gains of the PID struct.
225  *
226  * @param pid pointer to PID structure
227  * @param Kp proportional gain
228  * @param Kd derivative gain
229  * @param Ki integral gain
230  * @param Ts sampling time
231  */
232 static inline void set_gains_pid_df(struct PID_df *pid, float Kp, float Kd, float Ki, float Ts)
233 {
234   pid->g[0] = Kp + Ki * Ts / 2.f + Kd / Ts;
235   pid->g[1] = -Kp + Ki * Ts / 2.f - 2.f * Kd / Ts;
236   pid->g[2] = Kd / Ts;
237 }
238 
239 /** Distcrete time PI-D structure.
240  *  derivative term is directly provided as input
241  *  as it may be available directly from a sensor
242  *  or estimated separately.
243  *  floating point, fixed frequency.
244  *
245  * u_k = u_k-1 + a * e_k  + b * e_k-1 + Kd * d_k
246  *
247  * with:
248  *  u = outputs
249  *  e = inputs
250  *  d = derivative of input
251  *  a = Kp + Ki Ts/2
252  *  b = -Kp + Ki Ts/2
253  *  Kp = proportional gain
254  *  Kd = derivative gain
255  *  Ki = integral gain
256  *  Ts = sampling frequency
257  *
258  */
259 struct PI_D_df {
260   float u[2]; ///< output
261   float e[2]; ///< input
262   float g[3]; ///< controller gains
263 };
264 
265 /** Init PI-D struct.
266  *
267  * @param pid pointer to PID structure
268  * @param Kp proportional gain
269  * @param Kd derivative gain
270  * @param Ki integral gain
271  * @param Ts sampling time
272  */
273 static inline void init_pi_d_df(struct PI_D_df *pid, float Kp, float Kd, float Ki, float Ts)
274 {
275   *pid = (struct PI_D_df) {
276     { 0.f, 0.f },
277     { 0.f ,0.f },
278     { Kp + Ki * Ts / 2.f,
279      -Kp + Ki * Ts / 2.f,
280       Kd }
281   };
282 }
283 
284 /** Update PI-D with a new value and return new command.
285  *
286  * @param pid pointer to PI-D structure
287  * @param value new input value of the PI-D
288  * @param deriv new input derivative
289  * @return new output command
290  */
291 static inline float update_pi_d_df(struct PI_D_df *pid, float value, float deriv)
292 {
293   pid->e[1] = pid->e[0];
294   pid->e[0] = value;
295   pid->u[1] = pid->u[0];
296   pid->u[0] = pid->u[1] + pid->g[0] * pid->e[0] + pid->g[1] * pid->e[1] + pid->g[2] * deriv;
297   return pid->u[0];
298 }
299 
300 /** Get current value of the PI-D command.
301  *
302  * @param pid pointer to PI-D structure
303  * @return current value of PI-D command
304  */
305 static inline float get_pi_d_df(struct PI_D_df *pid)
306 {
307   return pid->u[0];
308 }
309 
310 /** Reset PI-D struture, gains left unchanged.
311  *
312  * @param pid pointer to PI-D structure
313  */
314 static inline void reset_pi_d_df(struct PI_D_df *pid)
315 {
316   pid->u[0] = 0.f;
317   pid->u[1] = 0.f;
318   pid->e[0] = 0.f;
319   pid->e[1] = 0.f;
320 }
321 
322 /** Set gains PI-D struct.
323  *
324  * @param pid pointer to PID structure
325  * @param Kp proportional gain
326  * @param Kd derivative gain
327  * @param Ki integral gain
328  * @param Ts sampling time
329  */
330 static inline void set_gains_pi_d_df(struct PI_D_df *pid, float Kp, float Kd, float Ki, float Ts)
331 {
332   pid->g[0] = Kp + Ki * Ts / 2.f;
333   pid->g[1] = -Kp + Ki * Ts / 2.f;
334   pid->g[2] = Kd;
335 }
336 
337 #endif
