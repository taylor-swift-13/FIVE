396 /** Fourth order Butterworth low pass filter.
397  *
398  * using two cascaded second order filters
399  */
400 typedef struct {
401   struct SecondOrderLowPass lp1;
402   struct SecondOrderLowPass lp2;
403 } Butterworth4LowPass;
404 
405 /** Init a fourth order Butterworth filter.
406  *
407  * based on two generic second order filters
408  * with Q1 = 1.30651
409  *  and Q2 = 0.541184
410  *
411  * http://en.wikipedia.org/wiki/Butterworth_filter
412  *
413  * @param filter fourth order Butterworth low pass filter structure
414  * @param tau time constant of the fourth order low pass filter
415  * @param sample_time sampling period of the signal
416  * @param value initial value of the filter
417  */
418 static inline void init_butterworth_4_low_pass(Butterworth4LowPass *filter, const float tau, const float sample_time,
419     const float value)
420 {
421   init_second_order_low_pass(&filter->lp1, tau, 1.30651, sample_time, value);
422   init_second_order_low_pass(&filter->lp2, tau, 0.51184, sample_time, value);
423 }
424 
425 /** Update fourth order Butterworth low pass filter state with a new value.
426  *
427  * using two cascaded second order filters
428  *
429  * @param filter fourth order Butterworth low pass filter structure
430  * @param value new input value of the filter
431  * @return new filtered value
432  */
433 static inline float update_butterworth_4_low_pass(Butterworth4LowPass *filter, const float value)
434 {
435   float tmp = update_second_order_low_pass(&filter->lp1, value);
436   return update_second_order_low_pass(&filter->lp2, tmp);
437 }
438 
439 /** Get current value of the fourth order Butterworth low pass filter.
440  *
441  * @param filter fourth order Butterworth low pass filter structure
442  * @return current value of the filter
443  */
444 static inline float get_butterworth_4_low_pass(const Butterworth4LowPass *filter)
445 {
446   return filter->lp2.o[0];
447 }
