148 /**
149  * @brief Initialize an array of first order low-pass filters.
150  *
151  * @param n Number of filters in the array.
152  * @param filter_array Array of FirstOrderLowPass filters to initialize.
153  * @param omega Cut-off frequencies for the filters (rad/s).
154  * @param dt Sampling time interval (seconds).
155  */
156 static inline void init_first_order_low_pass_array(const uint8_t n, struct FirstOrderLowPass filter_array[restrict n],
157     const float omega[restrict n], const float dt)
158 {
159   for (uint8_t i = 0; i < n; i++) {
160     init_first_order_low_pass(&filter_array[i], 1.0f / omega[i], dt, 0.0f);
161   }
162 }
163 
164 /**
165  * @brief Update an array of first order low-pass filters.
166  *
167  * @param n Number of filters in the array.
168  * @param filter_array Array of FirstOrderLowPass filters to update.
169  * @param input_array Array of input values for the filters.
170  */
171 static inline void update_first_order_low_pass_array(const uint8_t n, struct FirstOrderLowPass filter_array[restrict n],
172     const float input_array[restrict n])
173 {
174   for (uint8_t i = 0; i < n; i++) {
175     update_first_order_low_pass(&filter_array[i], input_array[i]);
176   }
177 }
178 
179 /**
180  * @brief Reset an array of first order low-pass filters to specific values.
181  *
182  * @param n Number of filters in the array.
183  * @param filter_array Array of FirstOrderLowPass filters to reset.
184  * @param value_array Array of values to reset the filters to.
185  */
186 static inline void reset_first_order_low_pass_array(const uint8_t n, struct FirstOrderLowPass filter_array[restrict n],
187     const float value_array[restrict n])
188 {
189   for (uint8_t i = 0; i < n; i++) {
190     reset_first_order_low_pass(&filter_array[i], value_array[i]);
191   }
192 }
193 
194 /**
195  * @brief Retrieve the filtered outputs from an array of first order low-pass filters.
196  *
197  * @param n Number of filters in the array.
198  * @param filter_array Array of FirstOrderLowPass filters.
199  * @param output_array Array to store the filtered output values.
200  */
201 static inline void get_first_order_low_pass_array(const uint8_t n,
202     const struct FirstOrderLowPass filter_array[restrict n], float output_array[restrict n])
203 {
204   for (uint8_t i = 0; i < n; i++) {
205     output_array[i] = get_first_order_low_pass(&filter_array[i]);
206   }
207 }
