403  *
404  * @param[in] filter Struct containing Butterworth filters for x, y, z components.
405  * @return FloatVect3 struct containing the filtered output values.
406  */
407 static inline struct FloatVect3 get_butterworth_4_low_pass_vect3(const struct Butterworth4LowPassVect3 *filter)
408 {
409   struct FloatVect3 output;
410   output.x = get_butterworth_4_low_pass(&filter->x);
411   output.y = get_butterworth_4_low_pass(&filter->y);
412   output.z = get_butterworth_4_low_pass(&filter->z);
413   return output;
414 }
415 
416 /**
417  * @brief Retrieve the filtered output from a Butterworth low-pass filter.
418  *
419  * @param[in] filter Butterworth4LowPass filter instance.
420  * @return Filtered output value.
421  */
422 static inline struct FloatRates get_butterworth_4_low_pass_rates(const struct Butterworth4LowPassVect3 *filter)
423 {
424   struct FloatRates output;
425   output.p = get_butterworth_4_low_pass(&filter->x);
426   output.q = get_butterworth_4_low_pass(&filter->y);
427   output.r = get_butterworth_4_low_pass(&filter->z);
428   return output;
429 }
430 
431 /**
432  * @brief Update 3D vector Butterworth filters with new input data.
433  *
434  * @param[in,out] filter Struct containing Butterworth filters for x, y, z components.
435  * @param[in] input Pointer to FloatVect3 struct containing new input data.
436  */
437 static inline struct FloatVect3 update_butterworth_4_low_pass_vect3(struct Butterworth4LowPassVect3 *filter,
438     const struct FloatVect3 *input)
439 {
440   update_butterworth_4_low_pass(&filter->x, input->x);
441   update_butterworth_4_low_pass(&filter->y, input->y);
442   update_butterworth_4_low_pass(&filter->z, input->z);
443   return get_butterworth_4_low_pass_vect3(filter);
444 }
445 
446 /**
447  * @brief Update 3D vector Butterworth filters with new rate input data.
448  *
449  * @param[in,out] filter Struct containing Butterworth filters for x, y, z components.
450  * @param[in] input Pointer to FloatRates struct containing new input rate data.
451  */
452 static inline struct FloatRates update_butterworth_4_low_pass_rates(struct Butterworth4LowPassVect3 *filter,
453     const struct FloatRates *input)
454 {
455   update_butterworth_4_low_pass(&filter->x, input->p);
456   update_butterworth_4_low_pass(&filter->y, input->q);
457   update_butterworth_4_low_pass(&filter->z, input->r);
458   return get_butterworth_4_low_pass_rates(filter);
459 }
460 
461 /**
462  * @brief Reset 3D vector Butterworth filters to a specific value.
463  *
464  * @param[out] filter Struct containing Butterworth filters for x, y, z components.
465  * @param[in] value Pointer to FloatVect3 struct containing the reset value.
466  */
467 static inline void reset_butterworth_4_low_pass_vect3(struct Butterworth4LowPassVect3 *filter,
468     const struct FloatVect3 *value)
469 {
470   reset_butterworth_4_low_pass(&filter->x, value->x);
471   reset_butterworth_4_low_pass(&filter->y, value->y);
472   reset_butterworth_4_low_pass(&filter->z, value->z);
473 }
474 
475 /**
476  * @brief Reset 3D vector Butterworth filters to specific rate values.
477  *
478  * @param[out] filter Struct containing Butterworth filters for x, y, z components.
479  * @param[in] value Pointer to FloatRates struct containing the reset values.
480  */
481 static inline void reset_butterworth_4_low_pass_rates(struct Butterworth4LowPassVect3 *filter,
482     const struct FloatRates *value)
483 {
484   reset_butterworth_4_low_pass(&filter->x, value->p);
485   reset_butterworth_4_low_pass(&filter->y, value->q);
486   reset_butterworth_4_low_pass(&filter->z, value->r);
487 }
488 
489 /**
490  * @brief Initialize an array of Butterworth low-pass filters to zero.
491  *
492  * @param[in] n Number of filters to initialize.
493  * @param[out] filter_array Array of Butterworth4LowPass filters to initialize.
494  * @param[in] omega Cut-off frequencies for the filters (rad/s).
495  * @param[in] dt Sampling time interval (seconds).
496  */
497 static inline void init_butterworth_4_low_pass_array(const uint8_t n, Butterworth4LowPass filter_array[restrict n],
498     const float omega[restrict n], const float dt)
499 {
500   for (uint8_t i = 0; i < n; i++) {
501     init_butterworth_4_low_pass(&filter_array[i], 1.0f / omega[i], dt, 0.0f);
502   }
503 }
504 
505 /**
506  * @brief Update an array of Butterworth low-pass filters with new input data.
507  *
508  * @param[in] n Number of filters in the array.
509  * @param[in,out] filter_array Array of Butterworth4LowPass filters to update.
510  * @param[in] input_array Array containing new input data for each filter.
511  */
512 static inline void update_butterworth_4_low_pass_array(const uint8_t n, Butterworth4LowPass filter_array[restrict n],
513     const float input_array[restrict n])
514 {
515   for (uint8_t i = 0; i < n; i++) {
516     update_butterworth_4_low_pass(&filter_array[i], input_array[i]);
517   }
518 }
519 
520 /**
521  * @brief Reset an array of Butterworth low-pass filters to specific values.
522  *
523  * @param[in] n Number of filters in the array.
524  * @param[out] filter_array Array of Butterworth4LowPass filters to reset.
525  * @param[in] value_array Array containing reset values for each filter.
526  */
527 static inline void reset_butterworth_4_low_pass_array(const uint8_t n, Butterworth4LowPass filter_array[restrict n],
528     const float value_array[restrict n])
529 {
530   for (uint8_t i = 0; i < n; i++) {
531     reset_butterworth_4_low_pass(&filter_array[i], value_array[i]);
532   }
533 }
534 
535 /**
536  * @brief Retrieve the filtered outputs from an array of Butterworth low-pass filters.
537  *
538  * @param[in] n Number of filters in the array.
539  * @param[in] filter_array Array of Butterworth4LowPass filters.
540  * @param[out] output_array Array to store the filtered output values.
541  */
542 static inline void get_butterworth_4_low_pass_array(const uint8_t n, const Butterworth4LowPass filter_array[restrict n],
543     float output_array[restrict n])
544 {
545   for (uint8_t i = 0; i < n; i++) {
546     output_array[i] = get_butterworth_4_low_pass(&filter_array[i]);
547   }
548 }
