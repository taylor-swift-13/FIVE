363  * @param filter second order Butterworth low pass filter structure
364  * @param cut_off Cutoff frequency of the filter with -3dB
365  * @param sample_time sampling period of the signal
366  * @param value initial value of the filter
367  */
368 static inline void init_butterworth_2_low_pass_int(Butterworth2LowPass_int *filter, const float cut_off,
369     const float sample_time,
370     int32_t value)
371 {
372   init_second_order_low_pass_int((struct SecondOrderLowPass_int *)filter, cut_off, 0.7071, sample_time, value);
373 }
