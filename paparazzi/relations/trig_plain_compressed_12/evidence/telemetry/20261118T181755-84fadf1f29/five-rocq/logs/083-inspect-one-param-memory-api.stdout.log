161-(** Selection of the appropriate case of a [switch], given the value [n]
162-  of the selector expression. *)
163-
164-Fixpoint select_switch_default (sl: labeled_statements): labeled_statements :=
165-  match sl with
166-  | LSnil => sl
167-  | LScons None s sl' => sl
168-  | LScons (Some i) s sl' => select_switch_default sl'
169-  end.
170-
171-Fixpoint select_switch_case (n: Z) (sl: labeled_statements): option labeled_statements :=
172-  match sl with
173-  | LSnil => None
174-  | LScons None s sl' => select_switch_case n sl'
