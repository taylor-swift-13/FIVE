            | _ => None
            end
        | cast_case_void => Some v
        | cast_case_default => None
        end
      with
      | Some v1' =>
          match
            match
              (if Archi.ptr64
               then cast_case_i2i I32 Signed
               else cast_case_pointer)
            with
            | cast_case_pointer =>
                if Archi.ptr64 then None else Some (Vint (Int.repr 15))
            | cast_case_i2i sz2 si2 =>
                Some
                  (Vint
                     match sz2 with
                     | I8 =>
                         match si2 with
                         | Signed => Int.sign_ext 8 (Int.repr 15)
                         | Unsigned => Int.zero_ext 8 (Int.repr 15)
                         end
                     | I16 =>
                         match si2 with
                         | Signed => Int.sign_ext 16 (Int.repr 15)
                         | Unsigned => Int.zero_ext 16 (Int.repr 15)
                         end
                     | I32 => Int.repr 15
                     | IBool =>
                         if Int.eq (Int.repr 15) Int.zero
                         then Int.zero
                         else Int.one
                     end)
            | cast_case_i2f si1 =>
                Some (Vfloat (cast_int_float si1 (Int.repr 15)))
            | cast_case_i2s si1 =>
                Some (Vsingle (cast_int_single si1 (Int.repr 15)))
            | cast_case_i2l si =>
                Some (Vlong (cast_int_long si (Int.repr 15)))
            | cast_case_i2bool =>
                Some
                  (Vint
                     (if Int.eq (Int.repr 15) Int.zero
                      then Int.zero
                      else Int.one))
            | cast_case_void => Some (Vint (Int.repr 15))
            | _ => None
            end
          with
          | Some v2' =>
              match v1' with
              | Vint n1 =>
                  match v2' with
                  | Vint n2 => Some (Vint (Int.and n1 n2))
                  | _ => None
                  end
              | _ => None
              end
          | None => None
          end
      | None => None
      end
  | None => None
  end = nibble_machine p x
