408:Theorem find_def_symbol:
410:  (prog_defmap p)!id = Some g <-> exists b, find_symbol (globalenv p) id = Some b /\ find_def (globalenv p) b = Some g.
413:  set (P := fun m ge => m!id = Some g <-> exists b, find_symbol ge id = Some b /\ find_def ge b = Some g).
420:  - apply IHl. unfold P, add_global, find_symbol, find_def; simpl.
431:  apply REC. unfold P, find_symbol, find_def; simpl.
