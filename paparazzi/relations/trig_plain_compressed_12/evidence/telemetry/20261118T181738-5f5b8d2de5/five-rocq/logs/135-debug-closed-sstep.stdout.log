17 goals
  
  ge : genv
  allowed : function -> Prop
  ids : list ident
  allowed_locals :
    forall f : function,
    allowed f ->
    Forall (fun p : ident * type => ~ In (fst p) ids)
      (fn_params f ++ fn_vars f)
  allowed_bodies :
    forall f : function,
    allowed f -> forall e : env, unshadowed e -> closed_stmt e (fn_body f)
  f : function
  x : expr
  k : cont
  e : env
  m : mem
  STEP : sstep ge (State f (Sdo x) k e m) E0 (ExprState f x (Kdo k) e m)
  H : allowed f
  H0 : unshadowed e
  H1 : closed_expr e x
  H2 : closed_cont e k
  ============================
  allowed f /\ unshadowed e /\ closed_expr e x /\ closed_cont e k

