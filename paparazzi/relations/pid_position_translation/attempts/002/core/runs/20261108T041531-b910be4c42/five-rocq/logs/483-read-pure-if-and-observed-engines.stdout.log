
FILE paparazzi/relations/guidance_mode/support/allorder/PureIfShell.v
From Stdlib Require Import Bool List Classical.
From compcert Require Import Coqlib Maps AST Values Memory Events Ctypes Cop Csyntax Csem Cstrategy Smallstep.
From FiveGuidanceAllOrder Require Import PureSyntax PureDenotation PureProgress CallfreeExecution PhaseComposition.
Section IF_SHELL.
Variable ge:genv.
Variable f:function.
Variable e:env.
Variable k:cont.
Variable m:mem.
Variable condition:expr.
Variable yes no:statement.
Variable value:val.
Variable taken:bool.
Hypothesis condition_simple:simple condition=true.
Hypothesis condition_value:pure_rval ge e m condition=Some value.
Hypothesis condition_bool:bool_val value(typeof condition)m=Some taken.
Definition target:Csem.state:=State f(if taken then yes else no)k e m.
Definition invariant(s:Csem.state):Prop:=
 s=State f(Sifthenelse condition yes no)k e m \/
 (exists residual,s=ExprState f residual(Kifthenelse yes no k)e m /\
 typeof residual=typeof condition /\simple residual=true /\pure_rval ge e m residual=Some value) \/s=target.
Lemma initial:invariant(State f(Sifthenelse condition yes no)k e m).
Proof. left;reflexivity. Qed.
Theorem all_successors:forall s t next,invariant s->s<>target->Csem.step ge s t next->invariant next.
Proof.
 intros s t next[START|[EXPR|DONE]]NF STEP.
 - subst s;destruct STEP as[ES|SS];[inversion ES|].
   inversion SS;subst;
   try solve[right;left;exists condition;repeat split;auto];
   repeat match goal with H:_ \/ _|-_=>destruct H end;discriminate.
 - destruct EXPR as[a[EQ[TY[SI VAL]]]];subst s.
   destruct STEP as[ES|SS].
   + destruct(simple_estep ge f a(Kifthenelse yes no k)e m t next SI ES)as[BAD|[a'[EQ[TA[SA DEN]]]]].
     * subst next;inversion ES;subst;exfalso.
       match goal with N:~imm_safe _ _ _ _ _,CT:Csem.context _ _ _|-_=>
       apply N;pose proof(pure_not_stuck ge e m _ value SI VAL)as NS;exact(NS _ _ _ CT eq_refl)end.
     * subst next;right;left;exists a';repeat split;auto;congruence.
   + inversion SS;subst.
     cbn[pure_rval]in VAL;injection VAL as EQ.
     cbn[typeof]in TY.
     match goal with B:bool_val _ _ _=Some _|-_=>
     rewrite EQ,TY in B;rewrite condition_bool in B;injection B as EQB end.
     right;right;unfold target;rewrite <-EQB;reflexivity.
 - contradiction.
Qed.
Theorem progress:forall s,invariant s->s=target \/exists t next,Csem.step ge s t next /\invariant next.
Proof.
 intros s[START|[EXPR|DONE]].
 - subst s;right;exists E0,(ExprState f condition(Kifthenelse yes no k)e m);split.
   + right;apply step_ifthenelse_1.
   + right;left;exists condition;repeat split;auto.
 - destruct EXPR as[a[EQ[TY[SI VAL]]]];subst s.
   destruct(literal RV a)eqn:LIT.
   + destruct(literal_r_inv a LIT)as[v[ty EQ]];subst a.
     cbn[pure_rval]in VAL;injection VAL as EQ.
     cbn[typeof]in TY;right;exists E0,target;split.
     * right;unfold target;eapply step_ifthenelse_2;rewrite EQ,TY;exact condition_bool.
     * right;right;reflexivity.
   + destruct(immediate_has_step ge f a(Kifthenelse yes no k)e m LIT
     (simple_immediate ge e m a SI ltac:(rewrite VAL;discriminate)))as[t[next STEP]].
     right;exists t,next;split;[exact STEP|].
     eapply all_successors;[right;left;exists a;repeat split;auto| |exact STEP].
     intro EQ;unfold target in EQ;discriminate EQ.
 - auto.
Qed.
Theorem if_certificate:certificate ge invariant target.
Proof. split;[apply progress|apply all_successors]. Qed.
Print Assumptions if_certificate.
End IF_SHELL.


FILE paparazzi/relations/pid_position_translation/attempts/002/core/cbmc/ArithmeticAtomic.v
From Stdlib Require Import Bool List Classical.
From compcert Require Import Coqlib Maps AST Values Memory Events Ctypes Cop Csyntax Csem Cstrategy.
From FiveGuidanceAllOrder Require Import PureSyntax PureDenotation PureProgress AtomicDenotation AtomicProgress CallfreeExecution PhaseComposition StandaloneCallShell.
From CoreCBMC Require Import ArithmeticTree.
Section ARITHMETIC_ATOMIC.
Variable ge:genv.
Variable f:function.
Variable e:env.
Variable k:cont.
Variable m mf:mem.
Variable original:expr.
Variable result:val.
Hypothesis syntax:atomic_expr original=true.
Hypothesis evaluation:atomic_eval ge e m original=Some(result,mf).
Hypothesis annotated:arithmetic_tree ge e m original.
Definition arithmetic_atomic_invariant(s:Csem.state):Prop:=
 s=State f Sskip k e mf \/
 exists a ma,s=ExprState f a(Kdo k)e ma /\atomic_expr a=true /\
 atomic_eval ge e ma a=Some(result,mf) /\arithmetic_tree ge e ma a.
Lemma arithmetic_atomic_successors:forall s t next,
 arithmetic_atomic_invariant s ->s<>State f Sskip k e mf ->
 Csem.step ge s t next ->arithmetic_atomic_invariant next.
Proof.
 intros s t next[DONE|[a[ma[EQ[AT[AE TREE]]]]]]NF STEP;[contradiction|subst s].
 destruct STEP as[ES|SS].
 - destruct(atomic_defined_estep ge f a(Kdo k)e ma t next result mf AT AE ES)
   as[ar[mr[EQ[TT[SY DEN]]]]].
   destruct(arithmetic_atomic_estep ge f a(Kdo k)e ma t next AT TREE ES)
   as[BAD|[ar2[mr2[EQ2[SY2 TREE2]]]]];[congruence|].
   rewrite EQ in EQ2;injection EQ2 as EX EM;subst ar2 mr2.
   right;exists ar,mr;auto.
 - inversion SS;subst;cbn[atomic_eval pure_rval]in AE;injection AE as VR MM;subst.
   left;reflexivity.
Qed.
Lemma arithmetic_atomic_progress:forall s,
 arithmetic_atomic_invariant s ->s=State f Sskip k e mf \/
 exists t next,Csem.step ge s t next /\arithmetic_atomic_invariant next.
Proof.
 intros s[DONE|[a[ma[EQ[AT[AE TREE]]]]]];[left;exact DONE|subst s].
 destruct(literal RV a)eqn:LIT.
 - destruct(literal_r_inv a LIT)as[v[ty EQ]];subst a.
   cbn[atomic_eval pure_rval]in AE;injection AE as VR MM;subst.
   right;exists E0,(State f Sskip k e mf);split;[right;constructor|left;reflexivity].
 - destruct(immediate_has_step ge f a(Kdo k)e ma LIT
    ltac:(exact(atomic_not_stuck ge e ma a result mf AT AE RV(fun x=>x)a(ctx_top RV)eq_refl)))as[t[next STEP]].
   right;exists t,next;split;[exact STEP|].
   eapply arithmetic_atomic_successors;[right;exists a,ma;auto|discriminate|exact STEP].
Qed.
Theorem arithmetic_atomic_certificate:
 certificate ge arithmetic_atomic_invariant(State f Sskip k e mf).
Proof. split;[exact arithmetic_atomic_progress|exact arithmetic_atomic_successors]. Qed.
Theorem arithmetic_atomic_initial:
 arithmetic_atomic_invariant(ExprState f original(Kdo k)e m).
Proof. right;exists original,m;auto. Qed.
Theorem arithmetic_atomic_observation:forall f' a k' e' ma,
 arithmetic_atomic_invariant(ExprState f' a k' e' ma) ->arithmetic_tree ge e' ma a.
Proof.
 intros f' a k' e' ma[DONE|[ar[mr[EQ REST]]]];[discriminate|].
 injection EQ as FF AA KK EE MM;subst;tauto.
Qed.
End ARITHMETIC_ATOMIC.
Print Assumptions arithmetic_atomic_certificate.


