Ltac option_cases E :=
 repeat match type of E with
 | context [match ?x with _ => _ end] =>
   let EQ := fresh "EQ" in destruct x eqn:EQ; try discriminate
 end.

Lemma pure_eval_big : forall a ge e m,
 simple a=true ->
 (forall v, pure_rval ge e m a=Some v -> eval_simple_rvalue ge e m a v) /\
 (forall b ofs bf, pure_lval ge e m a=Some(b,ofs,bf) -> eval_simple_lvalue ge e m a b ofs bf).
Proof.
 induction a; intros ge e m SIMPLE; simpl in SIMPLE; core_unpack; try discriminate;
 repeat match goal with
 | IH: forall ge e m, simple ?a=true -> _ /\ _ |- _ =>
   let R:=fresh "RV" in let L:=fresh "LV" in
   pose proof (IH ge e m ltac:(assumption)) as [R L]; clear IH
 end;
 split; intros; cbn [pure_rval pure_lval] in H; try discriminate.
 - inversion H; subst; constructor.
 - option_cases H; inversion H; subst; eauto using esl_var_local, esl_var_global.
 - option_cases H; inversion H; subst; eauto using esl_field_struct, esl_field_union.
 - option_cases H; inversion H; subst.
   match goal with D: do_deref_loc _ _ _ _ _ _ _ = Some _ |- _ =>
    destruct (do_deref_loc_sound _ _ _ _ _ _ _ _ _ _ D) as [DR PT]
   end.
   assert (SIL: t = E0) by (eapply deref_loc_silent; eauto; unfold nv; congruence).
   subst t. econstructor; eauto; try (symmetry; assumption).
   apply negb_true_iff; assumption.
 - option_cases H; inversion H; subst; eauto using esl_deref.
 - option_cases H; inversion H; subst; eauto using esr_addrof.
 - option_cases H; eauto using esr_unop.
 - option_cases H; eauto using esr_binop.
 - option_cases H; eauto using esr_cast.
 - inversion H; subst; constructor.
 - inversion H; subst; constructor.
 - inversion H; subst; constructor.
Qed.

Definition literal (k:kind) (a:expr) : bool :=
 match k,a with RV,Eval _ _ | LV,Eloc _ _ _ _=>true | _,_=>false end.

Lemma lift_immediate : forall ge e m from to C a,
 context from to C -> literal from a=false -> imm_safe ge e from a m ->
 imm_safe ge e to (C a) m.
Proof.
 intros ge e m from to C a CT NL IS; inversion IS; subst; try discriminate.
 - eapply imm_safe_lred with (C:=fun x=>C(C0 x)); eauto using Cstrategy.context_compose.
 - eapply imm_safe_rred with (C:=fun x=>C(C0 x)); eauto using Cstrategy.context_compose.
 - eapply imm_safe_callred with (C:=fun x=>C(C0 x)); eauto using Cstrategy.context_compose.
Qed.

Lemma literal_r_inv : forall a, literal RV a=true -> exists v ty,a=Eval v ty.
Proof. destruct a; simpl; intros; try discriminate; eauto. Qed.
Lemma literal_l_inv : forall a, literal LV a=true -> exists b ofs bf ty,a=Eloc b ofs bf ty.
Proof. destruct a; simpl; intros; try discriminate; eauto. Qed.

Ltac invert_literal_eval :=
 repeat match goal with
 | H:eval_simple_rvalue _ _ _ (Eval _ _) _ |- _ => inversion H; subst; clear H
 | H:eval_simple_lvalue _ _ _ (Eloc _ _ _ _) _ _ _ |- _ => inversion H; subst; clear H
 end.
Lemma big_immediate : forall ge e m,
 (forall a v,eval_simple_rvalue ge e m a v -> imm_safe ge e RV a m) /\
 (forall a b ofs bf,eval_simple_lvalue ge e m a b ofs bf -> imm_safe ge e LV a m).
Proof.
 intros ge e m; apply eval_simple_rvalue_lvalue_ind; intros.
 - constructor.
 - destruct (literal LV l) eqn:LIT.
   + destruct (literal_l_inv _ LIT) as [bl[ol[bfl[tl LITERAL_EQ]]]]; subst l.
     invert_literal_eval; cbn [typeof] in *; subst. eapply imm_safe_rred with (C:=fun x=>x); [|constructor].
     eapply red_rvalof; eauto.
   + eapply lift_immediate with (from:=LV) (C:=fun x=>Evalof x ty); eauto.
     constructor; constructor.
 - destruct (literal LV l) eqn:LIT.
   + destruct (literal_l_inv _ LIT) as [bl[ol[bfl[tl LITERAL_EQ]]]]; subst l.
     invert_literal_eval; cbn [typeof] in *; subst. eapply imm_safe_rred with (C:=fun x=>x); [|constructor].
     constructor.
   + eapply lift_immediate with (from:=LV) (C:=fun x=>Eaddrof x ty); eauto.
     constructor; constructor.
 - destruct (literal RV r1) eqn:LIT.
   + destruct (literal_r_inv _ LIT) as [vr[tr LITERAL_EQ]]; subst r1.
     invert_literal_eval; cbn [typeof] in *; subst. eapply imm_safe_rred with (C:=fun x=>x); [|constructor].
     econstructor; eassumption.
   + eapply lift_immediate with (from:=RV) (C:=fun x=>Eunop op x ty); eauto.
     constructor; constructor.
 - destruct (literal RV r1) eqn:L1.
   + destruct (literal_r_inv _ L1) as [vr[tr LITERAL_EQ]]; subst r1. invert_literal_eval; cbn [typeof] in *; subst.
     destruct (literal RV r2) eqn:L2.
     * destruct (literal_r_inv _ L2) as [vr2[tr2 LITERAL_EQ2]]; subst r2. invert_literal_eval; cbn [typeof] in *; subst.
       eapply imm_safe_rred with (C:=fun x=>x); [|constructor]. econstructor; eassumption.
     * eapply lift_immediate with (from:=RV) (C:=fun x=>Ebinop op _ x ty); eauto.
       constructor; constructor.
   + eapply lift_immediate with (from:=RV) (C:=fun x=>Ebinop op x r2 ty); eauto.
     constructor; constructor.
 - destruct (literal RV r1) eqn:LIT.
   + destruct (literal_r_inv _ LIT) as [vr[tr LITERAL_EQ]]; subst r1. invert_literal_eval; cbn [typeof] in *; subst.
     eapply imm_safe_rred with (C:=fun x=>x); [|constructor]. econstructor; eassumption.
   + eapply lift_immediate with (from:=RV) (C:=fun x=>Ecast x ty); eauto.
     constructor; constructor.
 - eapply imm_safe_rred with (C:=fun x=>x); [|constructor]. constructor.
 - eapply imm_safe_rred with (C:=fun x=>x); [|constructor]. constructor.
 - constructor.
 - eapply imm_safe_lred with (C:=fun x=>x); [|constructor]. econstructor; eassumption.
 - eapply imm_safe_lred with (C:=fun x=>x); [|constructor]. eapply red_var_global; eauto.
 - destruct (literal RV r) eqn:LIT.
   + destruct (literal_r_inv _ LIT) as [vr[tr LITERAL_EQ]]; subst r. invert_literal_eval; cbn [typeof] in *; subst.
     eapply imm_safe_lred with (C:=fun x=>x); [|constructor]. constructor.
   + eapply lift_immediate with (from:=RV) (C:=fun x=>Ederef x ty); eauto.
     constructor; constructor.
 - destruct (literal RV r) eqn:LIT.
   + destruct (literal_r_inv _ LIT) as [vr[tr LITERAL_EQ]]; subst r. invert_literal_eval; cbn [typeof] in *; subst.
     eapply imm_safe_lred with (C:=fun x=>x); [|constructor]. eapply red_field_struct; eauto.
   + eapply lift_immediate with (from:=RV) (C:=fun x=>Efield x f ty); eauto.
     constructor; constructor.
 - destruct (literal RV r) eqn:LIT.
   + destruct (literal_r_inv _ LIT) as [vr[tr LITERAL_EQ]]; subst r. invert_literal_eval; cbn [typeof] in *; subst.
     eapply imm_safe_lred with (C:=fun x=>x); [|constructor]. eapply red_field_union; eauto.
   + eapply lift_immediate with (from:=RV) (C:=fun x=>Efield x f ty); eauto.
     constructor; constructor.
Qed.

Definition big_defined (ge:genv) (e:env) (m:mem) (k:kind) (a:expr) : Prop :=
 match k with
 | RV=>exists v,eval_simple_rvalue ge e m a v
 | LV=>exists b ofs bf,eval_simple_lvalue ge e m a b ofs bf end.

Lemma big_context_hole : forall from to C,
 context from to C -> forall a ge e m,
 simple(C a)=true -> big_defined ge e m to (C a) -> big_defined ge e m from a.
Proof.
 induction 1; intros a0 ge e m SIMPLE BIG; simpl in SIMPLE; core_unpack; try discriminate; auto;
 unfold big_defined in BIG; repeat match goal with B:exists _,_ |- _=>destruct B end;
 match goal with
 | B:eval_simple_rvalue _ _ _ _ _ |- _=>inversion B; subst
 | B:eval_simple_lvalue _ _ _ _ _ _ _ |- _=>inversion B; subst
 end;
 eapply IHcontext; eauto; unfold big_defined; eauto.
Qed.

Lemma pure_not_stuck : forall ge e m a v,
 simple a=true -> pure_rval ge e m a=Some v -> Csem.not_stuck ge e a m.
Proof.
 intros ge e m a v S EV k C sub CT EQ; subst a.
 pose proof (proj1 (pure_eval_big _ ge e m S) _ EV) as BIG.
 destruct k.
 - destruct (big_context_hole _ _ _ CT sub ge e m S ltac:(unfold big_defined; eauto))
   as [b[ofs[bf L]]]. exact (proj2(big_immediate ge e m) _ _ _ _ L).
 - destruct (big_context_hole _ _ _ CT sub ge e m S ltac:(unfold big_defined; eauto))
   as [w R]. exact (proj1(big_immediate ge e m) _ _ R).
Qed.

Lemma simple_immediate : forall ge e m a,
 simple a=true -> pure_rval ge e m a<>None -> imm_safe ge e RV a m.
From Coq Require Import Bool List ZArith.
From compcert Require Import Coqlib Errors Maps Integers Floats AST Values Memory Events Globalenvs Determinism Ctypes Cop Csyntax Csem Cexec Cstrategy Smallstep.
From FiveGuidanceSemantics Require Import SemanticsSupport.
From FiveGuidanceAllOrder Require Import PureSyntax.
Import ListNotations.

(** This denotation is used to establish uniqueness of normal executions.
    Execution remains the complete error-preserving operational model. *)
Definition quiet_world: world := World (fun _ _ => None) (fun _ _ _ => None) (fun _ _ _ _ => None).

Section DENOTATION.
Variable ge: genv.
Variable e: env.
Variable m: mem.

Fixpoint pure_rval (a: expr): option val :=
  match a with
  | Eval v _ => Some v
  | Evalof l ty =>
      if type_eq ty (typeof l) then
      match pure_lval l with
      | Some (b,ofs,bf) =>
          match Cexec.do_deref_loc ge quiet_world ty m b ofs bf with
          | Some (_,_,v) => Some v | None => None end
      | None => None end else None
  | Eaddrof l _ =>
      match pure_lval l with Some (b,ofs,Full) => Some (Vptr b ofs) | _ => None end
  | Eunop op a _ =>
      match pure_rval a with Some v => sem_unary_operation op v (typeof a) m | None => None end
  | Ebinop op a b _ =>
      match pure_rval a, pure_rval b with
      | Some v, Some w => sem_binary_operation ge op v (typeof a) w (typeof b) m
      | _,_ => None end
  | Ecast a ty =>
      match pure_rval a with Some v => sem_cast v (typeof a) ty m | None => None end
  | Esizeof ty _ => Some (Vptrofs (Ptrofs.repr (sizeof ge ty)))
  | Ealignof ty _ => Some (Vptrofs (Ptrofs.repr (alignof ge ty)))
  | _ => None
  end
with pure_lval (a: expr): option (block * ptrofs * bitfield) :=
  match a with
  | Eloc b ofs bf _ => Some (b,ofs,bf)
  | Evar id ty =>
      match PTree.get id e with
      | Some (b,ty') => if type_eq ty ty' then Some (b,Ptrofs.zero,Full) else None
      | None => match Genv.find_symbol ge id with Some b => Some (b,Ptrofs.zero,Full) | None => None end end
  | Ederef a _ =>
      match pure_rval a with Some (Vptr b ofs) => Some (b,ofs,Full) | _ => None end
  | Efield a id _ =>
      match pure_rval a with
      | Some (Vptr b ofs) =>
          match typeof a with
          | Tstruct sid _ =>
              match PTree.get sid (genv_cenv ge) with
              | Some co => match field_offset ge id (co_members co) with
                | OK (delta,bf) => Some (b,Ptrofs.add ofs (Ptrofs.repr delta),bf)
                | _ => None end
              | None => None end
          | Tunion sid _ =>
              match PTree.get sid (genv_cenv ge) with
              | Some co => match union_field_offset ge id (co_members co) with
                | OK (delta,bf) => Some (b,Ptrofs.add ofs (Ptrofs.repr delta),bf)
                | _ => None end
              | None => None end
          | _ => None end
      | _ => None end
  | _ => None
  end.

Definition pure_eq (k: kind) (a b: expr): Prop :=
  match k with RV => pure_rval a = pure_rval b | LV => pure_lval a = pure_lval b end.

Lemma context_type_eq:
  forall from to C, context from to C -> forall a b,
  typeof a = typeof b -> typeof (C a) = typeof (C b).
Proof. induction 1; simpl; intros; auto. Qed.

Lemma pure_context_congr:
  forall from to C, context from to C -> forall a b,
  typeof a = typeof b -> pure_eq from a b -> pure_eq to (C a) (C b).
Proof.
  induction 1; simpl; intros a b HT HE; auto;
    try (rewrite (IHcontext a b HT HE); reflexivity);
    try (rewrite (context_type_eq _ _ _ H a b HT), (IHcontext a b HT HE); reflexivity).
Qed.

End DENOTATION.

Lemma simple_context_hole:
  forall from to C, context from to C -> forall a,
  simple (C a) = true -> simple a = true.
Proof.
  induction 1; simpl; intros a HA; core_unpack; try discriminate; eauto.
Qed.

Lemma pure_lred:
  forall ge e a m a' m', lred ge e a m a' m' ->
  m' = m /\ typeof a' = typeof a /\ simple a' = true /\
  pure_lval ge e m a = pure_lval ge e m a'.
Proof.
  intros ge e a m a' m' H; inversion H; subst; simpl; repeat split; auto;
    try rewrite H0; try rewrite H1; try rewrite H2; try rewrite dec_eq_true; auto.
Qed.

Lemma pure_rred:
  forall ge e a m t a' m', simple a = true -> rred ge a m t a' m' ->
  m' = m /\ t = E0 /\ typeof a' = typeof a /\ simple a' = true /\
  pure_rval ge e m a = pure_rval ge e m a'.
Proof.
  intros ge e a m t a' m' HA HR; inversion HR; subst; simpl in HA; core_unpack; try discriminate;
    simpl; repeat split; auto; try rewrite H; auto.
  - eapply deref_loc_silent; eauto.
  - assert (HT: t = E0) by (eapply deref_loc_silent; eauto). subst t.
    rewrite dec_eq_true.
    rewrite (do_deref_loc_complete ge quiet_world ty m' b ofs bf quiet_world E0 v H (possible_trace_nil _)).
    reflexivity.
Qed.

Definition flat_expr (a: expr): bool :=
  match a with Eassign l r _ => simple l && simple r | _ => simple a end.

Definition flat_eval (ge: genv) (e: env) (m: mem) (a: expr): option (val * mem) :=
  match a with
  | Eassign l r ty =>
      if type_eq (typeof l) ty then
      match pure_lval ge e m l, pure_rval ge e m r with
      | Some (b,ofs,bf), Some v =>
          match sem_cast v (typeof r) (typeof l) m with
          | Some v => match Cexec.do_assign_loc ge quiet_world (typeof l) m b ofs bf v with
              | Some (_,_,m',v') => Some (v',m') | None => None end
          | None => None end
      | _,_ => None end else None
  | _ => match pure_rval ge e m a with Some v => Some (v,m) | None => None end
  end.

Lemma flat_of_simple:
  forall a, simple a = true -> flat_expr a = true.
Proof. destruct a; simpl; auto; discriminate. Qed.

Lemma flat_eval_simple:
  forall ge e m a, simple a = true ->
  flat_eval ge e m a = match pure_rval ge e m a with Some v => Some (v,m) | None => None end.
Proof. destruct a; simpl; auto; discriminate. Qed.

Lemma flat_context_hole:
  forall from to C, context from to C -> forall a,
  flat_expr (C a) = true -> flat_expr a = true.
Proof.
  induction 1; simpl; intros a HA; core_unpack; try discrimina
From Stdlib Require Import Bool List ZArith String Classical.
From compcert Require Import Coqlib Errors Maps Integers Floats AST Values Memory Events Globalenvs Determinism Ctypes Cop Csyntax Csyntaxdefs Csem Cexec Cstrategy Smallstep.
From FiveGuidanceSemantics Require Import SemanticsSupport SourceClosure.
From FiveGuidanceAllOrder Require Import PureSyntax PureDenotation PureProgress AtomicDenotation AtomicProgress CallfreeExecution ContinuationLift BlockExecution.
Import ListNotations.
Inductive read_stage:=Rvar|Rloc|Rval.
Definition read_res(id:ident)(ty:type)(b:block)(v:val)(stage:read_stage):expr :=
 match stage with
 | Rvar=>Evalof(Evar id ty)ty
 | Rloc=>Evalof(Eloc b Ptrofs.zero Full ty)ty
 | Rval=>Eval v ty end.
Definition lhs_res(id:ident)(b:block)(ready:bool):expr :=
 if ready then Eloc b Ptrofs.zero Full tfloat else Evar id tfloat.
Definition leaf_type:=Tfunction[tfloat]tfloat cc_default.
Definition factor_context(l mx:expr):expr->expr :=
 fun hole=>Eassign l(Ebinop Odiv mx hole tfloat)tfloat.
Definition factor_expression(l mx rf arg:expr):expr :=
 factor_context l mx(Ecall rf(Econs arg Enil)tfloat).
Definition null_external(_ : string)(_ : signature)(_ : Senv.t)(_ : world)(_ : list val)(_ : mem)
 :option(world*trace*val*mem):=None.
Section FACTOR.
Variable ge:genv.
Variable e:env.
Variable caller leaf:function.
Variable k:cont.
Variable ifactor imax isqrt inorm:ident.
Variable bfactor bmax bsqrt bnorm:block.
Variable m:mem.
Variable maximum norm:float32.
Hypothesis factor_local:e!ifactor=Some(bfactor,tfloat).
Hypothesis max_global:e!imax=None.
Hypothesis max_symbol:Genv.find_symbol ge imax=Some bmax.
Hypothesis sqrt_global:e!isqrt=None.
Hypothesis sqrt_symbol:Genv.find_symbol ge isqrt=Some bsqrt.
Hypothesis norm_local:e!inorm=Some(bnorm,tfloat).
Hypothesis max_deref:Cexec.do_deref_loc ge quiet_world tfloat m bmax Ptrofs.zero Full=Some(quiet_world,E0,Vsingle maximum).
Hypothesis norm_deref:Cexec.do_deref_loc ge quiet_world tfloat m bnorm Ptrofs.zero Full=Some(quiet_world,E0,Vsingle norm).
Hypothesis leaf_find:Genv.find_funct ge(Vptr bsqrt Ptrofs.zero)=Some(Internal leaf).
Hypothesis leaf_signature:type_of_fundef(Internal leaf)=leaf_type.
Definition pre_expr(lready:bool)(ms rs ns:read_stage):expr :=
 factor_expression(lhs_res ifactor bfactor lready)
 (read_res imax tfloat bmax(Vsingle maximum)ms)
 (read_res isqrt leaf_type bsqrt(Vptr bsqrt Ptrofs.zero)rs)
 (read_res inorm tfloat bnorm(Vsingle norm)ns).
Definition pre_state(lready:bool)(ms rs ns:read_stage):Csem.state :=
 ExprState caller(pre_expr lready ms rs ns)(Kdo k)e m.
Definition leaf_frame(lready:bool)(ms:read_stage):cont :=
 Kcall caller e(factor_context(lhs_res ifactor bfactor lready)
 (read_res imax tfloat bmax(Vsingle maximum)ms))tfloat(Kdo k).
Definition pre_or_call(s:Csem.state):Prop :=
 (exists lready ms rs ns,s=pre_state lready ms rs ns) \/
 (exists lready ms,s=Callstate(Internal leaf)[Vsingle norm](leaf_frame lready ms)m).

Ltac factor_close :=
 split;[reflexivity|unfold pre_or_call;first[
 left;first[solve[exists true,Rvar,Rvar,Rvar;reflexivity]|solve[exists true,Rvar,Rvar,Rloc;reflexivity]|solve[exists true,Rvar,Rvar,Rval;reflexivity]|solve[exists true,Rvar,Rloc,Rvar;reflexivity]|solve[exists true,Rvar,Rloc,Rloc;reflexivity]|solve[exists true,Rvar,Rloc,Rval;reflexivity]|solve[exists true,Rvar,Rval,Rvar;reflexivity]|solve[exists true,Rvar,Rval,Rloc;reflexivity]|solve[exists true,Rvar,Rval,Rval;reflexivity]|solve[exists true,Rloc,Rvar,Rvar;reflexivity]|solve[exists true,Rloc,Rvar,Rloc;reflexivity]|solve[exists true,Rloc,Rvar,Rval;reflexivity]|solve[exists true,Rloc,Rloc,Rvar;reflexivity]|solve[exists true,Rloc,Rloc,Rloc;reflexivity]|solve[exists true,Rloc,Rloc,Rval;reflexivity]|solve[exists true,Rloc,Rval,Rvar;reflexivity]|solve[exists true,Rloc,Rval,Rloc;reflexivity]|solve[exists true,Rloc,Rval,Rval;reflexivity]|solve[exists true,Rval,Rvar,Rvar;reflexivity]|solve[exists true,Rval,Rvar,Rloc;reflexivity]|solve[exists true,Rval,Rvar,Rval;reflexivity]|solve[exists true,Rval,Rloc,Rvar;reflexivity]|solve[exists true,Rval,Rloc,Rloc;reflexivity]|solve[exists true,Rval,Rloc,Rval;reflexivity]|solve[exists true,Rval,Rval,Rvar;reflexivity]|solve[exists true,Rval,Rval,Rloc;reflexivity]|solve[exists true,Rval,Rval,Rval;reflexivity]|solve[exists false,Rvar,Rvar,Rvar;reflexivity]|solve[exists false,Rvar,Rvar,Rloc;reflexivity]|solve[exists false,Rvar,Rvar,Rval;reflexivity]|solve[exists false,Rvar,Rloc,Rvar;reflexivity]|solve[exists false,Rvar,Rloc,Rloc;reflexivity]|solve[exists false,Rvar,Rloc,Rval;reflexivity]|solve[exists false,Rvar,Rval,Rvar;reflexivity]|solve[exists false,Rvar,Rval,Rloc;reflexivity]|solve[exists false,Rvar,Rval,Rval;reflexivity]|solve[exists false,Rloc,Rvar,Rvar;reflexivity]|solve[exists false,Rloc,Rvar,Rloc;reflexivity]|solve[exists false,Rloc,Rvar,Rval;reflexivity]|solve[exists false,Rloc,Rloc,Rvar;reflexivity]|solve[exists false,Rloc,Rloc,Rloc;reflexivity]|solve[exists false,Rloc,Rloc,Rval;reflexivity]|solve[exists false,Rloc,Rval,Rvar;reflexivity]|solve[exists false,Rloc,Rval,Rloc;reflexivity]|solve[exists false,Rloc,Rval,Rval;reflexivity]|solve[exists false,Rval,Rvar,Rvar;reflexivity]|solve[exists false,Rval,Rvar,Rloc;reflexivity]|solve[exists false,Rval,Rvar,Rval;reflexivity]|solve[exists false,Rval,Rloc,Rvar;reflexivity]|solve[exists false,Rval,Rloc,Rloc;reflexivity]|solve[exists false,Rval,Rloc,Rval;reflexivity]|solve[exists false,Rval,Rval,Rvar;reflexivity]|solve[exists false,Rval,Rval,Rloc;reflexivity]|solve[exists false,Rval,Rval,Rval;reflexivity]]
 |right;first[solve[exists true,Rvar;reflexivity]|solve[exists true,Rloc;reflexivity]|solve[exists true,Rval;reflexivity]|solve[exists false,Rvar;reflexivity]|solve[exists false,Rloc;reflexivity]|solve[exists false,Rval;reflexivity]]]].
Lemma pre_animator_step:forall lr ms rs ns rule t next,
 In(TR rule t next)(Cexec.do_step ge null_external null_external quiet_world(pre_state lr ms rs ns)) ->
 t=E0 /\ pre_or_call next.
Proof.
 intros lr ms rs ns rule t next.
 destruct lr,ms,rs,ns;
 cbn[pre_state pre_expr factor_expression factor_context lhs_res read_res Cexec.do_step
 Cexec.is_val Cexec.step_expr Cexec.step_exprlist Cexec.is_loc Cexec.is_val_list
 Cexec.incontext Cexec.topred Cexec.stuck] ;
 rewrite ?factor_local,?max_global,?max_symbol,?sqrt_global,?sqrt_symbol,?norm_local;
 rewrite ?dec_eq_true;
 rewrite ?max_deref,?norm_deref;
 cbn[Cexec.do_deref_loc access_mode type_is_volatile];
 rewrite ?dec_eq_true.
 all: cbn[leaf_type classify_fun sem_cast_arguments sem_cast];
 rewrite ?leaf_find,?leaf_signature;rewrite ?dec_eq_true;
 cbn[Cexec.incontext2 Cexec.incontext Cexec.topred Cexec.expr_final_state map app fst snd].
 all: intros IN;simpl in IN;repeat destruct IN as[EQ|IN];try contradiction;
 inversion EQ;subst;factor_close.
Qed.

Lemma pre_callback_free:forall lr ms rs ns,callback_free_state(pre_state lr ms rs ns).
Proof. intros;destruct lr,ms,rs,ns;reflexivity. Qed.
Lemma pre_or_call_not_stuck:forall s,pre_or_call s ->s<>Stuckstate.
Proof. intros s[[lr[ms[rs[ns EQ]]]]|[lr[ms EQ]]];subst;discriminate. Qed.
Lemma pre_core:forall lr ms rs ns,
 SourceClosure.core_expr ge(fun _=>True)(fun _ _=>True)(pre_expr lr ms rs ns).
Proof.
 intros;destruct lr,ms,rs,ns;
 cbn[pre_expr factor_expression factor_context lhs_res read_res leaf_type
 SourceClosure.core_expr SourceClosure.core_exprlist SourceClosure.nv];
 repeat split;try reflexivity;unfold SourceClosure.valid_call;intros;split;exact I.
Qed.
Lemma pre_silent:forall lr ms rs ns,
 silent_state ge(pre_state lr ms rs ns).
Proof.
 intros lr ms rs ns t next STEP.
 pose proof(pre_core lr ms rs ns)as CORE.
 destruct STEP as[ES|SS];[|inversion SS].
 inversion ES;subst;auto.
 match goal with EQ:?C ?A=pre_expr _ _ _ _ |- _=>rewrite <-EQ in CORE end.
 match goal with HC:Csem.context RV RV ?C,RR:rred ge ?a m t ?a' ?m' |- _=>
 pose proof(SourceClosure.core_context_hole ge(fun _=>True)(fun _ _=>True)
 _ _ _ HC a CORE)as CA;
 exact(proj1(SourceClosure.core_rred ge(fun _=>True)(fun _ _=>True)
 a m t a' m' CA RR))end.
Qed.
Theorem pre_all_successors:forall lr ms rs ns t next,
 Csem.step ge(pre_state lr ms rs ns)t next ->t=E0 /\ pre_or_call next.
Proof.
 intros lr ms rs ns t next STEP.
 pose proof(pre_silent lr ms rs ns t next STEP)as TT;subst t.
 destruct(pure_do_step_complete ge null_external null_external quiet_world
 (pre_state lr ms rs ns) E0 next quiet_world (pre_callback_free lr ms rs ns)
 (possible_trace_nil quiet_world) STEP)as[rule IN].
 eapply pre_animator_step;exact IN.
Qed.
Lemma pre_animator_nonempty:forall lr ms rs ns,
 exists rule t next,In(TR rule t next)
 (Cexec.do_step ge null_external null_external quiet_world(pre_state lr ms rs ns)).
Proof.
 intros lr ms rs ns.
 destruct lr,ms,rs,ns;
 cbn[pre_state pre_expr factor_expression factor_context lhs_res read_res Cexec.do_step
 Cexec.is_val Cexec.step_expr Cexec.step_exprlist Cexec.is_loc Cexec.is_val_list
 Cexec.incontext Cexec.topred Cexec.stuck] ;
 rewrite ?factor_local,?max_global,?max_symbol,?sqrt_global,?sqrt_symbol,?norm_local;
 rewrite ?dec_eq_true;
 rewrite ?max_deref,?norm_deref;
 cbn[Cexec.do_deref_loc access_mode type_is_volatile];
 rewrite ?dec_eq_true.
 all: cbn[leaf_type classify_fun sem_cast_arguments sem_cast];
 rewrite ?leaf_find,?leaf_signature;rewrite ?dec_eq_true;
 cbn[Cexec.incontext2 Cexec.incontext Cexec.topred Cexec.expr_final_state map app fst snd].

 all: repeat eexists;apply in_eq.
Qed.
Theorem pre_progress:forall lr ms rs ns,
 exists t next,Csem.step ge(pre_state lr ms rs ns)t next /\ pre_or_call next.
Proof.
 intros lr ms rs ns.
 destruct(pre_animator_nonempty lr ms rs ns)as[rule[t[next IN]]].
 pose proof(proj2(pre_animator_step lr ms rs ns rule t next IN))as CLASS.
 exists t,next;split;auto.
 eapply supported_nonstuck_transition;[apply pre_callback_free|exact IN|].
 apply pre_or_call_not_stuck;exact CLASS.
Qed.
Print Assumptions pre_all_successors.
Print Assumptions pre_progress.

