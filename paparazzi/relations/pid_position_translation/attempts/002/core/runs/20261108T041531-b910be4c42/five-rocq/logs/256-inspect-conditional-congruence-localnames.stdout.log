94: Lemma conditional_rred:forall a v t a' mf,
95:  conditional_value a v ->rred ge a m t a' mf ->
96:  mf=m /\t=E0 /\typeof a'=typeof a /\conditional_value a' v.
97: Proof.
98:  intros a v t a' mf CV HR;inversion CV;subst.
99:  - destruct(pure_rred ge e a m t a' mf H HR)as[MM[TT[TY[SI DEN]]]]].
100:    subst mf;repeat split;auto;apply cv_simple;[exact SI|rewrite <-DEN;exact H0].
