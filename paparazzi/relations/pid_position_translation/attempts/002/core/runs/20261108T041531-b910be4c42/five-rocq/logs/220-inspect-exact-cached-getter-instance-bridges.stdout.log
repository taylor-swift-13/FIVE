Lemma do_assign_loc_sound:
  forall w ty m b ofs bf v w' t m' v',
  do_assign_loc w ty m b ofs bf v = Some(w', t, m', v') ->
  assign_loc ge ty m b ofs bf v t m' v' /\ possible_trace w t w'.
