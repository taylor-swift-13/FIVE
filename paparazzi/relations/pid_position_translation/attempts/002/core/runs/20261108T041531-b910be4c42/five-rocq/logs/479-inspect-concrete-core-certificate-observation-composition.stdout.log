 assert(VBI:Mem.valid_block c bi)by(eapply loaded_block;exact IX).
 exists mf;split.
 - intros k.
   destruct(TAIL(Kseq(Sreturn None)k))as[PT[CT IT]].
   assert(CR:certificate ge(fun s=>s=State S.f_guidance_pid_h_run(Sreturn None)k e mf)
    (State S.f_guidance_pid_h_run(Sreturn None)k e mf))by apply singleton_certificate.
