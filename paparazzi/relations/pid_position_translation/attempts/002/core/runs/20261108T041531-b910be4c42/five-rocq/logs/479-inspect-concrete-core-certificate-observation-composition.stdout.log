    CoreFactoryTail.return_assignment(Sreturn None)PT
    (fun s=>s=State S.f_guidance_pid_h_run(Sreturn None)k e mf)_
    CT IT CR eq_refl)as[QT[CQT IQT]].
   destruct(CTRL k)as[PC[CC IC]].
   eexists;split;[eapply join_certificate;[exact CC|exact CQT|exact IQT]|left;exact IC].
 - split;[exact ACTIVE|].
   split;[rewrite FRAME by(assumption||congruence);exact IX|].
   split;[rewrite FRAME by(assumption||congruence);exact IY|].
   split;[rewrite FRAME by(assumption||congruence);exact CX|].
   split;[rewrite FRAME by(assumption||congruence);exact CY|].
   split.
