846: static struct StabilizationSetpoint guidance_pid_h_run(bool in_flight, struct HorizontalGuidance *gh)
847: {
848:   /* maximum bank angle: default 20 deg, max 40 deg*/
849:   static const int32_t traj_max_bank = Min(BFP_OF_REAL(GUIDANCE_H_MAX_BANK, INT32_ANGLE_FRAC),
850:                                        BFP_OF_REAL(RadOfDeg(40), INT32_ANGLE_FRAC));
851:   static const int32_t total_max_bank = BFP_OF_REAL(RadOfDeg(45), INT32_ANGLE_FRAC);
852: 
853:   /* run PID */
854:   int32_t pd_x =
855:     ((guidance_pid.kp * guidance_pid_pos_err.x) >> (INT32_POS_FRAC - GH_GAIN_SCALE)) +
856:     ((guidance_pid.kd * (guidance_pid_speed_err.x >> 2)) >> (INT32_SPEED_FRAC - GH_GAIN_SCALE - 2));
857:   int32_t pd_y =
858:     ((guidance_pid.kp * guidance_pid_pos_err.y) >> (INT32_POS_FRAC - GH_GAIN_SCALE)) +
859:     ((guidance_pid.kd * (guidance_pid_speed_err.y >> 2)) >> (INT32_SPEED_FRAC - GH_GAIN_SCALE - 2));
860:   guidance_pid.cmd_earth.x = pd_x +
861:                            ((guidance_pid.kv * gh->ref.speed.x) >> (INT32_SPEED_FRAC - GH_GAIN_SCALE)) + /* speed feedforward gain */
862:                            ((guidance_pid.ka * gh->ref.accel.x) >> (INT32_ACCEL_FRAC - GH_GAIN_SCALE));  /* acceleration feedforward gain */
863:   guidance_pid.cmd_earth.y = pd_y +
864:                            ((guidance_pid.kv * gh->ref.speed.y) >> (INT32_SPEED_FRAC - GH_GAIN_SCALE)) + /* speed feedforward gain */
865:                            ((guidance_pid.ka * gh->ref.accel.y) >> (INT32_ACCEL_FRAC - GH_GAIN_SCALE));  /* acceleration feedforward gain */
866: 
867:   /* trim max bank angle from PD */
868:   VECT2_STRIM(guidance_pid.cmd_earth, -traj_max_bank, traj_max_bank);
869: 
870:   /* Update pos & speed error integral, zero it if not in_flight.
871:    * Integrate twice as fast when not only POS but also SPEED are wrong,
872:    * but do not integrate POS errors when the SPEED is already catching up.
873:    */
874:   if (in_flight) {
875:     /* ANGLE_FRAC (12) * GAIN (8) * LOOP_FREQ (9) -> INTEGRATOR HIGH RES ANGLE_FRAX (28) */
876:     guidance_pid_trim_att_integrator.x += (guidance_pid.ki * pd_x);
877:     guidance_pid_trim_att_integrator.y += (guidance_pid.ki * pd_y);
878:     /* saturate it  */
879:     VECT2_STRIM(guidance_pid_trim_att_integrator, -(traj_max_bank << (INT32_ANGLE_FRAC + GH_GAIN_SCALE * 2)),
880:                 (traj_max_bank << (INT32_ANGLE_FRAC + GH_GAIN_SCALE * 2)));
881:     /* add it to the command */
882:     guidance_pid.cmd_earth.x += (guidance_pid_trim_att_integrator.x >> (INT32_ANGLE_FRAC + GH_GAIN_SCALE * 2));
883:     guidance_pid.cmd_earth.y += (guidance_pid_trim_att_integrator.y >> (INT32_ANGLE_FRAC + GH_GAIN_SCALE * 2));
884:   } else {
885:     INT_VECT2_ZERO(guidance_pid_trim_att_integrator);
886:   }
887: 
888:   /* compute a better approximation of force commands by taking thrust into account */
889:   if (guidance_pid.approx_force_by_thrust && in_flight) {
890:     static int32_t thrust_cmd_filt;
891:     // FIXME strong coupling with guidance_v here !!!
892:     int32_t vertical_thrust = (stabilization.cmd[COMMAND_THRUST] * guidance_v.thrust_coeff) >> INT32_TRIG_FRAC;
893:     thrust_cmd_filt = (thrust_cmd_filt * GUIDANCE_H_THRUST_CMD_FILTER + vertical_thrust) /
894:                       (GUIDANCE_H_THRUST_CMD_FILTER + 1);
895:     guidance_pid.cmd_earth.x = ANGLE_BFP_OF_REAL(atan2f((guidance_pid.cmd_earth.x * MAX_PPRZ / INT32_ANGLE_PI_2),
896:                              thrust_cmd_filt));
897:     guidance_pid.cmd_earth.y = ANGLE_BFP_OF_REAL(atan2f((guidance_pid.cmd_earth.y * MAX_PPRZ / INT32_ANGLE_PI_2),
898:                              thrust_cmd_filt));
899:   }
900: 
901:   VECT2_STRIM(guidance_pid.cmd_earth, -total_max_bank, total_max_bank);
902: 
903:   return stab_sp_from_ltp_i(&guidance_pid.cmd_earth, ANGLE_BFP_OF_REAL(guidance_h.sp.heading));
904: }
