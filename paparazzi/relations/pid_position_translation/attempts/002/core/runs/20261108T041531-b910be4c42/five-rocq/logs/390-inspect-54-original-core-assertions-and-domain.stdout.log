835: struct StabilizationSetpoint stab_sp_from_ltp_i(struct Int32Vect2 *vect, int32_t heading)
836: {
837:   struct StabilizationSetpoint sp = {
838:     .type = STAB_SP_LTP,
839:     .format = STAB_SP_INT,
