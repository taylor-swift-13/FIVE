esl_field_union
     : forall (ge : genv) (e : env) (m : mem) (r : expr) 
         (f : ident) (ty : type) (b : block) (ofs : ptrofs) 
         (id : ident) (co : composite) (a : attr) 
         (delta : Z) (bf : bitfield),
       eval_simple_rvalue ge e m r (Vptr b ofs) ->
       typeof r = Tunion id a ->
       union_field_offset ge f (co_members co) = OK (delta, bf) ->
       ge ! id = Some co ->
       eval_simple_lvalue ge e m (Efield r f ty) b
         (Ptrofs.add ofs (Ptrofs.repr delta)) bf
esl_field_struct
     : forall (ge : genv) (e : env) (m : mem) (r : expr) 
         (f : ident) (ty : type) (b : block) (ofs : ptrofs) 
         (id : ident) (co : composite) (a : attr) 
         (delta : Z) (bf : bitfield),
       eval_simple_rvalue ge e m r (Vptr b ofs) ->
       typeof r = Tstruct id a ->
       ge ! id = Some co ->
       field_offset ge f (co_members co) = OK (delta, bf) ->
       eval_simple_lvalue ge e m (Efield r f ty) b
         (Ptrofs.add ofs (Ptrofs.repr delta)) bf
