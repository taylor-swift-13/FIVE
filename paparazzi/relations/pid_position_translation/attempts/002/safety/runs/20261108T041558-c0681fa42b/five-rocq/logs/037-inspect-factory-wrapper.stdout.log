22:Lemma raw_writes_bytes_frame:forall P m mf,raw_writes P m mf ->forall b ofs n,~P b ->0<=n ->Mem.loadbytes mf b ofs n=Mem.loadbytes m b ofs n.
27:Lemma raw_writes_range:forall P m mf,raw_writes P m mf ->forall b lo hi k p,Mem.range_perm m b lo hi k p ->Mem.range_perm mf b lo hi k p.
29:Lemma scalar_access_inside:forall m ch b n ofs p,Mem.range_perm m b 0 n Cur p ->0<=ofs ->ofs+size_chunk ch<=n ->(align_chunk ch|ofs) ->Mem.valid_access m ch b ofs p.
31:Lemma same_prefix_length:forall(A:Type)(p q r s:list A),length p=length r ->p++q=r++s ->p=r /\ q=s.
36:Lemma loadbytes_equal_subrange:forall a b ba bb oa ob n bytes delta len,
55:Lemma copy_typed_load:forall m mf src dst so dofs n bytes ch delta v,
