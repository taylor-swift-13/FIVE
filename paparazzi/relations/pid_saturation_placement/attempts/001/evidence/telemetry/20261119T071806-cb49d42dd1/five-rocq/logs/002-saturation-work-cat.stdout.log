 { eapply replay_stores_value_at with(i:=2%nat)(us:=symbolic_updates gh sb bp bi r kp ki)(m:=base)(v:=Vint(Int.repr r));
 [reflexivity|exact RUN|cbn[symbolic_updates skipn];witness_forall ltac:(witness_miss)]. }
