1 goal
  
  m : mem
  b : block
  ofs : Z
  v : int
  mf : mem
  RANGE : 0 <= ofs <= Ptrofs.max_unsigned
  END : ofs + 4 <= Ptrofs.modulus
  STORE : Mem.store Mint32 m b ofs (Vint v) = Some mf
  ============================
  match
    match access_mode tint with
    | By_value chunk =>
        if type_is_volatile tint
        then
         do_volatile_store ge quiet_world chunk m b 
           (Ptrofs.repr ofs) (Vint v)
        else
         match
           (if zle (ofs + size_chunk chunk) Ptrofs.modulus
            then Mem.store chunk m b ofs (Vint v)
            else None)
         with
         | Some m' => Some (quiet_world, E0, m', Vint v)
         | None => None
         end
    | _ => None
    end
  with
  | Some (_, _, mm, vf) => Some (vf, mm)
  | None => None
  end = Some (Vint v, mf)
