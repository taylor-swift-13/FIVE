262:       rred (Eseqand (Eval v1 ty1) r2 ty) m
263:         E0 (Eparen r2 type_bool ty) m
264:   | red_seqand_false: forall v1 ty1 r2 ty m,
265:       bool_val v1 ty1 m = Some false ->
266:       rred (Eseqand (Eval v1 ty1) r2 ty) m
267:         E0 (Eval (Vint Int.zero) ty) m
268:   | red_seqor_true: forall v1 ty1 r2 ty m,
269:       bool_val v1 ty1 m = Some true ->
270:       rred (Eseqor (Eval v1 ty1) r2 ty) m
271:         E0 (Eval (Vint Int.one) ty) m
272:   | red_seqor_false: forall v1 ty1 r2 ty m,
273:       bool_val v1 ty1 m = Some false ->
274:       rred (Eseqor (Eval v1 ty1) r2 ty) m
275:         E0 (Eparen r2 type_bool ty) m
276:   | red_condition: forall v1 ty1 r1 r2 ty b m,
277:       bool_val v1 ty1 m = Some b ->
278:       rred (Econdition (Eval v1 ty1) r1 r2 ty) m
279:         E0 (Eparen (if b then r1 else r2) ty ty) m
