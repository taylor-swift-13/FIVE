1908-(** ** Commutation between linking and program transformations *)
1909-
1910-Section LINK_MATCH_PROGRAM_GEN.
1911-
1912-Context {F G: Type}.
1913-Variable match_fundef: program F -> fundef F -> fundef G -> Prop.
1914-
1915-Hypothesis link_match_fundef:
1916-  forall ctx1 ctx2 f1 tf1 f2 tf2 f,
1917-  link f1 f2 = Some f ->
1918-  match_fundef ctx1 f1 tf1 -> match_fundef ctx2 f2 tf2 ->
1919-  exists tf, link tf1 tf2 = Some tf /\ (match_fundef ctx1 f tf \/ match_fundef ctx2 f tf).
1920-
1921-Let match_program (p: program F) (tp: program G) : Prop :=
1922-    Linking.match_program_gen match_fundef eq p p tp
1923- /\ prog_types tp = prog_types p.
1924-
1925-Theorem link_match_program_gen:
1926-  forall p1 p2 tp1 tp2 p,
1927-  link p1 p2 = Some p -> match_program p1 tp1 -> match_program p2 tp2 ->
1928-  exists tp, link tp1 tp2 = Some tp /\ match_program p tp.
1929-Proof.
1930-  intros until p; intros L [M1 T1] [M2 T2].
1931-  destruct (link_linkorder _ _ _ L) as [LO1 LO2].
1932-Local Transparent Linker_program.
1933-  simpl in L; unfold link_program in L.
1934-  destruct (link (program_of_program p1) (program_of_program p2)) as [pp|] eqn:LP; try discriminate.
1935-  assert (A: exists tpp,
1936-               link (program_of_program tp1) (program_of_program tp2) = Some tpp
1937-             /\ Linking.match_program_gen match_fundef eq p pp tpp).
1938-  { eapply Linking.link_match_program; eauto.
1939-  - intros.
1940-    Local Transparent Linker_types.
1941-    simpl in *. destruct (type_eq v1 v2); inv H. exists v; rewrite dec_eq_true; auto.
1942-  }
1943-  destruct A as (tpp & TLP & MP).
1944-  simpl; unfold link_program. rewrite TLP.
1945-  destruct (lift_option (link (prog_types p1) (prog_types p2))) as [[typs EQ]|EQ]; try discriminate.
1946-  destruct (link_build_composite_env (prog_types p1) (prog_types p2) typs
1947:           (prog_comp_env p1) (prog_comp_env p2) (prog_comp_env_eq p1)
1948:           (prog_comp_env_eq p2) EQ) as (env & P & Q). 
1949-  rewrite <- T1, <- T2 in EQ.
1950-  destruct (lift_option (link (prog_types tp1) (prog_types tp2))) as [[ttyps EQ']|EQ']; try congruence.
1951-  assert (ttyps = typs) by congruence. subst ttyps. 
1952-  destruct (link_build_composite_env (prog_types tp1) (prog_types tp2) typs
1953:         (prog_comp_env tp1) (prog_comp_env tp2) (prog_comp_env_eq tp1)
1954:         (prog_comp_env_eq tp2) EQ') as (tenv & R & S).
1955-  assert (tenv = env) by congruence. subst tenv.
1956-  econstructor; split; eauto. inv L. split; auto.
1957-Qed.
1958-
1959-End LINK_MATCH_PROGRAM_GEN.
1960-
1961-Section LINK_MATCH_PROGRAM.
1962-
1963-Context {F G: Type}.
1964-Variable match_fundef: fundef F -> fundef G -> Prop.
1965-
1966-Hypothesis link_match_fundef:
1967-  forall f1 tf1 f2 tf2 f,
1968-  link f1 f2 = Some f ->
1969-  match_fundef f1 tf1 -> match_fundef f2 tf2 ->
1970-  exists tf, link tf1 tf2 = Some tf /\ match_fundef f tf.
1971-
1972-Let match_program (p: program F) (tp: program G) : Prop :=
1973-    Linking.match_program (fun ctx f tf => match_fundef f tf) eq p tp
1974- /\ prog_types tp = prog_types p.
1975-
1976-Theorem link_match_program:
1977-  forall p1 p2 tp1 tp2 p,
1978-  link p1 p2 = Some p -> match_program p1 tp1 -> match_program p2 tp2 ->
1979-  exists tp, link tp1 tp2 = Some tp /\ match_program p tp.
1980-Proof.
1981-  intros. destruct H0, H1. 
1982-Local Transparent Linker_program.
1983-  simpl in H; unfold link_program in H.
1984-  destruct (link (program_of_program p1) (program_of_program p2)) as [pp|] eqn:LP; try discriminate.
1985-  assert (A: exists tpp,
1986-               link (program_of_program tp1) (program_of_program tp2) = Some tpp
1987-             /\ Linking.match_program (fun ctx f tf => match_fundef f tf) eq pp tpp).
1988-  { eapply Linking.link_match_program. 
1989-  - intros. exploit link_match_fundef; eauto. intros (tf & A & B). exists tf; auto.
1990-  - intros.
1991-    Local Transparent Linker_types.
1992-    simpl in *. destruct (type_eq v1 v2); inv H4. exists v; rewrite dec_eq_true; auto.
1993-  - eauto.
1994-  - eauto.
1995-  - eauto.
1996-  - apply (link_linkorder _ _ _ LP).
1997-  - apply (link_linkorder _ _ _ LP). }
1998-  destruct A as (tpp & TLP & MP).
1999-  simpl; unfold link_program. rewrite TLP.
2000-  destruct (lift_option (link (prog_types p1) (prog_types p2))) as [[typs EQ]|EQ]; try discriminate.
2001-  destruct (link_build_composite_env (prog_types p1) (prog_types p2) typs
2002:           (prog_comp_env p1) (prog_comp_env p2) (prog_comp_env_eq p1)
2003:           (prog_comp_env_eq p2) EQ) as (env & P & Q). 
2004-  rewrite <- H2, <- H3 in EQ.
2005-  destruct (lift_option (link (prog_types tp1) (prog_types tp2))) as [[ttyps EQ']|EQ']; try congruence.
2006-  assert (ttyps = typs) by congruence. subst ttyps. 
2007-  destruct (link_build_composite_env (prog_types tp1) (prog_types tp2) typs
2008:         (prog_comp_env tp1) (prog_comp_env tp2) (prog_comp_env_eq tp1)
2009:         (prog_comp_env_eq tp2) EQ') as (tenv & R & S).
2010-  assert (tenv = env) by congruence. subst tenv.
2011-  econstructor; split; eauto. inv H. split; auto.
2012-  unfold program_of_program; simpl. destruct pp, tpp; exact MP.
2013-Qed.
2014-
2015-End LINK_MATCH_PROGRAM.
