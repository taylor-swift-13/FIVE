1537-(** A program, or compilation unit, is composed of:
1538-- a list of definitions of functions and global variables;
1539-- the names of functions and global variables that are public (not static);
1540-- the name of the function that acts as entry point ("main" function).
1541-- a list of definitions for structure and union names
1542-- the corresponding composite environment
1543-- a proof that this environment is consistent with the definitions. *)
1544-
1545:Record program : Type := {
1546-  prog_defs: list (ident * globdef fundef type);
1547-  prog_public: list ident;
1548-  prog_main: ident;
1549-  prog_types: list composite_definition;
1550-  prog_comp_env: composite_env;
1551:  prog_comp_env_eq: build_composite_env prog_types = OK prog_comp_env
1552-}.
1553-
1554-Definition program_of_program (p: program) : AST.program fundef type :=
1555-  {| AST.prog_defs := p.(prog_defs);
1556-     AST.prog_public := p.(prog_public);
1557-     AST.prog_main := p.(prog_main) |}.
1558-
1559-Coercion program_of_program: program >-> AST.program.
1560-
1561:Program Definition make_program (types: list composite_definition)
1562-                                (defs: list (ident * globdef fundef type))
1563-                                (public: list ident)
1564-                                (main: ident) : res program :=
1565-  match build_composite_env types with
1566-  | Error e => Error e
1567-  | OK ce =>
1568-      OK {| prog_defs := defs;
1569-            prog_public := public;
1570-            prog_main := main;
1571-            prog_types := types;
1572-            prog_comp_env := ce;
1573:            prog_comp_env_eq := _ |}
1574-  end.
1575-
1576-End PROGRAMS.
1577-
1578-Arguments External {F} _ _ _ _.
1579-
1580-Unset Implicit Arguments.
1581-
1582-(** * Separate compilation and linking *)
1583-
1584-(** ** Linking types *)
1585-
1586-Global Program Instance Linker_types : Linker type := {
1587-  link := fun t1 t2 => if type_eq t1 t2 then Some t1 else None;
1588-  linkorder := fun t1 t2 => t1 = t2
1589-}.
1590-Next Obligation.
1591-  destruct (type_eq x y); inv H. auto.
1592-Defined.
1593-
1594-Global Opaque Linker_types.
1595-
1596-(** ** Linking composite definitions *)
1597-
1598-Definition check_compat_composite (l: list composite_definition) (cd: composite_definition) : bool :=
1599-  List.forallb
1600-    (fun cd' =>
1601-      if ident_eq (name_composite_def cd') (name_composite_def cd) then composite_def_eq cd cd' else true)
1602-    l.
1603-
1604-Definition filter_redefs (l1 l2: list composite_definition) :=
1605-  let names1 := map name_composite_def l1 in
1606-  List.filter (fun cd => negb (In_dec ident_eq (name_composite_def cd) names1)) l2.
1607-
1608-Definition link_composite_defs (l1 l2: list composite_definition): option (list composite_definition) :=
1609-  if List.forallb (check_compat_composite l2) l1
1610-  then Some (l1 ++ filter_redefs l1 l2)
1611-  else None.
1612-
1613-Lemma link_composite_def_inv:
1614-  forall l1 l2 l,
1615-  link_composite_defs l1 l2 = Some l ->
1616-     (forall cd1 cd2, In cd1 l1 -> In cd2 l2 -> name_composite_def cd2 = name_composite_def cd1 -> cd2 = cd1)
1617-  /\ l = l1 ++ filter_redefs l1 l2
1618-  /\ (forall x, In x l <-> In x l1 \/ In x l2).
1619-Proof.
1620-  unfold link_composite_defs; intros.
1621-  destruct (forallb (check_compat_composite l2) l1) eqn:C; inv H.
1622-  assert (A: 
1623-    forall cd1 cd2, In cd1 l1 -> In cd2 l2 -> name_composite_def cd2 = name_composite_def cd1 -> cd2 = cd1).
1624-  { rewrite forallb_forall in C. intros.
1625-    apply C in H. unfold check_compat_composite in H. rewrite forallb_forall in H. 
1626-    apply H in H0. rewrite H1, dec_eq_true in H0. symmetry; eapply proj_sumbool_true; eauto. }
1627-  split. auto. split. auto. 
1628-  unfold filter_redefs; intros. 
--
1859-  | None => None
1860-  | Some p =>
1861-      match lift_option (link p1.(prog_types) p2.(prog_types)) with
1862-      | inright _ => None
1863-      | inleft (exist typs EQ) =>
1864-          match link_build_composite_env
1865-                   p1.(prog_types) p2.(prog_types) typs
1866-                   p1.(prog_comp_env) p2.(prog_comp_env)
1867:                   p1.(prog_comp_env_eq) p2.(prog_comp_env_eq) EQ with
1868-          | exist env (conj P Q) =>
1869-              Some {| prog_defs := p.(AST.prog_defs);
1870-                      prog_public := p.(AST.prog_public);
1871-                      prog_main := p.(AST.prog_main);
1872-                      prog_types := typs;
1873-                      prog_comp_env := env;
1874:                      prog_comp_env_eq := P |}
1875-          end
1876-      end
1877-  end.
1878-
1879-Definition linkorder_program {F: Type} (p1 p2: program F) : Prop :=
1880-     linkorder (program_of_program p1) (program_of_program p2)
1881-  /\ (forall id co, p1.(prog_comp_env)!id = Some co -> p2.(prog_comp_env)!id = Some co).
1882-
1883-Global Program Instance Linker_program (F: Type): Linker (program F) := {
1884-  link := link_program;
1885-  linkorder := linkorder_program
1886-}.
1887-Next Obligation.
1888-  split. apply linkorder_refl. auto.
1889-Defined.
1890-Next Obligation.
1891-  destruct H, H0. split. eapply linkorder_trans; eauto.
1892-  intros; auto.
1893-Defined.
1894-Next Obligation.
1895-  revert H. unfold link_program.
1896-  destruct (link (program_of_program x) (program_of_program y)) as [p|] eqn:LP; try discriminate.
1897-  destruct (lift_option (link (prog_types x) (prog_types y))) as [[typs EQ]|EQ]; try discriminate.
1898-  destruct (link_build_composite_env (prog_types x) (prog_types y) typs
1899:       (prog_comp_env x) (prog_comp_env y) (prog_comp_env_eq x)
1900:       (prog_comp_env_eq y) EQ) as (env & P & Q & R).
1901-  destruct (link_linkorder _ _ _ LP). 
1902-  intros X; inv X.
1903-  split; split; auto.
1904-Defined.
1905-
1906-Global Opaque Linker_program.
