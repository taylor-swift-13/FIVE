50-(** ** Notations *)
51-
52-Declare Scope csyntax_scope.
53-
54-Module CsyntaxNotations.
55-
56-(** A convenient notation [$ "ident"] to force evaluation of
57-    [ident_of_string "ident"] *)
58-
59-Ltac ident_of_string s :=
60-  let x := constr:(ident_of_string s) in
61-  let y := eval compute in x in
62-  exact y.
63-
64-Notation "$ s" := (ltac:(ident_of_string s))
65-                  (at level 1, only parsing) : csyntax_scope.
66-
67-End CsyntaxNotations.
