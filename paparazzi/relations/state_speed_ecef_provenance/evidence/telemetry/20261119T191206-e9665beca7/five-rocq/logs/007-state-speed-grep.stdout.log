29-                                (WF: wf_composites types)
30-                             : { ce | build_composite_env types  = OK ce }.
31-Proof.
32-  revert WF. unfold wf_composites. case (build_composite_env types); intros.
33-- exists c; reflexivity.
34-- contradiction.
35-Defined.
36-
37:Definition mkprogram (types: list composite_definition)
38-                     (defs: list (ident * globdef fundef type))
39-                     (public: list ident)
40-                     (main: ident)
41-                     (WF: wf_composites types) : Csyntax.program :=
42-  let (ce, EQ) := build_composite_env' types WF in
43-  {| prog_defs := defs;
44-     prog_public := public;
45-     prog_main := main;
46-     prog_types := types;
47:     prog_comp_env := ce;
48:     prog_comp_env_eq := EQ |}.
