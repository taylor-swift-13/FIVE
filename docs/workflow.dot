digraph FIVE {
  graph [rankdir=TB, bgcolor="white", nodesep=0.40, ranksep=0.42, pad=0.10];
  node [shape=box, style=filled, color="#354551", fillcolor="#F4F7F9",
        penwidth=1.0, fontname="Helvetica", fontsize=12, margin="0.15,0.10"];
  edge [color="#405261", fontname="Helvetica", fontsize=10, arrowsize=0.67];

  input [label="C sources and target settings", fillcolor="white"];
  prepare [label="0  Prepare the C program\nKeep or redirect external calls\nRecord the chosen implementations and target", fillcolor="#EAF2F8"];
  cbmc [label="1  CBMC\nCheck C assertions within bounds"];
  compcert [label="2  CompCert\nExport the C execution model\nand generate proof goals"];
  rocq [label="3  Rocq\nState preconditions and prove\nproperties of model executions"];
  report [label="4  Report\nBounded checks, theorems, open goals and costs", fillcolor="white"];

  {rank=same; cbmc; compcert;}
  input -> prepare;
  prepare -> cbmc;
  prepare -> compcert;
  cbmc -> rocq [style=dashed, label="Assertions and\ncounterexamples"];
  compcert -> rocq [label="Model and\nproof goals"];
  cbmc:sw -> report:w [label="Bounded results", minlen=2];
  rocq -> report;
}
