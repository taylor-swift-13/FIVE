digraph FIVE {
 graph [rankdir=TB, bgcolor="white", nodesep=0.45, ranksep=0.48, pad=0.12];
 node [shape=box, fontname="Helvetica", fontsize=12, color="#303840", penwidth=1.1, margin="0.18,0.12", style=filled, fillcolor="#F6F7F8"];
 edge [fontname="Helvetica", fontsize=10, color="#404850", arrowsize=0.7];
 input [label="C source + dependencies + selected function\nFixed target semantics and observable bits / bytes", fillcolor="white"];
 cbmc [label="1  IMPLEMENTATION CHECKING\nCBMC: traditional bounded model checking\nHarness, assertions and unwinding bounds"];
 model [label="2  MODEL GENERATION\nCompCert Csyntax + original Csem / Cexec\nProvenance, property mapping, pending goals"];
 proof [label="3  PROOF CONSTRUCTION IN ROCQ\nExplicit preconditions and specifications\nCorrespondence + independent property reproof\nSafety, termination and functional induction"];
 evidence [label="SCOPED EVIDENCE AND COST REPORT\nBounded results | checked theorems | pending goals\nSource hashes, assumptions, tokens, time and memory", fillcolor="white"];
 {rank=same; cbmc; model;}
 input -> cbmc;
 input -> model;
 cbmc -> proof [style=dashed, label="Properties / counterexamples\n(not axioms)"];
 model -> proof [label="Execution model +\nunproved obligations"];
 cbmc:w -> evidence:w [label="Bounded evidence", minlen=2];
 proof -> evidence [label="Theorems and remaining obligations"];
}
