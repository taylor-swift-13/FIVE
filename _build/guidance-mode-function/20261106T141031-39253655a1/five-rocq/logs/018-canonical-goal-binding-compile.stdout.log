speed_target =
speed_helper_funcall
     : forall (m : mem) (x : Floats.float32),
       exists mf : mem,
         eval_funcall FiveGhSpeed.Execution.ge m
           (Internal FiveGhSpeed.Source.f_five_sqrtf) [
           Vsingle x] E0 mf (Vsingle (source_derived_sqrt x)) /\
         access_preserved m mf /\
         (forall (ch : AST.memory_chunk) (b : block) (ofs : BinNums.Z),
          Mem.valid_block m b -> Mem.load ch mf b ofs = Mem.load ch m b ofs) /\
         (forall (b : block) (ofs n : BinNums.Z),
          Mem.valid_block m b ->
          Mem.loadbytes mf b ofs n = Mem.loadbytes m b ofs n)

Arguments speed_target m x
accel_target =
accel_helper_funcall
     : forall (m : mem) (x : Floats.float32),
       exists mf : mem,
         eval_funcall Execution.ge m (Internal Source.f_five_sqrtf)
           [Vsingle x] E0 mf (Vsingle (source_derived_sqrt x)) /\
         access_preserved m mf /\
         (forall (ch : AST.memory_chunk) (b : block) (ofs : BinNums.Z),
          Mem.valid_block m b -> Mem.load ch mf b ofs = Mem.load ch m b ofs) /\
         (forall (b : block) (ofs n : BinNums.Z),
          Mem.valid_block m b ->
          Mem.loadbytes mf b ofs n = Mem.loadbytes m b ofs n)

Arguments accel_target m x
total_target =
source_derived_sqrt_total
     : forall x : Floats.float32,
       exists rho : PTree.t val,
         value_statement FiveGhSpeed.Source._FiveSqrtBits
           FiveGhSpeed.Source._f FiveGhSpeed.Source._u helper_types
           (PTree.set FiveGhSpeed.Source._x (Vsingle x) (PTree.empty val))
           (fn_body FiveGhSpeed.Source.f_five_sqrtf) =
         Some (ValueReturn (Vsingle (source_derived_sqrt x)) tfloat rho)

Arguments total_target x
