FILE paparazzi/relations/pid_df_positional_roundoff/support/Reference.v 
 From Stdlib Require Import Reals ZArith Lia Lra Psatz.
Open Scope R_scope.
Definition previous (x:nat->R)(n:nat):R:=match n with O=>0 |S k=>x k end.
Fixpoint trap_sum(x:nat->R)(n:nat):R:=
 match n with O=>0|S k=>trap_sum x k+x(S k)+x k end.
Definition positional(P H D:R)(x:nat->R)(n:nat):R:=
 P*x n+H*trap_sum x n+D*(x n-previous x n).
Fixpoint incremental(a b c:R)(x:nat->R)(n:nat):R:=
 match n with O=>0|S k=>incremental a b c x k+a*x(S k)+b*x k+c*previous x k end.
Definition Delta(a b c A B C:R):R:=Rabs(a-A)+Rabs(b-B)+Rabs(c-C).

Theorem exact_positional:forall P H D x,x O=0->forall n,
 incremental(P+H+D)(-P+H-2*D)D x n=positional P H D x n.
Proof.
 intros P H D x X n;induction n as[|n IH].
 - unfold positional,previous;cbn;rewrite X;ring.
 - cbn[incremental];rewrite IH;unfold positional at 1 2.
   cbn[trap_sum previous];destruct n;cbn[previous]in *;[rewrite X|];ring.
Qed.

Lemma product_difference:forall a A x,Rabs x<=1->
 Rabs(a*x-A*x)<=Rabs(a-A).
Proof.
 intros a A x H;replace(a*x-A*x)with((a-A)*x)by ring.
 rewrite Rabs_mult;pose proof(Rabs_pos(a-A));pose proof(Rabs_pos x);nra.
Qed.
Lemma Delta_nonnegative:forall a b c A B C,0<=Delta a b c A B C.
Proof. intros a b c A B C;unfold Delta;pose proof(Rabs_pos(a-A));pose proof(Rabs_pos(b-B));pose proof(Rabs_pos(c-C));nra. Qed.
Lemma coefficient_perturbation:forall a b c A B C x,
 (forall k,Rabs(x k)<=1)->forall n,
 Rabs(incremental a b c x n-incremental A B C x n)<=INR n*Delta a b c A B C.
Proof.
 intros a b c A B C x X n;induction n as[|n IH].
 - cbn;rewrite Rminus_diag,Rabs_R0;right;ring.
 - cbn[incremental];rewrite S_INR.
   replace(incremental a b c x n+a*x(S n)+b*x n+c*previous x n-
    (incremental A B C x n+A*x(S n)+B*x n+C*previous x n))
   with((incremental a b c x n-incremental A B C x n)+
    (a*x(S n)-A*x(S n))+(b*x n-B*x n)+(c*previous x n-C*previous x n))by ring.
   eapply Rle_trans;[apply Rabs_triang|].
   eapply Rle_trans;[apply Rplus_le_compat_r;apply Rabs_triang|].
   eapply Rle_trans;[apply Rplus_le_compat_r;apply Rplus_le_compat_r;apply Rabs_triang|].
   pose proof(product_difference a A(x(S n))(X(S n)))as Ha.
   pose proof(product_difference b B(x n)(X n))as Hb.
   assert(Hp:Rabs(previous x n)<=1)by(destruct n;cbn[previous];[rewrite Rabs_R0;lra|apply X]).
   pose proof(product_difference c C(previous x n)Hp)as Hc.
   unfold Delta in *;nra.
Qed.

Lemma accumulated_local_error:forall a b c x y d,
 0<=d->y O=0->
 (forall k,Rabs(y(S k)-(y k+a*x(S k)+b*x k+c*previous x k))<=2*d*(INR k+1))->
 forall n,Rabs(y n-incremental a b c x n)<=d*INR n*(INR n+1).
Proof.
 intros a b c x y d Hd Y E n;induction n as[|n IH].
 - cbn;rewrite Y,Rminus_diag,Rabs_R0;lra.
 - cbn[incremental];rewrite S_INR.
   replace(y(S n)-(incremental a b c x n+a*x(S n)+b*x n+c*previous x n))
   with((y(S n)-(y n+a*x(S n)+b*x n+c*previous x n))+
    (y n-incremental a b c x n))by ring.
   eapply Rle_trans;[apply Rabs_triang|].
   pose proof(E n);nra.
Qed.

FILE paparazzi/models/update_pid_df/rocq/support/Contract.v 
 From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Integers Floats AST Values Memory Memdata Csem Smallstep.
From FivePidDf Require Import Source Execution.
From FivePidDfCase Require Import PidMemory.
Import ListNotations.
Local Open Scope Z_scope.
Definition Args(b:block)(p:ptrofs)(value:float32):list val:=[Vptr b p;Vsingle value].
Definition fp_step(a bc c u e0 e1 x:float32):float32:=
 Float32.add(Float32.add(Float32.add u(Float32.mul a x))(Float32.mul bc e0))(Float32.mul c e1).
Definition Initialized(m:mem)(b:block)(p:ptrofs)(a bc c u0 u1 e0 e1 e2:float32):Prop:=
 writable32 m b p /\
 Mem.load Mfloat32 m b(Ptrofs.unsigned p+0)=Some(Vsingle u0) /\
 Mem.load Mfloat32 m b(Ptrofs.unsigned p+4)=Some(Vsingle u1) /\
 Mem.load Mfloat32 m b(Ptrofs.unsigned p+8)=Some(Vsingle e0) /\
 Mem.load Mfloat32 m b(Ptrofs.unsigned p+12)=Some(Vsingle e1) /\
 Mem.load Mfloat32 m b(Ptrofs.unsigned p+16)=Some(Vsingle e2) /\
 Mem.load Mfloat32 m b(Ptrofs.unsigned p+20)=Some(Vsingle a) /\
 Mem.load Mfloat32 m b(Ptrofs.unsigned p+24)=Some(Vsingle bc) /\
 Mem.load Mfloat32 m b(Ptrofs.unsigned p+28)=Some(Vsingle c).
Definition Precondition(args:list val)(m:mem):Prop:=exists b p a bc c u0 u1 e0 e1 e2 x,
 args=Args b p x /\Initialized m b p a bc c u0 u1 e0 e1 e2.
Definition Frame(m mf:mem)(b:block)(p:ptrofs):Prop:=forall q z n,Mem.valid_block m q->
 q<>b \/ z+n<=Ptrofs.unsigned p \/Ptrofs.unsigned p+20<=z ->
 Mem.loadbytes mf q z n=Mem.loadbytes m q z n.
Definition PreservesValid(m mf:mem):Prop:=forall q,Mem.valid_block m q->Mem.valid_block mf q.
Definition WrittenBytes(mf:mem)(b:block)(p:ptrofs)(a bc c u0 e0 e1 x:float32):Prop:=
 forall delta y,In(delta,y)[(0,fp_step a bc c u0 e0 e1 x);(4,u0);(8,x);(12,e0);(16,e1)]->
 Mem.loadbytes mf b(Ptrofs.unsigned p+delta)4=Some(encode_val Mfloat32(Vsingle y)).
Definition Post(m mf:mem)(b:block)(p:ptrofs)(a bc c u0 e0 e1 x:float32):Prop:=
 Initialized mf b p a bc c(fp_step a bc c u0 e0 e1 x)u0 x e0 e1 /\
 WrittenBytes mf b p a bc c u0 e0 e1 x /\ Frame m mf b p /\PreservesValid m mf.
Lemma initialized_valid:forall m b p a bc c u0 u1 e0 e1 e2,Initialized m b p a bc c u0 u1 e0 e1 e2->Mem.valid_block m b.
Proof. intros m b p a bc c u0 u1 e0 e1 e2[W[L _]];eapply Mem.valid_access_valid_block;eapply Mem.valid_access_implies;[eapply Mem.load_valid_access;exact L|constructor]. Qed.
Lemma frame_trans:forall m m1 mf b p,Frame m m1 b p->Frame m1 mf b p->PreservesValid m m1->Frame m mf b p.
Proof. intros m m1 mf b p A B V q z n VB OUT;rewrite(B q z n(V q VB)OUT);apply A;assumption. Qed.

