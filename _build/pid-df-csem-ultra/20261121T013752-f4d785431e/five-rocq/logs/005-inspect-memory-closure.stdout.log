From FiveLowpassUpdateFunctional Require Import Spec.
Theorem normal_completion:Spec.NormalCompletion.
Proof. unfold Spec.NormalCompletion;intros m b p tc li lo value P.
 destruct(update_call_summary m b p tc li lo value P)as[mf[EV POST]].
 assert(N:normal_state(Execution.entry(Args b p value)m)=true)by(vm_compute;reflexivity).
 assert(CN:call_names(Execution.entry(Args b p value)m))by(vm_compute;repeat constructor;simpl;intuition discriminate).
 destruct(defined_evaluator_return_exists Execution.ge _ _ _ N CN EV)as[t PATH];exists t,mf;auto. Qed.
Theorem all_returns:Spec.AllReturns.
Proof. unfold Spec.AllReturns;intros m b p tc li lo value P t result after PATH.
 destruct(update_call_summary m b p tc li lo value P)as[mf[EV POST]].
 assert(N:normal_state(Execution.entry(Args b p value)m)=true)by(vm_compute;reflexivity).
 assert(CN:call_names(Execution.entry(Args b p value)m))by(vm_compute;repeat constructor;simpl;intuition discriminate).
 destruct(defined_evaluator_exact_return Execution.ge _ _ _ _ _ _ N EV PATH)as[VR MR];subst result after;auto. Qed.
Print Assumptions normal_completion.
Print Assumptions all_returns.

From FiveLowpassUpdateCase Require Import Witness.
Theorem nonvacuity:Spec.Nonvacuity.
Proof. intros tc li lo;destruct(initialized_inhabited tc li lo)as[m[b P]];exists m,b,Ptrofs.zero;exact P. Qed.
Print Assumptions nonvacuity.
From Stdlib Require Import List ZArith.
From compcert Require Import AST Values Memory Events Ctypes Csyntax Csem Cexec Smallstep.
From FiveShared.verification Require Import Obligations.
From FiveLowpassUpdate Require Import Source Execution.
From FiveGuidanceSemantics Require Import SourceClosure.
From FiveLowpassUpdateExecutionCorrespondence Require Import Closure.
Import ListNotations.
Definition source_state := Closure.SS.
Definition closed_step := Closure.closed_step.
Definition domain_preservation_goal:Prop := forall args m,
 Execution.entry args m=Callstate(Internal Source.f_update_first_order_low_pass)args Kstop m /\ source_state(Execution.entry args m).
Definition reachable_step_goal:Prop := forall args m t reached tr next,
 star Csem.step Execution.ge(Execution.entry args m)t reached ->
 (closed_step tt reached tr next <-> Csem.step Execution.ge reached tr next).
Definition floating_point_correspondence_goal := reachable_step_goal.
Definition machine_integer_correspondence_goal := reachable_step_goal.
Definition memory_access_correspondence_goal := reachable_step_goal.
Definition control_and_exhaustion_correspondence_goal:Prop := forall args m t final,
 star closed_step tt(Execution.entry args m)t final <->
 star Csem.step Execution.ge(Execution.entry args m)t final.
Definition normal_result_and_memory_correspondence_goal:Prop := forall args m t v mf b ofs n,
 (star closed_step tt(Execution.entry args m)t(Returnstate v Kstop mf) <->
 star Csem.step Execution.ge(Execution.entry args m)t(Returnstate v Kstop mf)) /\
 Execution.observe_bytes mf b ofs n=Mem.loadbytes mf b ofs n.
Definition invalid_operation_correspondence_goal:Prop := forall args m t reached,
 star Csem.step Execution.ge(Execution.entry args m)t reached ->
 (Execution.source_error reached <-> ~Execution.normal_return reached /\ nostep closed_step tt reached).
Definition whole_execution_correspondence_goal := control_and_exhaustion_correspondence_goal.
From Stdlib Require Import List Bool.
From compcert Require Import AST Values Memory Events Globalenvs Ctypes Csyntax Csem Cexec Smallstep.
From FiveLowpassUpdate Require Import Source Execution.
From FiveGuidanceSemantics Require Import SemanticsSupport SourceClosure.
Import ListNotations.
Definition ge := Csem.globalenv Source.prog.
Definition allowed (fd:Csyntax.fundef):Prop := fd=Internal Source.f_update_first_order_low_pass.
Definition budget (_:type)(_:Csyntax.fundef):Prop := True.
Definition SS := SourceClosure.source_state ge allowed budget.
Lemma entry_body_core:SourceClosure.core_stmt ge allowed budget(fn_body Source.f_update_first_order_low_pass).
Proof. cbn [fn_body Source.f_update_first_order_low_pass SourceClosure.core_stmt SourceClosure.core_expr SourceClosure.core_exprlist SourceClosure.nv];repeat split;reflexivity. Qed.
Lemma internal_body:forall f,allowed(Internal f) -> SourceClosure.core_stmt ge allowed budget(fn_body f).
Proof. intros f H;unfold allowed in H;inversion H;subst;apply entry_body_core. Qed.
Lemma external_supported:forall ef args ret cc,allowed(External ef args ret cc) -> executable_builtin ef=true.
Proof. intros;unfold allowed in H;discriminate. Qed.
Theorem entry_source:forall args m,SS(Execution.entry args m).
Proof. intros;split;[reflexivity|constructor]. Qed.
Theorem source_step_invariant:forall s t s',SS s -> Csem.step ge s t s' -> t=E0 /\ SS s'.
Proof. exact(SourceClosure.source_step_invariant ge allowed budget internal_body external_supported). Qed.
Theorem one_step_correspondence:forall cb asm w s t s',SS s ->
 ((exists rule,In(TR rule t s')(Cexec.do_step ge cb asm w s)) <-> Csem.step ge s t s').
Proof. exact(SourceClosure.source_do_step_exact ge allowed budget internal_body external_supported). Qed.
Definition closed_step := Execution.model_step Execution.no_external Execution.no_external Execution.quiet_world.
Theorem source_reachable:forall args m t reached,
 star Csem.step ge(Execution.entry args m)t reached -> SS reached.
Proof.
 intros args m t reached PATH.
 pose proof(entry_source args m) as INIT.
 induction PATH;auto;apply IHPATH;exact(proj2(source_step_invariant _ _ _ INIT H)).
Qed.
Theorem whole_execution_correspondence:forall args m t final,
 star closed_step tt(Execution.entry args m)t final <->
 star Csem.step ge(Execution.entry args m)t final.
Proof.
 intros args m t final;split;intro PATH;
 pose proof(entry_source args m) as INIT;
 revert INIT;induction PATH;intros INV;[constructor| |constructor|].
 - pose proof(proj1(one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world _ _ _ INV)H)as STEP.
   eapply star_step;[exact STEP|apply IHPATH;exact(proj2(source_step_invariant _ _ _ INV STEP))|assumption].
 - eapply star_step.
   + apply(proj2(one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world _ _ _ INV));exact H.
   + apply IHPATH;exact(proj2(source_step_invariant _ _ _ INV H)).
   + assumption.
Qed.
Theorem invalid_operation_correspondence:forall args m t reached,
 star Csem.step ge(Execution.entry args m)t reached ->
 (Execution.source_error reached <->
 ~Execution.normal_return reached /\ nostep closed_step tt reached).
Proof.
 intros args m t reached PATH.
 pose proof(source_reachable _ _ _ _ PATH)as INV.
 unfold Execution.source_error;split;intros[N STOP];split;auto;intros tr nxt STEP;apply(STOP tr nxt).
 - apply(proj1(one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world _ _ _ INV));exact STEP.
 - apply(proj2(one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world _ _ _ INV));exact STEP.
Qed.
Print Assumptions one_step_correspondence.
Print Assumptions whole_execution_correspondence.
Print Assumptions invalid_operation_correspondence.
From FiveLowpassUpdateExecutionCorrespondence Require Import Spec.
From FiveLowpassUpdateExecutionCorrespondence Require Import Closure.
Theorem domain_preservation:Spec.domain_preservation_goal.
Proof. intros;split;[reflexivity|apply Closure.entry_source]. Qed.
Lemma reachable_step:Spec.reachable_step_goal.
Proof.
 intros args m t reached tr next PATH.
 apply (Closure.one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world).
 eapply Closure.source_reachable;eauto.
Qed.
Theorem floating_point_correspondence:Spec.floating_point_correspondence_goal.
Proof. exact reachable_step. Qed.
Theorem machine_integer_correspondence:Spec.machine_integer_correspondence_goal.
Proof. exact reachable_step. Qed.
Theorem memory_access_correspondence:Spec.memory_access_correspondence_goal.
Proof. exact reachable_step. Qed.
Theorem control_and_exhaustion_correspondence:Spec.control_and_exhaustion_correspondence_goal.
Proof. exact Closure.whole_execution_correspondence. Qed.
Theorem normal_result_and_memory_correspondence:Spec.normal_result_and_memory_correspondence_goal.
Proof. intros;split;[apply Closure.whole_execution_correspondence|reflexivity]. Qed.
Theorem invalid_operation_correspondence:Spec.invalid_operation_correspondence_goal.
Proof. exact Closure.invalid_operation_correspondence. Qed.
Theorem whole_execution_correspondence:Spec.whole_execution_correspondence_goal.
Proof. exact Closure.whole_execution_correspondence. Qed.
Print Assumptions domain_preservation.
Print Assumptions floating_point_correspondence.
Print Assumptions machine_integer_correspondence.
Print Assumptions memory_access_correspondence.
Print Assumptions control_and_exhaustion_correspondence.
Print Assumptions normal_result_and_memory_correspondence.
Print Assumptions invalid_operation_correspondence.
Print Assumptions whole_execution_correspondence.
