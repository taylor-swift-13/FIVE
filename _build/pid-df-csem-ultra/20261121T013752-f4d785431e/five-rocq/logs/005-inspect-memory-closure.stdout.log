From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Integers Floats AST Values Memory Memdata.
Import ListNotations.
Local Open Scope Z_scope.
Definition writable12(m:mem)(b:block)(p:ptrofs):Prop :=
 (4 | Ptrofs.unsigned p) /\ Ptrofs.unsigned p+12<=Ptrofs.modulus /\
 Mem.range_perm m b (Ptrofs.unsigned p)(Ptrofs.unsigned p+12) Cur Writable.
Lemma field_pointer:forall m b p delta,writable12 m b p -> In delta[0;4;8] ->
 Ptrofs.unsigned(Ptrofs.add p(Ptrofs.repr delta))=Ptrofs.unsigned p+delta.
Proof.
 intros m b p delta[AL[NW RP]]D;rewrite Ptrofs.add_unsigned.
 assert(DR:0<=delta<=Ptrofs.max_unsigned)by(change(0<=delta<=18446744073709551615);destruct D as[<-|[<-|[<-|[]]]];lia).
 rewrite (Ptrofs.unsigned_repr delta DR).
 apply Ptrofs.unsigned_repr;pose proof(Ptrofs.unsigned_range p).
 unfold Ptrofs.max_unsigned;destruct D as[<-|[<-|[<-|[]]]];lia.
Qed.
Lemma field_access:forall m b p delta,writable12 m b p -> In delta[0;4;8] ->
 Mem.valid_access m Mfloat32 b(Ptrofs.unsigned p+delta)Writable.
Proof.
 intros m b p delta[AL[NW RP]]D;split.
 - intros ofs RANGE;apply RP;cbn[size_chunk]in RANGE;destruct D as[<-|[<-|[<-|[]]]];lia.
 - change(4|Ptrofs.unsigned p+delta);destruct AL as[k K];destruct D as[<-|[<-|[<-|[]]]];
   [exists k|exists(k+1)|exists(k+2)];lia.
Qed.
Lemma field_store:forall m b p delta v,writable12 m b p -> In delta[0;4;8] ->
 exists mf,Mem.store Mfloat32 m b(Ptrofs.unsigned p+delta)(Vsingle v)=Some mf.
Proof. intros m b p delta v P D;destruct(Mem.valid_access_store m Mfloat32 b(Ptrofs.unsigned p+delta)(Vsingle v)(field_access m b p delta P D))as[mf ST];exists mf;exact ST. Qed.
Lemma store_preserves_writable12:forall m b p ch block ofs v mf,
 writable12 m b p -> Mem.store ch m block ofs v=Some mf -> writable12 mf b p.
Proof.
 intros m b p ch blk ofs v mf[AL[NW RP]]ST;repeat split;auto.
 intros z H;eapply Mem.perm_store_1;[exact ST|apply RP;exact H].
Qed.
Definition byte_frame(m mf:mem)(b:block)(p:ptrofs):Prop :=
 forall block ofs n,block<>b \/ ofs+n<=Ptrofs.unsigned p \/ Ptrofs.unsigned p+12<=ofs ->
 Mem.loadbytes mf block ofs n=Mem.loadbytes m block ofs n.
Lemma field_store_frame:forall m b p delta v mf,
 In delta[0;4;8] -> Mem.store Mfloat32 m b(Ptrofs.unsigned p+delta)(Vsingle v)=Some mf ->
 byte_frame m mf b p.
Proof.
 intros m b p delta v mf D ST block ofs n OUT.
 eapply Mem.loadbytes_store_other;[exact ST|].
 cbn[size_chunk];destruct D as[<-|[<-|[<-|[]]]];destruct OUT as[B|[L|R]];intuition lia.
Qed.
Lemma byte_frame_trans:forall m m1 mf b p,byte_frame m m1 b p->byte_frame m1 mf b p->byte_frame m mf b p.
Proof. intros m m1 mf b p A B block ofs n OUT;rewrite B by exact OUT;apply A;exact OUT. Qed.
Lemma field_store_load:forall m b base delta v mf,
 Mem.store Mfloat32 m b(base+delta)(Vsingle v)=Some mf ->
 Mem.load Mfloat32 mf b(base+delta)=Some(Vsingle v).
Proof. intros;exact(Mem.load_store_same _ _ _ _ _ _ H). Qed.
Definition three_stores(m:mem)(b:block)(p:ptrofs)(tc vi vo:float32)(mf:mem):Prop :=
 exists m1 m2,Mem.store Mfloat32 m b(Ptrofs.unsigned p+0)(Vsingle tc)=Some m1 /\
 Mem.store Mfloat32 m1 b(Ptrofs.unsigned p+4)(Vsingle vi)=Some m2 /\
 Mem.store Mfloat32 m2 b(Ptrofs.unsigned p+8)(Vsingle vo)=Some mf.
Lemma three_stores_exist:forall m b p tc vi vo,writable12 m b p->exists mf,three_stores m b p tc vi vo mf.
Proof.
 intros m b p tc vi vo P.
 destruct(field_store m b p 0 tc P ltac:(simpl;auto))as[m1 S1].
 pose proof(store_preserves_writable12 _ _ _ _ _ _ _ _ P S1)as P1.
 destruct(field_store m1 b p 4 vi P1 ltac:(simpl;auto))as[m2 S2].
 pose proof(store_preserves_writable12 _ _ _ _ _ _ _ _ P1 S2)as P2.
 destruct(field_store m2 b p 8 vo P2 ltac:(simpl;auto))as[mf S3].
 exists mf,m1,m2;auto.
Qed.
Lemma three_stores_bytes:forall m b p tc vi vo mf,three_stores m b p tc vi vo mf ->
 Mem.loadbytes mf b(Ptrofs.unsigned p)12=
 Some(encode_val Mfloat32(Vsingle tc)++encode_val Mfloat32(Vsingle vi)++encode_val Mfloat32(Vsingle vo)).
Proof.
 intros m b p tc vi vo mf[m1[m2[S1[S2 S3]]]].
 assert(L0:Mem.loadbytes mf b(Ptrofs.unsigned p)4=Some(encode_val Mfloat32(Vsingle tc))).
 { erewrite Mem.loadbytes_store_other by(exact S3||(cbn[size_chunk];lia)).
   erewrite Mem.loadbytes_store_other by(exact S2||(cbn[size_chunk];lia)).
   replace(Ptrofs.unsigned p)with(Ptrofs.unsigned p+0)by lia.
   exact(Mem.loadbytes_store_same _ _ _ _ _ _ S1). }
 assert(L4:Mem.loadbytes mf b(Ptrofs.unsigned p+4)4=Some(encode_val Mfloat32(Vsingle vi))).
 { erewrite Mem.loadbytes_store_other by(exact S3||(cbn[size_chunk];lia)).
   exact(Mem.loadbytes_store_same _ _ _ _ _ _ S2). }
 assert(L8:Mem.loadbytes mf b(Ptrofs.unsigned p+8)4=Some(encode_val Mfloat32(Vsingle vo)))by exact(Mem.loadbytes_store_same _ _ _ _ _ _ S3).
 assert(L48:Mem.loadbytes mf b(Ptrofs.unsigned p+4)8=Some(encode_val Mfloat32(Vsingle vi)++encode_val Mfloat32(Vsingle vo))).
 { replace 8 with(4+4)by lia;eapply Mem.loadbytes_concat;try exact L4;try lia.
   replace(Ptrofs.unsigned p+4+4)with(Ptrofs.unsigned p+8)by lia;exact L8. }
 replace 12 with(4+8)by lia;eapply Mem.loadbytes_concat;eauto;lia.
Qed.
Lemma three_stores_frame:forall m b p tc vi vo mf,three_stores m b p tc vi vo mf ->byte_frame m mf b p.
Proof.
 intros m b p tc vi vo mf[m1[m2[S1[S2 S3]]]].
 eapply byte_frame_trans;[exact(field_store_frame m b p 0 tc m1 ltac:(simpl;auto) S1)|].
 eapply byte_frame_trans;[exact(field_store_frame m1 b p 4 vi m2 ltac:(simpl;auto) S2)|].
 exact(field_store_frame m2 b p 8 vo mf ltac:(simpl;auto) S3).
Qed.
Print Assumptions field_pointer.
Print Assumptions three_stores_bytes.
Print Assumptions three_stores_frame.
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Errors Maps Integers Floats AST Values Memory Events Globalenvs Ctypes Cop Csyntax Csyntaxdefs Csem Cexec.
From FiveGuidanceAllOrder Require Import PureDenotation AtomicDenotation.
Local Open Scope Z_scope.
Lemma float_variable:forall ge e m id bx x,
 e!id=Some(bx,tfloat)->Mem.load Mfloat32 m bx 0=Some(Vsingle x)->
 pure_rval ge e m(Evalof(Evar id tfloat)tfloat)=Some(Vsingle x).
Proof.
 intros;cbn[pure_rval pure_lval];rewrite H;rewrite ?dec_eq_true.
 cbv[Cexec.do_deref_loc tfloat noattr access_mode type_is_volatile attr_of_type attr_volatile Mem.loadv];
 rewrite ?Ptrofs.unsigned_zero;try rewrite zle_true by(change(4<=18446744073709551616);lia);rewrite H0;reflexivity.
Qed.
Lemma pointer_variable:forall ge e m id bx b p ty,
 e!id=Some(bx,tptr ty)->Mem.load Mptr m bx 0=Some(Vptr b p)->
 pure_rval ge e m(Evalof(Evar id(tptr ty))(tptr ty))=Some(Vptr b p).
Proof.
 intros;cbn[pure_rval pure_lval];rewrite H;rewrite ?dec_eq_true.
 cbv[Cexec.do_deref_loc tptr noattr access_mode type_is_volatile attr_of_type attr_volatile Mem.loadv];
 rewrite ?Ptrofs.unsigned_zero;try rewrite zle_true by(change(8<=18446744073709551616);lia);rewrite H0;reflexivity.
Qed.
Lemma struct_field:forall ge e m ptr sid fid b p delta co,
 pure_rval ge e m ptr=Some(Vptr b p)->
 (genv_cenv ge)!sid=Some co->field_offset ge fid(co_members co)=OK(delta,Full)->
 pure_lval ge e m(Efield(Evalof(Ederef ptr(Tstruct sid noattr))(Tstruct sid noattr))fid tfloat)=Some(b,Ptrofs.add p(Ptrofs.repr delta),Full).
Proof.
 intros;cbn[pure_lval pure_rval];rewrite ?dec_eq_true;cbn;fold(pure_rval ge e m ptr);rewrite H.
 cbv[Cexec.do_deref_loc access_mode];cbn;rewrite H0,H1;reflexivity.
Qed.
Lemma assign_float:forall ge e m l r b p x mf,
 typeof l=tfloat->typeof r=tfloat->
 pure_lval ge e m l=Some(b,p,Full)->pure_rval ge e m r=Some(Vsingle x)->
 Ptrofs.unsigned p+4<=Ptrofs.modulus->
 Mem.store Mfloat32 m b(Ptrofs.unsigned p)(Vsingle x)=Some mf->
 atomic_eval ge e m(Eassign l r tfloat)=Some(Vsingle x,mf).
Proof.
 intros ge e m l r b p x mf TL TR LL RR B ST.
 cbn[atomic_eval];rewrite TL,dec_eq_true,LL,RR.
 unfold commit;rewrite TR;cbv[sem_cast classify_cast Cexec.do_assign_loc tfloat noattr access_mode type_is_volatile attr_of_type attr_volatile Mem.storev].
 rewrite zle_true by exact B;rewrite ST;reflexivity.
Qed.
Print Assumptions assign_float.
From Stdlib Require Import Bool List.
From compcert Require Import Values Memory Events Ctypes Csyntax Csem Smallstep.
From FiveShared.verification Require Import Obligations.
From FiveGuidanceSemantics Require Import WeightedTermination.
From FiveGuidanceAllOrder Require Import PureSyntax CallfreeExecution.

Lemma normal_stmt_finite: forall s,
 normal_stmt s=true -> finite_statement s=true.
Proof. induction s;simpl;intros H;core_unpack;try discriminate;core_build;auto. Qed.
Lemma normal_cont_finite: forall k,
 normal_cont k=true -> finite_continuation k.
Proof.
 induction k;simpl;intros H;core_unpack;try discriminate;constructor;auto using normal_stmt_finite.
Qed.
Lemma normal_state_finite: forall s,
 normal_state s=true -> finite_state s.
Proof.
 destruct s as[f st k e m|f a k e m|fd args k m|v k m|];simpl;intros H;core_unpack;try discriminate;
 try (split;auto using normal_stmt_finite,normal_cont_finite).
 - destruct k;simpl in H;core_unpack;try discriminate;constructor;auto using normal_cont_finite,normal_stmt_finite.
 - destruct fd;destruct k;try discriminate;constructor.
 - destruct k;try discriminate;constructor.
Qed.
Lemma normal_calls_budget: forall ge s,
 normal_state s=true -> calls_within_budget (fun _=>0) ge s.
Proof.
 destruct s;cbn[calls_within_budget];intros N;try exact I.
 intros C sub fd args ty CT EQ CR;exfalso.
 eapply normal_no_callred;[exact N|exact CT|exact EQ|exact CR].
Qed.
Theorem normal_all_successors_terminate: forall ge s,
 normal_state s=true -> Acc(successor ge)s.
Proof.
 intros ge;eapply(all_successors_accessible (fun _=>0) ge (fun s=>normal_state s=true)).
 - exact normal_state_finite.
 - exact(normal_calls_budget ge).
 - intros s t next N [ES|SS].
   + destruct s;inversion ES;subst;eapply normal_estep_backward in ES;eauto;exact(proj1 ES).
   + eapply normal_sstep_preserved;eauto.
Qed.
Theorem defined_evaluator_no_error: forall ge initial result,
 normal_state initial=true -> call_names initial ->
 state_eval ge initial=Some result -> no_error ge initial.
Proof.
 intros ge initial result N CN EV t reached PATH [BAD STOP].
 assert(INV:execution_invariant ge initial)by(repeat split;auto;exists result;exact EV).
 destruct(invariant_progress ge reached (reachable_invariant ge initial t reached INV PATH))as[RET|[tr[next STEP]]].
 - apply BAD;exact RET.
 - exact(STOP tr next STEP).
Qed.
Theorem defined_evaluator_exact_return: forall ge initial v mf t v' mf',
 normal_state initial=true -> state_eval ge initial=Some(v,mf) ->
 star Csem.step ge initial t(Returnstate v' Kstop mf') -> v'=v /\ mf'=mf.
Proof.
 intros ge initial v mf t v' mf' N EV PATH.
 pose proof(all_order_normal_correspondence ge initial t v' mf' N PATH)as EQ.
 rewrite EV in EQ;inversion EQ;auto.
Qed.
Theorem defined_evaluator_safe_termination: forall ge initial result,
 normal_state initial=true -> call_names initial ->
 state_eval ge initial=Some result -> safe_termination ge initial.
Proof.
 intros;split;[eapply defined_evaluator_no_error;eauto|apply normal_all_successors_terminate;auto].
Qed.
Theorem defined_evaluator_return_exists: forall ge initial v mf,
 normal_state initial=true -> call_names initial ->
 state_eval ge initial=Some(v,mf) ->
 exists t,star Csem.step ge initial t(Returnstate v Kstop mf).
Proof.
 intros ge initial v mf N CN EV.
 pose proof(normal_all_successors_terminate ge initial N)as AC.
 assert(INV:execution_invariant ge initial)by(repeat split;auto;exists(v,mf);exact EV).
 revert INV N EV;induction AC as[s AC IH];intros INV N EV.
 destruct(invariant_progress ge s INV)as[[v'[mf' EQ]]|[tr[next STEP]]].
 - subst s;cbn[state_eval]in EV;inversion EV;subst;exists E0;constructor.
 - destruct(normal_step_forward ge s tr next (v,mf) N EV STEP)as[NN EN].
   destruct(IH next ltac:(exists tr;exact STEP)(normal_step_names ge s tr next N CN STEP)(invariant_preserved ge s tr next INV STEP)NN EN)as[tail PATH].
   exists(tr**tail);eapply star_step;eauto.
Qed.
Print Assumptions normal_all_successors_terminate.
Print Assumptions defined_evaluator_safe_termination.
Print Assumptions defined_evaluator_return_exists.
From Stdlib Require Import List ZArith Lia.
