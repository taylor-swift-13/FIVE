From Stdlib Require Import List Bool.
From compcert Require Import AST Values Memory Events Globalenvs Ctypes Csyntax Csem Cexec Smallstep.
From FiveLowpassUpdate Require Import Source Execution.
From FiveGuidanceSemantics Require Import SemanticsSupport SourceClosure.
Import ListNotations.
Definition ge := Csem.globalenv Source.prog.
Definition allowed (fd:Csyntax.fundef):Prop := fd=Internal Source.f_update_first_order_low_pass.
Definition budget (_:type)(_:Csyntax.fundef):Prop := True.
Definition SS := SourceClosure.source_state ge allowed budget.
Lemma entry_body_core:SourceClosure.core_stmt ge allowed budget(fn_body Source.f_update_first_order_low_pass).
Proof. cbn [fn_body Source.f_update_first_order_low_pass SourceClosure.core_stmt SourceClosure.core_expr SourceClosure.core_exprlist SourceClosure.nv];repeat split;reflexivity. Qed.
Lemma internal_body:forall f,allowed(Internal f) -> SourceClosure.core_stmt ge allowed budget(fn_body f).
Proof. intros f H;unfold allowed in H;inversion H;subst;apply entry_body_core. Qed.
Lemma external_supported:forall ef args ret cc,allowed(External ef args ret cc) -> executable_builtin ef=true.
Proof. intros;unfold allowed in H;discriminate. Qed.
Theorem entry_source:forall args m,SS(Execution.entry args m).
Proof. intros;split;[reflexivity|constructor]. Qed.
Theorem source_step_invariant:forall s t s',SS s -> Csem.step ge s t s' -> t=E0 /\ SS s'.
Proof. exact(SourceClosure.source_step_invariant ge allowed budget internal_body external_supported). Qed.
Theorem one_step_correspondence:forall cb asm w s t s',SS s ->
 ((exists rule,In(TR rule t s')(Cexec.do_step ge cb asm w s)) <-> Csem.step ge s t s').
Proof. exact(SourceClosure.source_do_step_exact ge allowed budget internal_body external_supported). Qed.
Definition closed_step := Execution.model_step Execution.no_external Execution.no_external Execution.quiet_world.
Theorem source_reachable:forall args m t reached,
 star Csem.step ge(Execution.entry args m)t reached -> SS reached.
Proof.
 intros args m t reached PATH.
 pose proof(entry_source args m) as INIT.
 induction PATH;auto;apply IHPATH;exact(proj2(source_step_invariant _ _ _ INIT H)).
Qed.
Theorem whole_execution_correspondence:forall args m t final,
 star closed_step tt(Execution.entry args m)t final <->
 star Csem.step ge(Execution.entry args m)t final.
Proof.
 intros args m t final;split;intro PATH;
 pose proof(entry_source args m) as INIT;
 revert INIT;induction PATH;intros INV;[constructor| |constructor|].
 - pose proof(proj1(one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world _ _ _ INV)H)as STEP.
   eapply star_step;[exact STEP|apply IHPATH;exact(proj2(source_step_invariant _ _ _ INV STEP))|assumption].
 - eapply star_step.
   + apply(proj2(one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world _ _ _ INV));exact H.
   + apply IHPATH;exact(proj2(source_step_invariant _ _ _ INV H)).
   + assumption.
Qed.
Theorem invalid_operation_correspondence:forall args m t reached,
 star Csem.step ge(Execution.entry args m)t reached ->
 (Execution.source_error reached <->
 ~Execution.normal_return reached /\ nostep closed_step tt reached).
Proof.
 intros args m t reached PATH.
 pose proof(source_reachable _ _ _ _ PATH)as INV.
 unfold Execution.source_error;split;intros[N STOP];split;auto;intros tr nxt STEP;apply(STOP tr nxt).
 - apply(proj1(one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world _ _ _ INV));exact STEP.
 - apply(proj2(one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world _ _ _ INV));exact STEP.
Qed.
Print Assumptions one_step_correspondence.
Print Assumptions whole_execution_correspondence.
Print Assumptions invalid_operation_correspondence.
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Maps AST Values Memory Ctypes Csem.
From FiveGuidanceAllocation Require Import StackAllocation.
Import ListNotations.
Local Open Scope Z_scope.
Definition region_block(r:block*Z*Z):block:=let '(b,_,_):=r in b.
Lemma map_norepet_inv:forall(A B:Type)(f:A->B)xs,list_norepet(map f xs)->list_norepet xs.
Proof.
 intros A B f xs;induction xs as[|x xs IH];intros ND;[constructor|].
 inversion ND;subst;constructor.
 - intro IN;match goal with H:~In(f x)(map f xs)|-_=>apply H;apply in_map;exact IN end.
 - apply IH;assumption.
Qed.
Lemma env_blocks_norepet:forall(ge:Csem.genv)e,env_separated e ->list_norepet(map region_block(blocks_of_env ge e)).
Proof.
 intros ge e SEP;unfold blocks_of_env;rewrite map_map.
 apply list_map_norepet.
 - eapply map_norepet_inv;apply PTree.elements_keys_norepet.
 - intros[id1[b1 ty1]][id2[b2 ty2]]IN1 IN2 NE;cbn.
   intro EQ;subst b2;apply NE.
   pose proof(PTree.elements_complete _ _ _ IN1)as L1.
   pose proof(PTree.elements_complete _ _ _ IN2)as L2.
   assert(ID:id1=id2)by(eapply SEP;eauto);subst id2.
   rewrite L1 in L2;injection L2 as TY;subst ty2;reflexivity.
Qed.
Lemma free_regions:forall regions m,
 list_norepet(map region_block regions) ->
 (forall b lo hi,In(b,lo,hi)regions ->Mem.range_perm m b lo hi Cur Freeable) ->
 exists mf,Mem.free_list m regions=Some mf /\
 (forall ch b ofs,~In b(map region_block regions)->Mem.load ch mf b ofs=Mem.load ch m b ofs) /\
 (forall ch b ofs p,~In b(map region_block regions)->Mem.valid_access m ch b ofs p->Mem.valid_access mf ch b ofs p).
Proof.
 intros regions;induction regions as[|[[b lo]hi]regions IH];intros m ND FREE.
 - exists m;split;[reflexivity|split;auto].
 - cbn in ND;inversion ND as[|? ? NOT NDREST];subst.
   destruct(Mem.range_perm_free m b lo hi(FREE b lo hi(or_introl eq_refl)))as[ma F].
   assert(REST:forall bx lox hix,In(bx,lox,hix)regions->Mem.range_perm ma bx lox hix Cur Freeable).
   { intros bx lox hix IN ofs RANGE;eapply Mem.perm_free_1;[exact F| |].
     - left;intro EQ;subst bx;apply NOT;apply in_map with(f:=region_block)in IN;exact IN.
     - apply(FREE bx lox hix);[right;exact IN|exact RANGE]. }
   destruct(IH ma NDREST REST)as[mf[FF[LOAD ACCESS]]].
   exists mf;split;[cbn[Mem.free_list];rewrite F;exact FF|]. split.
   + intros ch bx ofs NP;rewrite LOAD by(cbn in NP;tauto).
     erewrite Mem.load_free by(exact F||(left;cbn in NP;intuition congruence));reflexivity.
   + intros ch bx ofs p NP VA;apply ACCESS;[cbn in NP;tauto|].
     eapply Mem.valid_access_free_1;[exact F|exact VA|left;cbn in NP;intuition congruence].
Qed.
Lemma free_environment:forall(ge:Csem.genv)e m,
 env_separated e ->
 (forall id b ty,e!id=Some(b,ty)->Mem.range_perm m b 0(sizeof ge ty)Cur Freeable) ->
 exists mf,Mem.free_list m(blocks_of_env ge e)=Some mf /\
 (forall ch b ofs,(forall id ty,e!id=Some(b,ty)->False)->Mem.load ch mf b ofs=Mem.load ch m b ofs) /\
 (forall ch b ofs p,(forall id ty,e!id=Some(b,ty)->False)->Mem.valid_access m ch b ofs p->Mem.valid_access mf ch b ofs p).
Proof.
 intros ge e m SEP FREE.
 destruct(free_regions(blocks_of_env ge e)m(env_blocks_norepet ge e SEP))as[mf[FF[LOAD ACCESS]]].
 - intros b lo hi IN;unfold blocks_of_env in IN;apply in_map_iff in IN as[[id[bx ty]][EQ IN]].
   cbn in EQ;injection EQ as EB EL EH;subst bx lo hi.
   eapply FREE;eapply PTree.elements_complete;exact IN.
 - exists mf;split;[exact FF|]. split.
   + intros ch b ofs OUT;apply LOAD;intro IN.
     unfold blocks_of_env in IN;rewrite map_map in IN;apply in_map_iff in IN as[[id[bx ty]][EQ IN]].
     cbn in EQ;subst bx;apply(OUT id ty);eapply PTree.elements_complete;exact IN.
   + intros ch b ofs p OUT VA;apply ACCESS;[|exact VA];intro IN.
     unfold blocks_of_env in IN;rewrite map_map in IN;apply in_map_iff in IN as[[id[bx ty]][EQ IN]].
     cbn in EQ;subst bx;apply(OUT id ty);eapply PTree.elements_complete;exact IN.
Qed.
Print Assumptions free_environment.
Lemma range_perm_access_preserved:forall m mf,
 (forall ch b ofs p,Mem.valid_access m ch b ofs p->Mem.valid_access mf ch b ofs p)->
 forall b lo hi p,Mem.range_perm m b lo hi Cur p->Mem.range_perm mf b lo hi Cur p.
Proof.
 intros m mf KEEP b lo hi p RANGE ofs BOUNDS.
 assert(VA:Mem.valid_access m Mint8unsigned b ofs p).
 { unfold Mem.valid_access;split.
   - intros x X;apply RANGE;cbn in X;lia.
   - change(1|ofs);exists ofs;lia. }
 pose proof(KEEP _ _ _ _ VA)as VF;apply(proj1 VF);cbn;lia.
Qed.
Lemma free_list_bytes_frame:forall regions m mf,
 Mem.free_list m regions=Some mf ->
 forall b ofs n,~In b(map region_block regions)->Mem.loadbytes mf b ofs n=Mem.loadbytes m b ofs n.
Proof.
 intros regions;induction regions as[|[[head lo]hi]regions IH];intros m mf FREE b ofs n OUT.
 - cbn[Mem.free_list]in FREE;injection FREE as<-;reflexivity.
 - cbn[Mem.free_list]in FREE;destruct(Mem.free m head lo hi)as[ma|]eqn:F;try discriminate.
   rewrite(IH ma mf FREE b ofs n)by(cbn in OUT;tauto).
   eapply Mem.loadbytes_free;[exact F|left;cbn in OUT;intuition congruence].
Qed.
Lemma free_environment_bytes_frame:forall ge e m mf,
 Mem.free_list m(blocks_of_env ge e)=Some mf ->
 forall b ofs n,(forall id ty,e!id=Some(b,ty)->False)->Mem.loadbytes mf b ofs n=Mem.loadbytes m b ofs n.
Proof.
 intros ge e m mf FREE b ofs n OUT;apply(free_list_bytes_frame _ _ _ FREE);intro IN.
 unfold blocks_of_env in IN;rewrite map_map in IN;apply in_map_iff in IN as[[id[bx ty]][EQ IN]].
 cbn in EQ;subst bx;apply(OUT id ty);eapply PTree.elements_complete;exact IN.
Qed.
Lemma range_perm_access_preserved_block:forall m mf b,
 (forall ch ofs p,Mem.valid_access m ch b ofs p->Mem.valid_access mf ch b ofs p)->
 forall lo hi p,Mem.range_perm m b lo hi Cur p->Mem.range_perm mf b lo hi Cur p.
Proof.
 intros m mf b KEEP lo hi p RANGE ofs BOUNDS.
 assert(VA:Mem.valid_access m Mint8unsigned b ofs p).
 { unfold Mem.valid_access;split;[intros x X;apply RANGE;cbn in X;lia|change(1|ofs);exists ofs;lia]. }
 pose proof(KEEP _ _ _ VA)as VF;apply(proj1 VF);cbn;lia.
Qed.
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Maps Integers Floats AST Values Memory Events Globalenvs Ctypes Csem Cexec.
Import ListNotations.
Local Open Scope Z_scope.

Section STACK.
Variable ge:Csem.genv.
Lemma allocation_load : forall vars e m ch b ofs v,
 Mem.load ch m b ofs=Some v ->
 Mem.load ch (snd(Cexec.do_alloc_variables ge e m vars))b ofs=Some v.
Proof.
 induction vars as[|[id ty] vars IH];intros e m ch b ofs v LD;cbn [Cexec.do_alloc_variables];[exact LD|].
 destruct(Mem.alloc m 0(sizeof ge ty))as[ma fresh]eqn:A;apply IH.
 eapply Mem.load_alloc_other;eauto.
Qed.
Lemma allocation_perm : forall vars e m b ofs k p,
 Mem.perm m b ofs k p -> Mem.perm(snd(Cexec.do_alloc_variables ge e m vars))b ofs k p.
Proof.
 induction vars as[|[id ty]vars IH];intros e m b ofs k p PER;cbn [Cexec.do_alloc_variables];[exact PER|].
 destruct(Mem.alloc m 0(sizeof ge ty))as[ma fresh]eqn:A;apply IH.
 eapply Mem.perm_alloc_1;eauto.
Qed.
Lemma allocation_valid_block : forall vars e m b,
 Mem.valid_block m b -> Mem.valid_block(snd(Cexec.do_alloc_variables ge e m vars))b.
Proof.
 induction vars as[|[id ty]vars IH];intros e m b VB;cbn [Cexec.do_alloc_variables];[exact VB|].
 destruct(Mem.alloc m 0(sizeof ge ty))as[ma fresh]eqn:A;apply IH.
 eapply Mem.valid_block_alloc;eauto.
Qed.
Lemma allocation_keeps_binding : forall vars e m id,
 ~In id(map fst vars) ->
 (fst(Cexec.do_alloc_variables ge e m vars))!id=e!id.
Proof.
 induction vars as[|[head ty]vars IH];intros e m id NOT;cbn [Cexec.do_alloc_variables];[reflexivity|].
 destruct(Mem.alloc m 0(sizeof ge ty))as[ma fresh]eqn:A.
 rewrite IH by(simpl in NOT;tauto).
 apply PTree.gso;intro EQ;subst;simpl in NOT;tauto.
Qed.
Definition env_valid (m:mem)(e:env):Prop := forall id b ty,e!id=Some(b,ty)->Mem.valid_block m b.
Definition env_separated (e:env):Prop := forall id1 id2 b ty1 ty2,
 e!id1=Some(b,ty1)->e!id2=Some(b,ty2)->id1=id2.
Lemma allocation_env_valid : forall vars e m,
 env_valid m e -> env_valid(snd(Cexec.do_alloc_variables ge e m vars))(fst(Cexec.do_alloc_variables ge e m vars)).
Proof.
 induction vars as[|[head ty]vars IH];intros e m VALID;cbn [Cexec.do_alloc_variables];[exact VALID|].
 destruct(Mem.alloc m 0(sizeof ge ty))as[ma fresh]eqn:A;apply IH.
 intros id b t LOOK;rewrite PTree.gsspec in LOOK;destruct(peq id head).
 - injection LOOK as EQ _;subst b;eapply Mem.valid_new_block;exact A.
 - eapply Mem.valid_block_alloc;[exact A|eapply VALID;exact LOOK].
Qed.
Lemma allocation_env_separated : forall vars e m,
 env_valid m e -> env_separated e -> env_separated(fst(Cexec.do_alloc_variables ge e m vars)).
Proof.
 induction vars as[|[head ty]vars IH];intros e m VALID SEP;cbn [Cexec.do_alloc_variables];[exact SEP|].
 destruct(Mem.alloc m 0(sizeof ge ty))as[ma fresh]eqn:A;apply IH.
 - intros id b t LOOK;rewrite PTree.gsspec in LOOK;destruct(peq id head).
   + injection LOOK as EQ _;subst b;eapply Mem.valid_new_block;exact A.
   + eapply Mem.valid_block_alloc;[exact A|eapply VALID;exact LOOK].
 - intros id1 id2 b t1 t2 L1 L2.
   rewrite PTree.gsspec in L1,L2;destruct(peq id1 head), (peq id2 head);subst;auto.
   + injection L1 as EQ _;subst b;exfalso.
     eapply(Mem.fresh_block_alloc _ _ _ _ _ A);eapply VALID;exact L2.
   + injection L2 as EQ _;subst b;exfalso.
     eapply(Mem.fresh_block_alloc _ _ _ _ _ A);eapply VALID;exact L1.
   + eapply SEP;eauto.
Qed.
Lemma allocated_variable : forall vars e m id ty,
 NoDup(map fst vars) -> In(id,ty)vars ->
 exists b,
 (fst(Cexec.do_alloc_variables ge e m vars))!id=Some(b,ty) /\
 ~Mem.valid_block m b /\
 Mem.valid_block(snd(Cexec.do_alloc_variables ge e m vars))b /\
 Mem.range_perm(snd(Cexec.do_alloc_variables ge e m vars))b 0(sizeof ge ty)Cur Freeable.
Proof.
 induction vars as[|[head ht]vars IH];intros e m id ty ND IN;[contradiction|].
 inversion ND as[|? ? NOT NDREST];subst.
 cbn [Cexec.do_alloc_variables].
 destruct(Mem.alloc m 0(sizeof ge ht))as[ma fresh]eqn:A.
 destruct IN as[EQ|IN].
 - injection EQ as EID ET;subst head ht;exists fresh;split.
   + rewrite allocation_keeps_binding by exact NOT;apply PTree.gss.
   + split;[eapply Mem.fresh_block_alloc;exact A|]. split.
     * apply allocation_valid_block;eapply Mem.valid_new_block;exact A.
     * intros ofs RANGE;apply allocation_perm;eapply Mem.perm_alloc_2;[exact A|exact RANGE].
 - destruct(IH(PTree.set head(fresh,ht)e)ma id ty NDREST IN)as[b[LOOK[FRESH[VB PERM]]]].
   exists b;split;[exact LOOK|]. split.
   + intro OLD;apply FRESH;eapply Mem.valid_block_alloc;[exact A|exact OLD].
   + split;assumption.
Qed.
End STACK.
Print Assumptions allocated_variable.
Print Assumptions allocation_env_separated.
