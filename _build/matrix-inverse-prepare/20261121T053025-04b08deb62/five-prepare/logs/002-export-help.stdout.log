usage: compcert-align.py export [-h] --source SOURCE --function FUNCTION
                                --output OUTPUT [--namespace NAMESPACE]
                                [--include-dir INCLUDE_DIR] [--define DEFINE]
                                [--struct-passing] [--request REQUEST]
                                [--session SESSION] [--clightgen CLIGHTGEN]
                                [--compcert-lib COMPCERT_LIB]

options:
  -h, --help            show this help message and exit
  --source SOURCE
  --function FUNCTION
  --output OUTPUT
  --namespace NAMESPACE
  --include-dir INCLUDE_DIR
  --define DEFINE
  --struct-passing
  --request REQUEST
  --session SESSION
  --clightgen CLIGHTGEN
  --compcert-lib COMPCERT_LIB
