      "id": "001-install-explicit-genuine-fabs-bindings",
      "argv": [
        "python3",
        "-c",
        "import json,hashlib\nfrom pathlib import Path\nfor d in [2,3]:\n c=Path(f'paparazzi/models/float_mat_inv_{d}d');p=c/f'prepare/source/float_mat_inv_{d}d.c';s=p.read_text();name='fabsf' if d==2 else 'fabs';marker='\\n\\n'+f'bool float_mat_inv_{d}d';s=s.replace(marker,'\\n\\n/* Explicit standard-library binding to the CompCert/CBMC intrinsic. */\\n#define '+name+' __builtin_'+name+marker);p.write_text(s)\n b=c/'prepare/source/bindings.json';j=json.loads(b.read_text());j['prepared_source']['sha256']=hashlib.sha256(p.read_bytes()).hexdigest();j['external_call_bindings']=[{'original':name,'actual':'__builtin_'+name,'kind':'recognized standard compiler intrinsic','semantics':'Float32.abs with original single signature' if d==2 else 'Oabsfloat with original double signature; argument promotes from single'}];j['redirections']=[{'call':name,'actual':'__builtin_'+name,'implementation_source':'CompCert Builtins0.v BI_fabsf' if d==2 else 'CompCert Cop.sem_absfloat / frontend Oabsfloat','reason':'Plain libm declarations remain EF_external in actual Csyntax; standard intrinsic supplies genuine supported operation. No uninterpreted oracle.'}];j['correspondence_obligations'].append('This explicitly bound source has original entry body; transfer to a different original libm requires an implementation correspondence, especially NaN behavior.');b.write_text(json.dumps(j,indent=2)+'\\n')\n h=c/'prepare/handoff.json';j=json.loads(h.read_text());[(x.update(sha256=hashlib.sha256((c/x['path']).read_bytes()).hexdigest())) for x in j['outputs']];j['limitations']=['Explicit standard fabs intrinsic binding; original libm implementation equivalence remains trust boundary'];h.write_text(json.dumps(j,indent=2)+'\\n')\n (c/'prepare/report/report.md').write_text('# 准备结果\\n\\n原始入口函数体逐字保留。标准 fabs 调用显式绑定至受支持的编译器内建：2d 单精度 __builtin_fabsf（CompCert BI_fabsf=Float32.abs），3d 双精度 __builtin_fabs（实际 Oabsfloat）。CBMC 和 CompCert 使用同一 C 文件。保持原始 double 1e-4、float FLT_EPSILON、运算顺序和返回码。不同 libm 实现的 NaN 行为及源抽取/前端属于明确可信边界。\\n')\n"
      ],
