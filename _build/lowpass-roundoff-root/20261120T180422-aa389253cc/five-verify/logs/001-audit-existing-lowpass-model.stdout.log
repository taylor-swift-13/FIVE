Theorem update_call_summary:forall m b p tc li lo value,
 Initialized m b p tc li lo ->
 exists mf,state_eval Execution.ge(Execution.entry(Args b p value)m)=Some(Vsingle(output tc li lo value),mf) /\Post m mf b p tc li lo value.
