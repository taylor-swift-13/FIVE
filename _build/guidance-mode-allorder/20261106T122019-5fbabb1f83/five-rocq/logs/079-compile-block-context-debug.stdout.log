13 goals
  
  ge : genv
  base : cont
  f : function
  s : statement
  k : cont
  e : env
  m : mem
  CORE : true = true
  CORE1 : block_stmt s = true
  CORE2 : block_cont k = true
  ND : ~ block_done (State f Sskip (Kseq s k) e m)
  m' : mem
  STEP :
    sstep ge (State f Sskip (Kseq s (plug_cont base k)) e m) E0
      (Returnstate Vundef (Kseq s (plug_cont base k)) m')
  H5 : is_call_cont (Kseq s (plug_cont base k))
  H6 : Mem.free_list m (blocks_of_env ge e) = Some m'
  ============================
  exists raw : Csem.state,
    Returnstate Vundef (Kseq s (plug_cont base k)) m' = plug_state base raw /\
    sstep ge (State f Sskip (Kseq s k) e m) E0 raw

