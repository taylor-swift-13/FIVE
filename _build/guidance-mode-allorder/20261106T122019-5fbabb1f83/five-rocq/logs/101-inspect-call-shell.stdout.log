goal 4 is:
 In (TR rule t next)
   (map (expr_final_state caller (Kdo k) e)
      (incontext2
         (fun x : expr =>
          Ecall x
            (Econs (Eaddrof (Evar ivector vectype) (tptr vectype)) Enil)
            tvoid)
         match
           match access_mode call_type with
           | By_value chunk =>
               if type_is_volatile call_type
               then
                do_volatile_load ge quiet_world chunk m bfunction Ptrofs.zero
               else
                match Mem.loadv chunk m (Vptr bfunction Ptrofs.zero) with
                | Some v => Some (quiet_world, E0, v)
                | None => None
                end
           | By_nothing => None
           | _ => Some (quiet_world, E0, Vptr bfunction Ptrofs.zero)
           end
         with
         | Some (_, t0, v) =>
             topred (Rred "red_rvalof" (Eval v call_type) m t0)
         | None => stuck
         end
         (fun x : exprlist =>
          Ecall
            (Evalof (Eloc bfunction Ptrofs.zero Full call_type) call_type) x
            tvoid)
         [(fun x : expr => Econs (Eaddrof x (tptr vectype)) Enil,
           Lred "red_var_local" (Eloc bvector Ptrofs.zero Full vectype) m)])) ->
 t = E0 /\ pre_or_call next
