9 goals
  
  ge : genv
  e : env
  caller : function
  callee : fundef
  k : cont
  ifunction, ivector : ident
  bfunction, bvector : block
  vectype : type
  m : mem
  vector_nonvolatile : type_is_volatile vectype = false
  function_global : e ! ifunction = None
  function_symbol : Genv.find_symbol ge ifunction = Some bfunction
  vector_local : e ! ivector = Some (bvector, vectype)
  callee_find : Genv.find_funct ge (Vptr bfunction Ptrofs.zero) = Some callee
  callee_signature : type_of_fundef callee = call_type
  rule : string
  t : trace
  next : Csem.state
  ============================
  In (TR rule t next)
    [TR "red_var_global" E0
       (ExprState caller
          (Ecall
             (Evalof (Eloc bfunction Ptrofs.zero Full call_type) call_type)
             (Econs (Eaddrof (Evar ivector vectype) (tptr vectype)) Enil)
             tvoid)
          (Kdo k) e m);
     TR "red_var_local" E0
       (ExprState caller
          (Ecall (Evalof (Evar ifunction call_type) call_type)
             (Econs
                (Eaddrof (Eloc bvector Ptrofs.zero Full vectype)
                   (tptr vectype))
                Enil)
             tvoid)
          (Kdo k) e m)] ->
  t = E0 /\ pre_or_call next

