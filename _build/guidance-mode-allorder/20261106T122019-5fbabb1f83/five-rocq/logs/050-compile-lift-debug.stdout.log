4 goals
  
  ge : genv
  base : cont
  BASE : is_call_cont base
  f : function
  k : cont
  e : env
  m, m' : mem
  STEP :
    sstep ge (State f (Sreturn None) k e m) E0
      (Returnstate Vundef (call_cont k) m')
  NORMAL : normal_cont k = true
  H : Mem.free_list m (blocks_of_env ge e) = Some m'
  ============================
  sstep ge (State f (Sreturn None) (plug_cont base k) e m) E0
    (Returnstate Vundef (plug_cont base (call_cont k)) m')

