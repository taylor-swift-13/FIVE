From Stdlib Require Import Arith Lia Wellfounded Bool.
From compcert Require Import Csyntax Csem Events Ctypes Values.
From FiveShared.verification Require Import Obligations.

(** Exact expression reduction measure.  Compound assignments and increment
    reserve the cost of their actual Csem expansion.  Calls are counted here;
    lifting this measure over function activation requires a call-graph weight. *)
Section WEIGHTED.
Variable call_weight:type -> nat.
Fixpoint expression_rank (a:expr):nat :=
 match a with
 | Eval _ _ | Eloc _ _ _ _ => 0
 | Evar _ _ | Esizeof _ _ | Ealignof _ _ => 1
 | Efield a _ _ | Evalof a _ | Ederef a _ | Eaddrof a _
 | Eunop _ a _ | Ecast a _ | Eparen a _ _ => S(expression_rank a)
 | Ebinop _ a b _ | Eassign a b _ | Ecomma a b _ =>
   S(expression_rank a + expression_rank b)
 | Eassignop _ a b _ _ => 3 + expression_rank a + expression_rank b
 | Epostincr _ a _ => 4 + expression_rank a
 | Eseqand a b _ | Eseqor a b _ => 2 + expression_rank a + expression_rank b
 | Econdition a b c _ => 2 + expression_rank a + expression_rank b + expression_rank c
 | Ecall a al ty => 1 + call_weight ty + expression_rank a + expressionlist_rank al
 | Ebuiltin _ _ al _ => 1 + expressionlist_rank al
 end
with expressionlist_rank (al:exprlist):nat :=
 match al with Enil => 0 | Econs a al => expression_rank a + expressionlist_rank al end.

Theorem lred_rank_decreases: forall ge e a m a' m',
 lred ge e a m a' m' -> expression_rank a' < expression_rank a.
Proof. intros; inversion H; subst; simpl; try lia; try (destruct b; simpl; lia). Qed.

Theorem rred_rank_decreases: forall ge a m t a' m',
 rred ge a m t a' m' -> expression_rank a' < expression_rank a.
Proof. intros; inversion H; subst; simpl; try lia; try (destruct b; simpl; lia). Qed.

Scheme context_rank_ind := Induction for context Sort Prop
with contextlist_rank_ind := Induction for contextlist Sort Prop.
Combined Scheme contexts_rank_ind from context_rank_ind, contextlist_rank_ind.

Lemma context_rank_decreases_mut:
 (forall from to C, context from to C -> forall a b,
 expression_rank b < expression_rank a ->
 expression_rank (C b) < expression_rank (C a)) /\
 (forall from C, contextlist from C -> forall a b,
 expression_rank b < expression_rank a ->
 expressionlist_rank (C b) < expressionlist_rank (C a)).
Proof.
 apply contexts_rank_ind; simpl; intros; try lia;
 match goal with IH:forall a b, _ |- _ =>
   specialize(IH a b ltac:(assumption)); lia end.
Qed.

Theorem context_rank_decreases:
 forall from to C, context from to C -> forall a b,
 expression_rank b < expression_rank a ->
 expression_rank (C b) < expression_rank (C a).
Proof. exact (proj1 context_rank_decreases_mut). Qed.

Theorem contextlist_rank_decreases:
 forall from C, contextlist from C -> forall a b,
 expression_rank b < expression_rank a ->
 expressionlist_rank (C b) < expressionlist_rank (C a).
Proof. exact (proj2 context_rank_decreases_mut). Qed.

Print Assumptions lred_rank_decreases.
Print Assumptions rred_rank_decreases.
Print Assumptions context_rank_decreases.




Lemma context_rank_additive_mut:
 (forall from to C, context from to C -> forall a,
 expression_rank (C a) = expression_rank a + expression_rank (C (Eval Vundef Tvoid))) /\
 (forall from C, contextlist from C -> forall a,
 expressionlist_rank (C a) = expression_rank a + expressionlist_rank (C (Eval Vundef Tvoid))).
Proof.
 apply contexts_rank_ind; simpl; intros; try lia;
 match goal with IH:forall a, _ |- _ => rewrite IH; lia end.
Qed.
Lemma context_value_rank:
 forall from to C, context from to C -> forall v ty,
 expression_rank (C (Eval v ty)) = expression_rank (C (Eval Vundef Tvoid)).
Proof. intros; rewrite (proj1 context_rank_additive_mut _ _ _ H); reflexivity. Qed.

Fixpoint statement_rank (s:statement):nat :=
 match s with
 | Sskip | Sreturn None => 1
 | Sdo a | Sreturn(Some a) => expression_rank a + 4
 | Ssequence a b => statement_rank a + statement_rank b + 2
 | Sifthenelse a b c => expression_rank a + statement_rank b + statement_rank c + 6
 | _ => 0 end.
Fixpoint finite_statement (s:statement):bool :=
 match s with
 | Sskip | Sdo _ | Sreturn _ => true
 | Ssequence a b => finite_statement a && finite_statement b
 | Sifthenelse _ a b => finite_statement a && finite_statement b
 | _ => false end.

Fixpoint continuation_rank (k:cont):nat :=
 match k with
 | Kstop => 0
 | Kseq s k => statement_rank s + continuation_rank k + 1
 | Kdo k | Kreturn k => continuation_rank k + 2
 | Kifthenelse a b k => statement_rank a + statement_rank b + continuation_rank k + 3
 | Kcall _ _ C ty k =>
   expression_rank(C(Eval Vundef Tvoid)) + continuation_rank k + 2
 | _ => 0 end.
Inductive finite_continuation:cont -> Prop :=
 | finite_stop: finite_continuation Kstop
 | finite_seq: forall s k, finite_statement s=true -> finite_continuation k -> finite_continuation(Kseq s k)
 | finite_do: forall k, finite_continuation k -> finite_continuation(Kdo k)
 | finite_return: forall k, finite_continuation k -> finite_continuation(Kreturn k)
 | finite_if: forall a b k, finite_statement a=true -> finite_statement b=true ->
   finite_continuation k -> finite_continuation(Kifthenelse a b k)
 | finite_call: forall f e C ty k, context RV RV C -> finite_continuation k ->
   finite_continuation(Kcall f e C ty k).

Definition activation_rank (fd:Csyntax.fundef):nat :=
 match fd with Internal f => statement_rank(fn_body f)+2 | External _ _ _ _ => 2 end.
Definition state_rank (s:Csem.state):nat :=
 match s with
 | State _ stmt k _ _ => statement_rank stmt + continuation_rank k + 1
 | ExprState _ a k _ _ => expression_rank a + continuation_rank k + 1
 | Callstate fd _ k _ => activation_rank fd + continuation_rank k
 | Returnstate _ k _ => continuation_rank k + 1
 | Stuckstate => 0 end.
Definition finite_state (s:Csem.state):Prop :=
 match s with
 | State _ stmt k _ _ => finite_statement stmt=true /\ finite_continuation k
 | ExprState _ _ k _ _ | Callstate _ _ k _ | Returnstate _ k _ => finite_continuation k
 | Stuckstate => True end.

Lemma call_cont_rank: forall k, finite_continuation k ->
 continuation_rank(call_cont k) <= continuation_rank k.
Proof. induction 1; simpl; try lia. Qed.

Lemma sstep_rank_decreases: forall ge s t s',
 finite_state s -> sstep ge s t s' -> state_rank s' < state_rank s.
Proof.
 intros ge s t s' FIN STEP; inversion STEP; subst; simpl in FIN;
 repeat match goal with H:_ /\ _ |- _ => destruct H end;
 repeat match goal with H: _ && _=true |- _ => apply Bool.andb_true_iff in H; destruct H end;
 try discriminate; simpl [state_rank activation_rank statement_rank continuation_rank]; try lia.
 all: try match goal with FC:finite_continuation ?K |- _ =>
   inversion FC; subst; simpl in *; try discriminate; try lia end.
 all: try match goal with FC:finite_continuation ?K |- _ =>
   pose proof(call_cont_rank K FC); lia end.
 all: try (destruct b; simpl; lia).
 all: try match goal with HC:Csem.context _ _ ?C |- _ =>
   rewrite(context_value_rank _ _ _ HC); lia end.
Qed.

Definition calls_within_budget (ge:genv) (s:Csem.state):Prop :=
 match s with
 | ExprState _ original _ _ m =>
   forall C a fd args ty, context RV RV C -> original=C a ->
   callred ge a m fd args ty ->
   activation_rank fd + 2 < expression_rank a
 | _ => True end.

Lemma estep_rank_decreases: forall ge s t s',
 calls_within_budget ge s -> estep ge s t s' ->
 state_rank s' < state_rank s.
Proof.
 intros ge s t s' BUD STEP; inversion STEP; subst; simpl in *.
 - pose proof(lred_rank_decreases _ _ _ _ _ _ H).
   pose proof(context_rank_decreases _ _ _ H0 _ _ H1); lia.
 - pose proof(rred_rank_decreases _ _ _ _ _ _ H).
   pose proof(context_rank_decreases _ _ _ H0 _ _ H1); lia.
 - specialize(BUD C a fd vargs ty H0 eq_refl H).
   pose proof(proj1 context_rank_additive_mut _ _ _ H0 a) as EQ.
   simpl in EQ. lia.
 - lia.
Qed.

(** Generic lifting theorem.  The invariant closure and static call budgets
    are explicit obligations for the actual program, not input preconditions. *)
Theorem all_successors_accessible:
 forall ge (INV:Csem.state -> Prop),
 (forall s, INV s -> finite_state s) ->
 (forall s, INV s -> calls_within_budget ge s) ->
 (forall s t s', INV s -> Csem.step ge s t s' -> INV s') ->
 forall s, INV s -> Acc (successor ge) s.
Proof.
 intros ge INV FIN BUD CLOSED.
 apply (well_founded_induction (well_founded_ltof _ state_rank)
 (fun s => INV s -> Acc(successor ge)s)).
 intros s IH I; constructor; intros next [t STEP].
 apply IH; [unfold ltof; destruct STEP as [ES|SS];
 eauto using estep_rank_decreases,sstep_rank_decreases|eauto].
Qed.
End WEIGHTED.

Print Assumptions all_successors_accessible.
