944:Definition sem_cmp (c:comparison)
945-                  (v1: val) (t1: type) (v2: val) (t2: type)
946-                  (m: mem): option val :=
947-  match classify_cmp t1 t2 with
948-  | cmp_case_pp =>
949-      cmp_ptr m c v1 v2
950-  | cmp_case_pi si =>
951-      match v2 with
952-      | Vint n2 =>
953-          let v2' := Vptrofs (ptrofs_of_int si n2) in
954-          cmp_ptr m c v1 v2'
955-      | Vptr b ofs =>
956-          if Archi.ptr64 then None else cmp_ptr m c v1 v2
957-      | _ =>
958-          None
959-      end
960-  | cmp_case_ip si =>
961-      match v1 with
962-      | Vint n1 =>
963-          let v1' := Vptrofs (ptrofs_of_int si n1) in
964-          cmp_ptr m c v1' v2
965-      | Vptr b ofs =>
966-          if Archi.ptr64 then None else cmp_ptr m c v1 v2
967-      | _ =>
968-          None
969-      end
970-  | cmp_case_pl =>
971-      match v2 with
972-      | Vlong n2 =>
973-          let v2' := Vptrofs (Ptrofs.of_int64 n2) in
974-          cmp_ptr m c v1 v2'
975-      | Vptr b ofs =>
976-          if Archi.ptr64 then cmp_ptr m c v1 v2 else None
977-      | _ =>
978-          None
979-      end
980-  | cmp_case_lp =>
981-      match v1 with
982-      | Vlong n1 =>
983-          let v1' := Vptrofs (Ptrofs.of_int64 n1) in
984-          cmp_ptr m c v1' v2
985-      | Vptr b ofs =>
986-          if Archi.ptr64 then cmp_ptr m c v1 v2 else None
987-      | _ =>
988-          None
989-      end
990-  | cmp_default =>
991-      sem_binarith
992-        (fun sg n1 n2 =>
993-            Some(Val.of_bool(match sg with Signed => Int.cmp c n1 n2 | Unsigned => Int.cmpu c n1 n2 end)))
994-        (fun sg n1 n2 =>
995-            Some(Val.of_bool(match sg with Signed => Int64.cmp c n1 n2 | Unsigned => Int64.cmpu c n1 n2 end)))
996-        (fun n1 n2 =>
997-            Some(Val.of_bool(Float.cmp c n1 n2)))
998-        (fun n1 n2 =>
999-            Some(Val.of_bool(Float32.cmp c n1 n2)))
1000-        v1 t1 v2 t2 m
1001-  end.
