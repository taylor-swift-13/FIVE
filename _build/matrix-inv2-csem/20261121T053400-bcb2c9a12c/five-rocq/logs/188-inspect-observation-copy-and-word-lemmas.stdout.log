847:Theorem loadbytes_split:
848-  forall m b ofs n1 n2 bytes,
849-  loadbytes m b ofs (n1 + n2) = Some bytes ->
850-  n1 >= 0 -> n2 >= 0 ->
851-  exists bytes1, exists bytes2,
852-     loadbytes m b ofs n1 = Some bytes1
853-  /\ loadbytes m b (ofs + n1) n2 = Some bytes2
854-  /\ bytes = bytes1 ++ bytes2.
855-Proof.
856-  unfold loadbytes; intros.
857-  destruct (range_perm_dec m b ofs (ofs + (n1 + n2)) Cur Readable);
858-  try congruence.
859-  rewrite Z2Nat.inj_add in H by lia. rewrite getN_concat in H.
860-  rewrite Z2Nat.id in H by lia.
861-  repeat rewrite pred_dec_true.
862-  econstructor; econstructor.
863-  split. reflexivity. split. reflexivity. congruence.
864-  red; intros; apply r; lia.
865-  red; intros; apply r; lia.
866-Qed.
