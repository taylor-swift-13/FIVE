868-Theorem load_rep:
869- forall ch m1 m2 b ofs v1 v2,
870-  (forall z, 0 <= z < size_chunk ch -> ZMap.get (ofs + z) m1.(mem_contents)#b = ZMap.get (ofs + z) m2.(mem_contents)#b) ->
871-  load ch m1 b ofs = Some v1 ->
872-  load ch m2 b ofs = Some v2 ->
873-  v1 = v2.
