879-  f_equal.
880-  rewrite size_chunk_conv in H.
881-  remember (size_chunk_nat ch) as n; clear Heqn.
882-  revert ofs H; induction n; intros; simpl; auto.
883-  f_equal.
884-  rewrite Nat2Z.inj_succ in H.
885-  replace ofs with (ofs+0) by lia.
