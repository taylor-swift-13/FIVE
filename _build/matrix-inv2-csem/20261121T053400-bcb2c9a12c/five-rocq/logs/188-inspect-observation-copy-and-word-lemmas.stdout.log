422:Definition encode_val (chunk: memory_chunk) (v: val) : list memval :=
423-  match v, chunk with
424-  | Vint n, (Mbool | Mint8signed | Mint8unsigned) => inj_bytes (encode_int 1%nat (Int.unsigned n))
425-  | Vint n, (Mint16signed | Mint16unsigned) => inj_bytes (encode_int 2%nat (Int.unsigned n))
426-  | Vint n, Mint32 => inj_bytes (encode_int 4%nat (Int.unsigned n))
427-  | Vptr b ofs, Mint32 => if Archi.ptr64 then List.repeat Undef 4%nat else inj_value Q32 v
428-  | Vlong n, Mint64 => inj_bytes (encode_int 8%nat (Int64.unsigned n))
429-  | Vptr b ofs, Mint64 => if Archi.ptr64 then inj_value Q64 v else List.repeat Undef 8%nat
430-  | Vsingle n, Mfloat32 => inj_bytes (encode_int 4%nat (Int.unsigned (Float32.to_bits n)))
431-  | Vfloat n, Mfloat64 => inj_bytes (encode_int 8%nat (Int64.unsigned (Float.to_bits n)))
432-  | _, Many32 => inj_value Q32 v
433-  | _, Many64 => inj_value Q64 v
434-  | _, _ => List.repeat Undef (size_chunk_nat chunk)
435-  end.
436-
437:Definition decode_val (chunk: memory_chunk) (vl: list memval) : val :=
438-  match proj_bytes vl with
439-  | Some bl =>
440-      match chunk with
441-      | Mbool => Val.norm_bool (Vint (Int.zero_ext 8 (Int.repr (decode_int bl))))
442-      | Mint8signed => Vint(Int.sign_ext 8 (Int.repr (decode_int bl)))
443-      | Mint8unsigned => Vint(Int.zero_ext 8 (Int.repr (decode_int bl)))
444-      | Mint16signed => Vint(Int.sign_ext 16 (Int.repr (decode_int bl)))
445-      | Mint16unsigned => Vint(Int.zero_ext 16 (Int.repr (decode_int bl)))
446-      | Mint32 => Vint(Int.repr(decode_int bl))
447-      | Mint64 => Vlong(Int64.repr(decode_int bl))
448-      | Mfloat32 => Vsingle(Float32.of_bits (Int.repr (decode_int bl)))
449-      | Mfloat64 => Vfloat(Float.of_bits (Int64.repr (decode_int bl)))
450-      | Many32 => Vundef
451-      | Many64 => Vundef
452-      end
453-  | None =>
454-      match chunk with
455-      | Mint32 => if Archi.ptr64 then Vundef else Val.load_result chunk (proj_value Q32 vl)
456-      | Many32 => Val.load_result chunk (proj_value Q32 vl)
457-      | Mint64 => if Archi.ptr64 then Val.load_result chunk (proj_value Q64 vl) else Vundef
458-      | Many64 => Val.load_result chunk (proj_value Q64 vl)
459-      | _ => Vundef
460-      end
461-  end.
462-
463-Ltac solve_encode_val_length :=
464-  match goal with
465-  | [ |- length (inj_bytes _) = _ ] => rewrite length_inj_bytes; solve_encode_val_length
466-  | [ |- length (encode_int _ _) = _ ] => apply encode_int_length
467-  | [ |- length (if ?x then _ else _) = _ ] => destruct x eqn:?; solve_encode_val_length
468-  | _ => reflexivity
469-  end.
470-
471-Lemma encode_val_length:
472-  forall chunk v, length(encode_val chunk v) = size_chunk_nat chunk.
