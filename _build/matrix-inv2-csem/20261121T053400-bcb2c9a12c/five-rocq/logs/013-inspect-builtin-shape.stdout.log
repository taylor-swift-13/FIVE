561: executable_builtin ef = true ->
562- external_call ef ge args m t v m' -> t = E0 /\ m' = m.
563-Proof.
564- intros ge ef args m t v m' HB; destruct ef; simpl in HB; try discriminate;
565- unfold external_call,builtin_or_external_sem;
566- destruct (lookup_builtin_function name sg) eqn:LOOK; try discriminate;
567- intros E; inversion E; subst; auto.
568-Qed.
569-
570-Print Assumptions pure_do_step_exact.
571-Print Assumptions supported_nonstuck_transition.
572:Print Assumptions executable_builtin_silent.
