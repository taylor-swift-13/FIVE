15-(** Syntactic closure only: no conditions on values, memory, permissions or definedness. *)
16-Fixpoint no_builtin (a: expr): bool :=
17-  match a with
18:  | Ebuiltin ef _ al _ => executable_builtin ef && no_builtin_list al
19-  | Efield a _ _ | Evalof a _ | Ederef a _ | Eaddrof a _
20-  | Eunop _ a _ | Ecast a _ | Epostincr _ a _ | Eparen a _ _ => no_builtin a
21-  | Ebinop _ a b _ | Eseqand a b _ | Eseqor a b _
22-  | Eassign a b _ | Eassignop _ a b _ _ | Ecomma a b _ => no_builtin a && no_builtin b
23-  | Econdition a b c _ => no_builtin a && no_builtin b && no_builtin c
24-  | Ecall a al _ => no_builtin a && no_builtin_list al
25-  | _ => true
26-  end
27-with no_builtin_list (al: exprlist): bool :=
28-  match al with Enil => true | Econs a al => no_builtin a && no_builtin_list al end.
