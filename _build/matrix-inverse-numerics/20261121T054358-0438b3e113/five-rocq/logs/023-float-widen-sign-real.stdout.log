730:Theorem B2R_Babs :
731-  forall abs_nan x,
732-  B2R (Babs abs_nan x) = Rabs (B2R x).
733-Proof.
734-  intros abs_nan [sx|sx|sx plx Hx|sx mx ex Hx]; apply sym_eq ; try apply Rabs_R0.
735-  simpl. rewrite <- F2R_abs. now destruct sx.
736-Qed.
737-
738-Theorem is_finite_Babs :
739-  forall abs_nan x,
740-  is_finite (Babs abs_nan x) = is_finite x.
741-Proof.
742-  now intros abs_nan [| | |].
