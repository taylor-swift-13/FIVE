768:Theorem loadbytes_load:
769-  forall chunk m b ofs bytes,
770-  loadbytes m b ofs (size_chunk chunk) = Some bytes ->
771-  (align_chunk chunk | ofs) ->
772-  load chunk m b ofs = Some(decode_val chunk bytes).
773-Proof.
774-  unfold loadbytes, load; intros.
775-  destruct (range_perm_dec m b ofs (ofs + size_chunk chunk) Cur Readable);
776-  try congruence.
777-  inv H. rewrite pred_dec_true. auto.
778-  split; auto.
779-Qed.
