1708-  forall b' ofs k p, perm m1 b' ofs k p -> perm m2 b' ofs k p.
1709-Proof.
1710-  unfold perm; intros. injection ALLOC; intros. rewrite <- H1; simpl.
1711-  subst b. rewrite PMap.gsspec. destruct (peq b' (nextblock m1)); auto.
1712-  rewrite nextblock_noaccess in H. contradiction. subst b'. apply Plt_strict.
1713-Qed.
