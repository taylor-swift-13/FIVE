6:Theorem initialized_inhabited:forall tc li lo:float32,exists m b,Initialized m b Ptrofs.zero tc li lo.
7-Proof.
8- intros tc li lo;destruct(Mem.alloc Mem.empty 0 12)as[ma b]eqn:A.
9- assert(W:writable12 ma b Ptrofs.zero).
10- { unfold writable12;rewrite Ptrofs.unsigned_zero;split;[exists 0;lia|]. split;[change(12<=18446744073709551616);lia|].
11- intros z R;eapply Mem.perm_implies;[eapply Mem.perm_alloc_2;[exact A|exact R]|constructor]. }
12- destruct(three_stores_exist ma b Ptrofs.zero tc li lo W)as[mf[m1[m2[S0[S4 S8]]]]].
13- exists mf,b;split.
14- - eapply store_preserves_writable12;[|exact S8]. eapply store_preserves_writable12;[|exact S4]. eapply store_preserves_writable12;[exact W|exact S0].
15- - split.
16- + erewrite Mem.load_store_other by(exact S8||(cbn[size_chunk];intuition lia)). erewrite Mem.load_store_other by(exact S4||(cbn[size_chunk];intuition lia)). erewrite Mem.load_store_same by exact S0;reflexivity.
17- + split.
18- * erewrite Mem.load_store_other by(exact S8||(cbn[size_chunk];intuition lia)). erewrite Mem.load_store_same by exact S4;reflexivity.
19- * erewrite Mem.load_store_same by exact S8;reflexivity.
20-Qed.
