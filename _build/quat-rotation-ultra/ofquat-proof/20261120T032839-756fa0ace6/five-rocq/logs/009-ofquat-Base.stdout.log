BEFOREPQ
1 goal
  
  e : PTree.tree (block * type)
  m : mem
  bp, bq : block
  qi : float32
  LQ : e ! _q = Some (bp, qtype)
  PQ : Mem.load Mptr m bp 0 = Some (Vptr bq Ptrofs.zero)
  QI : Mem.load Mfloat32 m bq 0 = Some (Vsingle qi)
  ============================
  match
    match
      match
        (if
          type_eq
            (Tstruct _FloatQuat
               {| attr_volatile := false; attr_alignas := None |})
            (typeof
               (Ederef
                  (Evalof
                     (Evar _q
                        (Tpointer
                           (Tstruct _FloatQuat
                              {|
                                attr_volatile := false; attr_alignas := None
                              |})
                           {| attr_volatile := false; attr_alignas := None |}))
                     (Tpointer
                        (Tstruct _FloatQuat
                           {| attr_volatile := false; attr_alignas := None |})
                        {| attr_volatile := false; attr_alignas := None |}))
                  (Tstruct _FloatQuat
                     {| attr_volatile := false; attr_alignas := None |})))
         then
          match
            match
              (if
                type_eq
                  (Tpointer
                     (Tstruct _FloatQuat
                        {| attr_volatile := false; attr_alignas := None |})
                     {| attr_volatile := false; attr_alignas := None |})
                  (typeof
                     (Evar _q
                        (Tpointer
                           (Tstruct _FloatQuat
                              {|
                                attr_volatile := false; attr_alignas := None
                              |})
                           {| attr_volatile := false; attr_alignas := None |})))
               then
                match
                  (if
                    type_eq
                      (Tpointer
                         (Tstruct _FloatQuat
                            {|
                              attr_volatile := false; attr_alignas := None
                            |})
                         {| attr_volatile := false; attr_alignas := None |})
                      qtype
                   then Some (bp, Ptrofs.zero, Full)
                   else None)
                with
                | Some (b, ofs, bf) =>
                    match
                      match bf with
                      | Full =>
                          match
                            (if zle (...) Ptrofs.modulus
                             then Mem.load Mptr m b (...)
                             else None)
                          with
                          | Some v =>
                              Some (PureDenotation.quiet_world, E0, v)
                          | None => None
                          end
                      | Bits _ _ _ _ => None
                      end
                    with
                    | Some (_, _, v) => Some v
                    | None => None
                    end
                | None => None
                end
               else None)
            with
            | Some (Vptr b ofs) => Some (b, ofs, Full)
            | _ => None
            end
          with
          | Some (b, ofs, bf) =>
              match
                match bf with
                | Full => Some (PureDenotation.quiet_world, E0, Vptr b ofs)
                | Bits _ _ _ _ => None
                end
              with
              | Some (_, _, v) => Some v
              | None => None
              end
          | None => None
          end
         else None)
      with
      | Some (Vptr b ofs) =>
          match
            typeof
              (Evalof
                 (Ederef
                    (Evalof
                       (Evar _q
                          (Tpointer
                             (Tstruct _FloatQuat
                                {|
                                  attr_volatile := false;
                                  attr_alignas := None
                                |})
                             {|
                               attr_volatile := false; attr_alignas := None
                             |}))
                       (Tpointer
                          (Tstruct _FloatQuat
                             {|
                               attr_volatile := false; attr_alignas := None
                             |})
                          {| attr_volatile := false; attr_alignas := None |}))
                    (Tstruct _FloatQuat
                       {| attr_volatile := false; attr_alignas := None |}))
                 (Tstruct _FloatQuat
                    {| attr_volatile := false; attr_alignas := None |}))
          with
          | Tstruct sid _ =>
              match ge ! sid with
              | Some co =>
                  match field_offset ge _qi (co_members co) with
                  | OK (delta, bf) =>
                      Some (b, Ptrofs.add ofs (Ptrofs.repr delta), bf)
                  | Error _ => None
                  end
              | None => None
              end
          | Tunion sid _ =>
              match ge ! sid with
              | Some co =>
                  match union_field_offset ge _qi (co_members co) with
                  | OK (delta, bf) =>
                      Some (b, Ptrofs.add ofs (Ptrofs.repr delta), bf)
                  | Error _ => None
                  end
              | None => None
              end
          | _ => None
          end
      | _ => None
      end
    with
    | Some (b, ofs, bf) =>
        match
          match bf with
          | Full =>
              match
                match tfloat with
                | Tvoid => By_nothing
                | Tint I8 Signed _ => By_value Mint8signed
                | Tint I8 Unsigned _ => By_value Mint8unsigned
                | Tint I16 Signed _ => By_value Mint16signed
                | Tint I16 Unsigned _ => By_value Mint16unsigned
                | Tint I32 _ _ => By_value Mint32
                | Tint IBool _ _ => By_value Mbool
                | Tlong _ _ => By_value Mint64
                | Tfloat F32 _ => By_value Mfloat32
                | Tfloat F64 _ => By_value Mfloat64
                | Tpointer _ _ => By_value Mptr
                | Tarray _ _ _ | Tfunction _ _ _ => By_reference
                | _ => By_copy
                end
              with
              | By_value chunk =>
                  if
                   match
                     match tfloat with
                     | Tvoid => By_nothing
                     | Tint I8 Signed _ => By_value Mint8signed
                     | Tint I8 Unsigned _ => By_value Mint8unsigned
                     | Tint I16 Signed _ => By_value Mint16signed
                     | Tint I16 Unsigned _ => By_value Mint16unsigned
                     | Tint I32 _ _ => By_value Mint32
                     | Tint IBool _ _ => By_value Mbool
                     | Tlong _ _ => By_value Mint64
                     | Tfloat F32 _ => By_value Mfloat32
                     | Tfloat F64 _ => By_value Mfloat64
                     | Tpointer _ _ => By_value Mptr
                     | Tarray _ _ _ | Tfunction _ _ _ => By_reference
                     | _ => By_copy
                     end
                   with
                   | By_value _ =>
                       let (attr_volatile, _) :=
                         match tfloat with
                         | Tint _ _ a | Tlong _ a | 
                           Tfloat _ a | Tpointer _ a | 
                           Tarray _ _ a | Tstruct _ a | 
                           Tunion _ a => a
                         | _ =>
                             {|
                               attr_volatile := false; attr_alignas := None
                             |}
                         end in
                       attr_volatile
                   | _ => false
                   end
                  then
                   do_volatile_load ge PureDenotation.quiet_world chunk m b
                     ofs
                  else
                   match
                     (if
                       zle (Ptrofs.unsigned ofs + size_chunk chunk)
                         Ptrofs.modulus
                      then Mem.load chunk m b (Ptrofs.unsigned ofs)
                      else None)
                   with
                   | Some v => Some (PureDenotation.quiet_world, E0, v)
                   | None => None
                   end
              | By_nothing => None
              | _ => Some (PureDenotation.quiet_world, E0, Vptr b ofs)
              end
          | Bits sz sg pos width =>
              match tfloat with
              | Tint sz1 sg1 _ =>
                  if
                   intsize_eq sz1 sz &&
                   signedness_eq sg1
                     (if zlt width (bitsize_intsize sz) then Signed else sg) &&
                   zle 0 pos && zlt 0 width && zle width (bitsize_intsize sz) &&
                   zle (pos + width) (bitsize_carrier sz)
                  then
                   match
                     (if
                       zle
                         (Ptrofs.unsigned ofs +
                          size_chunk (chunk_for_carrier sz))
                         Ptrofs.modulus
                      then
                       Mem.load (chunk_for_carrier sz) m b
                         (Ptrofs.unsigned ofs)
                      else None)
                   with
                   | Some (Vint c) =>
                       Some
                         (PureDenotation.quiet_world, E0,
                          Vint (bitfield_extract sz sg pos width c))
                   | _ => None
                   end
                  else None
              | _ => None
              end
          end
        with
        | Some (_, _, v) => Some v
        | None => None
        end
    | None => None
    end
  with
  | Some w =>
      sem_binary_operation ge Omul
        (Vfloat (Float.of_bits (Int64.repr 4609047870845172685)))
        (typeof
           (Eval (Vfloat (Float.of_bits (Int64.repr 4609047870845172685)))
              tdouble))
        w
        (typeof
           (Evalof
              (Efield
                 (Evalof
                    (Ederef
                       (Evalof
                          (Evar _q
                             (Tpointer
                                (Tstruct _FloatQuat
                                   {|
                                     attr_volatile := false;
                                     attr_alignas := None
                                   |})
                                {|
                                  attr_volatile := false;
                                  attr_alignas := None
                                |}))
                          (Tpointer
                             (Tstruct _FloatQuat
                                {|
                                  attr_volatile := false;
                                  attr_alignas := None
                                |})
                             {|
                               attr_volatile := false; attr_alignas := None
                             |}))
                       (Tstruct _FloatQuat
                          {| attr_volatile := false; attr_alignas := None |}))
                    (Tstruct _FloatQuat
                       {| attr_volatile := false; attr_alignas := None |}))
                 _qi tfloat)
              tfloat))
        m
  | None => None
  end =
  Some
    (Vfloat
       (Float.mul (Float.of_bits (Int64.repr 4609047870845172685))
          (Float.of_single qi)))
