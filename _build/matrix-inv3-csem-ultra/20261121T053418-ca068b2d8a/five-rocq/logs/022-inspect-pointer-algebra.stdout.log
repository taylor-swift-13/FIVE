Ptrofs.add_assoc
     : forall x y z : ptrofs,
       Ptrofs.add (Ptrofs.add x y) z = Ptrofs.add x (Ptrofs.add y z)
Ptrofs.add_unsigned
     : forall x y : ptrofs,
       Ptrofs.add x y =
       Ptrofs.repr (BinInt.Z.add (Ptrofs.unsigned x) (Ptrofs.unsigned y))
Ptrofs.add =
fun x y : ptrofs =>
Ptrofs.repr (BinInt.Z.add (Ptrofs.unsigned x) (Ptrofs.unsigned y))
     : ptrofs -> ptrofs -> ptrofs

Arguments Ptrofs.add x y
