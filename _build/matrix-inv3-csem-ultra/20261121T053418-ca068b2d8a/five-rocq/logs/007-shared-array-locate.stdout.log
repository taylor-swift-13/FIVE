#!/usr/bin/env python3
"""Exact dependency snapshots and strict Rocq theorem/goal receipts.

Use check(config, record_run=RUN_DIR), or this module's CLI. A recorded invocation
adds measured commands to an already-open five-rocq phase. The caller finishes
that phase after all work; this utility never fabricates a completed run status.
"""
from pathlib import Path
import argparse
import hashlib
import json
import re
import shutil
import subprocess
import sys
import tempfile

IDENT = r'[A-Za-z_][A-Za-z_0-9]*(?:\.[A-Za-z_][A-Za-z_0-9]*)*'


def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def dump(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + '\n')


def imports(path):
    """Read static Require imports without interpreting or rewriting Rocq."""
    source = re.sub(r'\(\*.*?\*\)', '', Path(path).read_text(), flags=re.S)
    result = []
    pattern = r'From\s+(' + IDENT + r')\s+Require\s+(?:Import\s+|Export\s+)?([A-Za-z0-9_.\s]+?)\.(?=\s|$)'
    for prefix, names in re.findall(pattern, source):
        result.extend(prefix + '.' + name for name in names.split())
    source = re.sub(pattern, '', source)
    pattern = r'Require\s+(?:Import\s+|Export\s+)?([A-Za-z0-9_.\s]+?)\.(?=\s|$)'
    for names in re.findall(pattern, source):
        result.extend(names.split())
    return result


def _resolve_path(root, value):
    path = (root / value).resolve()
    if not path.is_relative_to(root):
        raise ValueError('Source outside repository: ' + str(path))
    return path


def dependency_order(root, mappings, modules, roots):
    """Resolve the requested imports; installed Stdlib/CompCert stay external."""
    order, seen, active = [], set(), set()
    def resolve(name):
        if name in modules:
            return _resolve_path(root, modules[name])
        prefixes = [prefix for prefix in mappings if name.startswith(prefix + '.')]
        if not prefixes:
            if name.startswith(('Stdlib.', 'Coq.', 'compcert.', 'Flocq.')):
                return None
            raise ValueError('Unmapped project import: ' + name)
        prefix = max(prefixes, key=len)
        return _resolve_path(root, mappings[prefix]).joinpath(*name[len(prefix) + 1:].split('.')).with_suffix('.v')
    def visit(name):
        if name in seen:
            return
        path = resolve(name)
        if path is None:
            return
        if name in active:
            raise ValueError('Cyclic project import: ' + name)
        if not path.is_file():
            raise FileNotFoundError(str(path))
        active.add(name)
        for child in imports(path):
            visit(child)
        active.remove(name)
        seen.add(name)
        order.append((name, path))
    for name in roots:
        visit(name)
    if not order:
        raise ValueError('Empty proof dependency closure')
    return order


def _safe_capture(run, path, role):
    """Do not reuse an input-copy name with different bytes."""
    path = Path(path).resolve()
    role = re.sub(r'[^A-Za-z0-9_.-]+', '-', role)
    target = run.folder / 'inputs' / (role + '--' + path.name)
    if target.exists() and digest(target) != digest(path):
        raise ValueError('Immutable run input-copy conflict: ' + str(target))
    prior = run.read('inputs/manifest.json')
    existing = [row for row in prior if row.get('source') == str(path)]
    if existing and any(row.get('sha256') != digest(path) for row in existing):
        raise ValueError('Source changed within a proof run: ' + str(path))
    if not existing:
        run.capture(path, role, area='inputs')


def _check_configuration(config, root):
    required = ('attempt', 'namespace', 'mappings', 'modules', 'imports', 'goal_bindings')
    for key in required:
        if not config.get(key):
            raise ValueError('Missing configuration: ' + key)
    namespace = config['namespace']
    if not re.fullmatch(IDENT, namespace):
        raise ValueError('Invalid certificate namespace')
    goals = config['goal_bindings']
    names = [row.get('requested_goal') for row in goals]
    if len(set(names)) != len(names) or not all(isinstance(name, str) and name for name in names):
        raise ValueError('Missing or duplicate requested goals')
    for row in goals:
        if not re.fullmatch(IDENT, str(row.get('theorem', ''))):
            raise ValueError('Invalid theorem name')
        ty = row.get('type')
        if not isinstance(ty, str) or not ty.strip() or any(t in ty for t in ('(*', '*)', '\n', '\r')) or re.search(r'\.(?:\s|$)', ty):
            raise ValueError('Invalid exact expected Rocq type')
From Coq Require Import Bool List ZArith.
From compcert Require Import Coqlib Errors Maps Integers Floats AST Values Memory Events Globalenvs Determinism Ctypes Cop Csyntax Csem Cexec Cstrategy Smallstep.
From FiveGuidanceSemantics Require Import SemanticsSupport.
From FiveGuidanceAllOrder Require Import PureSyntax.
Import ListNotations.

(** This denotation is used to establish uniqueness of normal executions.
    Execution remains the complete error-preserving operational model. *)
Definition quiet_world: world := World (fun _ _ => None) (fun _ _ _ => None) (fun _ _ _ _ => None).

Section DENOTATION.
Variable ge: genv.
Variable e: env.
Variable m: mem.

Fixpoint pure_rval (a: expr): option val :=
  match a with
  | Eval v _ => Some v
  | Evalof l ty =>
      if type_eq ty (typeof l) then
      match pure_lval l with
      | Some (b,ofs,bf) =>
          match Cexec.do_deref_loc ge quiet_world ty m b ofs bf with
          | Some (_,_,v) => Some v | None => None end
      | None => None end else None
  | Eaddrof l _ =>
      match pure_lval l with Some (b,ofs,Full) => Some (Vptr b ofs) | _ => None end
  | Eunop op a _ =>
      match pure_rval a with Some v => sem_unary_operation op v (typeof a) m | None => None end
  | Ebinop op a b _ =>
      match pure_rval a, pure_rval b with
      | Some v, Some w => sem_binary_operation ge op v (typeof a) w (typeof b) m
      | _,_ => None end
  | Ecast a ty =>
      match pure_rval a with Some v => sem_cast v (typeof a) ty m | None => None end
  | Esizeof ty _ => Some (Vptrofs (Ptrofs.repr (sizeof ge ty)))
  | Ealignof ty _ => Some (Vptrofs (Ptrofs.repr (alignof ge ty)))
  | _ => None
  end
with pure_lval (a: expr): option (block * ptrofs * bitfield) :=
  match a with
  | Eloc b ofs bf _ => Some (b,ofs,bf)
  | Evar id ty =>
      match PTree.get id e with
      | Some (b,ty') => if type_eq ty ty' then Some (b,Ptrofs.zero,Full) else None
      | None => match Genv.find_symbol ge id with Some b => Some (b,Ptrofs.zero,Full) | None => None end end
  | Ederef a _ =>
      match pure_rval a with Some (Vptr b ofs) => Some (b,ofs,Full) | _ => None end
  | Efield a id _ =>
      match pure_rval a with
      | Some (Vptr b ofs) =>
          match typeof a with
          | Tstruct sid _ =>
              match PTree.get sid (genv_cenv ge) with
              | Some co => match field_offset ge id (co_members co) with
                | OK (delta,bf) => Some (b,Ptrofs.add ofs (Ptrofs.repr delta),bf)
                | _ => None end
              | None => None end
          | Tunion sid _ =>
              match PTree.get sid (genv_cenv ge) with
              | Some co => match union_field_offset ge id (co_members co) with
                | OK (delta,bf) => Some (b,Ptrofs.add ofs (Ptrofs.repr delta),bf)
                | _ => None end
              | None => None end
          | _ => None end
      | _ => None end
  | _ => None
  end.

Definition pure_eq (k: kind) (a b: expr): Prop :=
  match k with RV => pure_rval a = pure_rval b | LV => pure_lval a = pure_lval b end.

Lemma context_type_eq:
  forall from to C, context from to C -> forall a b,
  typeof a = typeof b -> typeof (C a) = typeof (C b).
Proof. induction 1; simpl; intros; auto. Qed.

Lemma pure_context_congr:
  forall from to C, context from to C -> forall a b,
  typeof a = typeof b -> pure_eq from a b -> pure_eq to (C a) (C b).
Proof.
  induction 1; simpl; intros a b HT HE; auto;
    try (rewrite (IHcontext a b HT HE); reflexivity);
    try (rewrite (context_type_eq _ _ _ H a b HT), (IHcontext a b HT HE); reflexivity).
Qed.

End DENOTATION.

Lemma simple_context_hole:
  forall from to C, context from to C -> forall a,
  simple (C a) = true -> simple a = true.
Proof.
  induction 1; simpl; intros a HA; core_unpack; try discriminate; eauto.
Qed.

Lemma pure_lred:
  forall ge e a m a' m', lred ge e a m a' m' ->
  m' = m /\ typeof a' = typeof a /\ simple a' = true /\
  pure_lval ge e m a = pure_lval ge e m a'.
Proof.
  intros ge e a m a' m' H; inversion H; subst; simpl; repeat split; auto;
    try rewrite H0; try rewrite H1; try rewrite H2; try rewrite dec_eq_true; auto.
Qed.

Lemma pure_rred:
  forall ge e a m t a' m', simple a = true -> rred ge a m t a' m' ->
  m' = m /\ t = E0 /\ typeof a' = typeof a /\ simple a' = true /\
  pure_rval ge e m a = pure_rval ge e m a'.
Proof.
  intros ge e a m t a' m' HA HR; inversion HR; subst; simpl in HA; core_unpack; try discriminate;
