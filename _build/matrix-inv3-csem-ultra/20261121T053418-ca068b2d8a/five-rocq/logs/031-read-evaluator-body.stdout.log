7:Fixpoint stmt_eval (ge:genv) (e:env) (ret:type) (s:statement) (m:mem): option (normal_outcome * mem) :=
8-  match s with
9-  | Sskip => Some (Nnormal,m)
10-  | Sdo a => match atomic_eval ge e m a with Some (_,m') => Some (Nnormal,m') | None => None end
11-  | Ssequence s1 s2 =>
12-      match stmt_eval ge e ret s1 m with
13-      | Some (Nnormal,m') => stmt_eval ge e ret s2 m'
14-      | Some (Nreturn v,m') => Some (Nreturn v,m')
15-      | None => None end
16-  | Sifthenelse a s1 s2 =>
17-      match pure_rval ge e m a with
18-      | Some v => match bool_val v (typeof a) m with
19-        | Some b => stmt_eval ge e ret (if b then s1 else s2) m
20-        | None => None end
21-      | None => None end
22-  | Sreturn None => Some (Nreturn Vundef,m)
23-  | Sreturn (Some a) =>
24-      match pure_rval ge e m a with
25-      | Some v => match sem_cast v (typeof a) ret m with
26-          | Some v' => Some (Nreturn v',m) | None => None end
27-      | None => None end
28-  | _ => None
29-  end.
