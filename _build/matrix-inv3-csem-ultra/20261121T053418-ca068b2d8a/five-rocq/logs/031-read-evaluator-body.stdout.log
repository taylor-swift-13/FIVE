82-Fixpoint normal_stmt (s:statement): bool :=
83-  match s with
84-  | Sskip | Sreturn None => true
85-  | Sdo a => atomic_expr a
86-  | Sreturn (Some a) => simple a
87-  | Ssequence s1 s2 => normal_stmt s1 && normal_stmt s2
88-  | Sifthenelse a s1 s2 => simple a && normal_stmt s1 && normal_stmt s2
89-  | _ => false end.
90-Fixpoint normal_cont (k:cont): bool :=
91-  match k with Kstop => true | Kseq s k => normal_stmt s && normal_cont k | _ => false end.
92-Definition normal_state (S:Csem.state): bool :=
93-  match S with
94-  | State _ s k _ _ => normal_stmt s && normal_cont k
95-  | ExprState _ a (Kdo k) _ _ => atomic_expr a && normal_cont k
96-  | ExprState _ a (Kreturn k) _ _ => simple a && normal_cont k
97-  | ExprState _ a (Kifthenelse s1 s2 k) _ _ => simple a && normal_stmt s1 && normal_stmt s2 && normal_cont k
98-  | ExprState _ _ _ _ _ => false
99:  | Callstate (Internal f) _ Kstop _ => normal_stmt (fn_body f)
100-  | Returnstate _ Kstop _ | Stuckstate => true
101-  | _ => false end.
