144-(** Left reduction contexts. These contexts allow reducing to the right
145-  of a binary operator only if the left subexpression is simple. *)
146-
147-Inductive leftcontext: kind -> kind -> (expr -> expr) -> Prop :=
148-  | lctx_top: forall k,
149-      leftcontext k k (fun x => x)
150-  | lctx_deref: forall k C ty,
151-      leftcontext k RV C -> leftcontext k LV (fun x => Ederef (C x) ty)
152-  | lctx_field: forall k C f ty,
153-      leftcontext k RV C -> leftcontext k LV (fun x => Efield (C x) f ty)
154-  | lctx_rvalof: forall k C ty,
155-      leftcontext k LV C -> leftcontext k RV (fun x => Evalof (C x) ty)
156-  | lctx_addrof: forall k C ty,
157-      leftcontext k LV C -> leftcontext k RV (fun x => Eaddrof (C x) ty)
158-  | lctx_unop: forall k C op ty,
159-      leftcontext k RV C -> leftcontext k RV (fun x => Eunop op (C x) ty)
160-  | lctx_binop_left: forall k C op e2 ty,
161-      leftcontext k RV C -> leftcontext k RV (fun x => Ebinop op (C x) e2 ty)
162-  | lctx_binop_right: forall k C op e1 ty,
163-      simple e1 = true -> leftcontext k RV C ->
164-      leftcontext k RV (fun x => Ebinop op e1 (C x) ty)
165-  | lctx_cast: forall k C ty,
166-      leftcontext k RV C -> leftcontext k RV (fun x => Ecast (C x) ty)
167-  | lctx_seqand: forall k C r2 ty,
168-      leftcontext k RV C -> leftcontext k RV (fun x => Eseqand (C x) r2 ty)
169-  | lctx_seqor: forall k C r2 ty,
170-      leftcontext k RV C -> leftcontext k RV (fun x => Eseqor (C x) r2 ty)
171-  | lctx_condition: forall k C r2 r3 ty,
172-      leftcontext k RV C -> leftcontext k RV (fun x => Econdition (C x) r2 r3 ty)
173-  | lctx_assign_left: forall k C e2 ty,
174-      leftcontext k LV C -> leftcontext k RV (fun x => Eassign (C x) e2 ty)
175-  | lctx_assign_right: forall k C e1 ty,
176-      simple e1 = true -> leftcontext k RV C ->
177-      leftcontext k RV (fun x => Eassign e1 (C x) ty)
178-  | lctx_assignop_left: forall k C op e2 tyres ty,
179-      leftcontext k LV C -> leftcontext k RV (fun x => Eassignop op (C x) e2 tyres ty)
180-  | lctx_assignop_right: forall k C op e1 tyres ty,
181-      simple e1 = true -> leftcontext k RV C ->
182-      leftcontext k RV (fun x => Eassignop op e1 (C x) tyres ty)
183-  | lctx_postincr: forall k C id ty,
184-      leftcontext k LV C -> leftcontext k RV (fun x => Epostincr id (C x) ty)
185-  | lctx_call_left: forall k C el ty,
186-      leftcontext k RV C -> leftcontext k RV (fun x => Ecall (C x) el ty)
187-  | lctx_call_right: forall k C e1 ty,
188-      simple e1 = true -> leftcontextlist k C ->
189-      leftcontext k RV (fun x => Ecall e1 (C x) ty)
190-  | lctx_builtin: forall k C ef tyargs ty,
191-      leftcontextlist k C ->
192-      leftcontext k RV (fun x => Ebuiltin ef tyargs (C x) ty)
193-  | lctx_comma: forall k C e2 ty,
194-      leftcontext k RV C -> leftcontext k RV (fun x => Ecomma (C x) e2 ty)
195-  | lctx_paren: forall k C tycast ty,
196-      leftcontext k RV C -> leftcontext k RV (fun x => Eparen (C x) tycast ty)
197-
198-with leftcontextlist: kind -> (expr -> exprlist) -> Prop :=
199-  | lctx_list_head: forall k C el,
200-      leftcontext k RV C -> leftcontextlist k (fun x => Econs (C x) el)
201-  | lctx_list_tail: forall k C e1,
202-      simple e1 = true -> leftcontextlist k C ->
203-      leftcontextlist k (fun x => Econs e1 (C x)).
204-
205-Lemma leftcontext_context:
206-  forall k1 k2 C, leftcontext k1 k2 C -> context k1 k2 C
207-with leftcontextlist_contextlist:
208-  forall k C, leftcontextlist k C -> contextlist k C.
209-Proof.
210-  induction 1; constructor; auto.
211-  induction 1; constructor; auto.
212-Qed.
