2304-Definition do_initial_state (p: program): option (genv * state) :=
2305-  let ge := globalenv p in
2306-  do m0 <- Genv.init_mem p;
2307-  do b <- Genv.find_symbol ge p.(prog_main);
2308-  do f <- Genv.find_funct_ptr ge b;
2309-  check (type_eq (type_of_fundef f) (Tfunction nil type_int32s cc_default));
2310-  Some (ge, Callstate f nil Kstop m0).
