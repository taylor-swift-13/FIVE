1882:Theorem shr_and_shru_and:
1883-  forall x y z,
1884-  shru (shl z y) y = z ->
1885-  and (shr x y) z = and (shru x y) z.
1886-Proof.
1887-  intros.
1888-  rewrite <- H.
1889-  rewrite and_shru. rewrite and_shr_shru. auto.
1890-Qed.
