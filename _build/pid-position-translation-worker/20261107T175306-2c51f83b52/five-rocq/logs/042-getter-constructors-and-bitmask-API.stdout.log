1947-      evalinf_expr e m' RV a2 t2 ->
1948-      evalinf_expr e m RV (Eseqand a1 a2 ty) (t1***t2)
1949-  | evalinf_seqor: forall e m a1 a2 ty t1,
1950-      evalinf_expr e m RV a1 t1 ->
1951-      evalinf_expr e m RV (Eseqor a1 a2 ty) t1
1952-  | evalinf_seqor_2: forall e m a1 a2 ty t1 m' a1' v1 t2,
1953-      eval_expr e m RV a1 t1 m' a1' -> eval_simple_rvalue ge e m' a1' v1 ->
1954-      bool_val v1 (typeof a1) m' = Some false ->
1955-      evalinf_expr e m' RV a2 t2 ->
1956-      evalinf_expr e m RV (Eseqor a1 a2 ty) (t1***t2)
1957-  | evalinf_condition: forall e m a1 a2 a3 ty t1,
1958-      evalinf_expr e m RV a1 t1 ->
1959-      evalinf_expr e m RV (Econdition a1 a2 a3 ty) t1
1960-  | evalinf_condition_2: forall e m a1 a2 a3 ty t1 m' a1' v1 t2 b,
1961-      eval_expr e m RV a1 t1 m' a1' -> eval_simple_rvalue ge e m' a1' v1 ->
1962-      bool_val v1 (typeof a1) m' = Some b ->
1963-      evalinf_expr e m' RV (if b then a2 else a3) t2 ->
1964-      evalinf_expr e m RV (Econdition a1 a2 a3 ty) (t1***t2)
1965-  | evalinf_assign_left: forall e m a1 t1 a2 ty,
1966-      evalinf_expr e m LV a1 t1 ->
1967-      evalinf_expr e m RV (Eassign a1 a2 ty) t1
1968-  | evalinf_assign_right: forall e m a1 t1 m' a1' a2 t2 ty,
1969-      eval_expr e m LV a1 t1 m' a1' -> evalinf_expr e m' RV a2 t2 ->
1970-      evalinf_expr e m RV (Eassign a1 a2 ty) (t1 *** t2)
