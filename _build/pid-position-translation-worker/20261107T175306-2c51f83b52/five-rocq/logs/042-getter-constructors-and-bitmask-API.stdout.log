1916-CoInductive evalinf_expr: env -> mem -> kind -> expr -> traceinf -> Prop :=
1917-  | evalinf_field: forall e m a t f ty,
1918-      evalinf_expr e m RV a t ->
1919-      evalinf_expr e m LV (Efield a f ty) t
1920-  | evalinf_valof: forall e m a t ty,
1921-      evalinf_expr e m LV a t ->
1922-      evalinf_expr e m RV (Evalof a ty) t
1923-  | evalinf_deref: forall e m a t ty,
1924-      evalinf_expr e m RV a t ->
1925-      evalinf_expr e m LV (Ederef a ty) t
1926-  | evalinf_addrof: forall e m a t ty,
1927-      evalinf_expr e m LV a t ->
1928-      evalinf_expr e m RV (Eaddrof a ty) t
1929-  | evalinf_unop: forall e m a t op ty,
1930-      evalinf_expr e m RV a t ->
