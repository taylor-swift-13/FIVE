 assert(FRAME:same_except_positions_and_return gh ret a b)by(eapply witness_replays_related;eauto).
 assert(TX:AxisTranslation gh a b S._x 25600).
 { exists(Int.repr 512),Int.zero,(Int.repr 26112),(Int.repr 25600).
