 load_global Mint32 mf S._guidance_pid_pos_err vec_type[S._x]=Some(Vint(ClampSemantics.clamp_bits(Int.sub rx px)(Int.repr 4096))) /\
 load_global Mint32 mf S._guidance_pid_pos_err vec_type[S._y]=Some(Vint(ClampSemantics.clamp_bits(Int.sub ry py)(Int.repr 4096))) /\
 load_global Mint32 mf S._guidance_pid_speed_err vec_type[S._x]=Some(Vint(ClampSemantics.clamp_bits(Int.sub sx vx)(Int.repr 8388608))) /\
 load_global Mint32 mf S._guidance_pid_speed_err vec_type[S._y]=Some(Vint(ClampSemantics.clamp_bits(Int.sub sy vy)(Int.repr 8388608))) /\
 load_path Mint32 mf gh gh_type[S._ref;S._pos;S._x]=Some(Vint rx) /\
 load_path Mint32 mf gh gh_type[S._ref;S._pos;S._y]=Some(Vint ry) /\
 Genv.find_symbol E.ge S._guidance_pid_pos_err=Some be /\
 Genv.find_symbol E.ge S._guidance_pid_speed_err=Some bs /\
 stack_shape m mf 15%nat /\
 (forall b ofs n,Mem.valid_block m b ->b<>ret ->
 (b<>be \/ofs+n<=0 \/8<=ofs) ->(b<>bs \/ofs+n<=0 \/8<=ofs) ->
 (b<>cid_pid _ _ D \/ofs+n<=32 \/40<=ofs) ->(b<>cid_i _ _ D \/ofs+n<=0 \/8<=ofs) ->
 0<=n ->Mem.loadbytes mf b ofs n=Mem.loadbytes m b ofs n) /\
 Mem.loadbytes mf (cid_i _ _ D) 0 4=Some(encode_val Mint32(Vint(entry_axis_integral m gh D flight rx px sx vx(cid_ix _ _ D)))) /\
 Mem.loadbytes mf (cid_i _ _ D) 4 4=Some(encode_val Mint32(Vint(entry_axis_integral m gh D flight ry py sy vy(cid_iy _ _ D)))) /\
 Mem.loadbytes mf (cid_pid _ _ D) 32 4=Some(encode_val Mint32(Vint(entry_axis_command m gh D flight rx px sx vx(cid_ax _ _ D)(cid_ix _ _ D)))) /\
 Mem.loadbytes mf (cid_pid _ _ D) 36 4=Some(encode_val Mint32(Vint(entry_axis_command m gh D flight ry py sy vy(cid_ay _ _ D)(cid_iy _ _ D)))) /\
 Mem.loadbytes mf be 0 4=Some(encode_val Mint32(Vint(ClampSemantics.clamp_bits(Int.sub rx px)(Int.repr 4096)))) /\
 Mem.loadbytes mf be 4 4=Some(encode_val Mint32(Vint(ClampSemantics.clamp_bits(Int.sub ry py)(Int.repr 4096)))) /\
 Mem.loadbytes mf bs 0 4=Some(encode_val Mint32(Vint(ClampSemantics.clamp_bits(Int.sub sx vx)(Int.repr 8388608)))) /\
 Mem.loadbytes mf bs 4 4=Some(encode_val Mint32(Vint(ClampSemantics.clamp_bits(Int.sub sy vy)(Int.repr 8388608)))).
Proof.
 intros m gh ret flight D GOOD.
 destruct D as[bp bi bt bu bh bfun kp kd ki kv ka ax ay ix iy h heading
 SP SI ST SU SH SF FF APP KP KD KI KV KA AX AY IX IY LT LU HEAD CAST HB WP WI].
