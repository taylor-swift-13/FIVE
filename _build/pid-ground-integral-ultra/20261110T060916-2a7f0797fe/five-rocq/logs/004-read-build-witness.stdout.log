 cid_total_limit:Mem.load Mint32 m cid_total 0=Some(Vint(Int.repr 3216));
 cid_heading_load:Mem.load Mfloat32 m cid_heading 28=Some(Vsingle cid_h);
 cid_heading_cast:forall mm,sem_cast(Vsingle(Float32.mul cid_h(Float32.of_int(Int.repr 4096))))tfloat tint mm=Some(Vint cid_hbits);
 cid_heading_bound:-12288<=Int.signed cid_hbits<=12288;
