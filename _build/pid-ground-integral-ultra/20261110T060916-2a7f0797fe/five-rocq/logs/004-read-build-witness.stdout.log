FILE check.py
#!/usr/bin/env python3
"""Cold-check immutable copies of the actual PID proof dependency closure.

Default: six relation goals and the two model aliases.  --cbmc adds the
model recheck proof once it exists.  --publish writes fresh, hash-bound
reference receipts; normal replay leaves the published receipts untouched.
An open --run lets the Ultra proof author retain its real phase accounting.
"""
from pathlib import Path
import argparse, hashlib, importlib.util, json, re, shlex, shutil, sys
from datetime import datetime, timezone

ATTEMPT = Path(__file__).resolve().parent
ROOT = ATTEMPT.parents[4]
sys.path.insert(0, str(ROOT / 'scripts'))
from five_telemetry import Run
from example_proof_gate import certificate_source, input_index

def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()

def dump(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')

def relative(path):
    return str(Path(path).resolve().relative_to(ROOT))

def config():
    p = ATTEMPT / 'core/BuildConfiguration.py'
    spec = importlib.util.spec_from_file_location('pid_build_configuration', p)
    obj = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(obj)
    pairs = list(obj.LOADPATHS)
    case = 'paparazzi/models/guidance_pid_h_run_pos/rocq'
    for name, prefix in [('no_error', 'PidPositionRunPosNoError'),
                         ('termination', 'PidPositionRunPosTermination'),
                         ('cbmc_recheck', 'PidPositionRunPosCBMC')]:
        pairs += [(f'{case}/{name}/problem', prefix + 'Problem'),
                  (f'{case}/{name}/attempts/002', prefix + 'Attempt002')]
    return pairs

def module(path, pairs):
    options = [(len(str(ROOT / d)), d, prefix) for d, prefix in pairs
               if Path(path).is_relative_to(ROOT / d)]
    if not options:
        raise ValueError('No explicit namespace for ' + str(path))
    _, directory, prefix = max(options)
    return prefix + '.' + '.'.join(Path(path).relative_to(ROOT / directory).with_suffix('').parts)

def problems(with_cbmc):
    aliases = ['position_translation', 'no_error', 'all_successor_termination',
               'input_nonvacuity', 'nonzero_nonvacuity', 'relational_frame']
    status = json.loads((ATTEMPT.parent.parent / 'problem/status.json').read_text())
    rel = {'attempt': ATTEMPT, 'problem': ATTEMPT.parent.parent / 'problem',
           'imports': ['PidPositionTranslationProblem.Spec', 'PidPositionTranslationAttempt002.Proof'],
           'bindings': [{'requested_goal': goal,
                         'theorem': 'PidPositionTranslationAttempt002.Proof.' + alias,
                         'type': 'PidPositionTranslationProblem.Spec.' + goal}
                        for goal, alias in zip(status['requested_goals'], aliases)]}
    assert len(rel['bindings']) == 6
    result = [rel]
    case = ROOT / 'paparazzi/models/guidance_pid_h_run_pos/rocq'
    kinds = [('no_error', 'PidPositionRunPosNoError'),
             ('termination', 'PidPositionRunPosTermination')]
    if with_cbmc:
        kinds.append(('cbmc_recheck', 'PidPositionRunPosCBMC'))
    for name, prefix in kinds:
        base = case / name
        proof = base / 'attempts/002/Proof.v'
        if not proof.is_file():
            raise FileNotFoundError(proof)
        goals = json.loads((base / 'problem/status.json').read_text())['requested_goals']
        explicit = proof.parent / 'evidence/expected-bindings.json'
        if explicit.is_file():
            declared = json.loads(explicit.read_text())
            if [b['requested_goal'] for b in declared['bindings']] != goals:
                raise ValueError('Explicit bindings differ from canonical requested goals')
            result.append({'attempt': proof.parent, 'problem': base / 'problem',
                           'imports': declared['imports'], 'bindings': declared['bindings']})
            continue
        declarations = re.findall(r'(?:Theorem|Lemma)\s+([A-Za-z_][A-Za-z_0-9]*)\s*:\s*'
                                  + re.escape(prefix + 'Problem.Spec.RequestedGoal'), proof.read_text())
        if len(goals) != 1 or len(declarations) != 1:
            raise ValueError('Model alias requires one exact RequestedGoal theorem: ' + str(proof))
        result.append({'attempt': proof.parent, 'problem': base / 'problem',
                       'imports': [prefix + 'Problem.Spec', prefix + 'Attempt002.Proof'],
                       'bindings': [{'requested_goal': goals[0],
                                     'theorem': prefix + 'Attempt002.Proof.' + declarations[0],
                                     'type': prefix + 'Problem.Spec.RequestedGoal'}]})
    return result

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run', type=Path, help='existing open, metered proof-author run')
    parser.add_argument('--publish', action='store_true')
    parser.add_argument('--cbmc', action='store_true')
    parser.add_argument('--plan', action='store_true', help='dependency plan only; no proof acceptance')
    parser.add_argument('--timeout', type=int, default=360)
    args = parser.parse_args()
    pairs = config()
    flags = [x for d, n in pairs for x in ['-Q', d, n]]
    groups = problems(args.cbmc)
    owned = args.run is None
    if args.run:
        run = Run(args.run.resolve())
        if run.read('run.json')['status'] != 'running':
            raise ValueError('Cannot append to a closed historical run')
    else:
        run = Run.start(ROOT / '_build/pid-ultra-cold-checks', 'five-rocq', [],
                        {'scope': 'tool-only cold reproduction, no new mathematical authoring',
                         'requested_proof_model': 'gpt-6.1-sol', 'requested_proof_effort': 'ultra'},
                        invocation_kind='tool-only')
    final = {}
    try:
        if not args.publish and not args.plan:
            for group in groups:
                if (group['attempt'] / 'provenance.json').is_file():
                    _, indexed_sources = input_index(ROOT, group['attempt'])
                    for source, expected in indexed_sources.items():
                        if digest(source) != expected:
                            raise ValueError('Published proof input changed: ' + str(source))
        excluded = {'runs', 'inputs', 'checked', 'exploratory', '__pycache__', 'cold-checks'}
        files = set()
        for directory, _ in pairs:
            base = ROOT / directory
            if base.is_dir():
                for source in base.rglob('*.v'):
                    if set(source.relative_to(base).parts) & excluded:
                        continue
                    if not re.fullmatch('[A-Za-z_][A-Za-z_0-9]*', source.stem):
                        continue
                    files.add(source.resolve())
        roots = [g['attempt'] / 'Proof.v' for g in groups]
        dep = run.command(['rocq', 'dep', *flags, *[relative(p) for p in sorted(files)]],
                          'cold-proof-dependency-graph', timeout=120, cwd=ROOT)
        graph = {}
        text = (run.folder / dep['stdout']).read_text().replace('\\\n', '')
        for line in text.splitlines():
            if ':' not in line:
                continue
            lhs, rhs = line.split(':', 1)
            targets = shlex.split(lhs)
            if not targets or not targets[0].endswith('.vo'):
                continue
            src = (ROOT / targets[0]).with_suffix('.v').resolve()
            graph[src] = [(ROOT / item).with_suffix('.v').resolve()
                          for item in shlex.split(rhs) if item.endswith('.vo')
                          and (ROOT / item).with_suffix('.v').is_file()]
        order, visiting, done = [], set(), set()
        def visit(source):
            source = source.resolve()
            if source in done:
                return
            if source in visiting:
                raise ValueError('Cyclic source dependency ' + str(source))
            if not source.is_relative_to(ROOT) or '/attempts/001/' in str(source):
                raise ValueError('Forbidden compilation target ' + str(source))
            if source not in graph:
                raise ValueError('Missing local dependency declaration ' + str(source))
            visiting.add(source)
            for child in graph[source]:
                visit(child)
            visiting.remove(source)
            done.add(source)
            order.append(source)
        for source in roots:
            visit(source)
        if args.plan:
            print(json.dumps({'scope': 'dependency plan only, no new validation claim',
                              'sources': [relative(p) for p in order]}, indent=2))
            if owned:
                note = run.folder / 'evidence/dependency-plan.json'
                dump(note, {'sources': [relative(p) for p in order]})
                run.finish('passed', 'Dependency plan only.', {'plan': note})
            return
        stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%f')
        base = (ATTEMPT / 'evidence/cold-checks' if args.publish else ROOT / '_build/pid-ultra-cold-replays') / stamp
        checked = base / 'checked'
        current = {source: digest(source) for source in order}
        snapshots = {}
        for source, expected in current.items():
            target = checked / relative(source)
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(source, target)
            assert digest(target) == expected
            snapshots[source] = target
            run.capture(target, 'cold-dependency-' + stamp + '-' + hashlib.sha256(relative(source).encode()).hexdigest()[:18], area='inputs')
        cold_flags = [x for directory, prefix in pairs
                      for x in ['-Q', relative(checked / directory), prefix]]
        for source in order:
            target = snapshots[source]
            run.command(['rocq', 'compile', '-q', *cold_flags, relative(target)],
                        'cold-compile-' + source.stem, timeout=args.timeout, cwd=ROOT)
        theorem_names = [b['theorem'] for g in groups for b in g['bindings']]
        kernel_modules = list(dict.fromkeys(name.rsplit('.', 1)[0] for name in theorem_names))
        kernel = run.command(['rocq', 'check', '-silent', *cold_flags, *kernel_modules],
                             'cold-independent-proof-kernel', timeout=args.timeout, cwd=ROOT)
        hashes = {relative(snapshots[s]): h for s, h in current.items()}
        proof_receipt = base / 'proof-kernel-evidence.json'
        dump(proof_receipt, {'kind': 'rocq-kernel-check', 'run': relative(run.folder),
                            'command_id': kernel['id'], 'theorems': theorem_names,
                            'statement_artifacts': [relative(snapshots[p.resolve()]) for p in roots],
                            'dependency_sha256': hashes})
        for group in groups:
            target = checked / relative(group['attempt']) / 'CurrentGoalBinding.v'
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(certificate_source(group['imports'], group['bindings']))
            run.capture(target, 'cold-certificate-' + hashlib.sha256(relative(target).encode()).hexdigest()[:18], area='inputs')
            compile_cmd = run.command(['rocq', 'compile', '-q', *cold_flags, relative(target)],
                                      'cold-exact-goalbinding', timeout=args.timeout, cwd=ROOT)
            cert_module = module(group['attempt'] / 'CurrentGoalBinding.v', pairs)
            cert_kernel = run.command(['rocq', 'check', '-silent', *cold_flags, cert_module],
                                      'cold-exact-goalbinding-kernel', timeout=args.timeout, cwd=ROOT)
            cert_receipt = target.parent / 'certificate-kernel-evidence.json'
            dump(cert_receipt, {'kind': 'rocq-kernel-check', 'run': relative(run.folder),
                               'command_id': cert_kernel['id'],
                               'theorems': [cert_module + '.goal_' + str(i) for i in range(len(group['bindings']))],
                               'statement_artifacts': [relative(target)],
                               'dependency_sha256': {**hashes, relative(target): digest(target)}})
            if args.publish:
                manifest = ROOT / 'paparazzi/models/guidance_pid_h_run_pos/align/model/compcert-manifest.json'
                semantic = json.loads(manifest.read_text())['semantic_dependencies']
                indexed = {relative(p): h for p, h in current.items()}
                for p in [Path(__file__).resolve(), manifest,
                          ATTEMPT / 'core/BuildConfiguration.py',
                          group['attempt'] / 'check.py',
                          ROOT / 'paparazzi/models/guidance_pid_h_run_pos/prepare/source/guidance_pid_h_run_pos.c',
                          ROOT / 'paparazzi/models/guidance_pid_h_run_pos/prepare/source/bindings.json']:
                    indexed[relative(p)] = digest(p)
                index = group['attempt'] / 'provenance.json'
                if (group['attempt'] / 'inputs.json').exists():
                    raise ValueError('Do not create competing input indexes')
                dump(index, {'schema': 'five-proof-inputs/1', 'dependency_sha256': indexed,
                             'semantic_dependencies': semantic})
                rows = [{'path': name, 'sha256': value,
                         **({'snapshot': relative(snapshots[ROOT / name])} if ROOT / name in snapshots else {})}
                        for name, value in sorted(indexed.items())]
                validation = group['attempt'] / 'evidence/goal-validation.json'
                dump(validation, {'schema': 'five-proof-validation/1',
                                  'index': {'path': relative(index), 'sha256': digest(index)},
                                  'inputs': rows, 'kernel_evidence': relative(proof_receipt),
                                  'goal_bindings': group['bindings'],
                                  'certificate': {'path': relative(target), 'sha256': digest(target),
                                                  'module': cert_module, 'imports': group['imports'],
                                                  'run': relative(run.folder),
                                                  'compile_command_id': compile_cmd['id'],
                                                  'kernel_command_id': cert_kernel['id'],
                                                  'kernel_evidence': relative(cert_receipt)}})
                status_path = group['problem'] / 'status.json'
                status = json.loads(status_path.read_text())
                status.update({'status': 'proved', 'active_attempt': '../attempts/002',
                               'goal_status': {b['requested_goal']: 'proved' for b in group['bindings']}})
                dump(status_path, status)
                final['validation-' + str(len(final))] = validation
        for source, expected in current.items():
            if digest(source) != expected:
                raise ValueError('Source changed during cold build: ' + str(source))
        print(json.dumps({'status': 'passed', 'source_count': len(order),
                          'goals': theorem_names, 'run': relative(run.folder),
                          'kernel_evidence': relative(proof_receipt)}, indent=2))
        if owned:
            run.finish('passed', 'Cold source snapshots, exact typed goals and independent kernel passed.',
                       {**final, 'kernel': proof_receipt})
    except BaseException:
        if owned and run.read('run.json')['status'] == 'running':
            note = run.folder / 'evidence/checker-failure.json'
            dump(note, {'scope': 'cold checker did not complete; failure retained in command logs'})
            run.finish('failed', 'Cold checker failed; no completion claim.', {'failure': note})
        raise

if __name__ == '__main__':
    main()

FILE WitnessMemory.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib AST Integers Values Memory Memdata Globalenvs Ctypes Csem.
From PidPositionRunPos Require Import Source Execution.
From PidPositionTranslationSupport Require Import MemoryLayout.
From PidPositionTranslationProblem Require Import Spec.
From PidPositionTranslationCore Require Import FactoryMemory CoreMemory.
From PidPositionTranslationAttempt002 Require Import ByteAgreement.
Import ListNotations.
Open Scope Z_scope.

Lemma replay_stores_exists : forall us m,
 Forall(fun u=>let '(ch,b,ofs,_):=u in Mem.valid_access m ch b ofs Writable)us ->
 exists mf,replay_stores m us=Some mf.
Proof.
 induction us as[|[[[ch b]ofs]v]us IH];intros m ACCESS.
 - exists m;reflexivity.
 - inversion ACCESS as[|u tail A REST];subst.
   destruct(Mem.valid_access_store m ch b ofs v A)as[ma STORE].
   destruct(IH ma ltac:(eapply Forall_impl;[|exact REST];intros[[[cu bu]ou]vu] VA;eapply Mem.store_valid_access_1;eauto))as[mf RUN].
   exists mf;cbn[replay_stores];rewrite STORE;exact RUN.
Qed.
Lemma replay_stores_value_at : forall i us m mf ch b ofs v,
 nth_error us i=Some(ch,b,ofs,v) ->replay_stores m us=Some mf ->
 Forall(misses_chunk ch b ofs)(skipn(S i)us) ->
 Mem.load ch mf b ofs=Some(Val.load_result ch v).
Proof.
 induction i as[|i IH];intros us m mf ch b ofs v NTH RUN MISS;
 destruct us as[|[[[cu bu]ou]vu]us];try discriminate;
 cbn[replay_stores]in RUN;
 destruct(Mem.store cu m bu ou vu)as[ma|]eqn:STORE;try discriminate.
 - cbn[nth_error]in NTH;injection NTH as<- <- <- <-.
   cbn[skipn]in MISS;rewrite(replay_stores_load_frame _ _ _ _ _ _ RUN MISS).
   eapply Mem.load_store_same;exact STORE.
 - eapply IH;[exact NTH|exact RUN|exact MISS].
Qed.

Lemma global_contract_after_allocation : forall m ma fresh lo hi,
 global_bytes_initialized m ->
 (forall b gv,Genv.find_var_info Execution.ge b=Some gv ->Mem.valid_block m b) ->
 Mem.alloc m lo hi=(ma,fresh) ->global_bytes_initialized ma.
Proof.
 intros m ma fresh lo hi[init[INIT GLOBAL]]VALID ALLOC.
 exists init;split;[exact INIT|].
 intros b gv VAR;destruct(GLOBAL b gv VAR)as[RP BY];split.
 - intros ofs R;eapply Mem.perm_alloc_1;[exact ALLOC|apply RP;exact R].
 - intros RO ofs R;erewrite Mem.loadbytes_alloc_unchanged;[|exact ALLOC|apply VALID with(gv:=gv);exact VAR].
   apply BY;assumption.
Qed.
Lemma global_contract_after_store : forall m mf ch dst ofs v,
 global_bytes_initialized m ->
 (forall b gv,Genv.find_var_info Execution.ge b=Some gv ->gvar_readonly gv=true ->b<>dst) ->
 Mem.store ch m dst ofs v=Some mf ->global_bytes_initialized mf.
Proof.
 intros m mf ch dst ofs v[init[INIT GLOBAL]]OUT STORE.
 exists init;split;[exact INIT|].
 intros b gv VAR;destruct(GLOBAL b gv VAR)as[RP BY];split.
 - intros i R;eapply Mem.perm_store_1;[exact STORE|apply RP;exact R].
 - intros RO i R;rewrite(Mem.loadbytes_store_other _ _ _ _ _ _ STORE b i 1)
    by(left;eapply OUT;eauto);apply BY;assumption.
Qed.
Lemma global_contract_after_replay : forall us m mf,
 global_bytes_initialized m ->
 Forall(fun u=>let '(_,dst,_,_):=u in
 forall b gv,Genv.find_var_info Execution.ge b=Some gv ->gvar_readonly gv=true ->b<>dst)us ->
 replay_stores m us=Some mf ->global_bytes_initialized mf.
Proof.
 induction us as[|[[[ch dst]ofs]v]us IH];intros m mf GOOD OUT RUN;cbn[replay_stores]in RUN.
 - injection RUN as<-;exact GOOD.
 - destruct(Mem.store ch m dst ofs v)as[ma|]eqn:STORE;try discriminate.
   inversion OUT as[|u tail HEAD REST];subst.
   eapply IH;[eapply global_contract_after_store;eauto|exact REST|exact RUN].
Qed.

Lemma translated_store_pair_preserves_canonical_frame : forall gh ret a b dst ofs ch va vb af bf,
 same_except_positions_and_return gh ret a b ->
 (forall i,ofs<=i<ofs+size_chunk ch ->translated_byte gh dst i) ->
 Mem.store ch a dst ofs va=Some af ->Mem.store ch b dst ofs vb=Some bf ->
 same_except_positions_and_return gh ret af bf.
Proof.
 intros gh ret a b dst ofs ch va vb af bf[NEXT[PERM BY]]TRAN SA SB;split.
 - rewrite(Mem.nextblock_store _ _ _ _ _ _ SA),(Mem.nextblock_store _ _ _ _ _ _ SB);exact NEXT.
 - split.
   + intros blk i k p;split;intro H.
     * eapply Mem.perm_store_1;[exact SB|]. apply(proj1(PERM blk i k p)).
       eapply Mem.perm_store_2;[exact SA|exact H].
     * eapply Mem.perm_store_1;[exact SA|]. apply(proj2(PERM blk i k p)).
       eapply Mem.perm_store_2;[exact SB|exact H].
   + intros blk i NT RET.
     assert(OUT:blk<>dst \/i+1<=ofs\/ofs+size_chunk ch<=i).
     { destruct(peq blk dst)as[->|D];[right|left;exact D].
       destruct(zlt i ofs);[left;lia|right].
       destruct(zle(ofs+size_chunk ch)i);[exact l|].
       exfalso;apply NT;apply TRAN;lia. }
     rewrite(Mem.loadbytes_store_other _ _ _ _ _ _ SA blk i 1)by(tauto).
     rewrite(Mem.loadbytes_store_other _ _ _ _ _ _ SB blk i 1)by(tauto).
     apply BY;assumption.
Qed.
Definition compatible_update(gh:block)(u v:scalar_update):Prop:=
 exists ch dst ofs va vb,u=(ch,dst,ofs,va)/\v=(ch,dst,ofs,vb)/\
 (va=vb\/(forall i,ofs<=i<ofs+size_chunk ch->translated_byte gh dst i)).
Lemma compatible_replay_preserves_canonical_frame : forall gh ret us vs a b af bf,
 Forall2(compatible_update gh)us vs ->
 same_except_positions_and_return gh ret a b ->
 replay_stores a us=Some af ->replay_stores b vs=Some bf ->
 same_except_positions_and_return gh ret af bf.
Proof.
 intros gh ret us vs a b af bf COMP;revert a b af bf.
 induction COMP;intros a b af bf FRAME UA UB.
 - cbn[replay_stores]in UA,UB;injection UA as<-;injection UB as<-;exact FRAME.
 - destruct H as[ch[dst[ofs[va[vb[-> [-> CASE]]]]]]].
   cbn[replay_stores]in UA,UB.
   destruct(Mem.store ch a dst ofs va)as[ma|]eqn:SA;try discriminate.
   destruct(Mem.store ch b dst ofs vb)as[mb|]eqn:SB;try discriminate.
   eapply IHCOMP;[|exact UA|exact UB].
   destruct CASE as[EQ|TR].
   + subst vb;eapply synchronized_store_preserves_canonical_frame;eauto.
   + eapply translated_store_pair_preserves_canonical_frame;eauto.
Qed.
Print Assumptions compatible_replay_preserves_canonical_frame.

FILE WitnessUpdates.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib AST Integers Values Memory Memdata Globalenvs Ctypes Csyntax Csyntaxdefs Csem.
From PidPositionRunPos Require Import Source Execution.
From PidPositionTranslationSupport Require Import MemoryLayout.
From PidPositionTranslationProblem Require Import Spec.
From PidPositionTranslationCore Require Import FactoryMemory CoreMemory.
From PidPositionTranslationAttempt002 Require Import ByteAgreement WitnessMemory.
Import ListNotations.
Open Scope Z_scope.
Module S:=PidPositionRunPos.Source.
Module E:=PidPositionRunPos.Execution.
Definition witness_updates(gh sb:block)(shift:Z):list scalar_update:=[
 (Mint16unsigned,sb,2,Vint(Int.repr 2));
 (Mint16unsigned,sb,280,Vint(Int.repr 2));
 (Mint32,gh,44,Vint(Int.repr(512+shift)));
 (Mint32,gh,48,Vint Int.zero);
 (Mint32,gh,52,Vint Int.zero);
 (Mint32,gh,56,Vint Int.zero);
 (Mint32,gh,60,Vint Int.zero);
 (Mint32,gh,64,Vint Int.zero);
 (Mint32,sb,100,Vint(Int.repr shift))].
Ltac witness_forall tac :=
 lazymatch goal with
 | |-Forall _ []=>apply Forall_nil
 | |-Forall _ (_::_)=>apply Forall_cons;[tac|witness_forall tac]
 end.
Ltac witness_align :=
 lazymatch goal with |-Z.divide ?a ?p=>
 let q:=eval vm_compute in(p/a)in exists q;reflexivity end.
Ltac witness_miss :=
 cbn[misses_chunk];first[left;congruence|right;left;cbn;lia|right;right;cbn;lia].
Theorem witness_updates_exist : forall base gh sb shift,
 Mem.range_perm base gh 0 84 Cur Writable ->
 Mem.range_perm base sb 0 656 Cur Writable ->
 exists mf,replay_stores base(witness_updates gh sb shift)=Some mf.
Proof.
 intros base gh sb shift WG WS;apply replay_stores_exists.
 unfold witness_updates;witness_forall ltac:(
 cbn;first[
 eapply scalar_access_inside with(n:=84);[exact WG|lia|cbn;lia|witness_align]|
 eapply scalar_access_inside with(n:=656);[exact WS|lia|cbn;lia|witness_align]]).
Qed.
Lemma zero_preserved_by_disjoint_replay : forall us base mf b len,
 Genv.read_as_zero base b 0 len ->
 Forall(fun u=>let '(_,dst,_,_):=u in b<>dst)us ->
 replay_stores base us=Some mf ->
 Genv.read_as_zero mf b 0 len.
Proof.
 intros us base mf b len ZERO MISS RUN ch ofs LO HI ALIGN.
 rewrite(replay_stores_load_frame us base mf ch b ofs RUN).
 - apply ZERO;assumption.
 - eapply Forall_impl;[|exact MISS].
   intros[[[cu dst]ou]v]NOT;left;exact NOT.
Qed.
Theorem witness_updated_loads : forall base mf gh sb shift,
 gh<>sb ->Genv.read_as_zero base sb 0 656 ->
 replay_stores base(witness_updates gh sb shift)=Some mf ->
 Mem.load Mint16unsigned mf sb 2=Some(Vint(Int.repr 2)) /\
 Mem.load Mint16unsigned mf sb 280=Some(Vint(Int.repr 2)) /\
 Mem.load Mint32 mf gh 44=Some(Vint(Int.repr(512+shift))) /\
 Mem.load Mint32 mf gh 48=Some(Vint Int.zero) /\
 Mem.load Mint32 mf gh 52=Some(Vint Int.zero) /\
 Mem.load Mint32 mf gh 56=Some(Vint Int.zero) /\
 Mem.load Mint32 mf gh 60=Some(Vint Int.zero) /\
 Mem.load Mint32 mf gh 64=Some(Vint Int.zero) /\
 Mem.load Mint32 mf sb 100=Some(Vint(Int.repr shift)) /\
 Mem.load Mint32 mf sb 104=Some(Vint Int.zero) /\
 Mem.load Mint32 mf sb 296=Some(Vint Int.zero) /\
 Mem.load Mint32 mf sb 300=Some(Vint Int.zero).
Proof.
 intros base mf gh sb shift DIFF ZERO RUN.
 assert(P:Mem.load Mint16unsigned mf sb 2=Some(Vint(Int.repr 2))).
 { eapply replay_stores_value_at with(i:=0%nat)(us:=witness_updates gh sb shift)(m:=base)(v:=Vint(Int.repr 2));
   [reflexivity|exact RUN|cbn[witness_updates skipn];witness_forall ltac:(witness_miss)]. }
 assert(S:Mem.load Mint16unsigned mf sb 280=Some(Vint(Int.repr 2))).
 { eapply replay_stores_value_at with(i:=1%nat)(us:=witness_updates gh sb shift)(m:=base)(v:=Vint(Int.repr 2));
   [reflexivity|exact RUN|cbn[witness_updates skipn];witness_forall ltac:(witness_miss)]. }
 assert(R:Mem.load Mint32 mf gh 44=Some(Vint(Int.repr(512+shift)))).
 { eapply replay_stores_value_at with(i:=2%nat)(us:=witness_updates gh sb shift)(m:=base)(v:=Vint(Int.repr(512+shift)));
   [reflexivity|exact RUN|cbn[witness_updates skipn];witness_forall ltac:(witness_miss)]. }
 assert(Y:Mem.load Mint32 mf gh 48=Some(Vint(Int.zero))).
 { eapply replay_stores_value_at with(i:=3%nat)(us:=witness_updates gh sb shift)(m:=base)(v:=Vint(Int.zero));
   [reflexivity|exact RUN|cbn[witness_updates skipn];witness_forall ltac:(witness_miss)]. }
 assert(VX:Mem.load Mint32 mf gh 52=Some(Vint(Int.zero))).
 { eapply replay_stores_value_at with(i:=4%nat)(us:=witness_updates gh sb shift)(m:=base)(v:=Vint(Int.zero));
   [reflexivity|exact RUN|cbn[witness_updates skipn];witness_forall ltac:(witness_miss)]. }
 assert(VY:Mem.load Mint32 mf gh 56=Some(Vint(Int.zero))).
 { eapply replay_stores_value_at with(i:=5%nat)(us:=witness_updates gh sb shift)(m:=base)(v:=Vint(Int.zero));
   [reflexivity|exact RUN|cbn[witness_updates skipn];witness_forall ltac:(witness_miss)]. }
 assert(AX:Mem.load Mint32 mf gh 60=Some(Vint(Int.zero))).
 { eapply replay_stores_value_at with(i:=6%nat)(us:=witness_updates gh sb shift)(m:=base)(v:=Vint(Int.zero));
   [reflexivity|exact RUN|cbn[witness_updates skipn];witness_forall ltac:(witness_miss)]. }
 assert(AY:Mem.load Mint32 mf gh 64=Some(Vint(Int.zero))).
 { eapply replay_stores_value_at with(i:=7%nat)(us:=witness_updates gh sb shift)(m:=base)(v:=Vint(Int.zero));
   [reflexivity|exact RUN|cbn[witness_updates skipn];witness_forall ltac:(witness_miss)]. }
 assert(N:Mem.load Mint32 mf sb 100=Some(Vint(Int.repr shift))).
 { eapply replay_stores_value_at with(i:=8%nat)(us:=witness_updates gh sb shift)(m:=base)(v:=Vint(Int.repr shift));
   [reflexivity|exact RUN|cbn[witness_updates skipn];witness_forall ltac:(witness_miss)]. }
 repeat(first[assumption|split]).
 all:rewrite(replay_stores_load_frame _ _ _ _ _ _ RUN);
 [apply ZERO;[lia|cbn;lia|witness_align]|unfold witness_updates;witness_forall ltac:(witness_miss)].
Qed.
Lemma reference_position_written_bytes : forall gh i,
 44<=i<48 ->translated_byte gh gh i.
Proof.
 intros gh i R;left;exists S._x;split;[cbn;auto|];split;[reflexivity|].
 exists tint,44;split;[reflexivity|exact R].
Qed.
Lemma measured_position_written_bytes : forall gh sb i,
 Genv.find_symbol E.ge S._state=Some sb ->100<=i<104 ->translated_byte gh sb i.
Proof.
 intros gh sb i SYM R;right;exists sb,S._x;split;[exact SYM|];split;[cbn;auto|].
 split;[reflexivity|];exists tint,100;split;[reflexivity|exact R].
Qed.
Lemma compatible_update_same : forall gh ch dst ofs v,
 compatible_update gh(ch,dst,ofs,v)(ch,dst,ofs,v).
Proof. intros;exists ch,dst,ofs,v,v;split;[reflexivity|];split;[reflexivity|];left;reflexivity. Qed.
Lemma compatible_update_translated : forall gh ch dst ofs va vb,
 (forall i,ofs<=i<ofs+size_chunk ch->translated_byte gh dst i) ->
 compatible_update gh(ch,dst,ofs,va)(ch,dst,ofs,vb).
Proof. intros;exists ch,dst,ofs,va,vb;split;[reflexivity|];split;[reflexivity|];right;assumption. Qed.
Theorem witness_replays_related : forall base gh ret sb a b,
 Genv.find_symbol E.ge S._state=Some sb ->
 replay_stores base(witness_updates gh sb 0)=Some a ->
 replay_stores base(witness_updates gh sb 25600)=Some b ->
 same_except_positions_and_return gh ret a b.
Proof.
 intros base gh ret sb a b SYM A B.
 eapply compatible_replay_preserves_canonical_frame;[| |exact A|exact B].
 - unfold witness_updates.
   repeat(apply Forall2_cons;[apply compatible_update_same|]).
   apply Forall2_cons.
   + apply compatible_update_translated;intros i R;apply reference_position_written_bytes;exact R.
   + repeat(apply Forall2_cons;[apply compatible_update_same|]).
     apply Forall2_cons.
     * apply compatible_update_translated;intros i R;apply measured_position_written_bytes with(sb:=sb);assumption.
     * constructor.
 - split;[reflexivity|];split;[intros;tauto|intros;reflexivity].
Qed.
Print Assumptions witness_replays_related.

FILE StackAgreement.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib AST Values Memory Memdata.
From PidPositionTranslationProblem Require Import Spec.
Import ListNotations.
Open Scope Z_scope.

Lemma unit_loadbytes_absent : forall m b ofs,
 ~Mem.perm m b ofs Cur Readable ->Mem.loadbytes m b ofs 1=None.
Proof.
 intros m b ofs NP;destruct(Mem.loadbytes m b ofs 1)as[bytes|]eqn:L;auto.
 exfalso;apply NP;pose proof(Mem.loadbytes_range_perm _ _ _ _ _ L)as RP;apply RP;lia.
Qed.
Lemma allocated_unit_is_undef : forall m lo hi ma fresh ofs bytes,
 Mem.alloc m lo hi=(ma,fresh) ->
 Mem.loadbytes ma fresh ofs 1=Some bytes ->bytes=[Undef].
Proof.
 intros m lo hi ma fresh ofs bytes AL LOAD.
 pose proof(Mem.loadbytes_length _ _ _ _ _ LOAD)as LEN;change(length bytes=1%nat)in LEN.
 destruct bytes as[|v tail];[discriminate|].
 destruct tail as[|v' tail];[|discriminate].
 f_equal;eapply Mem.loadbytes_alloc_same;[exact AL|exact LOAD|left;reflexivity].
Qed.

Theorem synchronized_alloc_preserves_canonical_frame :
 forall gh ret a b lo hi af ab bf bb,
 same_except_positions_and_return gh ret a b ->
 Mem.alloc a lo hi=(af,ab) ->Mem.alloc b lo hi=(bf,bb) ->
 ab=bb /\same_except_positions_and_return gh ret af bf.
Proof.
 intros gh ret a b lo hi af ab bf bb[NB[PERMS BYTES]]AA AB.
 assert(EQ:ab=bb).
 { rewrite(Mem.alloc_result _ _ _ _ _ AA),(Mem.alloc_result _ _ _ _ _ AB);exact NB. }
 subst bb;split;[reflexivity|].
 assert(NEXT:Mem.nextblock af=Mem.nextblock bf).
 { rewrite(Mem.nextblock_alloc _ _ _ _ _ AA),(Mem.nextblock_alloc _ _ _ _ _ AB),NB;reflexivity. }
 assert(PERM:forall blk ofs k p,Mem.perm af blk ofs k p<->Mem.perm bf blk ofs k p).
 { intros blk ofs k p;destruct(peq blk ab)as[EQ|NE].
   - subst blk;split;intro P.
     + pose proof(Mem.perm_alloc_3 _ _ _ _ _ AA _ _ _ P)as R.
       eapply Mem.perm_implies;[apply(Mem.perm_alloc_2 _ _ _ _ _ AB);exact R|destruct p;constructor].
     + pose proof(Mem.perm_alloc_3 _ _ _ _ _ AB _ _ _ P)as R.
       eapply Mem.perm_implies;[apply(Mem.perm_alloc_2 _ _ _ _ _ AA);exact R|destruct p;constructor].
   - split;intro P.
     + apply(Mem.perm_alloc_1 _ _ _ _ _ AB);apply PERMS;eapply Mem.perm_alloc_4;[exact AA|exact P|exact NE].
     + apply(Mem.perm_alloc_1 _ _ _ _ _ AA);apply PERMS;eapply Mem.perm_alloc_4;[exact AB|exact P|exact NE]. }
 split;[exact NEXT|];split;[exact PERM|].
 intros blk ofs NT NR;destruct(peq blk ab)as[EQ|NE].
 - subst blk.
   destruct(Mem.loadbytes af ab ofs 1)as[av|]eqn:LA.
   + assert(RB:Mem.range_perm bf ab ofs(ofs+1)Cur Readable).
     { intros z ZR;apply PERM;exact(Mem.loadbytes_range_perm _ _ _ _ _ LA z ZR). }
     destruct(Mem.range_perm_loadbytes _ _ _ _ RB)as[bv LB];rewrite LB.
     rewrite(allocated_unit_is_undef _ _ _ _ _ _ _ AA LA).
     rewrite(allocated_unit_is_undef _ _ _ _ _ _ _ AB LB);reflexivity.
   + destruct(Mem.loadbytes bf ab ofs 1)as[bv|]eqn:LB;[|reflexivity].
     assert(RA:Mem.range_perm af ab ofs(ofs+1)Cur Readable).
     { intros z ZR;apply PERM;exact(Mem.loadbytes_range_perm _ _ _ _ _ LB z ZR). }
     destruct(Mem.range_perm_loadbytes _ _ _ _ RA)as[av L];rewrite LA in L;discriminate.
 - destruct(plt blk(Mem.nextblock a))as[VA|NVA].
   + assert(VB:Mem.valid_block b blk)by(unfold Mem.valid_block;rewrite<-NB;exact VA).
     rewrite(Mem.loadbytes_alloc_unchanged _ _ _ _ _ AA _ _ _ VA).
     rewrite(Mem.loadbytes_alloc_unchanged _ _ _ _ _ AB _ _ _ VB).
     apply BYTES;assumption.
   + assert(NA:~Mem.perm af blk ofs Cur Readable).
     { intro P;pose proof(Mem.perm_valid_block _ _ _ _ _ P)as V.
       destruct(Mem.valid_block_alloc_inv _ _ _ _ _ AA blk V)as[E|V0];[contradiction|exact(NVA V0)]. }
     assert(NB':~Mem.perm bf blk ofs Cur Readable)by(intro P;apply NA;apply PERM;exact P).
     rewrite(unit_loadbytes_absent _ _ _ NA),(unit_loadbytes_absent _ _ _ NB');reflexivity.
Qed.

Theorem synchronized_free_preserves_canonical_frame :
 forall gh ret a b blk lo hi af bf,
 same_except_positions_and_return gh ret a b ->
 Mem.free a blk lo hi=Some af ->Mem.free b blk lo hi=Some bf ->
 same_except_positions_and_return gh ret af bf.
Proof.
 intros gh ret a b blk lo hi af bf[NB[PERMS BYTES]]FA FB.
 assert(PERM:forall b ofs k p,Mem.perm af b ofs k p<->Mem.perm bf b ofs k p).
 { intros b' ofs k p;destruct(peq b' blk)as[EQ|NE].
   - subst b';destruct(zle lo ofs), (zlt ofs hi).
     + split;intro P;exfalso;[exact(Mem.perm_free_2 a blk lo hi af FA ofs k p ltac:(lia)P)|exact(Mem.perm_free_2 b blk lo hi bf FB ofs k p ltac:(lia)P)].
     + split;intro P;[eapply Mem.perm_free_1;[exact FB|right;right;lia|apply PERMS;eapply Mem.perm_free_3;eauto]|
       eapply Mem.perm_free_1;[exact FA|right;right;lia|apply PERMS;eapply Mem.perm_free_3;eauto]].
     + split;intro P;[eapply Mem.perm_free_1;[exact FB|right;left;lia|apply PERMS;eapply Mem.perm_free_3;eauto]|
       eapply Mem.perm_free_1;[exact FA|right;left;lia|apply PERMS;eapply Mem.perm_free_3;eauto]].
     + split;intro P;[eapply Mem.perm_free_1;[exact FB|right;left;lia|apply PERMS;eapply Mem.perm_free_3;eauto]|
       eapply Mem.perm_free_1;[exact FA|right;left;lia|apply PERMS;eapply Mem.perm_free_3;eauto]].
   - split;intro P;[eapply Mem.perm_free_1;[exact FB|left;exact NE|apply PERMS;eapply Mem.perm_free_3;eauto]|
      eapply Mem.perm_free_1;[exact FA|left;exact NE|apply PERMS;eapply Mem.perm_free_3;eauto]]. }
 split.
 - rewrite(Mem.nextblock_free _ _ _ _ _ FA),(Mem.nextblock_free _ _ _ _ _ FB);exact NB.
 - split;[exact PERM|].
   intros b' ofs NT NR;destruct(peq b' blk)as[EQ|NE].
   + subst b';destruct(zle lo ofs), (zlt ofs hi).
     * assert(NA:~Mem.perm af blk ofs Cur Readable)by(eapply Mem.perm_free_2;[exact FA|split;assumption]).
       assert(NB':~Mem.perm bf blk ofs Cur Readable)by(eapply Mem.perm_free_2;[exact FB|split;assumption]).
       rewrite(unit_loadbytes_absent _ _ _ NA),(unit_loadbytes_absent _ _ _ NB');reflexivity.
     * rewrite(Mem.loadbytes_free _ _ _ _ _ FA)by(right;right;right;lia).
       rewrite(Mem.loadbytes_free _ _ _ _ _ FB)by(right;right;right;lia);apply BYTES;assumption.
     * rewrite(Mem.loadbytes_free _ _ _ _ _ FA)by(right;right;left;lia).
       rewrite(Mem.loadbytes_free _ _ _ _ _ FB)by(right;right;left;lia);apply BYTES;assumption.
     * rewrite(Mem.loadbytes_free _ _ _ _ _ FA)by(right;right;left;lia).
       rewrite(Mem.loadbytes_free _ _ _ _ _ FB)by(right;right;left;lia);apply BYTES;assumption.
   + rewrite(Mem.loadbytes_free _ _ _ _ _ FA)by(left;exact NE).
     rewrite(Mem.loadbytes_free _ _ _ _ _ FB)by(left;exact NE);apply BYTES;assumption.
Qed.
Print Assumptions synchronized_alloc_preserves_canonical_frame.
Print Assumptions synchronized_free_preserves_canonical_frame.

FILE ByteSubrange.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib AST Integers Values Memory Memdata.
Import ListNotations.
Open Scope Z_scope.
Lemma unit_loadbytes_singleton : forall m b ofs bytes,
 Mem.loadbytes m b ofs 1=Some bytes ->exists v,bytes=[v].
Proof.
 intros m b ofs bytes LOAD;pose proof(Mem.loadbytes_length _ _ _ _ _ LOAD)as LEN.
 change(length bytes=1%nat)in LEN.
 destruct bytes as[|v tail];[discriminate|].
 destruct tail as[|v' tail];[exists v;reflexivity|discriminate].
Qed.
Lemma equal_loadbytes_all_units : forall(n:nat)a b blk base bytes,
 Mem.loadbytes a blk base(Z.of_nat n)=Some bytes ->
 Mem.loadbytes b blk base(Z.of_nat n)=Some bytes ->
 forall ofs,base<=ofs<base+Z.of_nat n ->
 Mem.loadbytes a blk ofs 1=Mem.loadbytes b blk ofs 1.
Proof.
 induction n as[|n IH];intros a b blk base bytes LA LB ofs RANGE.
 - cbn in RANGE;lia.
 - replace(Z.of_nat(S n))with(1+Z.of_nat n)in LA,LB by lia.
   destruct(Mem.loadbytes_split a blk base 1(Z.of_nat n)bytes LA ltac:(lia)ltac:(lia))
   as[ah[atail[AH[AT AE]]]].
   destruct(Mem.loadbytes_split b blk base 1(Z.of_nat n)bytes LB ltac:(lia)ltac:(lia))
   as[bh[btail[BH[BT BE]]]].
   destruct(unit_loadbytes_singleton _ _ _ _ AH)as[av AV].
   destruct(unit_loadbytes_singleton _ _ _ _ BH)as[bv BV].
   rewrite AV in AH,AE;rewrite BV in BH,BE.
   rewrite AE in BE;cbn in BE;injection BE as EV ET;subst bv btail.
   destruct(Z.eq_dec ofs base)as[EQ|NE].
   + subst ofs;rewrite AH,BH;reflexivity.
   + eapply IH;[exact AT|exact BT|lia].
Qed.
Lemma equal_int32_words_all_units : forall a b blk base bytes,
 Mem.loadbytes a blk base 4=Some bytes ->
 Mem.loadbytes b blk base 4=Some bytes ->
 forall ofs,base<=ofs<base+4 ->
 Mem.loadbytes a blk ofs 1=Mem.loadbytes b blk ofs 1.
Proof.
 intros a b blk base bytes LA LB ofs RANGE.
 exact(equal_loadbytes_all_units 4 a b blk base bytes LA LB ofs RANGE).
Qed.
Print Assumptions equal_int32_words_all_units.

