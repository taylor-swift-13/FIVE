 cid_i_writable:Mem.range_perm m cid_i 0 8 Cur Writable
}.
Lemma actual_factory_target : exists b,Genv.find_symbol E.ge S._stab_sp_from_ltp_i=Some b /\
 Genv.find_funct E.ge(Vptr b Ptrofs.zero)=Some(Internal S.f_stab_sp_from_ltp_i).
Proof.
 exists(PidTermination.symbol_block S._stab_sp_from_ltp_i);split.
 - change(Genv.find_symbol(genv_genv PidTermination.ge)S._stab_sp_from_ltp_i=Some(PidTermination.symbol_block S._stab_sp_from_ltp_i)).
   rewrite PidTermination.ge_base;vm_compute;reflexivity.
 - change(Genv.find_funct_ptr(genv_genv PidTermination.ge)(PidTermination.symbol_block S._stab_sp_from_ltp_i)=Some(Internal S.f_stab_sp_from_ltp_i)).
   rewrite PidTermination.ge_base;vm_compute;reflexivity.
Qed.
Theorem inputgood_core_initial_data : forall m gh ret,InputGood m gh ret ->exists data:core_initial_data m gh,True.
Proof.
 intros m gh ret GOOD;pose proof(proj1 GOOD)as LEG.
 assert(WR:writable_controller_globals m)by(unfold InputGoodLegacy in LEG;tauto).
 destruct(WR S._guidance_pid ltac:(cbn;intuition congruence))as[bp[gv[SP[VP WP]]]].
 destruct(actual_global_variable_binding S._guidance_pid S.v_guidance_pid ltac:(vm_compute;reflexivity))as[bp0[SP0 VP0]].
 rewrite SP in SP0;injection SP0 as EQ;subst bp0;rewrite VP0 in VP;injection VP as EQ;subst gv.
 change(Mem.range_perm m bp 0 48 Cur Writable)in WP.
 destruct(WR S._guidance_pid_trim_att_integrator ltac:(cbn;intuition congruence))as[bi[gv[SI[VI WI]]]].
 destruct(actual_global_variable_binding S._guidance_pid_trim_att_integrator S.v_guidance_pid_trim_att_integrator ltac:(vm_compute;reflexivity))as[bi0[SI0 VI0]].
 rewrite SI in SI0;injection SI0 as EQ;subst bi0;rewrite VI0 in VI;injection VI as EQ;subst gv.
 change(Mem.range_perm m bi 0 8 Cur Writable)in WI.
 assert(GAIN:forall gain,In gain[S._kp;S._kd;S._ki;S._kv;S._ka]->bounded_global m S._guidance_pid pid_type[gain]0 100)
 by(unfold InputGoodLegacy in LEG;tauto).
 destruct(GAIN S._kp ltac:(cbn;intuition congruence))as[kp[KP _]].
 destruct(GAIN S._kd ltac:(cbn;intuition congruence))as[kd[KD _]].
 destruct(GAIN S._ki ltac:(cbn;intuition congruence))as[ki[KI _]].
 destruct(GAIN S._kv ltac:(cbn;intuition congruence))as[kv[KV _]].
 destruct(GAIN S._ka ltac:(cbn;intuition congruence))as[ka[KA _]].
 unfold load_global in KP,KD,KI,KV,KA;rewrite SP in KP,KD,KI,KV,KA.
 assert(XY:forall axis,In axis[S._x;S._y]->
 bounded_global m S._guidance_pid_trim_att_integrator vec_type[axis](-100000000)100000000 /\
 bounded_path m gh gh_type[S._ref;S._speed;axis](-10000)10000 /\
 bounded_path m gh gh_type[S._ref;S._accel;axis](-10000)10000 /\
 bounded_global m S._state state_type[S._ned_speed_i;axis](-10000)10000)
 by(unfold InputGoodLegacy in LEG;tauto).
 destruct(XY S._x ltac:(cbn;intuition congruence))as[[ix[IX _]][_[[ax[AX _]]_]]].
 destruct(XY S._y ltac:(cbn;intuition congruence))as[[iy[IY _]][_[[ay[AY _]]_]]].
 unfold load_global in IX,IY;rewrite SI in IX,IY.
 assert(APP:load_global Mint8unsigned m S._guidance_pid pid_type[S._approx_force_by_thrust]=Some(Vint Int.zero))
 by(unfold InputGoodLegacy in LEG;tauto).
 unfold load_global in APP;rewrite SP in APP.
 destruct(actual_global_variable_binding S._guidance_h S.v_guidance_h ltac:(vm_compute;reflexivity))as[bh[SH VH]].
 assert(HEAD:heading_safe m)by(unfold InputGoodLegacy in LEG;tauto).
 destruct HEAD as[h[HEAD[LO HI]]];unfold load_global in HEAD;rewrite SH in HEAD.
 destruct(heading_angle_cast_defined h LO HI)as[heading[CAST HBOUND]].
 destruct(inputgood_static_limits m gh ret GOOD)as[bt[bu[ST[SU[LT LU]]]]].
 destruct actual_factory_target as[bfun[SF FF]].
 refine(ex_intro _ {|cid_pid:=bp;cid_i:=bi;cid_traj:=bt;cid_total:=bu;cid_heading:=bh;cid_factory:=bfun;
 cid_kp:=kp;cid_kd:=kd;cid_ki:=ki;cid_kv:=kv;cid_ka:=ka;cid_ax:=ax;cid_ay:=ay;cid_ix:=ix;cid_iy:=iy;
 cid_h:=h;cid_hbits:=heading;cid_pid_symbol:=SP;cid_i_symbol:=SI;cid_traj_symbol:=ST;cid_total_symbol:=SU;
 cid_heading_symbol:=SH;cid_factory_symbol:=SF;cid_factory_function:=FF;cid_approx:=APP;
 cid_gain_p:=KP;cid_gain_d:=KD;cid_gain_i:=KI;cid_gain_v:=KV;cid_gain_a:=KA;
 cid_accel_x:=AX;cid_accel_y:=AY;cid_integral_x:=IX;cid_integral_y:=IY;
 cid_trajectory_limit:=LT;cid_total_limit:=LU;cid_heading_load:=HEAD;cid_heading_bound:=HBOUND;
 cid_pid_writable:=WP;cid_i_writable:=WI|} I).
 intros mm;change(match Float32.to_int(Float32.mul h(Float32.of_int(Int.repr 4096)))with Some n=>Some(Vint n)|None=>None end=Some(Vint heading)).
 rewrite CAST;reflexivity.
Qed.
Print Assumptions inputgood_core_initial_data.

