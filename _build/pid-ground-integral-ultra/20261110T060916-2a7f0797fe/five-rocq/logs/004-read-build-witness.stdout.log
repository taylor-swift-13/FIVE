 - change(Genv.find_symbol(genv_genv PidTermination.ge)S._guidance_pid_h_run=Some(PidTermination.symbol_block S._guidance_pid_h_run)).
   rewrite PidTermination.ge_base;vm_compute;reflexivity.
 - change(Genv.find_funct_ptr(genv_genv PidTermination.ge)(PidTermination.symbol_block S._guidance_pid_h_run)=Some(Internal S.f_guidance_pid_h_run)).
   rewrite PidTermination.ge_base;vm_compute;reflexivity.
