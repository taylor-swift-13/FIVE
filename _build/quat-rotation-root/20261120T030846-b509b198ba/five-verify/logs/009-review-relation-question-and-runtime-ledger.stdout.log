FILE paparazzi/relations/quat_rotation_paths/problem/Spec.v
From Stdlib Require Import List ZArith.
From compcert Require Import AST Integers Floats Values Memory Memdata Ctypes Csem Smallstep.
Require FiveQuatVmult.Execution FiveRmatOfQuat.Execution FiveRmatVmult.Execution.
Import ListNotations.
Local Open Scope Z_scope.
Definition NormalCall(ge:Csem.genv)(entry:list val->mem->Csem.state)(args:list val)(m mf:mem):Prop:=
 exists t,star Csem.step ge(entry args m)t(Returnstate Vundef Kstop mf).
Definition float_cells(m:mem)(b:block)(n:nat):Prop:=
 forall i,(i<n)%nat->exists x,Mem.load Mfloat32 m b(4*Z.of_nat i)=Some(Vsingle x).
Definition writable(m:mem)(b:block)(n:Z):Prop:=Mem.range_perm m b 0 n Cur Writable.
Definition disjoint(q v a r b:block):Prop:=NoDup[q;v;a;r;b].
Definition Domain(m:mem)(q v a r b:block):Prop:=
 disjoint q v a r b /\ float_cells m q 4 /\ float_cells m v 3 /\ writable m a 12 /\ writable m r 36 /\ writable m b 12 /\
 (forall i,(i<4)%nat->exists x,Mem.load Mfloat32 m q(4*Z.of_nat i)=Some(Vsingle x) /\ Float32.cmp Cle (Float32.neg Float32.one) x=true /\ Float32.cmp Cle x Float32.one=true) /\
 (forall i,(i<3)%nat->exists x,Mem.load Mfloat32 m v(4*Z.of_nat i)=Some(Vsingle x) /\ Float32.cmp Cle (Float32.of_bits(Int.repr 3296722944)) x=true /\ Float32.cmp Cle x(Float32.of_bits(Int.repr 1149239296))=true).
Definition BitEquality:Prop:=forall m q v a r b md mr mf,
 Domain m q v a r b ->
 NormalCall FiveQuatVmult.Execution.ge FiveQuatVmult.Execution.entry[Vptr a Ptrofs.zero;Vptr q Ptrofs.zero;Vptr v Ptrofs.zero]m md ->
 NormalCall FiveRmatOfQuat.Execution.ge FiveRmatOfQuat.Execution.entry[Vptr r Ptrofs.zero;Vptr q Ptrofs.zero]md mr ->
 NormalCall FiveRmatVmult.Execution.ge FiveRmatVmult.Execution.entry[Vptr b Ptrofs.zero;Vptr r Ptrofs.zero;Vptr v Ptrofs.zero]mr mf ->
 Mem.loadbytes mf a 0 12=Mem.loadbytes mf b 0 12.
Definition FrameOutside(m mf:mem)(a r b:block):Prop:=forall blk ofs n,
 Mem.valid_block m blk -> (blk<>a /\ blk<>r /\ blk<>b) -> Mem.loadbytes mf blk ofs n=Mem.loadbytes m blk ofs n.
Definition Refutation:Prop:=~BitEquality.
FILE paparazzi/models/float_rmat_vmult/rocq/no_error/problem/Spec.v
From Stdlib Require Import List.
From compcert Require Import Values Memory.
From FiveShared.verification Require Import Obligations.
From FiveRmatVmult Require Import Execution.
From FiveRmatVmultCase Require Import Contract.
Definition NoError : Prop := forall args m,Contract.Precondition args m->no_error Execution.ge(Execution.entry args m).
FILE paparazzi/models/float_rmat_vmult/rocq/cbmc_recheck/problem/Spec.v
From Stdlib Require Import List String ZArith.
From compcert Require Import AST Integers Floats Values Memory Memdata Csem Smallstep.
From FiveShared.verification Require Import Obligations.
From FiveLowpassSupport Require Import LowpassMemory.
From FiveRmatVmult Require Import Execution.
From FiveRmatVmultCase Require Import Contract.
From FiveRmatVmultNoError Require Import Spec.
Import ListNotations.
Local Open Scope Z_scope.
Local Open Scope string_scope.
Local Open Scope list_scope.
Inductive GuardKind := Dst(delta:Z)|MatrixBase|Src(i:Z)|Index(i:Z).
Definition ValidKind(k:GuardKind):Prop :=match k with Dst d=>In d[0;4;8]|MatrixBase=>True|Src i=>0<=i<3|Index i=>0<=i<9 end.
Definition FieldValid(m:mem)(b:block)(p:ptrofs)(delta:Z)(perm:permission):Prop :=
 Mem.valid_block m b /\Ptrofs.unsigned(Ptrofs.add p(Ptrofs.repr delta))=Ptrofs.unsigned p+delta /\
 Ptrofs.unsigned p+delta+4<=Ptrofs.modulus /\Mem.valid_access m Mfloat32 b(Ptrofs.unsigned p+delta)perm.
Definition SourceFields(m:mem)(b:block)(p:ptrofs)(n:Z):Prop :=
 Mem.valid_block m b /\forall i,0<=i<n->FieldValid m b p(4*i)Readable.
Definition SiteFacts(k:GuardKind):Prop :=forall args m,Contract.Precondition args m->
 exists bo br bv po pr pv f v,args=Args bo br bv po pr pv /\Reads m br pr 9 f /\Reads m bv pv 3 v /\
 match k with
 |Dst delta=>FieldValid m bo po delta Writable
 |MatrixBase=>SourceFields m br pr 9
 |Src i=>FieldValid m bv pv(4*i)Readable
 |Index i=>0<=i<9 /\FieldValid m br pr(4*i)Readable
 end.
Definition ExactObservation:Prop :=forall m bo br bv po pr pv f v,
 bo<>br->bo<>bv->br<>bv->writable12 m bo po->Reads m br pr 9 f->Reads m bv pv 3 v->
 exists mf,(exists t,star Csem.step Execution.ge(Execution.entry(Args bo br bv po pr pv)m)t(Returnstate Vundef Kstop mf)) /\
 Mem.loadbytes mf bo(Ptrofs.unsigned po)12=Some(encode_val Mfloat32(Vsingle(Row f v 0))++encode_val Mfloat32(Vsingle(Row f v 3))++encode_val Mfloat32(Vsingle(Row f v 6))) /\
 Frame m mf bo po /\
 (forall t vr mr,star Csem.step Execution.ge(Execution.entry(Args bo br bv po pr pv)m)t(Returnstate vr Kstop mr)->vr=Vundef /\mr=mf).
Definition MappedGoal(k:GuardKind):Prop :=FiveRmatVmultNoError.Spec.NoError /\SiteFacts k /\ExactObservation.
