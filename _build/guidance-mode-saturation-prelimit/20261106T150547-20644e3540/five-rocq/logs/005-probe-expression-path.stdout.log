     (m2 : Memory.Mem.mem) (r2' : Csyntax.expr),
   eval_expr ge e m RV r1 t1 m1 r1' ->
   P0 e m RV r1 t1 m1 r1' ->
   eval_simple_rvalue ge e m1 r1' v1 ->
   eval_expr ge e m1 RV r2 t2 m2 r2' ->
   P0 e m1 RV r2 t2 m2 r2' ->
   ty = Csyntax.typeof r2 ->
   P0 e m RV (Csyntax.Ecomma r1 r2 ty) (Events.Eapp t1 t2) m2 r2') ->
  (forall (e : env) (m : Memory.Mem.mem) (rf : Csyntax.expr)
     (rargs : Csyntax.exprlist) (ty : Ctypes.type) 
     (t1 : Events.trace) (m1 : Memory.Mem.mem) (rf' : Csyntax.expr)
     (t2 : Events.trace) (m2 : Memory.Mem.mem) (rargs' : Csyntax.exprlist)
     (vf : Values.val) (vargs : list Values.val) (targs : list Ctypes.type)
     (tres : Ctypes.type) (cconv : AST.calling_convention)
     (fd : Csyntax.fundef) (t3 : Events.trace) (m3 : Memory.Mem.mem)
     (vres : Values.val),
   eval_expr ge e m RV rf t1 m1 rf' ->
   P0 e m RV rf t1 m1 rf' ->
   eval_exprlist ge e m1 rargs t2 m2 rargs' ->
   P1 e m1 rargs t2 m2 rargs' ->
   eval_simple_rvalue ge e m2 rf' vf ->
   eval_simple_list ge e m2 rargs' targs vargs ->
   Cop.classify_fun (Csyntax.typeof rf) = Cop.fun_case_f targs tres cconv ->
   Globalenvs.Genv.find_funct ge vf = Some fd ->
   Csyntax.type_of_fundef fd = Ctypes.Tfunction targs tres cconv ->
   eval_funcall ge m2 fd vargs t3 m3 vres ->
   P3 m2 fd vargs t3 m3 vres ->
   P0 e m RV (Csyntax.Ecall rf rargs ty) (Events.Eapp t1 (Events.Eapp t2 t3))
     m3 (Csyntax.Eval vres ty)) ->
  (forall (e : env) (m : Memory.Mem.mem),
   P1 e m Csyntax.Enil Events.E0 m Csyntax.Enil) ->
  (forall (e : env) (m : Memory.Mem.mem) (a1 : Csyntax.expr)
     (al : Csyntax.exprlist) (t1 : Events.trace) (m1 : Memory.Mem.mem)
     (a1' : Csyntax.expr) (t2 : Events.trace) (m2 : Memory.Mem.mem)
     (al' : Csyntax.exprlist),
   eval_expr ge e m RV a1 t1 m1 a1' ->
   P0 e m RV a1 t1 m1 a1' ->
   eval_exprlist ge e m1 al t2 m2 al' ->
   P1 e m1 al t2 m2 al' ->
   P1 e m (Csyntax.Econs a1 al) (Events.Eapp t1 t2) m2
     (Csyntax.Econs a1' al')) ->
  (forall (e : env) (m : Memory.Mem.mem),
   P2 e m Csyntax.Sskip Events.E0 m Out_normal) ->
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (t : Events.trace) (m' : Memory.Mem.mem) (v : Values.val),
   eval_expression ge e m a t m' v ->
   P e m a t m' v -> P2 e m (Csyntax.Sdo a) t m' Out_normal) ->
  (forall (e : env) (m : Memory.Mem.mem) (s1 s2 : Csyntax.statement)
     (t1 : Events.trace) (m1 : Memory.Mem.mem) (t2 : Events.trace)
     (m2 : Memory.Mem.mem) (out : outcome),
   exec_stmt ge e m s1 t1 m1 Out_normal ->
   P2 e m s1 t1 m1 Out_normal ->
   exec_stmt ge e m1 s2 t2 m2 out ->
   P2 e m1 s2 t2 m2 out ->
   P2 e m (Csyntax.Ssequence s1 s2) (Events.Eapp t1 t2) m2 out) ->
  (forall (e : env) (m : Memory.Mem.mem) (s1 s2 : Csyntax.statement)
     (t1 : Events.trace) (m1 : Memory.Mem.mem) (out : outcome),
   exec_stmt ge e m s1 t1 m1 out ->
   P2 e m s1 t1 m1 out ->
   out <> Out_normal -> P2 e m (Csyntax.Ssequence s1 s2) t1 m1 out) ->
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (s1 s2 : Csyntax.statement) (t1 : Events.trace) 
     (m1 : Memory.Mem.mem) (v1 : Values.val) (t2 : Events.trace)
     (m2 : Memory.Mem.mem) (b : bool) (out : outcome),
   eval_expression ge e m a t1 m1 v1 ->
   P e m a t1 m1 v1 ->
   Cop.bool_val v1 (Csyntax.typeof a) m1 = Some b ->
   exec_stmt ge e m1 (if b then s1 else s2) t2 m2 out ->
   P2 e m1 (if b then s1 else s2) t2 m2 out ->
   P2 e m (Csyntax.Sifthenelse a s1 s2) (Events.Eapp t1 t2) m2 out) ->
  (forall (e : env) (m : Memory.Mem.mem),
   P2 e m (Csyntax.Sreturn None) Events.E0 m (Out_return None)) ->
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (t : Events.trace) (m' : Memory.Mem.mem) (v : Values.val),
   eval_expression ge e m a t m' v ->
   P e m a t m' v ->
   P2 e m (Csyntax.Sreturn (Some a)) t m'
     (Out_return (Some (v, Csyntax.typeof a)))) ->
  (forall (e : env) (m : Memory.Mem.mem),
   P2 e m Csyntax.Sbreak Events.E0 m Out_break) ->
  (forall (e : env) (m : Memory.Mem.mem),
   P2 e m Csyntax.Scontinue Events.E0 m Out_continue) ->
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (s : Csyntax.statement) (t : Events.trace) (m' : Memory.Mem.mem)
     (v : Values.val),
   eval_expression ge e m a t m' v ->
   P e m a t m' v ->
   Cop.bool_val v (Csyntax.typeof a) m' = Some false ->
   P2 e m (Csyntax.Swhile a s) t m' Out_normal) ->
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (s : Csyntax.statement) (t1 : Events.trace) (m1 : Memory.Mem.mem)
     (v : Values.val) (t2 : Events.trace) (m2 : Memory.Mem.mem)
     (out' out : outcome),
   eval_expression ge e m a t1 m1 v ->
   P e m a t1 m1 v ->
   Cop.bool_val v (Csyntax.typeof a) m1 = Some true ->
   exec_stmt ge e m1 s t2 m2 out' ->
   P2 e m1 s t2 m2 out' ->
   out_break_or_return out' out -> P2 e m ... ... m2 out) ->
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (s : Csyntax.statement) (t1 : Events.trace) (m1 : Memory.Mem.mem)
     (v : Values.val) (t2 : Events.trace) (m2 : Memory.Mem.mem)
     (out1 : outcome) (t3 : Events.trace) (m3 : Memory.Mem.mem)
     (out : outcome),
   eval_expression ge e m a t1 m1 v ->
   P e m a t1 m1 v ->
   Cop.bool_val v (...) m1 = Some true ->
   exec_stmt ge e m1 s t2 m2 out1 -> P2 e m1 s t2 m2 out1 -> ... -> ...) ->
  (forall (e : env) (m : Memory.Mem.mem) (s : Csyntax.statement)
     (a : Csyntax.expr) (t1 : Events.trace) (m1 : Memory.Mem.mem)
     (out1 : outcome) (t2 : Events.trace) (m2 : Memory.Mem.mem)
     (v : Values.val),
   exec_stmt ge e m s t1 m1 out1 ->
   P2 e m s t1 m1 out1 ->
   out_normal_or_continue out1 ->
   eval_expression ge e m1 a t2 m2 v -> ... -> ...) ->
  (forall (e : env) (m : Memory.Mem.mem) (s : Csyntax.statement)
     (a : Csyntax.expr) (t : Events.trace) (m1 : Memory.Mem.mem)
     (out1 out : outcome),
   exec_stmt ge e m s t m1 out1 ->
   P2 e m s t m1 out1 -> out_break_or_return out1 out -> P2 e m ... t m1 out) ->
  (forall (e : env) (m : Memory.Mem.mem) (s : Csyntax.statement)
     (a : Csyntax.expr) (t1 : Events.trace) (m1 : Memory.Mem.mem)
     (out1 : outcome) (t2 : Events.trace) (m2 : Memory.Mem.mem)
     (v : Values.val) (t3 : Events.trace) (m3 : Memory.Mem.mem)
     (out : outcome),
   exec_stmt ge e m s t1 m1 out1 -> P2 e m s t1 m1 out1 -> ... -> ...) ->
  (forall (e : env) (m : Memory.Mem.mem) (s a1 : Csyntax.statement)
     (a2 : Csyntax.expr) (a3 : Csyntax.statement) 
     (out : outcome) (m1 m2 : Memory.Mem.mem) (t1 t2 : Events.trace),
   exec_stmt ge e m a1 t1 m1 Out_normal -> ... -> ...) ->
  (forall ... ... ... ... ... ... ... ..., ... -> ...) ->
  (..., ...) -> (...) -> ... -> ...
Inductive estep (ge : genv) : state -> Events.trace -> state -> Prop :=
    step_expr : forall (f : Csyntax.function) (r : Csyntax.expr) 
                  (k : cont) (e : env) (m : Memory.Mem.mem) 
                  (v : Values.val) (ty : Ctypes.type),
                eval_simple_rvalue ge e m r v ->
                match r with
                | Csyntax.Eval _ _ => False
                | _ => True
                end ->
                ty = Csyntax.typeof r ->
                estep ge (ExprState f r k e m) Events.E0
                  (ExprState f (Csyntax.Eval v ty) k e m)
  | step_rvalof_volatile : forall (f : Csyntax.function)
                             (C : Csyntax.expr -> Csyntax.expr)
                             (l : Csyntax.expr) (ty : Ctypes.type) 
                             (k : cont) (e : env) 
                             (m : Memory.Mem.mem) 
                             (b : Values.block) (ofs : Integers.Ptrofs.int)
                             (bf : Ctypes.bitfield) 
                             (t : Events.trace) (v : Values.val),
                           leftcontext RV RV C ->
                           eval_simple_lvalue ge e m l b ofs bf ->
                           deref_loc ge ty m b ofs bf t v ->
                           ty = Csyntax.typeof l ->
                           Ctypes.type_is_volatile ty = true ->
                           estep ge
                             (ExprState f (C (Csyntax.Evalof l ty)) k e m) t
                             (ExprState f (C (Csyntax.Eval v ty)) k e m)
  | step_seqand_true : forall (f : Csyntax.function)
                         (C : Csyntax.expr -> Csyntax.expr)
                         (r1 r2 : Csyntax.expr) (ty : Ctypes.type) 
                         (k : cont) (e : env) (m : Memory.Mem.mem)
                         (v : Values.val),
                       leftcontext RV RV C ->
                       eval_simple_rvalue ge e m r1 v ->
                       Cop.bool_val v (Csyntax.typeof r1) m = Some true ->
                       estep ge
                         (ExprState f (C (Csyntax.Eseqand r1 r2 ty)) k e m)
                         Events.E0
                         (ExprState f
                            (C (Csyntax.Eparen r2 Ctypes.type_bool ty)) k e m)
  | step_seqand_false : forall (f : Csyntax.function)
                          (C : Csyntax.expr -> Csyntax.expr)
                          (r1 r2 : Csyntax.expr) (ty : Ctypes.type)
                          (k : cont) (e : env) (m : Memory.Mem.mem)
                          (v : Values.val),
                        leftcontext RV RV C ->
                        eval_simple_rvalue ge e m r1 v ->
                        Cop.bool_val v (Csyntax.typeof r1) m = Some false ->
                        estep ge
                          (ExprState f (C (Csyntax.Eseqand r1 r2 ty)) k e m)
                          Events.E0
                          (ExprState f
                             (C
                                (Csyntax.Eval (Values.Vint Integers.Int.zero)
                                   ty))
                             k e m)
  | step_seqor_true : forall (f : Csyntax.function)
                        (C : Csyntax.expr -> Csyntax.expr)
                        (r1 r2 : Csyntax.expr) (ty : Ctypes.type) 
                        (k : cont) (e : env) (m : Memory.Mem.mem)
                        (v : Values.val),
                      leftcontext RV RV C ->
                      eval_simple_rvalue ge e m r1 v ->
                      Cop.bool_val v (Csyntax.typeof r1) m = Some true ->
                      estep ge
                        (ExprState f (C (Csyntax.Eseqor r1 r2 ty)) k e m)
                        Events.E0
                        (ExprState f
                           (C
                              (Csyntax.Eval (Values.Vint Integers.Int.one) ty))
                           k e m)
  | step_seqor_false : forall (f : Csyntax.function)
                         (C : Csyntax.expr -> Csyntax.expr)
                         (r1 r2 : Csyntax.expr) (ty : Ctypes.type) 
                         (k : cont) (e : env) (m : Memory.Mem.mem)
                         (v : Values.val),
                       leftcontext RV RV C ->
                       eval_simple_rvalue ge e m r1 v ->
                       Cop.bool_val v (Csyntax.typeof r1) m = Some false ->
                       estep ge
                         (ExprState f (C (Csyntax.Eseqor r1 r2 ty)) k e m)
                         Events.E0
                         (ExprState f
                            (C (Csyntax.Eparen r2 Ctypes.type_bool ty)) k e m)
  | step_condition : forall (f : Csyntax.function)
                       (C : Csyntax.expr -> Csyntax.expr)
                       (r1 r2 r3 : Csyntax.expr) (ty : Ctypes.type)
                       (k : cont) (e : env) (m : Memory.Mem.mem)
                       (v : Values.val) (b : bool),
                     leftcontext RV RV C ->
                     eval_simple_rvalue ge e m r1 v ->
                     Cop.bool_val v (Csyntax.typeof r1) m = Some b ->
                     estep ge
                       (ExprState f (C (Csyntax.Econdition r1 r2 r3 ty)) k e
                          m)
                       Events.E0
                       (ExprState f
                          (C (Csyntax.Eparen (if b then r2 else r3) ty ty)) k
                          e m)
  | step_assign : forall (f : Csyntax.function)
                    (C : Csyntax.expr -> Csyntax.expr) 
                    (l r : Csyntax.expr) (ty : Ctypes.type) 
                    (k : cont) (e : env) (m : Memory.Mem.mem)
                    (b : Values.block) (ofs : Integers.Ptrofs.int)
                    (bf : Ctypes.bitfield) (v v1 : Values.val)
                    (t : Events.trace) (m' : Memory.Mem.mem)
                    (v' : Values.val),
                  leftcontext RV RV C ->
                  eval_simple_lvalue ge e m l b ofs bf ->
                  eval_simple_rvalue ge e m r v ->
                  Cop.sem_cast v (Csyntax.typeof r) (Csyntax.typeof l) m =
                  Some v1 ->
                  assign_loc ge (Csyntax.typeof l) m b ofs bf v1 t m' v' ->
                  ty = Csyntax.typeof l ->
                  estep ge (ExprState f (C (Csyntax.Eassign l r ty)) k e m) t
                    (ExprState f (C (Csyntax.Eval v' ty)) k e m')
  | step_assignop : forall (f : Csyntax.function)
                      (C : Csyntax.expr -> Csyntax.expr)
                      (op : Cop.binary_operation) 
                      (l r : Csyntax.expr) (tyres ty : Ctypes.type)
                      (k : cont) (e : env) (m : Memory.Mem.mem)
                      (b : Values.block) (ofs : Integers.Ptrofs.int)
                      (bf : Ctypes.bitfield) (v1 v2 v3 v4 : Values.val)
                      (t1 t2 : Events.trace) (m' : Memory.Mem.mem)
                      (v' : Values.val) (t : Events.trace),
                    leftcontext RV RV C ->
                    eval_simple_lvalue ge e m l b ofs bf ->
                    deref_loc ge (Csyntax.typeof l) m b ofs bf t1 v1 ->
                    eval_simple_rvalue ge e m r v2 ->
                    Cop.sem_binary_operation ge op v1 
                      (Csyntax.typeof l) v2 (Csyntax.typeof r) m =
                    Some v3 ->
                    Cop.sem_cast v3 tyres (Csyntax.typeof l) m = Some v4 ->
                    assign_loc ge (Csyntax.typeof l) m b ofs bf v4 t2 m' v' ->
                    ty = Csyntax.typeof l ->
                    t = Events.Eapp t1 t2 ->
                    estep ge
                      (ExprState f (C (Csyntax.Eassignop op l r tyres ty)) k
                         e m)
                      t (ExprState f (C (Csyntax.Eval v' ty)) k e m')
  | step_assignop_stuck : forall (f : Csyntax.function)
                            (C : Csyntax.expr -> Csyntax.expr)
                            (op : Cop.binary_operation) 
                            (l r : Csyntax.expr) (tyres ty : Ctypes.type)
                            (k : cont) (e : env) (m : Memory.Mem.mem)
                            (b : Values.block) (ofs : Integers.Ptrofs.int)
                            (bf : Ctypes.bitfield) 
                            (v1 v2 : Values.val) (t : Events.trace),
                          leftcontext RV RV C ->
                          eval_simple_lvalue ge e m l b ofs bf ->
                          deref_loc ge (Csyntax.typeof l) m b ofs bf t v1 ->
                          eval_simple_rvalue ge e m r v2 ->
                          match
                            Cop.sem_binary_operation ge op v1
                              (Csyntax.typeof l) v2 
                              (Csyntax.typeof r) m
                          with
                          | Some v3 =>
                              match
                                Cop.sem_cast v3 tyres (Csyntax.typeof l) m
                              with
                              | Some v4 =>
                                  forall (t2 : Events.trace)
                                    (m' : Memory.Mem.mem) 
                                    (v' : Values.val),
                                  ~
                                  assign_loc ge (Csyntax.typeof l) m b ofs bf
                                    v4 t2 m' v'
                              | None => True
                              end
                          | None => True
                          end ->
                          ty = Csyntax.typeof l ->
                          estep ge
                            (ExprState f
                               (C (Csyntax.Eassignop op l r tyres ty)) k e m)
                            t Stuckstate
  | step_postincr : forall (f : Csyntax.function)
                      (C : Csyntax.expr -> Csyntax.expr)
                      (id : Cop.incr_or_decr) (l : Csyntax.expr)
                      (ty : Ctypes.type) (k : cont) 
                      (e : env) (m : Memory.Mem.mem) 
                      (b : Values.block) (ofs : Integers.Ptrofs.int)
                      (bf : Ctypes.bitfield) (v1 v2 v3 : Values.val)
                      (t1 t2 : Events.trace) (m' : Memory.Mem.mem)
                      (v' : Values.val) (t : Events.trace),
                    leftcontext RV RV C ->
                    eval_simple_lvalue ge e m l b ofs bf ->
                    deref_loc ge ty m b ofs bf t1 v1 ->
                    Cop.sem_incrdecr ge id v1 ty m = Some v2 ->
                    Cop.sem_cast v2 (Cop.incrdecr_type ty) ty m = Some v3 ->
                    assign_loc ge ty m b ofs bf v3 t2 m' v' ->
                    ty = Csyntax.typeof l ->
                    t = Events.Eapp t1 t2 ->
                    estep ge
                      (ExprState f (C (Csyntax.Epostincr id l ty)) k e m) t
                      (ExprState f (C (Csyntax.Eval v1 ty)) k e m')
  | step_postincr_stuck : forall (f : Csyntax.function)
                            (C : Csyntax.expr -> Csyntax.expr)
                            (id : Cop.incr_or_decr) 
                            (l : Csyntax.expr) (ty : Ctypes.type) 
                            (k : cont) (e : env) (m : Memory.Mem.mem)
                            (b : Values.block) (ofs : Integers.Ptrofs.int)
                            (bf : Ctypes.bitfield) 
                            (v1 : Values.val) (t : Events.trace),
                          leftcontext RV RV C ->
                          eval_simple_lvalue ge e m l b ofs bf ->
                          deref_loc ge ty m b ofs bf t v1 ->
                          match Cop.sem_incrdecr ge id v1 ty m with
                          | Some v2 =>
                              match
                                Cop.sem_cast v2 (Cop.incrdecr_type ty) ty m
                              with
                              | Some v3 =>
                                  forall (t2 : Events.trace)
                                    (m' : Memory.Mem.mem) 
                                    (v' : Values.val),
                                  ~
                                  assign_loc ge (Csyntax.typeof l) m b ofs bf
                                    v3 t2 m' v'
                              | None => True
                              end
                          | None => True
                          end ->
                          ty = Csyntax.typeof l ->
                          estep ge
                            (ExprState f (C (Csyntax.Epostincr id l ty)) k e
                               m)
                            t Stuckstate
  | step_comma : forall (f : Csyntax.function)
                   (C : Csyntax.expr -> Csyntax.expr) 
                   (r1 r2 : Csyntax.expr) (ty : Ctypes.type) 
                   (k : cont) (e : env) (m : Memory.Mem.mem) 
                   (v : Values.val),
                 leftcontext RV RV C ->
                 eval_simple_rvalue ge e m r1 v ->
                 ty = Csyntax.typeof r2 ->
                 estep ge (ExprState f (C (Csyntax.Ecomma r1 r2 ty)) k e m)
                   Events.E0 (ExprState f (C r2) k e m)
  | step_paren : forall (f : Csyntax.function)
                   (C : Csyntax.expr -> Csyntax.expr) 
                   (r : Csyntax.expr) (tycast ty : Ctypes.type) 
                   (k : cont) (e : env) (m : Memory.Mem.mem)
                   (v1 v : Values.val),
                 leftcontext RV RV C ->
                 eval_simple_rvalue ge e m r v1 ->
                 Cop.sem_cast v1 (Csyntax.typeof r) tycast m = Some v ->
                 estep ge
                   (ExprState f (C (Csyntax.Eparen r tycast ty)) k e m)
                   Events.E0 (ExprState f (C (Csyntax.Eval v ty)) k e m)
  | step_call : forall (f : Csyntax.function)
                  (C : Csyntax.expr -> Csyntax.expr) 
                  (rf : Csyntax.expr) (rargs : Csyntax.exprlist)
                  (ty : Ctypes.type) (k : cont) (e : env)
                  (m : Memory.Mem.mem) (targs : list Ctypes.type)
                  (tres : Ctypes.type) (cconv : AST.calling_convention)
                  (vf : Values.val) (vargs : list Values.val)
                  (fd : Csyntax.fundef),
                leftcontext RV RV C ->
                Cop.classify_fun (Csyntax.typeof rf) =
                Cop.fun_case_f targs tres cconv ->
                eval_simple_rvalue ge e m rf vf ->
                eval_simple_list ge e m rargs targs vargs ->
                Globalenvs.Genv.find_funct ge vf = Some fd ->
                Csyntax.type_of_fundef fd = Ctypes.Tfunction targs tres cconv ->
                estep ge (ExprState f (C (Csyntax.Ecall rf rargs ty)) k e m)
                  Events.E0 (Callstate fd vargs (Kcall f e C ty k) m)
  | step_builtin : forall (f : Csyntax.function)
                     (C : Csyntax.expr -> Csyntax.expr)
                     (ef : AST.external_function) 
                     (tyargs : list Ctypes.type) (rargs : Csyntax.exprlist)
                     (ty : Ctypes.type) (k : cont) 
                     (e : env) (m : Memory.Mem.mem) 
                     (vargs : list Values.val) (t : Events.trace)
                     (vres : Values.val) (m' : Memory.Mem.mem),
                   leftcontext RV RV C ->
                   eval_simple_list ge e m rargs tyargs vargs ->
                   Events.external_call ef (Globalenvs.Genv.to_senv ge) vargs
                     m t vres m' ->
                   estep ge
                     (ExprState f (C (Csyntax.Ebuiltin ef tyargs rargs ty)) k
                        e m)
                     t (ExprState f (C (Csyntax.Eval vres ty)) k e m').

Arguments estep ge _ _ _
Arguments step_expr ge f r k e m v ty _ _ _
Arguments step_rvalof_volatile ge f C%_function_scope 
  l ty k e m b ofs bf t v _ _ _ _ _
Arguments step_seqand_true ge f C%_function_scope r1 r2 ty k e m v _ _ _
Arguments step_seqand_false ge f C%_function_scope r1 r2 ty k e m v _ _ _
Arguments step_seqor_true ge f C%_function_scope r1 r2 ty k e m v _ _ _
Arguments step_seqor_false ge f C%_function_scope r1 r2 ty k e m v _ _ _
Arguments step_condition ge f C%_function_scope r1 
  r2 r3 ty k e m v b%_bool_scope _ _ _
Arguments step_assign ge f C%_function_scope l r ty 
  k e m b ofs bf v v1 t m' v' _ _ _ _ _ _
Arguments step_assignop ge f C%_function_scope op 
  l r tyres ty k e m b ofs bf v1 v2 v3 v4 t1 t2 m' 
  v' t _ _ _ _ _ _ _ _ _
Arguments step_assignop_stuck ge f C%_function_scope 
  op l r tyres ty k e m b ofs bf v1 v2 t _ _ _ _ _ 
  _
Arguments step_postincr ge f C%_function_scope id 
  l ty k e m b ofs bf v1 v2 v3 t1 t2 m' v' t _ _ _ 
  _ _ _ _ _
Arguments step_postincr_stuck ge f C%_function_scope 
  id l ty k e m b ofs bf v1 t _ _ _ _ _
Arguments step_comma ge f C%_function_scope r1 r2 ty k e m v _ _ _
Arguments step_paren ge f C%_function_scope r tycast ty k e m v1 v _ _ _
Arguments step_call ge f C%_function_scope rf rargs 
  ty k e m targs%_list_scope tres cconv vf vargs%_list_scope 
  fd _ _ _ _ _ _
Arguments step_builtin ge f C%_function_scope ef tyargs%_list_scope 
  rargs ty k e m vargs%_list_scope t vres m' _ _ _
eval_expr_to_steps =
fun ge : genv => proj1 (proj2 (bigstep_to_steps ge))
     : forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
         (K : kind) (a : Csyntax.expr) (t : Events.trace)
         (m' : Memory.Mem.mem) (a' : Csyntax.expr),
       eval_expr ge e m K a t m' a' ->
       forall (C : Csyntax.expr -> Csyntax.expr) (f : Csyntax.function)
         (k : cont),
       leftcontext K RV C ->
       simple a' = true /\
       Csyntax.typeof a' = Csyntax.typeof a /\
       Smallstep.star step ge (ExprState f (C a) k e m) t
         (ExprState f (C a') k e m')

Arguments eval_expr_to_steps ge e m K a t m' a' _ C%_function_scope f k _
