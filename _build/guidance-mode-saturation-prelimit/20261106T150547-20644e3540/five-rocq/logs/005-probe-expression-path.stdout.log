exec_Sdo:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (t : Events.trace) (m' : Memory.Mem.mem)
    (v : Values.val),
  eval_expression ge e m a t m' v ->
  exec_stmt ge e m (Csyntax.Sdo a) t m' Out_normal
eval_expression_intro:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (t : Events.trace) (m' : Memory.Mem.mem)
    (a' : Csyntax.expr) (v : Values.val),
  eval_expr ge e m RV a t m' a' ->
  eval_simple_rvalue ge e m' a' v -> eval_expression ge e m a t m' v
exec_Sreturn_some:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (t : Events.trace) (m' : Memory.Mem.mem)
    (v : Values.val),
  eval_expression ge e m a t m' v ->
  exec_stmt ge e m (Csyntax.Sreturn (Some a)) t m'
    (Out_return (Some (v, Csyntax.typeof a)))
eval_expression_to_steps:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (t : Events.trace) (m' : Memory.Mem.mem)
    (v : Values.val),
  eval_expression ge e m a t m' v ->
  forall (f : Csyntax.function) (k : cont),
  Smallstep.star step ge (ExprState f a k e m) t
    (ExprState f (Csyntax.Eval v (Csyntax.typeof a)) k e m')
exec_Swhile_false:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (s : Csyntax.statement) (t : Events.trace)
    (m' : Memory.Mem.mem) (v : Values.val),
  eval_expression ge e m a t m' v ->
  Cop.bool_val v (Csyntax.typeof a) m' = Some false ->
  exec_stmt ge e m (Csyntax.Swhile a s) t m' Out_normal
exec_Sfor_false:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (s : Csyntax.statement) (a2 : Csyntax.expr) (a3 : Csyntax.statement)
    (t : Events.trace) (m' : Memory.Mem.mem) (v : Values.val),
  eval_expression ge e m a2 t m' v ->
  Cop.bool_val v (Csyntax.typeof a2) m' = Some false ->
  exec_stmt ge e m (Csyntax.Sfor Csyntax.Sskip a2 a3 s) t m' Out_normal
eval_expression_ind:
  forall (ge : genv)
    (P : env ->
         Memory.Mem.mem ->
         Csyntax.expr -> Events.trace -> Memory.Mem.mem -> Values.val -> Prop),
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (t : Events.trace) (m' : Memory.Mem.mem) (a' : Csyntax.expr)
     (v : Values.val),
   eval_expr ge e m RV a t m' a' ->
   eval_simple_rvalue ge e m' a' v -> P e m a t m' v) ->
  forall (e : env) (m : Memory.Mem.mem) (e0 : Csyntax.expr)
    (t : Events.trace) (m0 : Memory.Mem.mem) (v : Values.val),
  eval_expression ge e m e0 t m0 v -> P e m e0 t m0 v
eval_expression_sind:
  forall (ge : genv)
    (P : env ->
         Memory.Mem.mem ->
         Csyntax.expr ->
         Events.trace -> Memory.Mem.mem -> Values.val -> SProp),
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (t : Events.trace) (m' : Memory.Mem.mem) (a' : Csyntax.expr)
     (v : Values.val),
   eval_expr ge e m RV a t m' a' ->
   eval_simple_rvalue ge e m' a' v -> P e m a t m' v) ->
  forall (e : env) (m : Memory.Mem.mem) (e0 : Csyntax.expr)
    (t : Events.trace) (m0 : Memory.Mem.mem) (v : Values.val),
  eval_expression ge e m e0 t m0 v -> P e m e0 t m0 v
execinf_Swhile_body:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (s : Csyntax.statement) (t1 : Events.trace)
    (m1 : Memory.Mem.mem) (v : Values.val) (t2 : Events.traceinf),
  eval_expression ge e m a t1 m1 v ->
  Cop.bool_val v (Csyntax.typeof a) m1 = Some true ->
  execinf_stmt ge e m1 s t2 ->
  execinf_stmt ge e m (Csyntax.Swhile a s) (Events.Eappinf t1 t2)
execinf_Sifthenelse:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (s1 s2 : Csyntax.statement) 
    (t1 : Events.trace) (m1 : Memory.Mem.mem) (v1 : Values.val)
    (t2 : Events.traceinf) (b : bool),
  eval_expression ge e m a t1 m1 v1 ->
  Cop.bool_val v1 (Csyntax.typeof a) m1 = Some b ->
  execinf_stmt ge e m1 (if b then s1 else s2) t2 ->
  execinf_stmt ge e m (Csyntax.Sifthenelse a s1 s2) (Events.Eappinf t1 t2)
execinf_Sfor_body:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (s : Csyntax.statement) (a2 : Csyntax.expr) (a3 : Csyntax.statement)
    (t1 : Events.trace) (m1 : Memory.Mem.mem) (v : Values.val)
    (t2 : Events.traceinf),
  eval_expression ge e m a2 t1 m1 v ->
  Cop.bool_val v (Csyntax.typeof a2) m1 = Some true ->
  execinf_stmt ge e m1 s t2 ->
  execinf_stmt ge e m (Csyntax.Sfor Csyntax.Sskip a2 a3 s)
    (Events.Eappinf t1 t2)
execinf_Sswitch_body:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (sl : Csyntax.labeled_statements) 
    (t1 : Events.trace) (m1 : Memory.Mem.mem) (v : Values.val)
    (n : BinNums.Z) (t2 : Events.traceinf),
  eval_expression ge e m a t1 m1 v ->
  Cop.sem_switch_arg v (Csyntax.typeof a) = Some n ->
  execinf_stmt ge e m1 (seq_of_labeled_statement (select_switch n sl)) t2 ->
  execinf_stmt ge e m (Csyntax.Sswitch a sl) (Events.Eappinf t1 t2)
exec_Sifthenelse:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (s1 s2 : Csyntax.statement) 
    (t1 : Events.trace) (m1 : Memory.Mem.mem) (v1 : Values.val)
    (t2 : Events.trace) (m2 : Memory.Mem.mem) (b : bool) 
    (out : outcome),
  eval_expression ge e m a t1 m1 v1 ->
  Cop.bool_val v1 (Csyntax.typeof a) m1 = Some b ->
  exec_stmt ge e m1 (if b then s1 else s2) t2 m2 out ->
  exec_stmt ge e m (Csyntax.Sifthenelse a s1 s2) (Events.Eapp t1 t2) m2 out
exec_Sdowhile_false:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (s : Csyntax.statement) (a : Csyntax.expr) (t1 : Events.trace)
    (m1 : Memory.Mem.mem) (out1 : outcome) (t2 : Events.trace)
    (m2 : Memory.Mem.mem) (v : Values.val),
  exec_stmt ge e m s t1 m1 out1 ->
  out_normal_or_continue out1 ->
  eval_expression ge e m1 a t2 m2 v ->
  Cop.bool_val v (Csyntax.typeof a) m2 = Some false ->
  exec_stmt ge e m (Csyntax.Sdowhile a s) (Events.Eapp t1 t2) m2 Out_normal
exec_Swhile_stop:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (s : Csyntax.statement) (t1 : Events.trace)
    (m1 : Memory.Mem.mem) (v : Values.val) (t2 : Events.trace)
    (m2 : Memory.Mem.mem) (out' out : outcome),
  eval_expression ge e m a t1 m1 v ->
  Cop.bool_val v (Csyntax.typeof a) m1 = Some true ->
  exec_stmt ge e m1 s t2 m2 out' ->
  out_break_or_return out' out ->
  exec_stmt ge e m (Csyntax.Swhile a s) (Events.Eapp t1 t2) m2 out
exec_Sswitch:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (sl : Csyntax.labeled_statements) 
    (t1 : Events.trace) (m1 : Memory.Mem.mem) (v : Values.val)
    (n : BinNums.Z) (t2 : Events.trace) (m2 : Memory.Mem.mem) 
    (out : outcome),
  eval_expression ge e m a t1 m1 v ->
  Cop.sem_switch_arg v (Csyntax.typeof a) = Some n ->
  exec_stmt ge e m1 (seq_of_labeled_statement (select_switch n sl)) t2 m2 out ->
  exec_stmt ge e m (Csyntax.Sswitch a sl) (Events.Eapp t1 t2) m2
    (outcome_switch out)
exec_Sfor_stop:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (s : Csyntax.statement) (a2 : Csyntax.expr) (a3 : Csyntax.statement)
    (t1 : Events.trace) (m1 : Memory.Mem.mem) (v : Values.val)
    (t2 : Events.trace) (m2 : Memory.Mem.mem) (out1 out : outcome),
  eval_expression ge e m a2 t1 m1 v ->
  Cop.bool_val v (Csyntax.typeof a2) m1 = Some true ->
  exec_stmt ge e m1 s t2 m2 out1 ->
  out_break_or_return out1 out ->
  exec_stmt ge e m (Csyntax.Sfor Csyntax.Sskip a2 a3 s) 
    (Events.Eapp t1 t2) m2 out
execinf_Sdowhile_loop:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (s : Csyntax.statement) (a : Csyntax.expr) (t1 : Events.trace)
    (m1 : Memory.Mem.mem) (out1 : outcome) (t2 : Events.trace)
    (m2 : Memory.Mem.mem) (v : Values.val) (t3 : Events.traceinf),
  exec_stmt ge e m s t1 m1 out1 ->
  out_normal_or_continue out1 ->
  eval_expression ge e m1 a t2 m2 v ->
  Cop.bool_val v (Csyntax.typeof a) m2 = Some true ->
  execinf_stmt ge e m2 (Csyntax.Sdowhile a s) t3 ->
  execinf_stmt ge e m (Csyntax.Sdowhile a s)
    (Events.Eappinf t1 (Events.Eappinf t2 t3))
execinf_Swhile_loop:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (s : Csyntax.statement) (t1 : Events.trace)
    (m1 : Memory.Mem.mem) (v : Values.val) (t2 : Events.trace)
    (m2 : Memory.Mem.mem) (out1 : outcome) (t3 : Events.traceinf),
  eval_expression ge e m a t1 m1 v ->
  Cop.bool_val v (Csyntax.typeof a) m1 = Some true ->
  exec_stmt ge e m1 s t2 m2 out1 ->
  out_normal_or_continue out1 ->
  execinf_stmt ge e m2 (Csyntax.Swhile a s) t3 ->
  execinf_stmt ge e m (Csyntax.Swhile a s)
    (Events.Eappinf t1 (Events.Eappinf t2 t3))
exec_Swhile_loop:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (a : Csyntax.expr) (s : Csyntax.statement) (t1 : Events.trace)
    (m1 : Memory.Mem.mem) (v : Values.val) (t2 : Events.trace)
    (m2 : Memory.Mem.mem) (out1 : outcome) (t3 : Events.trace)
    (m3 : Memory.Mem.mem) (out : outcome),
  eval_expression ge e m a t1 m1 v ->
  Cop.bool_val v (Csyntax.typeof a) m1 = Some true ->
  exec_stmt ge e m1 s t2 m2 out1 ->
  out_normal_or_continue out1 ->
  exec_stmt ge e m2 (Csyntax.Swhile a s) t3 m3 out ->
  exec_stmt ge e m (Csyntax.Swhile a s) (Events.Eapp t1 (Events.Eapp t2 t3))
    m3 out
exec_Sdowhile_loop:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (s : Csyntax.statement) (a : Csyntax.expr) (t1 : Events.trace)
    (m1 : Memory.Mem.mem) (out1 : outcome) (t2 : Events.trace)
    (m2 : Memory.Mem.mem) (v : Values.val) (t3 : Events.trace)
    (m3 : Memory.Mem.mem) (out : outcome),
  exec_stmt ge e m s t1 m1 out1 ->
  out_normal_or_continue out1 ->
  eval_expression ge e m1 a t2 m2 v ->
  Cop.bool_val v (Csyntax.typeof a) m2 = Some true ->
  exec_stmt ge e m2 (Csyntax.Sdowhile a s) t3 m3 out ->
  exec_stmt ge e m (Csyntax.Sdowhile a s)
    (Events.Eapp t1 (Events.Eapp t2 t3)) m3 out
execinf_Sfor_next:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (s : Csyntax.statement) (a2 : Csyntax.expr) (a3 : Csyntax.statement)
    (t1 : Events.trace) (m1 : Memory.Mem.mem) (v : Values.val)
    (t2 : Events.trace) (m2 : Memory.Mem.mem) (out1 : outcome)
    (t3 : Events.traceinf),
  eval_expression ge e m a2 t1 m1 v ->
  Cop.bool_val v (Csyntax.typeof a2) m1 = Some true ->
  exec_stmt ge e m1 s t2 m2 out1 ->
  out_normal_or_continue out1 ->
  execinf_stmt ge e m2 a3 t3 ->
  execinf_stmt ge e m (Csyntax.Sfor Csyntax.Sskip a2 a3 s)
    (Events.Eappinf t1 (Events.Eappinf t2 t3))
execinf_Sfor_loop:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (s : Csyntax.statement) (a2 : Csyntax.expr) (a3 : Csyntax.statement)
    (t1 : Events.trace) (m1 : Memory.Mem.mem) (v : Values.val)
    (t2 : Events.trace) (m2 : Memory.Mem.mem) (out1 : outcome)
    (t3 : Events.trace) (m3 : Memory.Mem.mem) (t4 : Events.traceinf),
  eval_expression ge e m a2 t1 m1 v ->
  Cop.bool_val v (Csyntax.typeof a2) m1 = Some true ->
  exec_stmt ge e m1 s t2 m2 out1 ->
  out_normal_or_continue out1 ->
  exec_stmt ge e m2 a3 t3 m3 Out_normal ->
  execinf_stmt ge e m3 (Csyntax.Sfor Csyntax.Sskip a2 a3 s) t4 ->
  execinf_stmt ge e m (Csyntax.Sfor Csyntax.Sskip a2 a3 s)
    (Events.Eappinf t1 (Events.Eappinf t2 (Events.Eappinf t3 t4)))
exec_Sfor_loop:
  forall (ge : genv) (e : env) (m : Memory.Mem.mem) 
    (s : Csyntax.statement) (a2 : Csyntax.expr) (a3 : Csyntax.statement)
    (t1 : Events.trace) (m1 : Memory.Mem.mem) (v : Values.val)
    (t2 : Events.trace) (m2 : Memory.Mem.mem) (out1 : outcome)
    (t3 : Events.trace) (m3 : Memory.Mem.mem) (t4 : Events.trace)
    (m4 : Memory.Mem.mem) (out : outcome),
  eval_expression ge e m a2 t1 m1 v ->
  Cop.bool_val v (Csyntax.typeof a2) m1 = Some true ->
  exec_stmt ge e m1 s t2 m2 out1 ->
  out_normal_or_continue out1 ->
  exec_stmt ge e m2 a3 t3 m3 Out_normal ->
  exec_stmt ge e m3 (Csyntax.Sfor Csyntax.Sskip a2 a3 s) t4 m4 out ->
  exec_stmt ge e m (Csyntax.Sfor Csyntax.Sskip a2 a3 s)
    (Events.Eapp t1 (Events.Eapp t2 (Events.Eapp t3 t4))) m4 out
bigstep_to_steps:
  forall ge : genv,
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (t : Events.trace) (m' : Memory.Mem.mem) (v : Values.val),
   eval_expression ge e m a t m' v ->
   forall (f : Csyntax.function) (k : cont),
   Smallstep.star step ge (ExprState f a k e m) t
     (ExprState f (Csyntax.Eval v (Csyntax.typeof a)) k e m')) /\
  (forall (e : env) (m : Memory.Mem.mem) (K : kind) 
     (a : Csyntax.expr) (t : Events.trace) (m' : Memory.Mem.mem)
     (a' : Csyntax.expr),
   eval_expr ge e m K a t m' a' ->
   forall (C : Csyntax.expr -> Csyntax.expr) (f : Csyntax.function)
     (k : cont),
   leftcontext K RV C ->
   simple a' = true /\
   Csyntax.typeof a' = Csyntax.typeof a /\
   Smallstep.star step ge (ExprState f (C a) k e m) t
     (ExprState f (C a') k e m')) /\
  (forall (e : env) (m : Memory.Mem.mem) (al : Csyntax.exprlist)
     (t : Events.trace) (m' : Memory.Mem.mem) (al' : Csyntax.exprlist),
   eval_exprlist ge e m al t m' al' ->
   forall (a1 : Csyntax.expr) (al2 : Csyntax.exprlist) 
     (ty : Ctypes.type) (C : Csyntax.expr -> Csyntax.expr)
     (f : Csyntax.function) (k : cont),
   leftcontext RV RV C ->
   simple a1 = true ->
   simplelist al2 = true ->
   simplelist al' = true /\
   Smallstep.star step ge
     (ExprState f (C (Csyntax.Ecall a1 (exprlist_app al2 al) ty)) k e m) t
     (ExprState f (C (Csyntax.Ecall a1 (exprlist_app al2 al') ty)) k e m')) /\
  (forall (e : env) (m : Memory.Mem.mem) (s : Csyntax.statement)
     (t : Events.trace) (m' : Memory.Mem.mem) (out : outcome),
   exec_stmt ge e m s t m' out ->
   forall (f : Csyntax.function) (k : cont),
   exists S : state,
     Smallstep.star step ge (State f s k e m) t S /\
     outcome_state_match e m' f k out S) /\
  (forall (m : Memory.Mem.mem) (fd : Csyntax.fundef) 
     (args : list Values.val) (t : Events.trace) (m' : Memory.Mem.mem)
     (res : Values.val),
   eval_funcall ge m fd args t m' res ->
   forall k : cont,
   is_call_cont k ->
   Smallstep.star step ge (Callstate fd args k m) t (Returnstate res k m'))
exec_stmt_ind:
  forall (ge : genv)
    (P : env ->
         Memory.Mem.mem ->
         Csyntax.statement ->
         Events.trace -> Memory.Mem.mem -> outcome -> Prop),
  (forall (e : env) (m : Memory.Mem.mem),
   P e m Csyntax.Sskip Events.E0 m Out_normal) ->
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (t : Events.trace) (m' : Memory.Mem.mem) (v : Values.val),
   eval_expression ge e m a t m' v -> P e m (Csyntax.Sdo a) t m' Out_normal) ->
  (forall (e : env) (m : Memory.Mem.mem) (s1 s2 : Csyntax.statement)
     (t1 : Events.trace) (m1 : Memory.Mem.mem) (t2 : Events.trace)
     (m2 : Memory.Mem.mem) (out : outcome),
   exec_stmt ge e m s1 t1 m1 Out_normal ->
   P e m s1 t1 m1 Out_normal ->
   exec_stmt ge e m1 s2 t2 m2 out ->
   P e m1 s2 t2 m2 out ->
   P e m (Csyntax.Ssequence s1 s2) (Events.Eapp t1 t2) m2 out) ->
  (forall (e : env) (m : Memory.Mem.mem) (s1 s2 : Csyntax.statement)
     (t1 : Events.trace) (m1 : Memory.Mem.mem) (out : outcome),
   exec_stmt ge e m s1 t1 m1 out ->
   P e m s1 t1 m1 out ->
   out <> Out_normal -> P e m (Csyntax.Ssequence s1 s2) t1 m1 out) ->
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (s1 s2 : Csyntax.statement) (t1 : Events.trace) 
     (m1 : Memory.Mem.mem) (v1 : Values.val) (t2 : Events.trace)
     (m2 : Memory.Mem.mem) (b : bool) (out : outcome),
   eval_expression ge e m a t1 m1 v1 ->
   Cop.bool_val v1 (Csyntax.typeof a) m1 = Some b ->
   exec_stmt ge e m1 (if b then s1 else s2) t2 m2 out ->
   P e m1 (if b then s1 else s2) t2 m2 out ->
   P e m (Csyntax.Sifthenelse a s1 s2) (Events.Eapp t1 t2) m2 out) ->
  (forall (e : env) (m : Memory.Mem.mem),
   P e m (Csyntax.Sreturn None) Events.E0 m (Out_return None)) ->
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (t : Events.trace) (m' : Memory.Mem.mem) (v : Values.val),
   eval_expression ge e m a t m' v ->
   P e m (Csyntax.Sreturn (Some a)) t m'
     (Out_return (Some (v, Csyntax.typeof a)))) ->
  (forall (e : env) (m : Memory.Mem.mem),
   P e m Csyntax.Sbreak Events.E0 m Out_break) ->
  (forall (e : env) (m : Memory.Mem.mem),
   P e m Csyntax.Scontinue Events.E0 m Out_continue) ->
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (s : Csyntax.statement) (t : Events.trace) (m' : Memory.Mem.mem)
     (v : Values.val),
   eval_expression ge e m a t m' v ->
   Cop.bool_val v (Csyntax.typeof a) m' = Some false ->
   P e m (Csyntax.Swhile a s) t m' Out_normal) ->
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (s : Csyntax.statement) (t1 : Events.trace) (m1 : Memory.Mem.mem)
     (v : Values.val) (t2 : Events.trace) (m2 : Memory.Mem.mem)
     (out' out : outcome),
   eval_expression ge e m a t1 m1 v ->
   Cop.bool_val v (Csyntax.typeof a) m1 = Some true ->
   exec_stmt ge e m1 s t2 m2 out' ->
   P e m1 s t2 m2 out' ->
   out_break_or_return out' out ->
   P e m (Csyntax.Swhile a s) (Events.Eapp t1 t2) m2 out) ->
  (forall (e : env) (m : Memory.Mem.mem) (a : Csyntax.expr)
     (s : Csyntax.statement) (t1 : Events.trace) (m1 : Memory.Mem.mem)
     (v : Values.val) (t2 : Events.trace) (m2 : Memory.Mem.mem)
     (out1 : outcome) (t3 : Events.trace) (m3 : Memory.Mem.mem)
     (out : outcome),
   eval_expression ge e m a t1 m1 v ->
   Cop.bool_val v (Csyntax.typeof a) m1 = Some true ->
   exec_stmt ge e m1 s t2 m2 out1 ->
   P e m1 s t2 m2 out1 ->
   out_normal_or_continue out1 ->
   exec_stmt ge e m2 (Csyntax.Swhile a s) t3 m3 out ->
   P e m2 (Csyntax.Swhile a s) t3 m3 out ->
   P e m (Csyntax.Swhile a s) (Events.Eapp t1 (Events.Eapp t2 t3)) m3 out) ->
  (forall (e : env) (m : Memory.Mem.mem) (s : Csyntax.statement)
     (a : Csyntax.expr) (t1 : Events.trace) (m1 : Memory.Mem.mem)
     (out1 : outcome) (t2 : Events.trace) (m2 : Memory.Mem.mem)
     (v : Values.val),
   exec_stmt ge e m s t1 m1 out1 ->
   P e m s t1 m1 out1 ->
   out_normal_or_continue out1 ->
   eval_expression ge e m1 a t2 m2 v ->
   Cop.bool_val v (Csyntax.typeof a) m2 = Some false ->
   P e m (Csyntax.Sdowhile a s) (Events.Eapp t1 t2) m2 Out_normal) ->
  (forall (e : env) (m : Memory.Mem.mem) (s : Csyntax.statement)
     (a : Csyntax.expr) (t : Events.trace) (m1 : Memory.Mem.mem)
     (out1 out : outcome),
   exec_stmt ge e m s t m1 out1 ->
   P e m s t m1 out1 ->
   out_break_or_return out1 out -> P e m (Csyntax.Sdowhile a s) t m1 out) ->
  (forall (e : env) (m : Memory.Mem.mem) (s : Csyntax.statement)
     (a : Csyntax.expr) (t1 : Events.trace) (m1 : Memory.Mem.mem)
     (out1 : outcome) (t2 : Events.trace) (m2 : Memory.Mem.mem)
     (v : Values.val) (t3 : Events.trace) (m3 : Memory.Mem.mem)
     (out : outcome),
   exec_stmt ge e m s t1 m1 out1 ->
   P e m s t1 m1 out1 ->
   out_normal_or_continue out1 ->
