Lemma join_certificate:forall ge P Q middle target,
 certificate ge P middle ->certificate ge Q target ->Q middle ->
 certificate ge(fun s=>P s \/Q s)target.
Proof.
 intros ge P Q middle target[PP PC][QP QC]QM;split.
 - intros s[PS|QS].
   + destruct(PP s PS)as[EQ|[t[next[STEP PN]]]].
     * subst s;destruct(QP middle QM)as[EQ|[t[next[STEP QN]]]];[auto|right;eauto].
     * right;eauto.
   + destruct(QP s QS)as[EQ|[t[next[STEP QN]]]];[auto|right;eauto].
 - intros s t next[PS|QS]NF STEP.
   + destruct(classic(s=middle))as[EQ|NE].
     * subst s;right;eapply QC;eauto.
     * left;eapply PC;eauto.
   + right;eapply QC;eauto.
Qed.

Lemma prepend_transition:forall ge initial middle P target,
 unique_transition ge initial middle ->certificate ge P target ->P middle ->
 exists Q,certificate ge Q target /\Q initial.
Proof.
 intros ge initial middle P target TRANS CERT PI.
 exists(fun s=>s=initial \/P s);split;[|auto].
 eapply chain_certificate with(P:=fun s=>s=initial)(middle:=initial)(initial:=middle);
 [apply singleton_certificate|exact CERT|exact TRANS|exact PI].
Qed.

Lemma normal_block_certificate:forall ge f e k m st mf,
 block_stmt st=true ->Cstrategy.exec_stmt ge e m st E0 mf Out_normal ->
 exists P,certificate ge P(State f Sskip k e mf) /\P(State f st k e m).
Proof.
 intros ge f e k m st mf SYN EXEC.
 exists(block_context_invariant ge k f e mf);split.
 - split;[apply block_context_progress|apply block_context_all_successors].
 - eapply block_context_entry;[exact SYN|eapply normal_statement_path;exact EXEC].
Qed.

Lemma single_deref:forall ge m b x,
 Mem.load Mfloat32 m b 0=Some(Vsingle x) ->
 Cexec.do_deref_loc ge quiet_world tfloat m b Ptrofs.zero Full=
 Some(quiet_world,E0,Vsingle x).
Proof.
 intros ge m b x LOAD;apply Cexec.do_deref_loc_complete;[|constructor].
 eapply deref_loc_value;[reflexivity|reflexivity|].
 unfold Mem.loadv;rewrite Ptrofs.unsigned_zero;rewrite zle_true;
 [exact LOAD|change(0+4<=18446744073709551616)%Z;lia].
Qed.

Lemma single_assign:forall ge m b x mf,
 Mem.store Mfloat32 m b 0(Vsingle x)=Some mf ->
 Cexec.do_assign_loc ge quiet_world tfloat m b Ptrofs.zero Full(Vsingle x)=
 Some(quiet_world,E0,mf,Vsingle x).
Proof.
 intros ge m b x mf STORE;apply Cexec.do_assign_loc_complete;[|constructor].
 eapply assign_loc_value;[reflexivity|reflexivity|].
 unfold Mem.storev;rewrite Ptrofs.unsigned_zero;rewrite zle_true;
 [exact STORE|change(0+4<=18446744073709551616)%Z;lia].
Qed.
Print Assumptions join_certificate.

Lemma sequence_certificate:forall ge f e k m mid first second P Q target,
 certificate ge P(State f Sskip(Kseq second k)e mid) ->
 P(State f first(Kseq second k)e m) ->
 certificate ge Q target ->Q(State f second k e mid) ->
 exists R,certificate ge R target /\R(State f(Ssequence first second)k e m).
Proof.
 intros ge f e k m mid first second P Q target CP PI CQ QI.
 pose proof(chain_certificate ge P Q _ _ target CP CQ
 (skip_sequence_transition ge f second k e mid)QI)as JOIN.
 eapply prepend_transition;[apply sequence_transition|exact JOIN|left;exact PI].
Qed.
From Stdlib Require Import Bool List Classical.
From compcert Require Import Coqlib Maps AST Values Memory Events Ctypes Csyntax Csem Smallstep.
Import ListNotations.
Definition certificate(ge:genv)(P:Csem.state->Prop)(target:Csem.state):Prop :=
 (forall s,P s ->s=target \/ exists t next,Csem.step ge s t next /\ P next) /\
 (forall s t next,P s ->s<>target ->Csem.step ge s t next ->P next).
Definition unique_transition(ge:genv)(from to:Csem.state):Prop :=
 Csem.step ge from E0 to /\
 forall t next,Csem.step ge from t next ->t=E0 /\ next=to.
Theorem chain_certificate:forall ge P Q middle initial target,
 certificate ge P middle -> certificate ge Q target ->
 unique_transition ge middle initial ->Q initial ->
 certificate ge(fun s=>P s \/ Q s)target.
Proof.
 intros ge P Q middle initial target[PP PC][QP QC][BRIDGE UNIQUE]QI.
 split.
 - intros s[PS|QS].
   + destruct(PP s PS)as[EQ|[t[next[STEP PN]]]].
     * subst s;right;exists E0,initial;split;auto.
     * right;exists t,next;split;auto.
   + destruct(QP s QS)as[EQ|[t[next[STEP QN]]]].
     * auto.
     * right;exists t,next;split;auto.
 - intros s t next[PS|QS]NF STEP.
   + destruct(classic(s=middle))as[EQ|NE].
     * subst;destruct(UNIQUE _ _ STEP);subst;auto.
     * left;eapply PC;eauto.
   + right;eapply QC;eauto.
Qed.
Theorem singleton_bridge_certificate:forall ge initial target,
 unique_transition ge initial target ->
 certificate ge(fun s=>s=initial \/ s=target)target.
Proof.
 intros ge initial target[STEP UNIQUE];split.
 - intros s[EQ|EQ];[subst s;right;exists E0,target;split;auto|auto].
 - intros s t next[EQ|EQ]NF ST;subst;try contradiction.
   destruct(UNIQUE _ _ ST);subst;auto.
Qed.
Theorem certificate_reachable:forall ge P target initial,
 certificate ge P target ->P initial ->nostep Csem.step ge target ->
 forall t reached,star Csem.step ge initial t reached ->P reached.
Proof.
 intros ge P target initial[PR CL]PI STOP t reached PATH.
 revert PI;induction PATH;intros PI;auto.
 apply IHPATH;destruct(classic(s1=target))as[EQ|NE].
 - subst;exfalso;eapply STOP;eauto.
 - eapply CL;eauto.
Qed.
Theorem certificate_no_error:forall ge P target initial,
 certificate ge P target ->P initial ->nostep Csem.step ge target ->
 forall t reached,star Csem.step ge initial t reached ->
 reached=target \/ exists tr next,Csem.step ge reached tr next.
Proof.
 intros ge P target initial CERT PI STOP t reached PATH.
 pose proof(certificate_reachable ge P target initial CERT PI STOP t reached PATH)as INV.
 destruct(proj1 CERT reached INV)as[EQ|[tr[next[STEP PN]]]];[auto|right;eauto].
Qed.
Theorem certificate_normal_unique:forall ge P v mf initial,
 certificate ge P(Returnstate v Kstop mf) ->P initial ->
 forall t v' mf',star Csem.step ge initial t(Returnstate v' Kstop mf') ->
 v'=v /\ mf'=mf.
Proof.
 intros ge P v mf initial CERT PI t v' mf' PATH.
 assert(STOP:nostep Csem.step ge(Returnstate v Kstop mf)).
 { intros tr next[ES|SS];inversion ES||inversion SS. }
 destruct(certificate_no_error ge P _ initial CERT PI STOP t _ PATH)as[EQ|[tr[next STEP]]].
 - inversion EQ;auto.
 - destruct STEP as[ES|SS];inversion ES||inversion SS.
Qed.
Print Assumptions chain_certificate.
Print Assumptions certificate_no_error.
Print Assumptions certificate_normal_unique.
13:Definition block_state(s:Csem.state):bool :=
14- match s with
15- | State _ st k _ _=>block_stmt st && block_cont k
16- | ExprState _ a(Kdo k)_ _=>atomic_expr a && block_cont k
17- | ExprState _ a(Kifthenelse b c k)_ _=>simple a && block_stmt b && block_stmt c && block_cont k
18- | _=>false end.
19-Fixpoint block_eval(ge:genv)(e:env)(s:statement)(m:mem):option mem :=
20- match s with
21- | Sskip=>Some m
22- | Sdo a=>option_map snd(atomic_eval ge e m a)
23- | Ssequence a b=>match block_eval ge e a m with Some ma=>block_eval ge e b ma|None=>None end
24- | Sifthenelse a b c=>
25-   match pure_rval ge e m a with
26-   | Some v=>match bool_val v(typeof a)m with Some bv=>block_eval ge e(if bv then b else c)m|None=>None end
27-   | None=>None end
28- | _=>None end.
29-Fixpoint block_tail(ge:genv)(e:env)(k:cont)(m:mem):option mem :=
30- match k with
31- | Kstop=>Some m
32- | Kseq s k=>match block_eval ge e s m with Some ma=>block_tail ge e k ma|None=>None end
33- | _=>None end.
34-Definition block_denotation(ge:genv)(s:Csem.state):option mem :=
35- match s with
36- | State _ st k e m=>match block_eval ge e st m with Some ma=>block_tail ge e k ma|None=>None end
37- | ExprState _ a(Kdo k)e m=>match atomic_eval ge e m a with Some(_,ma)=>block_tail ge e k ma|None=>None end
38- | ExprState _ a(Kifthenelse b c k)e m=>
39-   match pure_rval ge e m a with
40-   | Some v=>match bool_val v(typeof a)m with
41-     | Some bv=>match block_eval ge e(if bv then b else c)m with Some ma=>block_tail ge e k ma|None=>None end
42-     | None=>None end
43-   | None=>None end
44- | _=>None end.
45-Definition block_done(s:Csem.state):Prop :=
46- exists f e m,s=State f Sskip Kstop e m.
47-Lemma block_stmt_normal:forall s,block_stmt s=true -> CallfreeExecution.normal_stmt s=true.
48-Proof. induction s;simpl;intros;core_unpack;try discriminate;core_build;eauto. Qed.
--
124:Definition block_invariant(ge:genv)(mf:mem)(s:Csem.state):Prop :=
125- block_state s=true /\ block_denotation ge s=Some mf.
126-Lemma block_successors:forall ge mf s t next,
127- block_invariant ge mf s -> ~block_done s ->
128- Csem.step ge s t next -> block_invariant ge mf next.
129-Proof.
130- intros ge mf s t next[BL DEN]ND[ES|SS].
131- - destruct s;inversion ES;subst;eapply block_estep_defined;eauto.
132- - destruct(block_sstep ge s t next BL ND SS)as [BN EQ];split;auto;congruence.
133-Qed.
134-Lemma block_progress_raw:forall ge mf s,
135- block_invariant ge mf s ->
136- block_done s \/ exists t next,Csem.step ge s t next.
137-Proof.
138- intros ge mf s[BL DEN].
139- destruct s as[f st k e m|f a k e m|fd args k m|v k m|];
140- cbn[block_state] in BL;try discriminate.
141- - core_unpack;destruct st;cbn[block_stmt] in *;core_unpack;try discriminate.
142-   + destruct k;cbn[block_cont] in *;core_unpack;try discriminate.
143-     * left;unfold block_done;eauto.
144-     * right;eexists;eexists;right;eapply step_skip_seq.
145-   + right;eexists;eexists;right;eapply step_do_1.
146-   + right;eexists;eexists;right;eapply step_seq.
147-   + right;eexists;eexists;right;eapply step_ifthenelse_1.
148- - destruct k;cbn[block_state] in BL;try discriminate;core_unpack.
149-   + destruct(literal RV a)eqn:LIT.
150-     * destruct(literal_r_inv _ LIT)as[v[ty EQ]];subst a.
151-       right;eexists;eexists;right;eapply step_do_2.
152-     * right;eapply CallfreeExecution.immediate_has_step;eauto.
153-       pose proof(block_expression_not_stuck ge f a(Kdo k)e m mf ltac:(simpl;core_build;eauto)DEN)as NS;
154-       exact(NS RV(fun x=>x)a(ctx_top RV)eq_refl).
155-   + destruct(literal RV a)eqn:LIT.
156-     * destruct(literal_r_inv _ LIT)as[v[ty EQ]];subst a.
157-       cbn[block_denotation pure_rval typeof] in DEN.
158-       destruct(bool_val v ty m)eqn:BV;try discriminate.
159-       right;eexists;eexists;right;eapply step_ifthenelse_2;exact BV.
--
270:Definition block_context_invariant(ge:genv)(base:cont)(f:function)(e:env)(mf:mem)(s:Csem.state):Prop :=
271- exists raw,s=plug_state base raw /\ block_invariant ge mf raw /\ block_owner f e raw.
272-Lemma block_context_entry:forall ge base f e st m t mf,
273- block_stmt st=true ->
274- star Csem.step ge(State f st Kstop e m)t(State f Sskip Kstop e mf) ->
275- block_context_invariant ge base f e mf(State f st base e m).
276-Proof.
277- intros ge base f e st m t mf BS PATH.
278- exists(State f st Kstop e m);split;[reflexivity|];split.
279- - split;[simpl;core_build;auto|eapply block_normal_correspondence;[simpl;core_build;auto|exact PATH]].
280- - split;reflexivity.
281-Qed.
282-Theorem block_context_progress:forall ge base f e mf s,
283- block_context_invariant ge base f e mf s ->
284- s=State f Sskip base e mf \/
285- exists t next,Csem.step ge s t next /\ block_context_invariant ge base f e mf next.
286-Proof.
287- intros ge base f e mf s[raw[EQ[INV OWN]]];subst s.
288- destruct(classic(block_done raw))as[DONE|ND].
289- - destruct DONE as[ff[ee[mm EQ]]];subst raw;destruct INV as[BL DEN].
290-   cbn[block_denotation block_eval block_tail]in DEN;inversion DEN;subst.
291-   cbn[block_owner]in OWN;destruct OWN;subst;left;reflexivity.
292- - destruct(block_progress_raw ge mf raw INV)as[DONE|[t[next STEP]]];[contradiction|].
293-   right;exists t,(plug_state base next);split.
294-   + apply block_plug_step;auto;exact(proj1 INV).
295-   + exists next;split;auto;split.
296-     * eapply block_successors;eauto.
297-     * eapply block_owner_preserved;[exact(proj1 INV)|exact(proj2 INV)|exact ND|exact OWN|eassumption].
298-Qed.
299-Theorem block_context_all_successors:forall ge base f e mf s t next,
300- block_context_invariant ge base f e mf s ->
301- s<>State f Sskip base e mf -> Csem.step ge s t next ->
302- block_context_invariant ge base f e mf next.
303-Proof.
304- intros ge base f e mf s t next[raw[EQ[INV OWN]]]NF STEP;subst s.
305- assert(ND:~block_done raw).
 bind_parameters ge e m params args mf1 ->bind_parameters ge e m params args mf2 ->mf1=mf2.
Proof.
 intros ge e m params args mf1 mf2 B1 B2.
 pose proof(Cexec.sem_bind_parameters_complete ge phase_world e m params args mf1 B1)as D1.
 pose proof(Cexec.sem_bind_parameters_complete ge phase_world e m params args mf2 B2)as D2.
 rewrite D1 in D2;injection D2;auto.
Qed.
Lemma internal_dispatch_transition:forall ge f args m e ma mb k,
 list_norepet(var_names(fn_params f)++var_names(fn_vars f)) ->
 alloc_variables ge empty_env m(fn_params f++fn_vars f)e ma ->
 bind_parameters ge e ma(fn_params f)args mb ->
 unique_transition ge(Callstate(Internal f)args k m)(State f(fn_body f)k e mb).
Proof.
 intros ge f args m e ma mb k NAMES ALLOC BIND;split.
 - right;eapply step_internal_function;[exact NAMES|exact ALLOC|exact BIND].
 - intros t next[ES|SS];[inversion ES|].
   inversion SS;subst;split;[reflexivity|].
   match goal with
   |A:alloc_variables ge empty_env m(fn_params f++fn_vars f)?ee ?mx
    |-State _ _ _ ?ee _=_ =>
     destruct(allocation_deterministic ge empty_env m _ e ma ee mx ALLOC A)as[EE MM];subst ee mx end.
   match goal with
   |B:bind_parameters ge e ma(fn_params f)args ?mx |-State _ _ _ _ ?mx=_=>
    pose proof(parameters_deterministic ge e ma(fn_params f)args mb mx BIND B)as EQ;subst mx;reflexivity end.
Qed.
Lemma cleanup_transition:forall ge f k e m mf,
 is_call_cont k ->Mem.free_list m(blocks_of_env ge e)=Some mf ->
 unique_transition ge(State f Sskip k e m)(Returnstate Vundef k mf).
Proof.
 intros ge f k e m mf CALL FREE;split;[right;eapply step_skip_call;eauto|].
 intros t next[ES|SS];[inversion ES|].
 destruct k;cbn in CALL;try contradiction;inversion SS;subst;
 repeat match goal with H:_ \/ _|-_=>destruct H end;try discriminate.
 all:(split;[reflexivity|];
 match goal with F:Mem.free_list _ _=Some ?mx|-Returnstate _ _ ?mx=_=>
 rewrite FREE in F;injection F as EQ;subst mx;reflexivity end).
Qed.
Print Assumptions internal_dispatch_transition.
Print Assumptions cleanup_transition.
