Inductive estep (ge : genv) : state -> Events.trace -> state -> Prop :=
    step_expr : forall (f : Csyntax.function) (r : Csyntax.expr) 
                  (k : cont) (e : env) (m : Memory.Mem.mem) 
                  (v : Values.val) (ty : Ctypes.type),
                eval_simple_rvalue ge e m r v ->
                match r with
                | Csyntax.Eval _ _ => False
                | _ => True
                end ->
                ty = Csyntax.typeof r ->
                estep ge (ExprState f r k e m) Events.E0
                  (ExprState f (Csyntax.Eval v ty) k e m)
  | step_rvalof_volatile : forall (f : Csyntax.function)
                             (C : Csyntax.expr -> Csyntax.expr)
                             (l : Csyntax.expr) (ty : Ctypes.type) 
                             (k : cont) (e : env) 
                             (m : Memory.Mem.mem) 
                             (b : Values.block) (ofs : Integers.Ptrofs.int)
                             (bf : Ctypes.bitfield) 
                             (t : Events.trace) (v : Values.val),
                           leftcontext RV RV C ->
                           eval_simple_lvalue ge e m l b ofs bf ->
                           deref_loc ge ty m b ofs bf t v ->
                           ty = Csyntax.typeof l ->
                           Ctypes.type_is_volatile ty = true ->
                           estep ge
                             (ExprState f (C (Csyntax.Evalof l ty)) k e m) t
                             (ExprState f (C (Csyntax.Eval v ty)) k e m)
  | step_seqand_true : forall (f : Csyntax.function)
                         (C : Csyntax.expr -> Csyntax.expr)
                         (r1 r2 : Csyntax.expr) (ty : Ctypes.type) 
                         (k : cont) (e : env) (m : Memory.Mem.mem)
                         (v : Values.val),
                       leftcontext RV RV C ->
                       eval_simple_rvalue ge e m r1 v ->
                       Cop.bool_val v (Csyntax.typeof r1) m = Some true ->
                       estep ge
                         (ExprState f (C (Csyntax.Eseqand r1 r2 ty)) k e m)
                         Events.E0
                         (ExprState f
                            (C (Csyntax.Eparen r2 Ctypes.type_bool ty)) k e m)
  | step_seqand_false : forall (f : Csyntax.function)
                          (C : Csyntax.expr -> Csyntax.expr)
                          (r1 r2 : Csyntax.expr) (ty : Ctypes.type)
                          (k : cont) (e : env) (m : Memory.Mem.mem)
                          (v : Values.val),
                        leftcontext RV RV C ->
                        eval_simple_rvalue ge e m r1 v ->
                        Cop.bool_val v (Csyntax.typeof r1) m = Some false ->
                        estep ge
                          (ExprState f (C (Csyntax.Eseqand r1 r2 ty)) k e m)
                          Events.E0
                          (ExprState f
                             (C
                                (Csyntax.Eval (Values.Vint Integers.Int.zero)
                                   ty))
                             k e m)
  | step_seqor_true : forall (f : Csyntax.function)
                        (C : Csyntax.expr -> Csyntax.expr)
                        (r1 r2 : Csyntax.expr) (ty : Ctypes.type) 
                        (k : cont) (e : env) (m : Memory.Mem.mem)
                        (v : Values.val),
                      leftcontext RV RV C ->
                      eval_simple_rvalue ge e m r1 v ->
                      Cop.bool_val v (Csyntax.typeof r1) m = Some true ->
                      estep ge
                        (ExprState f (C (Csyntax.Eseqor r1 r2 ty)) k e m)
                        Events.E0
                        (ExprState f
                           (C
                              (Csyntax.Eval (Values.Vint Integers.Int.one) ty))
                           k e m)
  | step_seqor_false : forall (f : Csyntax.function)
                         (C : Csyntax.expr -> Csyntax.expr)
                         (r1 r2 : Csyntax.expr) (ty : Ctypes.type) 
                         (k : cont) (e : env) (m : Memory.Mem.mem)
                         (v : Values.val),
                       leftcontext RV RV C ->
                       eval_simple_rvalue ge e m r1 v ->
                       Cop.bool_val v (Csyntax.typeof r1) m = Some false ->
                       estep ge
                         (ExprState f (C (Csyntax.Eseqor r1 r2 ty)) k e m)
                         Events.E0
                         (ExprState f
                            (C (Csyntax.Eparen r2 Ctypes.type_bool ty)) k e m)
  | step_condition : forall (f : Csyntax.function)
                       (C : Csyntax.expr -> Csyntax.expr)
                       (r1 r2 r3 : Csyntax.expr) (ty : Ctypes.type)
                       (k : cont) (e : env) (m : Memory.Mem.mem)
                       (v : Values.val) (b : bool),
                     leftcontext RV RV C ->
                     eval_simple_rvalue ge e m r1 v ->
                     Cop.bool_val v (Csyntax.typeof r1) m = Some b ->
                     estep ge
                       (ExprState f (C (Csyntax.Econdition r1 r2 r3 ty)) k e
                          m)
                       Events.E0
                       (ExprState f
                          (C (Csyntax.Eparen (if b then r2 else r3) ty ty)) k
                          e m)
  | step_assign : forall (f : Csyntax.function)
                    (C : Csyntax.expr -> Csyntax.expr) 
                    (l r : Csyntax.expr) (ty : Ctypes.type) 
                    (k : cont) (e : env) (m : Memory.Mem.mem)
                    (b : Values.block) (ofs : Integers.Ptrofs.int)
                    (bf : Ctypes.bitfield) (v v1 : Values.val)
                    (t : Events.trace) (m' : Memory.Mem.mem)
                    (v' : Values.val),
                  leftcontext RV RV C ->
                  eval_simple_lvalue ge e m l b ofs bf ->
                  eval_simple_rvalue ge e m r v ->
                  Cop.sem_cast v (Csyntax.typeof r) (Csyntax.typeof l) m =
                  Some v1 ->
                  assign_loc ge (Csyntax.typeof l) m b ofs bf v1 t m' v' ->
                  ty = Csyntax.typeof l ->
                  estep ge (ExprState f (C (Csyntax.Eassign l r ty)) k e m) t
                    (ExprState f (C (Csyntax.Eval v' ty)) k e m')
  | step_assignop : forall (f : Csyntax.function)
                      (C : Csyntax.expr -> Csyntax.expr)
                      (op : Cop.binary_operation) 
                      (l r : Csyntax.expr) (tyres ty : Ctypes.type)
                      (k : cont) (e : env) (m : Memory.Mem.mem)
                      (b : Values.block) (ofs : Integers.Ptrofs.int)
                      (bf : Ctypes.bitfield) (v1 v2 v3 v4 : Values.val)
                      (t1 t2 : Events.trace) (m' : Memory.Mem.mem)
                      (v' : Values.val) (t : Events.trace),
                    leftcontext RV RV C ->
                    eval_simple_lvalue ge e m l b ofs bf ->
                    deref_loc ge (Csyntax.typeof l) m b ofs bf t1 v1 ->
                    eval_simple_rvalue ge e m r v2 ->
                    Cop.sem_binary_operation ge op v1 
                      (Csyntax.typeof l) v2 (Csyntax.typeof r) m =
                    Some v3 ->
                    Cop.sem_cast v3 tyres (Csyntax.typeof l) m = Some v4 ->
                    assign_loc ge (Csyntax.typeof l) m b ofs bf v4 t2 m' v' ->
                    ty = Csyntax.typeof l ->
                    t = Events.Eapp t1 t2 ->
                    estep ge
                      (ExprState f (C (Csyntax.Eassignop op l r tyres ty)) k
                         e m)
                      t (ExprState f (C (Csyntax.Eval v' ty)) k e m')
  | step_assignop_stuck : forall (f : Csyntax.function)
                            (C : Csyntax.expr -> Csyntax.expr)
                            (op : Cop.binary_operation) 
                            (l r : Csyntax.expr) (tyres ty : Ctypes.type)
                            (k : cont) (e : env) (m : Memory.Mem.mem)
                            (b : Values.block) (ofs : Integers.Ptrofs.int)
                            (bf : Ctypes.bitfield) 
                            (v1 v2 : Values.val) (t : Events.trace),
                          leftcontext RV RV C ->
                          eval_simple_lvalue ge e m l b ofs bf ->
                          deref_loc ge (Csyntax.typeof l) m b ofs bf t v1 ->
                          eval_simple_rvalue ge e m r v2 ->
                          match
                            Cop.sem_binary_operation ge op v1
                              (Csyntax.typeof l) v2 
                              (Csyntax.typeof r) m
                          with
                          | Some v3 =>
                              match
                                Cop.sem_cast v3 tyres (Csyntax.typeof l) m
                              with
                              | Some v4 =>
                                  forall (t2 : Events.trace)
                                    (m' : Memory.Mem.mem) 
                                    (v' : Values.val),
                                  ~
                                  assign_loc ge (Csyntax.typeof l) m b ofs bf
                                    v4 t2 m' v'
                              | None => True
                              end
                          | None => True
                          end ->
                          ty = Csyntax.typeof l ->
                          estep ge
                            (ExprState f
                               (C (Csyntax.Eassignop op l r tyres ty)) k e m)
                            t Stuckstate
  | step_postincr : forall (f : Csyntax.function)
                      (C : Csyntax.expr -> Csyntax.expr)
                      (id : Cop.incr_or_decr) (l : Csyntax.expr)
                      (ty : Ctypes.type) (k : cont) 
                      (e : env) (m : Memory.Mem.mem) 
                      (b : Values.block) (ofs : Integers.Ptrofs.int)
                      (bf : Ctypes.bitfield) (v1 v2 v3 : Values.val)
                      (t1 t2 : Events.trace) (m' : Memory.Mem.mem)
                      (v' : Values.val) (t : Events.trace),
                    leftcontext RV RV C ->
                    eval_simple_lvalue ge e m l b ofs bf ->
                    deref_loc ge ty m b ofs bf t1 v1 ->
                    Cop.sem_incrdecr ge id v1 ty m = Some v2 ->
                    Cop.sem_cast v2 (Cop.incrdecr_type ty) ty m = Some v3 ->
                    assign_loc ge ty m b ofs bf v3 t2 m' v' ->
                    ty = Csyntax.typeof l ->
                    t = Events.Eapp t1 t2 ->
                    estep ge
                      (ExprState f (C (Csyntax.Epostincr id l ty)) k e m) t
                      (ExprState f (C (Csyntax.Eval v1 ty)) k e m')
  | step_postincr_stuck : forall (f : Csyntax.function)
                            (C : Csyntax.expr -> Csyntax.expr)
                            (id : Cop.incr_or_decr) 
                            (l : Csyntax.expr) (ty : Ctypes.type) 
                            (k : cont) (e : env) (m : Memory.Mem.mem)
                            (b : Values.block) (ofs : Integers.Ptrofs.int)
                            (bf : Ctypes.bitfield) 
                            (v1 : Values.val) (t : Events.trace),
                          leftcontext RV RV C ->
                          eval_simple_lvalue ge e m l b ofs bf ->
                          deref_loc ge ty m b ofs bf t v1 ->
                          match Cop.sem_incrdecr ge id v1 ty m with
                          | Some v2 =>
                              match
                                Cop.sem_cast v2 (Cop.incrdecr_type ty) ty m
                              with
                              | Some v3 =>
                                  forall (t2 : Events.trace)
                                    (m' : Memory.Mem.mem) 
                                    (v' : Values.val),
                                  ~
                                  assign_loc ge (Csyntax.typeof l) m b ofs bf
                                    v3 t2 m' v'
                              | None => True
                              end
                          | None => True
                          end ->
                          ty = Csyntax.typeof l ->
                          estep ge
                            (ExprState f (C (Csyntax.Epostincr id l ty)) k e
                               m)
                            t Stuckstate
  | step_comma : forall (f : Csyntax.function)
                   (C : Csyntax.expr -> Csyntax.expr) 
                   (r1 r2 : Csyntax.expr) (ty : Ctypes.type) 
                   (k : cont) (e : env) (m : Memory.Mem.mem) 
                   (v : Values.val),
                 leftcontext RV RV C ->
                 eval_simple_rvalue ge e m r1 v ->
                 ty = Csyntax.typeof r2 ->
                 estep ge (ExprState f (C (Csyntax.Ecomma r1 r2 ty)) k e m)
                   Events.E0 (ExprState f (C r2) k e m)
  | step_paren : forall (f : Csyntax.function)
                   (C : Csyntax.expr -> Csyntax.expr) 
                   (r : Csyntax.expr) (tycast ty : Ctypes.type) 
                   (k : cont) (e : env) (m : Memory.Mem.mem)
                   (v1 v : Values.val),
                 leftcontext RV RV C ->
                 eval_simple_rvalue ge e m r v1 ->
                 Cop.sem_cast v1 (Csyntax.typeof r) tycast m = Some v ->
                 estep ge
                   (ExprState f (C (Csyntax.Eparen r tycast ty)) k e m)
                   Events.E0 (ExprState f (C (Csyntax.Eval v ty)) k e m)
  | step_call : forall (f : Csyntax.function)
                  (C : Csyntax.expr -> Csyntax.expr) 
                  (rf : Csyntax.expr) (rargs : Csyntax.exprlist)
                  (ty : Ctypes.type) (k : cont) (e : env)
                  (m : Memory.Mem.mem) (targs : list Ctypes.type)
                  (tres : Ctypes.type) (cconv : AST.calling_convention)
                  (vf : Values.val) (vargs : list Values.val)
                  (fd : Csyntax.fundef),
                leftcontext RV RV C ->
                Cop.classify_fun (Csyntax.typeof rf) =
                Cop.fun_case_f targs tres cconv ->
                eval_simple_rvalue ge e m rf vf ->
                eval_simple_list ge e m rargs targs vargs ->
                Globalenvs.Genv.find_funct ge vf = Some fd ->
                Csyntax.type_of_fundef fd = Ctypes.Tfunction targs tres cconv ->
                estep ge (ExprState f (C (Csyntax.Ecall rf rargs ty)) k e m)
                  Events.E0 (Callstate fd vargs (Kcall f e C ty k) m)
  | step_builtin : forall (f : Csyntax.function)
                     (C : Csyntax.expr -> Csyntax.expr)
                     (ef : AST.external_function) 
                     (tyargs : list Ctypes.type) (rargs : Csyntax.exprlist)
                     (ty : Ctypes.type) (k : cont) 
                     (e : env) (m : Memory.Mem.mem) 
                     (vargs : list Values.val) (t : Events.trace)
                     (vres : Values.val) (m' : Memory.Mem.mem),
                   leftcontext RV RV C ->
                   eval_simple_list ge e m rargs tyargs vargs ->
                   Events.external_call ef (Globalenvs.Genv.to_senv ge) vargs
                     m t vres m' ->
                   estep ge
                     (ExprState f (C (Csyntax.Ebuiltin ef tyargs rargs ty)) k
                        e m)
                     t (ExprState f (C (Csyntax.Eval vres ty)) k e m').

Arguments estep ge _ _ _
Arguments step_expr ge f r k e m v ty _ _ _
Arguments step_rvalof_volatile ge f C%_function_scope 
  l ty k e m b ofs bf t v _ _ _ _ _
Arguments step_seqand_true ge f C%_function_scope r1 r2 ty k e m v _ _ _
Arguments step_seqand_false ge f C%_function_scope r1 r2 ty k e m v _ _ _
Arguments step_seqor_true ge f C%_function_scope r1 r2 ty k e m v _ _ _
Arguments step_seqor_false ge f C%_function_scope r1 r2 ty k e m v _ _ _
Arguments step_condition ge f C%_function_scope r1 
  r2 r3 ty k e m v b%_bool_scope _ _ _
Arguments step_assign ge f C%_function_scope l r ty 
  k e m b ofs bf v v1 t m' v' _ _ _ _ _ _
Arguments step_assignop ge f C%_function_scope op 
  l r tyres ty k e m b ofs bf v1 v2 v3 v4 t1 t2 m' 
  v' t _ _ _ _ _ _ _ _ _
Arguments step_assignop_stuck ge f C%_function_scope 
  op l r tyres ty k e m b ofs bf v1 v2 t _ _ _ _ _ 
  _
Arguments step_postincr ge f C%_function_scope id 
  l ty k e m b ofs bf v1 v2 v3 t1 t2 m' v' t _ _ _ 
  _ _ _ _ _
Arguments step_postincr_stuck ge f C%_function_scope 
  id l ty k e m b ofs bf v1 t _ _ _ _ _
Arguments step_comma ge f C%_function_scope r1 r2 ty k e m v _ _ _
Arguments step_paren ge f C%_function_scope r tycast ty k e m v1 v _ _ _
Arguments step_call ge f C%_function_scope rf rargs 
  ty k e m targs%_list_scope tres cconv vf vargs%_list_scope 
  fd _ _ _ _ _ _
Arguments step_builtin ge f C%_function_scope ef tyargs%_list_scope 
  rargs ty k e m vargs%_list_scope t vres m' _ _ _
Inductive
leftcontext : kind -> kind -> (Csyntax.expr -> Csyntax.expr) -> Prop :=
    lctx_top : forall k : kind, leftcontext k k (fun x : Csyntax.expr => x)
  | lctx_deref : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                   (ty : Ctypes.type),
                 leftcontext k RV C ->
                 leftcontext k LV
                   (fun x : Csyntax.expr => Csyntax.Ederef (C x) ty)
  | lctx_field : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                   (f : AST.ident) (ty : Ctypes.type),
                 leftcontext k RV C ->
                 leftcontext k LV
                   (fun x : Csyntax.expr => Csyntax.Efield (C x) f ty)
  | lctx_rvalof : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                    (ty : Ctypes.type),
                  leftcontext k LV C ->
                  leftcontext k RV
                    (fun x : Csyntax.expr => Csyntax.Evalof (C x) ty)
  | lctx_addrof : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                    (ty : Ctypes.type),
                  leftcontext k LV C ->
                  leftcontext k RV
                    (fun x : Csyntax.expr => Csyntax.Eaddrof (C x) ty)
  | lctx_unop : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                  (op : Cop.unary_operation) (ty : Ctypes.type),
                leftcontext k RV C ->
                leftcontext k RV
                  (fun x : Csyntax.expr => Csyntax.Eunop op (C x) ty)
  | lctx_binop_left : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                        (op : Cop.binary_operation) 
                        (e2 : Csyntax.expr) (ty : Ctypes.type),
                      leftcontext k RV C ->
                      leftcontext k RV
                        (fun x : Csyntax.expr =>
                         Csyntax.Ebinop op (C x) e2 ty)
  | lctx_binop_right : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                         (op : Cop.binary_operation) 
                         (e1 : Csyntax.expr) (ty : Ctypes.type),
                       simple e1 = true ->
                       leftcontext k RV C ->
                       leftcontext k RV
                         (fun x : Csyntax.expr =>
                          Csyntax.Ebinop op e1 (C x) ty)
  | lctx_cast : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                  (ty : Ctypes.type),
                leftcontext k RV C ->
                leftcontext k RV
                  (fun x : Csyntax.expr => Csyntax.Ecast (C x) ty)
  | lctx_seqand : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                    (r2 : Csyntax.expr) (ty : Ctypes.type),
                  leftcontext k RV C ->
                  leftcontext k RV
                    (fun x : Csyntax.expr => Csyntax.Eseqand (C x) r2 ty)
  | lctx_seqor : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                   (r2 : Csyntax.expr) (ty : Ctypes.type),
                 leftcontext k RV C ->
                 leftcontext k RV
                   (fun x : Csyntax.expr => Csyntax.Eseqor (C x) r2 ty)
  | lctx_condition : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                       (r2 r3 : Csyntax.expr) (ty : Ctypes.type),
                     leftcontext k RV C ->
                     leftcontext k RV
                       (fun x : Csyntax.expr =>
                        Csyntax.Econdition (C x) r2 r3 ty)
  | lctx_assign_left : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                         (e2 : Csyntax.expr) (ty : Ctypes.type),
                       leftcontext k LV C ->
                       leftcontext k RV
                         (fun x : Csyntax.expr => Csyntax.Eassign (C x) e2 ty)
  | lctx_assign_right : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                          (e1 : Csyntax.expr) (ty : Ctypes.type),
                        simple e1 = true ->
                        leftcontext k RV C ->
                        leftcontext k RV
                          (fun x : Csyntax.expr =>
                           Csyntax.Eassign e1 (C x) ty)
  | lctx_assignop_left : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                           (op : Cop.binary_operation) 
                           (e2 : Csyntax.expr) (tyres ty : Ctypes.type),
                         leftcontext k LV C ->
                         leftcontext k RV
                           (fun x : Csyntax.expr =>
                            Csyntax.Eassignop op (C x) e2 tyres ty)
  | lctx_assignop_right : forall (k : kind)
                            (C : Csyntax.expr -> Csyntax.expr)
                            (op : Cop.binary_operation) 
                            (e1 : Csyntax.expr) (tyres ty : Ctypes.type),
                          simple e1 = true ->
                          leftcontext k RV C ->
                          leftcontext k RV
                            (fun x : Csyntax.expr =>
                             Csyntax.Eassignop op e1 (C x) tyres ty)
  | lctx_postincr : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                      (id : Cop.incr_or_decr) (ty : Ctypes.type),
                    leftcontext k LV C ->
                    leftcontext k RV
                      (fun x : Csyntax.expr => Csyntax.Epostincr id (C x) ty)
  | lctx_call_left : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                       (el : Csyntax.exprlist) (ty : Ctypes.type),
                     leftcontext k RV C ->
                     leftcontext k RV
                       (fun x : Csyntax.expr => Csyntax.Ecall (C x) el ty)
  | lctx_call_right : forall (k : kind)
                        (C : Csyntax.expr -> Csyntax.exprlist)
                        (e1 : Csyntax.expr) (ty : Ctypes.type),
                      simple e1 = true ->
                      leftcontextlist k C ->
                      leftcontext k RV
                        (fun x : Csyntax.expr => Csyntax.Ecall e1 (C x) ty)
  | lctx_builtin : forall (k : kind) (C : Csyntax.expr -> Csyntax.exprlist)
                     (ef : AST.external_function) 
                     (tyargs : list Ctypes.type) (ty : Ctypes.type),
                   leftcontextlist k C ->
                   leftcontext k RV
                     (fun x : Csyntax.expr =>
                      Csyntax.Ebuiltin ef tyargs (C x) ty)
  | lctx_comma : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                   (e2 : Csyntax.expr) (ty : Ctypes.type),
                 leftcontext k RV C ->
                 leftcontext k RV
                   (fun x : Csyntax.expr => Csyntax.Ecomma (C x) e2 ty)
  | lctx_paren : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                   (tycast ty : Ctypes.type),
                 leftcontext k RV C ->
                 leftcontext k RV
                   (fun x : Csyntax.expr => Csyntax.Eparen (C x) tycast ty)
  with leftcontextlist
           : kind -> (Csyntax.expr -> Csyntax.exprlist) -> Prop :=
    lctx_list_head : forall (k : kind) (C : Csyntax.expr -> Csyntax.expr)
                       (el : Csyntax.exprlist),
                     leftcontext k RV C ->
                     leftcontextlist k
                       (fun x : Csyntax.expr => Csyntax.Econs (C x) el)
  | lctx_list_tail : forall (k : kind) (C : Csyntax.expr -> Csyntax.exprlist)
                       (e1 : Csyntax.expr),
                     simple e1 = true ->
                     leftcontextlist k C ->
                     leftcontextlist k
                       (fun x : Csyntax.expr => Csyntax.Econs e1 (C x)).

Arguments leftcontext _ _ _%_function_scope
Arguments lctx_top k
Arguments lctx_deref k C%_function_scope ty _
Arguments lctx_field k C%_function_scope f ty _
Arguments lctx_rvalof k C%_function_scope ty _
Arguments lctx_addrof k C%_function_scope ty _
Arguments lctx_unop k C%_function_scope op ty _
Arguments lctx_binop_left k C%_function_scope op e2 ty _
Arguments lctx_binop_right k C%_function_scope op e1 ty _ _
Arguments lctx_cast k C%_function_scope ty _
Arguments lctx_seqand k C%_function_scope r2 ty _
Arguments lctx_seqor k C%_function_scope r2 ty _
Arguments lctx_condition k C%_function_scope r2 r3 ty _
Arguments lctx_assign_left k C%_function_scope e2 ty _
Arguments lctx_assign_right k C%_function_scope e1 ty _ _
Arguments lctx_assignop_left k C%_function_scope op e2 tyres ty _
Arguments lctx_assignop_right k C%_function_scope op e1 tyres ty _ _
Arguments lctx_postincr k C%_function_scope id ty _
Arguments lctx_call_left k C%_function_scope el ty _
Arguments lctx_call_right k C%_function_scope e1 ty _ _
Arguments lctx_builtin k C%_function_scope ef tyargs%_list_scope ty _
Arguments lctx_comma k C%_function_scope e2 ty _
Arguments lctx_paren k C%_function_scope tycast ty _
Arguments leftcontextlist _ _%_function_scope
Arguments lctx_list_head k C%_function_scope el _
Arguments lctx_list_tail k C%_function_scope e1 _ _
Inductive sstep (ge : genv) : state -> Events.trace -> state -> Prop :=
    step_do_1 : forall (f : Csyntax.function) (x : Csyntax.expr) 
                  (k : cont) (e : env) (m : Memory.Mem.mem),
                sstep ge (State f (Csyntax.Sdo x) k e m) Events.E0
                  (ExprState f x (Kdo k) e m)
  | step_do_2 : forall (f : Csyntax.function) (v : Values.val)
                  (ty : Ctypes.type) (k : cont) (e : env)
                  (m : Memory.Mem.mem),
                sstep ge (ExprState f (Csyntax.Eval v ty) (Kdo k) e m)
                  Events.E0 (State f Csyntax.Sskip k e m)
  | step_seq : forall (f : Csyntax.function) (s1 s2 : Csyntax.statement)
                 (k : cont) (e : env) (m : Memory.Mem.mem),
               sstep ge (State f (Csyntax.Ssequence s1 s2) k e m) Events.E0
                 (State f s1 (Kseq s2 k) e m)
  | step_skip_seq : forall (f : Csyntax.function) 
                      (s : Csyntax.statement) (k : cont) 
                      (e : env) (m : Memory.Mem.mem),
                    sstep ge (State f Csyntax.Sskip (Kseq s k) e m) Events.E0
                      (State f s k e m)
  | step_continue_seq : forall (f : Csyntax.function) 
                          (s : Csyntax.statement) 
                          (k : cont) (e : env) (m : Memory.Mem.mem),
                        sstep ge (State f Csyntax.Scontinue (Kseq s k) e m)
                          Events.E0 (State f Csyntax.Scontinue k e m)
  | step_break_seq : forall (f : Csyntax.function) 
                       (s : Csyntax.statement) (k : cont) 
                       (e : env) (m : Memory.Mem.mem),
                     sstep ge (State f Csyntax.Sbreak (Kseq s k) e m)
                       Events.E0 (State f Csyntax.Sbreak k e m)
  | step_ifthenelse_1 : forall (f : Csyntax.function) 
                          (a : Csyntax.expr) (s1 s2 : Csyntax.statement)
                          (k : cont) (e : env) (m : Memory.Mem.mem),
                        sstep ge
                          (State f (Csyntax.Sifthenelse a s1 s2) k e m)
                          Events.E0 (ExprState f a (Kifthenelse s1 s2 k) e m)
  | step_ifthenelse_2 : forall (f : Csyntax.function) 
                          (v : Values.val) (ty : Ctypes.type)
                          (s1 s2 : Csyntax.statement) 
                          (k : cont) (e : env) (m : Memory.Mem.mem)
                          (b : bool),
                        Cop.bool_val v ty m = Some b ->
                        sstep ge
                          (ExprState f (Csyntax.Eval v ty)
                             (Kifthenelse s1 s2 k) e m)
                          Events.E0 (State f (if b then s1 else s2) k e m)
  | step_while : forall (f : Csyntax.function) (x : Csyntax.expr)
                   (s : Csyntax.statement) (k : cont) 
                   (e : env) (m : Memory.Mem.mem),
                 sstep ge (State f (Csyntax.Swhile x s) k e m) Events.E0
                   (ExprState f x (Kwhile1 x s k) e m)
  | step_while_false : forall (f : Csyntax.function) 
                         (v : Values.val) (ty : Ctypes.type)
                         (x : Csyntax.expr) (s : Csyntax.statement)
                         (k : cont) (e : env) (m : Memory.Mem.mem),
                       Cop.bool_val v ty m = Some false ->
                       sstep ge
                         (ExprState f (Csyntax.Eval v ty) (Kwhile1 x s k) e m)
                         Events.E0 (State f Csyntax.Sskip k e m)
  | step_while_true : forall (f : Csyntax.function) 
                        (v : Values.val) (ty : Ctypes.type)
                        (x : Csyntax.expr) (s : Csyntax.statement) 
                        (k : cont) (e : env) (m : Memory.Mem.mem),
                      Cop.bool_val v ty m = Some true ->
                      sstep ge
                        (ExprState f (Csyntax.Eval v ty) (Kwhile1 x s k) e m)
                        Events.E0 (State f s (Kwhile2 x s k) e m)
  | step_skip_or_continue_while : forall (f : Csyntax.function)
                                    (s0 : Csyntax.statement)
                                    (x : Csyntax.expr)
                                    (s : Csyntax.statement) 
                                    (k : cont) (e : env) 
                                    (m : Memory.Mem.mem),
                                  s0 = Csyntax.Sskip \/
                                  s0 = Csyntax.Scontinue ->
                                  sstep ge (State f s0 (Kwhile2 x s k) e m)
                                    Events.E0
                                    (State f (Csyntax.Swhile x s) k e m)
  | step_break_while : forall (f : Csyntax.function) 
                         (x : Csyntax.expr) (s : Csyntax.statement)
                         (k : cont) (e : env) (m : Memory.Mem.mem),
                       sstep ge (State f Csyntax.Sbreak (Kwhile2 x s k) e m)
                         Events.E0 (State f Csyntax.Sskip k e m)
  | step_dowhile : forall (f : Csyntax.function) (a : Csyntax.expr)
                     (s : Csyntax.statement) (k : cont) 
                     (e : env) (m : Memory.Mem.mem),
                   sstep ge (State f (Csyntax.Sdowhile a s) k e m) Events.E0
                     (State f s (Kdowhile1 a s k) e m)
  | step_skip_or_continue_dowhile : forall (f : Csyntax.function)
                                      (s0 : Csyntax.statement)
                                      (x : Csyntax.expr)
                                      (s : Csyntax.statement) 
                                      (k : cont) (e : env)
                                      (m : Memory.Mem.mem),
                                    s0 = Csyntax.Sskip \/
                                    s0 = Csyntax.Scontinue ->
                                    sstep ge
                                      (State f s0 (Kdowhile1 x s k) e m)
                                      Events.E0
                                      (ExprState f x (Kdowhile2 x s k) e m)
  | step_dowhile_false : forall (f : Csyntax.function) 
                           (v : Values.val) (ty : Ctypes.type)
                           (x : Csyntax.expr) (s : Csyntax.statement)
                           (k : cont) (e : env) (m : Memory.Mem.mem),
                         Cop.bool_val v ty m = Some false ->
                         sstep ge
                           (ExprState f (Csyntax.Eval v ty) 
                              (Kdowhile2 x s k) e m)
                           Events.E0 (State f Csyntax.Sskip k e m)
  | step_dowhile_true : forall (f : Csyntax.function) 
                          (v : Values.val) (ty : Ctypes.type)
                          (x : Csyntax.expr) (s : Csyntax.statement)
                          (k : cont) (e : env) (m : Memory.Mem.mem),
                        Cop.bool_val v ty m = Some true ->
                        sstep ge
                          (ExprState f (Csyntax.Eval v ty) 
                             (Kdowhile2 x s k) e m)
                          Events.E0 (State f (Csyntax.Sdowhile x s) k e m)
  | step_break_dowhile : forall (f : Csyntax.function) 
                           (a : Csyntax.expr) (s : Csyntax.statement)
                           (k : cont) (e : env) (m : Memory.Mem.mem),
                         sstep ge
                           (State f Csyntax.Sbreak (Kdowhile1 a s k) e m)
                           Events.E0 (State f Csyntax.Sskip k e m)
  | step_for_start : forall (f : Csyntax.function) 
                       (a1 : Csyntax.statement) (a2 : Csyntax.expr)
                       (a3 s : Csyntax.statement) 
                       (k : cont) (e : env) (m : Memory.Mem.mem),
                     a1 <> Csyntax.Sskip ->
                     sstep ge (State f (Csyntax.Sfor a1 a2 a3 s) k e m)
                       Events.E0
                       (State f a1
                          (Kseq (Csyntax.Sfor Csyntax.Sskip a2 a3 s) k) e m)
  | step_for : forall (f : Csyntax.function) (a2 : Csyntax.expr)
                 (a3 s : Csyntax.statement) (k : cont) 
                 (e : env) (m : Memory.Mem.mem),
               sstep ge (State f (Csyntax.Sfor Csyntax.Sskip a2 a3 s) k e m)
                 Events.E0 (ExprState f a2 (Kfor2 a2 a3 s k) e m)
  | step_for_false : forall (f : Csyntax.function) 
                       (v : Values.val) (ty : Ctypes.type)
                       (a2 : Csyntax.expr) (a3 s : Csyntax.statement)
                       (k : cont) (e : env) (m : Memory.Mem.mem),
                     Cop.bool_val v ty m = Some false ->
                     sstep ge
                       (ExprState f (Csyntax.Eval v ty) (Kfor2 a2 a3 s k) e m)
                       Events.E0 (State f Csyntax.Sskip k e m)
  | step_for_true : forall (f : Csyntax.function) 
                      (v : Values.val) (ty : Ctypes.type) 
                      (a2 : Csyntax.expr) (a3 s : Csyntax.statement)
                      (k : cont) (e : env) (m : Memory.Mem.mem),
                    Cop.bool_val v ty m = Some true ->
                    sstep ge
                      (ExprState f (Csyntax.Eval v ty) (Kfor2 a2 a3 s k) e m)
                      Events.E0 (State f s (Kfor3 a2 a3 s k) e m)
  | step_skip_or_continue_for3 : forall (f : Csyntax.function)
                                   (x : Csyntax.statement)
                                   (a2 : Csyntax.expr)
                                   (a3 s : Csyntax.statement) 
                                   (k : cont) (e : env) 
                                   (m : Memory.Mem.mem),
                                 x = Csyntax.Sskip \/ x = Csyntax.Scontinue ->
                                 sstep ge (State f x (Kfor3 a2 a3 s k) e m)
                                   Events.E0
                                   (State f a3 (Kfor4 a2 a3 s k) e m)
  | step_break_for3 : forall (f : Csyntax.function) 
                        (a2 : Csyntax.expr) (a3 s : Csyntax.statement)
                        (k : cont) (e : env) (m : Memory.Mem.mem),
                      sstep ge (State f Csyntax.Sbreak (Kfor3 a2 a3 s k) e m)
                        Events.E0 (State f Csyntax.Sskip k e m)
  | step_skip_for4 : forall (f : Csyntax.function) 
                       (a2 : Csyntax.expr) (a3 s : Csyntax.statement)
                       (k : cont) (e : env) (m : Memory.Mem.mem),
                     sstep ge (State f Csyntax.Sskip (Kfor4 a2 a3 s k) e m)
                       Events.E0
                       (State f (Csyntax.Sfor Csyntax.Sskip a2 a3 s) k e m)
  | step_return_0 : forall (f : Csyntax.function) 
                      (k : cont) (e : env) (m m' : Memory.Mem.mem),
                    Memory.Mem.free_list m (blocks_of_env ge e) = Some m' ->
                    sstep ge (State f (Csyntax.Sreturn None) k e m) Events.E0
                      (Returnstate Values.Vundef (call_cont k) m')
  | step_return_1 : forall (f : Csyntax.function) 
                      (x : Csyntax.expr) (k : cont) 
                      (e : env) (m : Memory.Mem.mem),
                    sstep ge (State f (Csyntax.Sreturn (Some x)) k e m)
                      Events.E0 (ExprState f x (Kreturn k) e m)
  | step_return_2 : forall (f : Csyntax.function) 
                      (v1 : Values.val) (ty : Ctypes.type) 
                      (k : cont) (e : env) (m : Memory.Mem.mem)
                      (v2 : Values.val) (m' : Memory.Mem.mem),
                    Cop.sem_cast v1 ty (Csyntax.fn_return f) m = Some v2 ->
                    Memory.Mem.free_list m (blocks_of_env ge e) = Some m' ->
                    sstep ge
                      (ExprState f (Csyntax.Eval v1 ty) (Kreturn k) e m)
                      Events.E0 (Returnstate v2 (call_cont k) m')
  | step_skip_call : forall (f : Csyntax.function) 
                       (k : cont) (e : env) (m m' : Memory.Mem.mem),
                     is_call_cont k ->
                     Memory.Mem.free_list m (blocks_of_env ge e) = Some m' ->
                     sstep ge (State f Csyntax.Sskip k e m) Events.E0
                       (Returnstate Values.Vundef k m')
  | step_switch : forall (f : Csyntax.function) (x : Csyntax.expr)
                    (sl : Csyntax.labeled_statements) 
                    (k : cont) (e : env) (m : Memory.Mem.mem),
                  sstep ge (State f (Csyntax.Sswitch x sl) k e m) Events.E0
                    (ExprState f x (Kswitch1 sl k) e m)
  | step_expr_switch : forall (f : Csyntax.function) 
                         (ty : Ctypes.type) (sl : Csyntax.labeled_statements)
                         (k : cont) (e : env) (m : Memory.Mem.mem)
                         (v : Values.val) (n : BinNums.Z),
                       Cop.sem_switch_arg v ty = Some n ->
                       sstep ge
                         (ExprState f (Csyntax.Eval v ty) (Kswitch1 sl k) e m)
                         Events.E0
                         (State f
                            (seq_of_labeled_statement (select_switch n sl))
                            (Kswitch2 k) e m)
  | step_skip_break_switch : forall (f : Csyntax.function)
                               (x : Csyntax.statement) 
                               (k : cont) (e : env) 
                               (m : Memory.Mem.mem),
                             x = Csyntax.Sskip \/ x = Csyntax.Sbreak ->
                             sstep ge (State f x (Kswitch2 k) e m) Events.E0
                               (State f Csyntax.Sskip k e m)
  | step_continue_switch : forall (f : Csyntax.function) 
                             (k : cont) (e : env) 
                             (m : Memory.Mem.mem),
                           sstep ge
                             (State f Csyntax.Scontinue (Kswitch2 k) e m)
                             Events.E0 (State f Csyntax.Scontinue k e m)
  | step_label : forall (f : Csyntax.function) (lbl : Csyntax.label)
                   (s : Csyntax.statement) (k : cont) 
                   (e : env) (m : Memory.Mem.mem),
                 sstep ge (State f (Csyntax.Slabel lbl s) k e m) Events.E0
                   (State f s k e m)
  | step_goto : forall (f : Csyntax.function) (lbl : Csyntax.label)
                  (k : cont) (e : env) (m : Memory.Mem.mem)
                  (s' : Csyntax.statement) (k' : cont),
                find_label lbl (Csyntax.fn_body f) (call_cont k) =
                Some (s', k') ->
                sstep ge (State f (Csyntax.Sgoto lbl) k e m) Events.E0
                  (State f s' k' e m)
  | step_internal_function : forall (f : Csyntax.function)
                               (vargs : list Values.val) 
                               (k : cont) (m : Memory.Mem.mem) 
                               (e : env) (m1 m2 : Memory.Mem.mem),
                             Coqlib.list_norepet
                               (Csyntax.var_names (Csyntax.fn_params f) ++
                                Csyntax.var_names (Csyntax.fn_vars f)) ->
                             alloc_variables ge empty_env m
                               (Csyntax.fn_params f ++ Csyntax.fn_vars f) e
                               m1 ->
                             bind_parameters ge e m1 
                               (Csyntax.fn_params f) vargs m2 ->
                             sstep ge
                               (Callstate (Ctypes.Internal f) vargs k m)
                               Events.E0 (State f (Csyntax.fn_body f) k e m2)
  | step_external_function : forall (ef : AST.external_function)
                               (targs : list Ctypes.type)
                               (tres : Ctypes.type)
                               (cc : AST.calling_convention)
                               (vargs : list Values.val) 
                               (k : cont) (m : Memory.Mem.mem)
                               (vres : Values.val) 
                               (t : Events.trace) 
                               (m' : Memory.Mem.mem),
                             Events.external_call ef
                               (Globalenvs.Genv.to_senv ge) vargs m t vres m' ->
                             sstep ge
                               (Callstate (Ctypes.External ef targs tres cc)
                                  vargs k m)
                               t (Returnstate vres k m')
  | step_returnstate : forall (v : Values.val) (f : Csyntax.function)
                         (e : env) (C : Csyntax.expr -> Csyntax.expr)
                         (ty : Ctypes.type) (k : cont) 
                         (m : Memory.Mem.mem),
                       sstep ge (Returnstate v (Kcall f e C ty k) m)
                         Events.E0
                         (ExprState f (C (Csyntax.Eval v ty)) k e m).

Arguments sstep ge _ _ _
Arguments step_do_1 ge f x k e m
Arguments step_do_2 ge f v ty k e m
Arguments step_seq ge f s1 s2 k e m
Arguments step_skip_seq ge f s k e m
Arguments step_continue_seq ge f s k e m
Arguments step_break_seq ge f s k e m
Arguments step_ifthenelse_1 ge f a s1 s2 k e m
Arguments step_ifthenelse_2 ge f v ty s1 s2 k e m b%_bool_scope _
Arguments step_while ge f x s k e m
Arguments step_while_false ge f v ty x s k e m _
Arguments step_while_true ge f v ty x s k e m _
Arguments step_skip_or_continue_while ge f s0 x s k e m _
Arguments step_break_while ge f x s k e m
Arguments step_dowhile ge f a s k e m
Arguments step_skip_or_continue_dowhile ge f s0 x s k e m _
Arguments step_dowhile_false ge f v ty x s k e m _
Arguments step_dowhile_true ge f v ty x s k e m _
Arguments step_break_dowhile ge f a s k e m
Arguments step_for_start ge f a1 a2 a3 s k e m _
Arguments step_for ge f a2 a3 s k e m
Arguments step_for_false ge f v ty a2 a3 s k e m _
Arguments step_for_true ge f v ty a2 a3 s k e m _
Arguments step_skip_or_continue_for3 ge f x a2 a3 s k e m _
Arguments step_break_for3 ge f a2 a3 s k e m
Arguments step_skip_for4 ge f a2 a3 s k e m
Arguments step_return_0 ge f k e m m' _
Arguments step_return_1 ge f x k e m
Arguments step_return_2 ge f v1 ty k e m v2 m' _ _
Arguments step_skip_call ge f k e m m' _ _
Arguments step_switch ge f x sl k e m
Arguments step_expr_switch ge f ty sl k e m v n%_Z_scope _
Arguments step_skip_break_switch ge f x k e m _
Arguments step_continue_switch ge f k e m
Arguments step_label ge f lbl s k e m
Arguments step_goto ge f lbl k e m s' k' _
Arguments step_internal_function ge f vargs%_list_scope k m e m1 m2 _ _ _
Arguments step_external_function ge ef targs%_list_scope 
  tres cc vargs%_list_scope k m vres t m' _
Arguments step_returnstate ge v f e C%_function_scope ty k m
