From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Errors Maps Integers Floats AST Values Memory Events Globalenvs Ctypes Cop Csyntax Csyntaxdefs Csem Cstrategy Smallstep.
From FiveGuidanceEntry Require Import Entry SoftwareSqrt BigstepSupport EffectfulSupport SymbolicPrefix.
Require FiveGhSpeed.Source FiveGhSpeed.Execution.
Import ListNotations.
Local Open Scope Z_scope.
Module S:=FiveGhSpeed.Source.
Definition old_load_frame(m mf:mem):Prop:=forall ch b ofs,Mem.valid_block m b ->Mem.load ch mf b ofs=Mem.load ch m b ofs.
Definition old_bytes_frame(m mf:mem):Prop:=forall b ofs n,Mem.valid_block m b ->Mem.loadbytes mf b ofs n=Mem.loadbytes m b ofs n.
Definition sqrt_call_contract:Prop:=forall m x,exists mf,
 Cstrategy.eval_funcall ge m(Internal S.f_five_sqrtf)[Vsingle x]E0 mf(Vsingle(software_sqrt x)) /\
 access_preserved m mf /\old_load_frame m mf /\old_bytes_frame m mf.
Definition pointer_read:expr:=Evalof(Evar S._accel_sp(tptr vt))(tptr vt).
Definition accel_field(coord:ident):expr:=Efield(Evalof(Ederef pointer_read vt)vt)coord tfloat.
Definition accel_read(coord:ident):expr:=Evalof(accel_field coord)tfloat.
Definition named_read(id:ident):expr:=Evalof(Evar id tfloat)tfloat.
Definition norm_statement:statement:=Sdo(Eassign(Evar S._a_norm2 tfloat)
 (Ebinop Oadd(Ebinop Omul(accel_read S._x)(accel_read S._x)tfloat)
 (Ebinop Omul(accel_read S._y)(accel_read S._y)tfloat)tfloat)tfloat).
Definition sqrt_function_type:=Tfunction(tfloat::nil)tfloat cc_default.
Definition sqrt_rf:=Evalof(Evar S._five_sqrtf sqrt_function_type)sqrt_function_type.
Definition sqrt_call:=Ecall sqrt_rf(Econs(named_read S._a_norm2)Enil)tfloat.
Definition factor_statement:=Sdo(Eassign(Evar S._factor tfloat)
 (Ebinop Odiv(named_read S._gh_max_accel)sqrt_call tfloat)tfloat).
Definition scale_component(coord:ident):statement:=Sdo(Eassign(accel_field coord)
 (Ebinop Omul(accel_read coord)(named_read S._factor)tfloat)tfloat).
Definition scale_pair:=Ssequence(scale_component S._x)(scale_component S._y).
Definition sat_branch_statement:=Ssequence factor_statement scale_pair.
Definition condition_expr:=Ebinop Ogt(named_read S._a_norm2)
 (Ebinop Omul(named_read S._gh_max_accel)(named_read S._gh_max_accel)tfloat)tint.
Lemma saturation_body_shape:fn_body S.f_gh_saturate_accel=
 Ssequence norm_statement(Sifthenelse condition_expr sat_branch_statement Sskip).
Proof. reflexivity. Qed.
Lemma loaded_valid_block:forall ch m b ofs v,Mem.load ch m b ofs=Some v ->Mem.valid_block m b.
Proof.
 intros;eapply Mem.valid_access_valid_block;eapply Mem.valid_access_implies;[eapply Mem.load_valid_access;exact H|constructor].
Qed.
Lemma read_named:forall e m id b x,
 e!id=Some(b,tfloat) ->Mem.load Mfloat32 m b 0=Some(Vsingle x) ->
 Cstrategy.eval_simple_rvalue ge e m(named_read id)(Vsingle x).
Proof.
 intros;eapply read_at_single with(b:=b)(ofs:=0).
 - apply Cstrategy.esl_var_local;exact H.
 - reflexivity.
 - vm_compute;intuition discriminate.
 - exact H0.
Qed.
Lemma read_maximum:forall e m bc maximum,
 e!S._gh_max_accel=None ->Genv.find_symbol ge S._gh_max_accel=Some bc ->
 Mem.load Mfloat32 m bc 0=Some(Vsingle maximum) ->
 Cstrategy.eval_simple_rvalue ge e m(named_read S._gh_max_accel)(Vsingle maximum).
Proof.
 intros;eapply read_at_single with(b:=bc)(ofs:=0).
 - eapply Cstrategy.esl_var_global;eauto.
 - reflexivity.
 - vm_compute;intuition discriminate.
 - exact H1.
Qed.
Lemma read_pointer:forall e m bp ba,
 e!S._accel_sp=Some(bp,tptr vt) ->Mem.load Mint64 m bp 0=Some(Vptr ba Ptrofs.zero) ->
 Cstrategy.eval_simple_rvalue ge e m pointer_read(Vptr ba Ptrofs.zero).
Proof.
 intros e m bp ba LOOK LOAD;unfold pointer_read;eapply Cstrategy.esr_rvalof.
 - apply Cstrategy.esl_var_local;exact LOOK.
 - reflexivity.
 - reflexivity.
 - eapply deref_loc_value;[reflexivity|reflexivity|].
   unfold Mem.loadv;rewrite Ptrofs.unsigned_zero;rewrite zle_true;[exact LOAD|change(0+8<=18446744073709551616);lia].
Qed.
Lemma accel_location:forall e m bp ba coord ofs,
 e!S._accel_sp=Some(bp,tptr vt) ->Mem.load Mint64 m bp 0=Some(Vptr ba Ptrofs.zero) ->
 (coord=S._x /\ofs=0 \/coord=S._y /\ofs=4) ->
 Cstrategy.eval_simple_lvalue ge e m(accel_field coord)ba(Ptrofs.repr ofs)Full.
Proof.
 intros e m bp ba coord ofs LOOK LOAD [[-> ->]|[-> ->]];unfold accel_field;
 rewrite <-Ptrofs.add_zero_l at 1.
 all:eapply Cstrategy.esl_field_struct;
 [eapply Cstrategy.esr_rvalof;
 [eapply Cstrategy.esl_deref;eapply read_pointer;eauto|reflexivity|reflexivity|apply deref_loc_copy;reflexivity]|
 reflexivity|reflexivity|reflexivity].
Qed.
Lemma read_accel:forall e m bp ba coord ofs x,
 e!S._accel_sp=Some(bp,tptr vt) ->Mem.load Mint64 m bp 0=Some(Vptr ba Ptrofs.zero) ->
 (coord=S._x /\ofs=0 \/coord=S._y /\ofs=4) ->Mem.load Mfloat32 m ba ofs=Some(Vsingle x) ->
 Cstrategy.eval_simple_rvalue ge e m(accel_read coord)(Vsingle x).
Proof.
 intros e m bp ba coord ofs x LP PTR OFF LOAD;unfold accel_read;eapply read_at_single with(b:=ba)(ofs:=ofs).
 - eapply accel_location;eauto.
 - reflexivity.
 - destruct OFF as[[-> ->]|[-> ->]];vm_compute;intuition discriminate.
 - exact LOAD.
Qed.
Print Assumptions accel_location.
Definition sqrt_block:block:=match Genv.find_symbol ge S._five_sqrtf with Some b=>b|None=>1%positive end.
Lemma sqrt_symbol:Genv.find_symbol ge S._five_sqrtf=Some sqrt_block.
Proof. reflexivity. Qed.
Lemma sqrt_funct:Genv.find_funct ge(Vptr sqrt_block Ptrofs.zero)=Some(Internal S.f_five_sqrtf).
Proof. reflexivity. Qed.
Lemma read_sqrt_function:forall e m,e!S._five_sqrtf=None ->
 Cstrategy.eval_simple_rvalue ge e m sqrt_rf(Vptr sqrt_block Ptrofs.zero).
Proof.
 intros e m ENV;unfold sqrt_rf;eapply Cstrategy.esr_rvalof.
 - eapply Cstrategy.esl_var_global;[exact ENV|exact sqrt_symbol].
 - reflexivity.
 - reflexivity.
 - apply deref_loc_reference;reflexivity.
Qed.
Lemma factor_statement_exec:forall e m bn bf bc n maximum,
 sqrt_call_contract ->e!S._five_sqrtf=None ->e!S._gh_max_accel=None ->
 Genv.find_symbol ge S._gh_max_accel=Some bc ->
 e!S._a_norm2=Some(bn,tfloat) ->e!S._factor=Some(bf,tfloat) ->
 Mem.load Mfloat32 m bn 0=Some(Vsingle n) ->Mem.load Mfloat32 m bc 0=Some(Vsingle maximum) ->
 Mem.valid_access m Mfloat32 bf 0 Writable ->
 exists mf mc,
 Cstrategy.exec_stmt ge e m factor_statement E0 mf Out_normal /\
 Mem.store Mfloat32 mc bf 0(Vsingle(Float32.div maximum(software_sqrt n)))=Some mf /\
 access_preserved m mf /\
 (forall ch b ofs,Mem.valid_block m b ->b<>bf ->Mem.load ch mf b ofs=Mem.load ch m b ofs) /\
 (forall b ofs nbytes,Mem.valid_block m b ->b<>bf ->Mem.loadbytes mf b ofs nbytes=Mem.loadbytes m b ofs nbytes).
Proof.
 intros e m bn bf bc n maximum CONTRACT ES EM SYM LN LF LOADN LOADC ACCESS.
 destruct(CONTRACT m n)as[mc[CALL[KEEP[FRAME BFRAME]]]].
 assert(RF:Cstrategy.eval_simple_rvalue ge e m sqrt_rf(Vptr sqrt_block Ptrofs.zero))by(eapply read_sqrt_function;exact ES).
 assert(RN:Cstrategy.eval_simple_rvalue ge e m(named_read S._a_norm2)(Vsingle n))by(eapply read_named;eauto).
 assert(RM:Cstrategy.eval_simple_rvalue ge e m(named_read S._gh_max_accel)(Vsingle maximum))by(eapply read_maximum;eauto).
 assert(EXPR:Cstrategy.eval_expr ge e m RV
 (Ebinop Odiv(named_read S._gh_max_accel)sqrt_call tfloat)E0 mc
 (Ebinop Odiv(named_read S._gh_max_accel)(Eval(Vsingle(software_sqrt n))tfloat)tfloat)).
 { replace E0 with(E0**E0)by reflexivity;eapply Cstrategy.eval_binop.
   - eapply(proj1(simple_eval_expr_refl ge e m));[exact RM|reflexivity].
   - unfold sqrt_call;eapply simple_call_expr with(vf:=Vptr sqrt_block Ptrofs.zero)(fd:=Internal S.f_five_sqrtf)(targs:=[tfloat])(tres:=tfloat)(cc:=cc_default)(vargs:=[Vsingle n]).
     + exact RF.
     + reflexivity.
     + econstructor;[exact RN|reflexivity|constructor].
     + reflexivity.
     + reflexivity.
     + exact sqrt_funct.
     + reflexivity.
     + exact CALL. }
 assert(CVALID:Mem.valid_block m bc)by(eapply loaded_valid_block;exact LOADC).
 assert(LOADMC:Mem.load Mfloat32 mc bc 0=Some(Vsingle maximum))by(rewrite FRAME by exact CVALID;exact LOADC).
 assert(RMC:Cstrategy.eval_simple_rvalue ge e mc(named_read S._gh_max_accel)(Vsingle maximum))by(eapply read_maximum;eauto).
 destruct(Mem.valid_access_store mc Mfloat32 bf 0(Vsingle(Float32.div maximum(software_sqrt n)))(KEEP _ _ _ _ ACCESS))as[mf STORE].
 exists mf,mc;split.
 - unfold factor_statement;eapply effectful_assign with(mr:=mc)
 (r':=Ebinop Odiv(named_read S._gh_max_accel)(Eval(Vsingle(software_sqrt n))tfloat)tfloat)
 (v:=Vsingle(Float32.div maximum(software_sqrt n)))(vc:=Vsingle(Float32.div maximum(software_sqrt n)))
 (v':=Vsingle(Float32.div maximum(software_sqrt n)))(b:=bf)(ofs:=Ptrofs.zero)(bf:=Full).
   + apply Cstrategy.esl_var_local;exact LF.
   + reflexivity.
   + exact EXPR.
   + apply Cstrategy.esl_var_local;exact LF.
   + eapply Cstrategy.esr_binop;[exact RMC|constructor|reflexivity].
   + reflexivity.
   + eapply assign_loc_value;[reflexivity|reflexivity|].
     unfold Mem.storev;rewrite Ptrofs.unsigned_zero;rewrite zle_true;[exact STORE|change(0+4<=18446744073709551616);lia].
   + reflexivity.
 - split;[exact STORE|]. split.
   + unfold access_preserved in *;intros;eapply Mem.store_valid_access_1;[exact STORE|apply KEEP;assumption].
   + split.
     * intros ch b ofs VB D;erewrite Mem.load_store_other by(exact STORE||(left;exact D));apply FRAME;exact VB.
     * intros b ofs nbytes VB D;erewrite Mem.loadbytes_store_other by(exact STORE||(left;exact D));apply BFRAME;exact VB.
Qed.
Print Assumptions factor_statement_exec.
Lemma scale_pair_exec:forall e m bp ba bf a factor,
 e!S._accel_sp=Some(bp,tptr vt) ->e!S._factor=Some(bf,tfloat) ->ba<>bp ->ba<>bf ->
 Mem.load Mint64 m bp 0=Some(Vptr ba Ptrofs.zero) ->
 Mem.load Mfloat32 m ba 0=Some(Vsingle(vx a)) ->Mem.load Mfloat32 m ba 4=Some(Vsingle(vy a)) ->
 Mem.load Mfloat32 m bf 0=Some(Vsingle factor) ->
 Mem.valid_access m Mfloat32 ba 0 Writable ->Mem.valid_access m Mfloat32 ba 4 Writable ->
 exists mf ma,Cstrategy.exec_stmt ge e m scale_pair E0 mf Out_normal /\
 Mem.load Mfloat32 mf ba 0=Some(Vsingle(Float32.mul(vx a)factor)) /\
 Mem.load Mfloat32 mf ba 4=Some(Vsingle(Float32.mul(vy a)factor)) /\access_preserved m mf /\
 Mem.store Mfloat32 m ba 0(Vsingle(Float32.mul(vx a)factor))=Some ma /\
 Mem.store Mfloat32 ma ba 4(Vsingle(Float32.mul(vy a)factor))=Some mf.
Proof.
 intros e m bp ba bf a factor LP LF DBP DBF PTR LX LY LOADF A0 A4.
 destruct(Mem.valid_access_store m Mfloat32 ba 0(Vsingle(Float32.mul(vx a)factor))A0)as[m1 SX].
 assert(A41:Mem.valid_access m1 Mfloat32 ba 4 Writable)by prior_store_access.
 assert(PTR1:Mem.load Mint64 m1 bp 0=Some(Vptr ba Ptrofs.zero))by prior_store_load.
 assert(LY1:Mem.load Mfloat32 m1 ba 4=Some(Vsingle(vy a)))by prior_store_load.
 assert(LF1:Mem.load Mfloat32 m1 bf 0=Some(Vsingle factor))by prior_store_load.
 destruct(Mem.valid_access_store m1 Mfloat32 ba 4(Vsingle(Float32.mul(vy a)factor))A41)as[m2 SY].
 exists m2,m1;split.
 - unfold scale_pair;eapply sequence_normal.
   + unfold scale_component;eapply write_at_single with(b:=ba)(ofs:=0)(x:=Float32.mul(vx a)factor).
     * eapply accel_location;[exact LP|exact PTR|intuition congruence].
     * reflexivity.
     * reflexivity.
     * reflexivity.
     * reflexivity.
     * eapply Cstrategy.esr_binop.
       -- eapply read_accel;[exact LP|exact PTR|intuition congruence|exact LX].
       -- eapply read_named;[exact LF|exact LOADF].
       -- reflexivity.
     * vm_compute;intuition discriminate.
     * exact SX.
   + unfold scale_component;eapply write_at_single with(b:=ba)(ofs:=4)(x:=Float32.mul(vy a)factor).
     * eapply accel_location;[exact LP|exact PTR1|intuition congruence].
     * reflexivity.
     * reflexivity.
     * reflexivity.
     * reflexivity.
     * eapply Cstrategy.esr_binop.
       -- eapply read_accel;[exact LP|exact PTR1|intuition congruence|exact LY1].
       -- eapply read_named;[exact LF|exact LF1].
       -- reflexivity.
     * vm_compute;intuition discriminate.
     * exact SY.
 - split;[prior_store_load|]. split;[prior_store_load|]. split.
   + unfold access_preserved;intros;prior_store_access.
   + auto.
Qed.
Print Assumptions scale_pair_exec.
Lemma saturation_body_exec:forall e m bp bn bf ba bc a maximum,
 sqrt_call_contract ->e!S._five_sqrtf=None ->e!S._gh_max_accel=None ->
 Genv.find_symbol ge S._gh_max_accel=Some bc ->
 e!S._accel_sp=Some(bp,tptr vt) ->e!S._a_norm2=Some(bn,tfloat) ->e!S._factor=Some(bf,tfloat) ->
 ba<>bp ->bn<>bp ->bn<>ba ->bn<>bc ->bf<>bp ->bf<>ba ->
 Mem.load Mint64 m bp 0=Some(Vptr ba Ptrofs.zero) ->
 Mem.load Mfloat32 m ba 0=Some(Vsingle(vx a)) ->Mem.load Mfloat32 m ba 4=Some(Vsingle(vy a)) ->
 Mem.load Mfloat32 m bc 0=Some(Vsingle maximum) ->
 Mem.valid_access m Mfloat32 bn 0 Writable ->Mem.valid_access m Mfloat32 bf 0 Writable ->
 Mem.valid_access m Mfloat32 ba 0 Writable ->Mem.valid_access m Mfloat32 ba 4 Writable ->
 exists mf,Cstrategy.exec_stmt ge e m(fn_body S.f_gh_saturate_accel)E0 mf Out_normal /\
 Mem.load Mfloat32 mf ba 0=Some(Vsingle(vx(saturate maximum a))) /\
 Mem.load Mfloat32 mf ba 4=Some(Vsingle(vy(saturate maximum a))) /\
 access_preserved m mf /\
 (forall ch b ofs,Mem.valid_block m b ->b<>bn ->b<>bf ->b<>ba ->Mem.load ch mf b ofs=Mem.load ch m b ofs) /\
 (forall b ofs nbytes,Mem.valid_block m b ->b<>bn ->b<>bf ->b<>ba ->Mem.loadbytes mf b ofs nbytes=Mem.loadbytes m b ofs nbytes).
Proof.
 intros e m bp bn bf ba bc a maximum CONTRACT ES EM SYM LP LN LF DAP DNP DNA DNC DFP DFA PTR LX LY LC AN AF AA0 AA4.
 destruct(Mem.valid_access_store m Mfloat32 bn 0(Vsingle(norm2 a))AN)as[m1 SN].
 assert(NORM:Cstrategy.exec_stmt ge e m norm_statement E0 m1 Out_normal).
 { unfold norm_statement;eapply write_at_single with(b:=bn)(ofs:=0)(x:=norm2 a).
   - apply Cstrategy.esl_var_local;exact LN.
   - reflexivity.
   - reflexivity.
   - reflexivity.
   - reflexivity.
   - unfold norm2;eapply Cstrategy.esr_binop.
     + eapply Cstrategy.esr_binop.
       * eapply read_accel;[exact LP|exact PTR|intuition congruence|exact LX].
       * eapply read_accel;[exact LP|exact PTR|intuition congruence|exact LX].
       * reflexivity.
     + eapply Cstrategy.esr_binop.
       * eapply read_accel;[exact LP|exact PTR|intuition congruence|exact LY].
       * eapply read_accel;[exact LP|exact PTR|intuition congruence|exact LY].
       * reflexivity.
     + reflexivity.
   - vm_compute;intuition discriminate.
   - exact SN. }
 assert(PTR1:Mem.load Mint64 m1 bp 0=Some(Vptr ba Ptrofs.zero))by prior_store_load.
 assert(LX1:Mem.load Mfloat32 m1 ba 0=Some(Vsingle(vx a)))by prior_store_load.
 assert(LY1:Mem.load Mfloat32 m1 ba 4=Some(Vsingle(vy a)))by prior_store_load.
 assert(LC1:Mem.load Mfloat32 m1 bc 0=Some(Vsingle maximum))by prior_store_load.
 assert(LN1:Mem.load Mfloat32 m1 bn 0=Some(Vsingle(norm2 a)))by prior_store_load.
 assert(AF1:Mem.valid_access m1 Mfloat32 bf 0 Writable)by prior_store_access.
 assert(AA01:Mem.valid_access m1 Mfloat32 ba 0 Writable)by prior_store_access.
 assert(AA41:Mem.valid_access m1 Mfloat32 ba 4 Writable)by prior_store_access.
 assert(CMP:Cstrategy.eval_simple_rvalue ge e m1 condition_expr(Val.of_bool(saturation_branch maximum a))).
 { unfold condition_expr,saturation_branch;eapply Cstrategy.esr_binop.
   - eapply read_named;[exact LN|exact LN1].
   - eapply Cstrategy.esr_binop;
     [eapply read_maximum;[exact EM|exact SYM|exact LC1]|
      eapply read_maximum;[exact EM|exact SYM|exact LC1]|reflexivity].
   - reflexivity. }
 destruct(saturation_branch maximum a)eqn:BR.
 - destruct(factor_statement_exec e m1 bn bf bc(norm2 a)maximum CONTRACT ES EM SYM LN LF LN1 LC1 AF1)
   as[m2[mc[FACTOR[SF[APF[FRAME BFRAME]]]]]].
   assert(PTR2:Mem.load Mint64 m2 bp 0=Some(Vptr ba Ptrofs.zero)).
   { rewrite FRAME;[exact PTR1|eapply loaded_valid_block;exact PTR1|congruence]. }
   assert(LX2:Mem.load Mfloat32 m2 ba 0=Some(Vsingle(vx a))).
   { rewrite FRAME;[exact LX1|eapply loaded_valid_block;exact LX1|congruence]. }
   assert(LY2:Mem.load Mfloat32 m2 ba 4=Some(Vsingle(vy a))).
   { rewrite FRAME;[exact LY1|eapply loaded_valid_block;exact LY1|congruence]. }
   assert(LF2:Mem.load Mfloat32 m2 bf 0=Some(Vsingle(Float32.div maximum(software_sqrt(norm2 a))))).
   { erewrite Mem.load_store_same by exact SF;reflexivity. }
   destruct(scale_pair_exec e m2 bp ba bf a(Float32.div maximum(software_sqrt(norm2 a)))
   LP LF DAP ltac:(congruence) PTR2 LX2 LY2 LF2(APF _ _ _ _ AA01)(APF _ _ _ _ AA41))
   as[mf[ms[SCALE[AX[AY[APS[SX SY]]]]]]].
   exists mf;split.
   + rewrite saturation_body_shape;eapply sequence_normal;[exact NORM|].
     replace E0 with(E0**E0)by reflexivity;eapply Cstrategy.exec_Sifthenelse with(v1:=Val.of_bool true)(b:=true)(m1:=m1).
     * eapply simple_expression;[exact CMP|reflexivity].
     * reflexivity.
     * cbn;eapply sequence_normal;[exact FACTOR|exact SCALE].
   + unfold saturate,saturate_using;rewrite BR;cbn;split;[exact AX|]. split;[exact AY|]. split.
     * unfold access_preserved in *;intros;apply APS;apply APF;prior_store_access.
     * split.
       { intros ch b ofs VB DBN DBF DBA.
         erewrite Mem.load_store_other by(exact SY||(left;exact DBA)).
         erewrite Mem.load_store_other by(exact SX||(left;exact DBA)).
         rewrite FRAME;[|eapply Mem.store_valid_block_1;eauto|exact DBF].
         erewrite Mem.load_store_other by(exact SN||(left;exact DBN));reflexivity. }
       intros b ofs nbytes VB DBN DBF DBA.
       erewrite Mem.loadbytes_store_other by(exact SY||(left;exact DBA)).
       erewrite Mem.loadbytes_store_other by(exact SX||(left;exact DBA)).
       rewrite BFRAME;[|eapply Mem.store_valid_block_1;eauto|exact DBF].
       erewrite Mem.loadbytes_store_other by(exact SN||(left;exact DBN));reflexivity.
 - exists m1;split.
   + rewrite saturation_body_shape;eapply sequence_normal;[exact NORM|].
     replace E0 with(E0**E0)by reflexivity;eapply Cstrategy.exec_Sifthenelse with(v1:=Val.of_bool false)(b:=false)(m1:=m1).
     * eapply simple_expression;[exact CMP|reflexivity].
     * reflexivity.
     * cbn;constructor.
   + unfold saturate,saturate_using;rewrite BR;cbn;split;[exact LX1|]. split;[exact LY1|]. split.
     * unfold access_preserved;intros;prior_store_access.
     * split.
       { intros ch b ofs VB DBN DBF DBA;erewrite Mem.load_store_other by(exact SN||(left;exact DBN));reflexivity. }
       intros b ofs nbytes VB DBN DBF DBA;erewrite Mem.loadbytes_store_other by(exact SN||(left;exact DBN));reflexivity.
Qed.
Print Assumptions saturation_body_exec.
From Stdlib Require Import Bool List ZArith String Classical.
From compcert Require Import Coqlib Errors Maps Integers Floats AST Values Memory Events Globalenvs Determinism Ctypes Cop Csyntax Csyntaxdefs Csem Cexec Cstrategy Smallstep.
From FiveGuidanceSemantics Require Import SemanticsSupport SourceClosure.
From FiveGuidanceAllOrder Require Import PureSyntax PureDenotation PureProgress AtomicDenotation AtomicProgress CallfreeExecution ContinuationLift BlockExecution.
Import ListNotations.
Inductive read_stage:=Rvar|Rloc|Rval.
Definition read_res(id:ident)(ty:type)(b:block)(v:val)(stage:read_stage):expr :=
 match stage with
 | Rvar=>Evalof(Evar id ty)ty
 | Rloc=>Evalof(Eloc b Ptrofs.zero Full ty)ty
 | Rval=>Eval v ty end.
Definition lhs_res(id:ident)(b:block)(ready:bool):expr :=
 if ready then Eloc b Ptrofs.zero Full tfloat else Evar id tfloat.
Definition leaf_type:=Tfunction[tfloat]tfloat cc_default.
Definition factor_context(l mx:expr):expr->expr :=
 fun hole=>Eassign l(Ebinop Odiv mx hole tfloat)tfloat.
Definition factor_expression(l mx rf arg:expr):expr :=
 factor_context l mx(Ecall rf(Econs arg Enil)tfloat).
Definition null_external(_ : string)(_ : signature)(_ : Senv.t)(_ : world)(_ : list val)(_ : mem)
 :option(world*trace*val*mem):=None.
Section FACTOR.
Variable ge:genv.
Variable e:env.
Variable caller leaf:function.
Variable k:cont.
Variable ifactor imax isqrt inorm:ident.
Variable bfactor bmax bsqrt bnorm:block.
Variable m:mem.
Variable maximum norm:float32.
Hypothesis factor_local:e!ifactor=Some(bfactor,tfloat).
Hypothesis max_global:e!imax=None.
Hypothesis max_symbol:Genv.find_symbol ge imax=Some bmax.
Hypothesis sqrt_global:e!isqrt=None.
Hypothesis sqrt_symbol:Genv.find_symbol ge isqrt=Some bsqrt.
Hypothesis norm_local:e!inorm=Some(bnorm,tfloat).
Hypothesis max_deref:Cexec.do_deref_loc ge quiet_world tfloat m bmax Ptrofs.zero Full=Some(quiet_world,E0,Vsingle maximum).
Hypothesis norm_deref:Cexec.do_deref_loc ge quiet_world tfloat m bnorm Ptrofs.zero Full=Some(quiet_world,E0,Vsingle norm).
Hypothesis leaf_find:Genv.find_funct ge(Vptr bsqrt Ptrofs.zero)=Some(Internal leaf).
Hypothesis leaf_signature:type_of_fundef(Internal leaf)=leaf_type.
Definition pre_expr(lready:bool)(ms rs ns:read_stage):expr :=
 factor_expression(lhs_res ifactor bfactor lready)
 (read_res imax tfloat bmax(Vsingle maximum)ms)
 (read_res isqrt leaf_type bsqrt(Vptr bsqrt Ptrofs.zero)rs)
 (read_res inorm tfloat bnorm(Vsingle norm)ns).
Definition pre_state(lready:bool)(ms rs ns:read_stage):Csem.state :=
 ExprState caller(pre_expr lready ms rs ns)(Kdo k)e m.
Definition leaf_frame(lready:bool)(ms:read_stage):cont :=
 Kcall caller e(factor_context(lhs_res ifactor bfactor lready)
 (read_res imax tfloat bmax(Vsingle maximum)ms))tfloat(Kdo k).
Definition pre_or_call(s:Csem.state):Prop :=
 (exists lready ms rs ns,s=pre_state lready ms rs ns) \/
 (exists lready ms,s=Callstate(Internal leaf)[Vsingle norm](leaf_frame lready ms)m).

Ltac factor_close :=
 split;[reflexivity|unfold pre_or_call;first[
 left;first[solve[exists true,Rvar,Rvar,Rvar;reflexivity]|solve[exists true,Rvar,Rvar,Rloc;reflexivity]|solve[exists true,Rvar,Rvar,Rval;reflexivity]|solve[exists true,Rvar,Rloc,Rvar;reflexivity]|solve[exists true,Rvar,Rloc,Rloc;reflexivity]|solve[exists true,Rvar,Rloc,Rval;reflexivity]|solve[exists true,Rvar,Rval,Rvar;reflexivity]|solve[exists true,Rvar,Rval,Rloc;reflexivity]|solve[exists true,Rvar,Rval,Rval;reflexivity]|solve[exists true,Rloc,Rvar,Rvar;reflexivity]|solve[exists true,Rloc,Rvar,Rloc;reflexivity]|solve[exists true,Rloc,Rvar,Rval;reflexivity]|solve[exists true,Rloc,Rloc,Rvar;reflexivity]|solve[exists true,Rloc,Rloc,Rloc;reflexivity]|solve[exists true,Rloc,Rloc,Rval;reflexivity]|solve[exists true,Rloc,Rval,Rvar;reflexivity]|solve[exists true,Rloc,Rval,Rloc;reflexivity]|solve[exists true,Rloc,Rval,Rval;reflexivity]|solve[exists true,Rval,Rvar,Rvar;reflexivity]|solve[exists true,Rval,Rvar,Rloc;reflexivity]|solve[exists true,Rval,Rvar,Rval;reflexivity]|solve[exists true,Rval,Rloc,Rvar;reflexivity]|solve[exists true,Rval,Rloc,Rloc;reflexivity]|solve[exists true,Rval,Rloc,Rval;reflexivity]|solve[exists true,Rval,Rval,Rvar;reflexivity]|solve[exists true,Rval,Rval,Rloc;reflexivity]|solve[exists true,Rval,Rval,Rval;reflexivity]|solve[exists false,Rvar,Rvar,Rvar;reflexivity]|solve[exists false,Rvar,Rvar,Rloc;reflexivity]|solve[exists false,Rvar,Rvar,Rval;reflexivity]|solve[exists false,Rvar,Rloc,Rvar;reflexivity]|solve[exists false,Rvar,Rloc,Rloc;reflexivity]|solve[exists false,Rvar,Rloc,Rval;reflexivity]|solve[exists false,Rvar,Rval,Rvar;reflexivity]|solve[exists false,Rvar,Rval,Rloc;reflexivity]|solve[exists false,Rvar,Rval,Rval;reflexivity]|solve[exists false,Rloc,Rvar,Rvar;reflexivity]|solve[exists false,Rloc,Rvar,Rloc;reflexivity]|solve[exists false,Rloc,Rvar,Rval;reflexivity]|solve[exists false,Rloc,Rloc,Rvar;reflexivity]|solve[exists false,Rloc,Rloc,Rloc;reflexivity]|solve[exists false,Rloc,Rloc,Rval;reflexivity]|solve[exists false,Rloc,Rval,Rvar;reflexivity]|solve[exists false,Rloc,Rval,Rloc;reflexivity]|solve[exists false,Rloc,Rval,Rval;reflexivity]|solve[exists false,Rval,Rvar,Rvar;reflexivity]|solve[exists false,Rval,Rvar,Rloc;reflexivity]|solve[exists false,Rval,Rvar,Rval;reflexivity]|solve[exists false,Rval,Rloc,Rvar;reflexivity]|solve[exists false,Rval,Rloc,Rloc;reflexivity]|solve[exists false,Rval,Rloc,Rval;reflexivity]|solve[exists false,Rval,Rval,Rvar;reflexivity]|solve[exists false,Rval,Rval,Rloc;reflexivity]|solve[exists false,Rval,Rval,Rval;reflexivity]]
 |right;first[solve[exists true,Rvar;reflexivity]|solve[exists true,Rloc;reflexivity]|solve[exists true,Rval;reflexivity]|solve[exists false,Rvar;reflexivity]|solve[exists false,Rloc;reflexivity]|solve[exists false,Rval;reflexivity]]]].
Lemma pre_animator_step:forall lr ms rs ns rule t next,
 In(TR rule t next)(Cexec.do_step ge null_external null_external quiet_world(pre_state lr ms rs ns)) ->
 t=E0 /\ pre_or_call next.
Proof.
 intros lr ms rs ns rule t next.
 destruct lr,ms,rs,ns;
 cbn[pre_state pre_expr factor_expression factor_context lhs_res read_res Cexec.do_step
 Cexec.is_val Cexec.step_expr Cexec.step_exprlist Cexec.is_loc Cexec.is_val_list
 Cexec.incontext Cexec.topred Cexec.stuck] ;
 rewrite ?factor_local,?max_global,?max_symbol,?sqrt_global,?sqrt_symbol,?norm_local;
 rewrite ?dec_eq_true;
 rewrite ?max_deref,?norm_deref;
 cbn[Cexec.do_deref_loc access_mode type_is_volatile];
 rewrite ?dec_eq_true.
 all: cbn[leaf_type classify_fun sem_cast_arguments sem_cast];
 rewrite ?leaf_find,?leaf_signature;rewrite ?dec_eq_true;
 cbn[Cexec.incontext2 Cexec.incontext Cexec.topred Cexec.expr_final_state map app fst snd].
 all: intros IN;simpl in IN;repeat destruct IN as[EQ|IN];try contradiction;
 inversion EQ;subst;factor_close.
Qed.

Lemma pre_callback_free:forall lr ms rs ns,callback_free_state(pre_state lr ms rs ns).
Proof. intros;destruct lr,ms,rs,ns;reflexivity. Qed.
Lemma pre_or_call_not_stuck:forall s,pre_or_call s ->s<>Stuckstate.
Proof. intros s[[lr[ms[rs[ns EQ]]]]|[lr[ms EQ]]];subst;discriminate. Qed.
Lemma pre_core:forall lr ms rs ns,
 SourceClosure.core_expr ge(fun _=>True)(fun _ _=>True)(pre_expr lr ms rs ns).
Proof.
 intros;destruct lr,ms,rs,ns;
 cbn[pre_expr factor_expression factor_context lhs_res read_res leaf_type
 SourceClosure.core_expr SourceClosure.core_exprlist SourceClosure.nv];
 repeat split;try reflexivity;unfold SourceClosure.valid_call;intros;split;exact I.
Qed.
Lemma pre_silent:forall lr ms rs ns,
 silent_state ge(pre_state lr ms rs ns).
Proof.
 intros lr ms rs ns t next STEP.
 pose proof(pre_core lr ms rs ns)as CORE.
 destruct STEP as[ES|SS];[|inversion SS].
 inversion ES;subst;auto.
 match goal with EQ:?C ?A=pre_expr _ _ _ _ |- _=>rewrite <-EQ in CORE end.
 match goal with HC:Csem.context RV RV ?C,RR:rred ge ?a m t ?a' ?m' |- _=>
 pose proof(SourceClosure.core_context_hole ge(fun _=>True)(fun _ _=>True)
 _ _ _ HC a CORE)as CA;
 exact(proj1(SourceClosure.core_rred ge(fun _=>True)(fun _ _=>True)
 a m t a' m' CA RR))end.
Qed.
Theorem pre_all_successors:forall lr ms rs ns t next,
 Csem.step ge(pre_state lr ms rs ns)t next ->t=E0 /\ pre_or_call next.
Proof.
 intros lr ms rs ns t next STEP.
 pose proof(pre_silent lr ms rs ns t next STEP)as TT;subst t.
 destruct(pure_do_step_complete ge null_external null_external quiet_world
 (pre_state lr ms rs ns) E0 next quiet_world (pre_callback_free lr ms rs ns)
 (possible_trace_nil quiet_world) STEP)as[rule IN].
 eapply pre_animator_step;exact IN.
Qed.
Lemma pre_animator_nonempty:forall lr ms rs ns,
 exists rule t next,In(TR rule t next)
 (Cexec.do_step ge null_external null_external quiet_world(pre_state lr ms rs ns)).
Proof.
 intros lr ms rs ns.
 destruct lr,ms,rs,ns;
 cbn[pre_state pre_expr factor_expression factor_context lhs_res read_res Cexec.do_step
 Cexec.is_val Cexec.step_expr Cexec.step_exprlist Cexec.is_loc Cexec.is_val_list
 Cexec.incontext Cexec.topred Cexec.stuck] ;
 rewrite ?factor_local,?max_global,?max_symbol,?sqrt_global,?sqrt_symbol,?norm_local;
 rewrite ?dec_eq_true;
 rewrite ?max_deref,?norm_deref;
 cbn[Cexec.do_deref_loc access_mode type_is_volatile];
 rewrite ?dec_eq_true.
 all: cbn[leaf_type classify_fun sem_cast_arguments sem_cast];
 rewrite ?leaf_find,?leaf_signature;rewrite ?dec_eq_true;
 cbn[Cexec.incontext2 Cexec.incontext Cexec.topred Cexec.expr_final_state map app fst snd].

 all: repeat eexists;apply in_eq.
Qed.
Theorem pre_progress:forall lr ms rs ns,
 exists t next,Csem.step ge(pre_state lr ms rs ns)t next /\ pre_or_call next.
Proof.
 intros lr ms rs ns.
 destruct(pre_animator_nonempty lr ms rs ns)as[rule[t[next IN]]].
 pose proof(proj2(pre_animator_step lr ms rs ns rule t next IN))as CLASS.
 exists t,next;split;auto.
 eapply supported_nonstuck_transition;[apply pre_callback_free|exact IN|].
 apply pre_or_call_not_stuck;exact CLASS.
Qed.
Print Assumptions pre_all_successors.
Print Assumptions pre_progress.

Variable root:float32.
Variable leaf_mem final_mem:mem.
Hypothesis max_post_deref:Cexec.do_deref_loc ge quiet_world tfloat leaf_mem bmax Ptrofs.zero Full=
 Some(quiet_world,E0,Vsingle maximum).
Hypothesis factor_store:Cexec.do_assign_loc ge quiet_world tfloat leaf_mem bfactor Ptrofs.zero Full
 (Vsingle(Float32.div maximum root))=
 Some(quiet_world,E0,final_mem,Vsingle(Float32.div maximum root)).
Hypothesis leaf_normal:normal_state(Callstate(Internal leaf)[Vsingle norm]Kstop m)=true.
Hypothesis leaf_names:call_names(Callstate(Internal leaf)[Vsingle norm]Kstop m).
Hypothesis leaf_witness:star Csem.step ge(Callstate(Internal leaf)[Vsingle norm]Kstop m)E0
 (Returnstate(Vsingle root)Kstop leaf_mem).

Definition post_expr(lr:bool)(ms:read_stage):expr :=
 factor_context(lhs_res ifactor bfactor lr)
 (read_res imax tfloat bmax(Vsingle maximum)ms)(Eval(Vsingle root)tfloat).
Lemma post_atomic:forall lr ms,
 atomic_expr(post_expr lr ms)=true /\
 atomic_eval ge e leaf_mem(post_expr lr ms)=
 Some(Vsingle(Float32.div maximum root),final_mem).
Proof.
 intros lr ms;destruct lr,ms;split;try reflexivity;
 cbn[post_expr factor_context lhs_res read_res atomic_eval pure_lval pure_rval typeof];
 rewrite ?factor_local,?max_global,?max_symbol;
 rewrite ?dec_eq_true;rewrite ?max_post_deref;
 cbn[sem_binary_operation sem_div sem_binarith classify_binarith sem_cast classify_cast commit];
 change(match Cexec.do_assign_loc ge quiet_world tfloat leaf_mem bfactor Ptrofs.zero Full(Vsingle(Float32.div maximum root))with
 |Some(_,_,mm,vv)=>Some(vv,mm)|None=>None end=Some(Vsingle(Float32.div maximum root),final_mem));
 rewrite factor_store;reflexivity.
Qed.
Lemma post_certificate:forall lr ms,
 block_context_invariant ge k caller e final_mem
 (ExprState caller(post_expr lr ms)(Kdo k)e leaf_mem).
Proof.
 intros lr ms;exists(ExprState caller(post_expr lr ms)(Kdo Kstop)e leaf_mem).
 split;[reflexivity|];split.
 - split.
   + cbn[block_state];rewrite(proj1(post_atomic lr ms));reflexivity.
   + cbn[block_denotation];rewrite(proj2(post_atomic lr ms));reflexivity.
 - split;reflexivity.
Qed.
Lemma leaf_certificate:forall lr ms,
 callee_invariant ge(leaf_frame lr ms)(Vsingle root)leaf_mem
 (Callstate(Internal leaf)[Vsingle norm](leaf_frame lr ms)m).
Proof.
 intros lr ms;exact(callee_invariant_entry ge(leaf_frame lr ms)
 (Callstate(Internal leaf)[Vsingle norm]Kstop m)E0(Vsingle root)leaf_mem
 leaf_normal leaf_names leaf_witness).
Qed.
Lemma do_step_unique:forall ge f a k e m t next,
 Csem.step ge(State f(Sdo a)k e m)t next ->
 t=E0 /\ next=ExprState f a(Kdo k)e m.
Proof.
 intros ge0 f a k0 e0 m0 t next[ES|SS];[inversion ES|].
 inversion SS;subst;auto;
 repeat match goal with H:_\/_ |- _=>destruct H end;discriminate.
Qed.
Lemma return_call_step_unique:forall ge v f e C ty k m t next,
 Csem.step ge(Returnstate v(Kcall f e C ty k)m)t next ->
 t=E0 /\ next=ExprState f(C(Eval v ty))k e m.
Proof. intros ge0 v f e0 C ty k0 m0 t next[ES|SS];[inversion ES|inversion SS;subst;auto]. Qed.
Definition factor_invariant(s:Csem.state):Prop :=
 (s=State caller(Sdo(pre_expr false Rvar Rvar Rvar))k e m) \/
 (exists lr ms rs ns,s=pre_state lr ms rs ns) \/
 (exists lr ms,callee_invariant ge(leaf_frame lr ms)(Vsingle root)leaf_mem s) \/
 block_context_invariant ge k caller e final_mem s.

Theorem factor_all_successors:forall s t next,
 factor_invariant s ->s<>State caller Sskip k e final_mem ->
 Csem.step ge s t next ->factor_invariant next.
Proof.
 intros s t next[START|[PRE|[CALLEE|POST]]]NF STEP.
 - subst s;destruct(do_step_unique _ _ _ _ _ _ _ _ STEP)as[TT EQ];subst next.
   right;left;exists false,Rvar,Rvar,Rvar;reflexivity.
 - destruct PRE as[lr[ms[rs[ns EQ]]]];subst s.
   destruct(pre_all_successors lr ms rs ns t next STEP)as[TT[PRE|CALL]].
   + right;left;exact PRE.
   + destruct CALL as[lr'[ms' EQ]];subst next.
     right;right;left;exists lr',ms';apply leaf_certificate.
 - destruct CALLEE as[lr[ms CERT]].
   destruct(classic(s=Returnstate(Vsingle root)(leaf_frame lr ms)leaf_mem))as[RET|NR].
   + subst s;destruct(return_call_step_unique _ _ _ _ _ _ _ _ _ _ STEP)as[TT EQ];subst next.
     right;right;right;apply post_certificate.
   + right;right;left;exists lr,ms.
     eapply callee_invariant_all_successors;[exact I|exact CERT|exact NR|exact STEP].
 - right;right;right;eapply block_context_all_successors;eauto.
Qed.
Theorem factor_progress:forall s,
 factor_invariant s ->
 s=State caller Sskip k e final_mem \/
 exists t next,Csem.step ge s t next /\ factor_invariant next.
Proof.
 intros s[START|[PRE|[CALLEE|POST]]].
 - subst s;right;exists E0,(pre_state false Rvar Rvar Rvar);split.
   + right;apply step_do_1.
   + right;left;exists false,Rvar,Rvar,Rvar;reflexivity.
 - destruct PRE as[lr[ms[rs[ns EQ]]]];subst s.
   destruct(pre_progress lr ms rs ns)as[t[next[STEP CLASS]]].
   right;exists t,next;split;auto.
   destruct CLASS as[PRE|[lr'[ms' EQ]]].
   + right;left;exact PRE.
   + subst next;right;right;left;exists lr',ms';apply leaf_certificate.
 - destruct CALLEE as[lr[ms CERT]].
   destruct(callee_invariant_progress ge(leaf_frame lr ms)(Vsingle root)leaf_mem s I CERT)
    as[RET|[t[next[STEP CERT']]]].
   + subst s;right;exists E0,(ExprState caller(post_expr lr ms)(Kdo k)e leaf_mem);split.
     * right;apply step_returnstate.
     * right;right;right;apply post_certificate.
   + right;exists t,next;split;auto;right;right;left;eauto.
 - destruct(block_context_progress ge k caller e final_mem s POST)as[DONE|[t[next[STEP CERT]]]].
   + auto.
   + right;exists t,next;split;auto;right;right;right;exact CERT.
Qed.
Print Assumptions factor_all_successors.
Print Assumptions factor_progress.
End FACTOR.
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Errors Maps Integers Floats AST Values Memory Events Globalenvs Ctypes Cop Csyntax Csyntaxdefs Csem Cstrategy Smallstep.
From FivePaparazziState Require Import State MemorySupport.
From FiveGuidanceEntry Require Import Entry BigstepSupport.
Require FiveGhSpeed.Source FiveGhSpeed.Execution.
Import ListNotations.
Local Open Scope Z_scope.
Module S:=FiveGhSpeed.Source.
Definition ge:=FiveGhSpeed.Execution.ge.
Definition vt:=Tstruct S._FloatVect2 noattr.
Definition it:=Tstruct S._Int64Vect2 noattr.
Definition gt:=Tstruct S._GuidanceHRef noattr.
Definition local_field (id coord : ident) (ty ft : type) : expr :=
 Efield (Evalof (Evar id ty) ty) coord ft.
Definition global_field (id : ident) (ty : type) : expr :=
 Efield (Evalof (Evar S._gh_ref gt) gt) id ty.
Definition global_vector_field (id coord : ident) (ty ft : type) : expr :=
 Efield (Evalof (global_field id ty) ty) coord ft.
Lemma local_vector_location : forall e m id b coord ofs,
 e!id=Some(b,vt) -> (coord=S._x /\ ofs=0 \/ coord=S._y /\ ofs=4) ->
 Cstrategy.eval_simple_lvalue ge e m (local_field id coord vt tfloat) b (Ptrofs.repr ofs) Full.
Proof.
 intros e m id b coord ofs LOOK [[-> ->]|[-> ->]];
 unfold local_field,vt;
 rewrite <- Ptrofs.add_zero_l at 1.
 all: eapply Cstrategy.esl_field_struct;
 [eapply Cstrategy.esr_rvalof;[apply Cstrategy.esl_var_local;exact LOOK|reflexivity|reflexivity|apply deref_loc_copy;reflexivity]|
 reflexivity|reflexivity|reflexivity].
Qed.
Lemma global_scalar_location : forall e m b id ofs ty,
 e!S._gh_ref=None -> Genv.find_symbol ge S._gh_ref=Some b ->
 (id=S._dt /\ ofs=60 /\ ty=tfloat \/ id=S._inv_tau /\ ofs=56 /\ ty=tfloat) ->
 Cstrategy.eval_simple_lvalue ge e m (global_field id ty) b (Ptrofs.repr ofs) Full.
Proof.
 intros e m b id ofs ty ENV SYM OFF;
 destruct OFF as [[-> [-> ->]]|[-> [-> ->]]]; unfold global_field,gt.
 all: rewrite <- Ptrofs.add_zero_l at 1.
 all: eapply Cstrategy.esl_field_struct;
 [eapply Cstrategy.esr_rvalof;[eapply Cstrategy.esl_var_global;[exact ENV|exact SYM]|reflexivity|reflexivity|apply deref_loc_copy;reflexivity]|
 reflexivity|reflexivity|reflexivity].
Qed.
Lemma global_aggregate_location : forall e m b id ofs ty,
 e!S._gh_ref=None -> Genv.find_symbol ge S._gh_ref=Some b ->
 (id=S._accel /\ ofs=0 /\ ty=vt \/
 id=S._speed /\ ofs=8 /\ ty=vt \/ id=S._pos /\ ofs=16 /\ ty=it) ->
 Cstrategy.eval_simple_lvalue ge e m (global_field id ty) b (Ptrofs.repr ofs) Full.
Proof.
 intros e m b id ofs ty ENV SYM OFF;
 destruct OFF as [[-> [-> ->]]|[[-> [-> ->]]|[-> [-> ->]]]]; unfold global_field,gt;
 rewrite <- Ptrofs.add_zero_l at 1.
 all: eapply Cstrategy.esl_field_struct;
 [eapply Cstrategy.esr_rvalof;[eapply Cstrategy.esl_var_global;[exact ENV|exact SYM]|reflexivity|reflexivity|apply deref_loc_copy;reflexivity]|
 reflexivity|reflexivity|reflexivity].
Qed.
Lemma global_vector_location : forall e m b id coord ofs,
 e!S._gh_ref=None -> Genv.find_symbol ge S._gh_ref=Some b ->
 (id=S._accel /\ coord=S._x /\ ofs=0 \/
  id=S._accel /\ coord=S._y /\ ofs=4 \/
  id=S._speed /\ coord=S._x /\ ofs=8 \/
  id=S._speed /\ coord=S._y /\ ofs=12) ->
 Cstrategy.eval_simple_lvalue ge e m (global_vector_field id coord vt tfloat) b (Ptrofs.repr ofs) Full.
Proof.
 intros e m b id coord ofs ENV SYM OFF;
 destruct OFF as [[-> [-> ->]]|[[-> [-> ->]]|[[-> [-> ->]]|[-> [-> ->]]]]];
 unfold global_vector_field;
 first [change (Cstrategy.eval_simple_lvalue ge e m
 (Efield (Evalof (global_field S._accel vt) vt) S._x tfloat) b
 (Ptrofs.add (Ptrofs.repr 0) (Ptrofs.repr 0)) Full)|
 change (Cstrategy.eval_simple_lvalue ge e m
 (Efield (Evalof (global_field S._accel vt) vt) S._y tfloat) b
 (Ptrofs.add (Ptrofs.repr 0) (Ptrofs.repr 4)) Full)|
 change (Cstrategy.eval_simple_lvalue ge e m
 (Efield (Evalof (global_field S._speed vt) vt) S._x tfloat) b
 (Ptrofs.add (Ptrofs.repr 8) (Ptrofs.repr 0)) Full)|
 change (Cstrategy.eval_simple_lvalue ge e m
 (Efield (Evalof (global_field S._speed vt) vt) S._y tfloat) b
 (Ptrofs.add (Ptrofs.repr 8) (Ptrofs.repr 4)) Full)].
 all: eapply Cstrategy.esl_field_struct;
 [eapply Cstrategy.esr_rvalof;
 [eapply global_aggregate_location;[exact ENV|exact SYM|intuition congruence]|
 reflexivity|reflexivity|apply deref_loc_copy;reflexivity]|
 reflexivity|reflexivity|reflexivity].
Qed.
Lemma read_at_single : forall e m l b ofs x,
 Cstrategy.eval_simple_lvalue ge e m l b (Ptrofs.repr ofs) Full ->
 typeof l=tfloat -> 0<=ofs<=Ptrofs.max_unsigned-4 ->
 Mem.load Mfloat32 m b ofs=Some(Vsingle x) ->
 Cstrategy.eval_simple_rvalue ge e m (Evalof l tfloat) (Vsingle x).
Proof.
 intros e m l b ofs x LOC TY RNG LOAD.
 eapply read_scalar;[exact LOC|symmetry;exact TY|reflexivity|reflexivity|].
 change (0<=ofs<=18446744073709551611) in RNG.
 unfold Mem.loadv;rewrite Ptrofs.unsigned_repr by (change(0<=ofs<=18446744073709551615);lia).
 rewrite zle_true by (change(ofs+4<=18446744073709551616);lia);exact LOAD.
Qed.
Lemma write_at_single : forall e m l r b ofs x mf,
 Cstrategy.eval_simple_lvalue ge e m l b (Ptrofs.repr ofs) Full ->
 typeof l=tfloat -> source_simple l=true -> typeof r=tfloat ->
 source_simple r=true -> Cstrategy.eval_simple_rvalue ge e m r (Vsingle x) ->
 0<=ofs<=Ptrofs.max_unsigned-4 -> Mem.store Mfloat32 m b ofs(Vsingle x)=Some mf ->
 Cstrategy.exec_stmt ge e m (Sdo(Eassign l r tfloat)) E0 mf Out_normal.
Proof.
 intros e m l r b ofs x mf LOC TL SL TR SR RV RNG STORE.
 eapply atomic_assign with (vc:=Vsingle x)(v':=Vsingle x);
 [exact LOC|exact SL|exact RV|exact SR|rewrite TL,TR;reflexivity| |symmetry;exact TL].
 rewrite TL;eapply assign_scalar;[reflexivity|reflexivity|].
 change (0<=ofs<=18446744073709551611) in RNG.
 unfold Mem.storev;rewrite Ptrofs.unsigned_repr by (change(0<=ofs<=18446744073709551615);lia).
 rewrite zle_true by (change(ofs+4<=18446744073709551616);lia);exact STORE.
Qed.
Print Assumptions global_vector_location.
Print Assumptions write_at_single.
Definition f_read (l:expr) : expr := Evalof l tfloat.
Definition smul_component (local global coord:ident) : statement :=
 Sdo(Eassign (local_field local coord vt tfloat)
 (Ebinop Omul (f_read(global_vector_field global coord vt tfloat))
 (f_read(global_field S._dt tfloat)) tfloat) tfloat).
Definition source_pos_step : statement :=
 Ssequence (smul_component S._pos_step S._speed S._x)
           (smul_component S._pos_step S._speed S._y).
Lemma source_pos_step_shape :
 match fn_body S.f_gh_update_ref_from_speed_sp with
 |Ssequence a _=>a|_=>Sskip end=source_pos_step.
Proof. reflexivity. Qed.
Lemma read_speed_component : forall s e m bg coord ofs x,
 e!S._gh_ref=None -> Genv.find_symbol ge S._gh_ref=Some bg -> repr s m bg ->
 (coord=S._x /\ ofs=8 /\ x=speed_x s \/ coord=S._y /\ ofs=12 /\ x=speed_y s) ->
 Cstrategy.eval_simple_rvalue ge e m (f_read(global_vector_field S._speed coord vt tfloat))(Vsingle x).
Proof.
 intros s e m bg coord ofs x ENV SYM REP OFF.
 eapply read_at_single with (b:=bg)(ofs:=ofs).
 - eapply global_vector_location;[exact ENV|exact SYM|destruct OFF as [[-> [-> ->]]|[-> [-> ->]]];intuition congruence].
 - reflexivity.
 - destruct OFF as [[-> [-> ->]]|[-> [-> ->]]];vm_compute;intuition discriminate.
 - unfold repr in REP;destruct OFF as [[-> [-> ->]]|[-> [-> ->]]];tauto.
Qed.
Lemma read_dt : forall s e m bg,
 e!S._gh_ref=None -> Genv.find_symbol ge S._gh_ref=Some bg -> repr s m bg ->
 Cstrategy.eval_simple_rvalue ge e m (f_read(global_field S._dt tfloat))(Vsingle(dt s)).
Proof.
 intros s e m bg ENV SYM REP.
 eapply read_at_single with (b:=bg)(ofs:=60).
 - eapply global_scalar_location;[exact ENV|exact SYM|intuition congruence].
 - reflexivity.
 - vm_compute;intuition discriminate.
 - unfold repr in REP;tauto.
Qed.
Lemma source_pos_step_exec : forall s e m bg bp,
 e!S._gh_ref=None -> Genv.find_symbol ge S._gh_ref=Some bg ->
 e!S._pos_step=Some(bp,vt) -> bg<>bp -> repr s m bg -> writable m bg ->
 Mem.valid_access m Mfloat32 bp 0 Writable ->
 Mem.valid_access m Mfloat32 bp 4 Writable ->
 exists mf,
 Cstrategy.exec_stmt ge e m source_pos_step E0 mf Out_normal /\
 repr s mf bg /\ writable mf bg /\
 Mem.load Mfloat32 mf bp 0=Some(Vsingle(Float32.mul(speed_x s)(dt s))) /\
 Mem.load Mfloat32 mf bp 4=Some(Vsingle(Float32.mul(speed_y s)(dt s))) /\
 (exists m1, Mem.store Mfloat32 m bp 0 (Vsingle(Float32.mul(speed_x s)(dt s)))=Some m1 /\
 Mem.store Mfloat32 m1 bp 4 (Vsingle(Float32.mul(speed_y s)(dt s)))=Some mf).
Proof.
 intros s e m bg bp ENV SYM LOOK DIFF REP WR A0 A4.
 destruct(Mem.valid_access_store m Mfloat32 bp 0
 (Vsingle(Float32.mul(speed_x s)(dt s))) A0)as[m1 SX].
 assert(REP1:repr s m1 bg)by(eapply repr_store_other;eauto).
 assert(WR1:writable m1 bg)by(eapply writable_store_other;eauto).
 assert(A41:Mem.valid_access m1 Mfloat32 bp 4 Writable)by(eapply Mem.store_valid_access_1;eauto).
 destruct(Mem.valid_access_store m1 Mfloat32 bp 4
 (Vsingle(Float32.mul(speed_y s)(dt s))) A41)as[m2 SY].
 exists m2;split.
 - unfold source_pos_step;eapply sequence_normal.
   + unfold smul_component;eapply write_at_single with(b:=bp)(ofs:=0).
     * eapply local_vector_location;[exact LOOK|intuition congruence].
     * reflexivity.
     * reflexivity.
     * reflexivity.
     * reflexivity.
     * eapply Cstrategy.esr_binop.
       -- eapply read_speed_component;[exact ENV|exact SYM|exact REP|intuition congruence].
       -- eapply read_dt;eauto.
       -- reflexivity.
     * vm_compute;intuition discriminate.
     * exact SX.
   + unfold smul_component;eapply write_at_single with(b:=bp)(ofs:=4).
     * eapply local_vector_location;[exact LOOK|intuition congruence].
     * reflexivity.
     * reflexivity.
     * reflexivity.
     * reflexivity.
     * eapply Cstrategy.esr_binop.
       -- eapply read_speed_component;[exact ENV|exact SYM|exact REP1|intuition congruence].
       -- eapply read_dt;eauto.
       -- reflexivity.
     * vm_compute;intuition discriminate.
     * exact SY.
 - split;[eapply repr_store_other;eauto|].
   split;[eapply writable_store_other;eauto|].
   split.
   + erewrite Mem.load_store_other by(exact SY||(right;cbn;lia)).
     erewrite Mem.load_store_same by exact SX;reflexivity.
   + split;[erewrite Mem.load_store_same by exact SY;reflexivity|exists m1;auto].
Qed.
Print Assumptions source_pos_step_exec.

