Ltac prior_store_access :=
 first [assumption|
 match goal with |-Mem.valid_access ?mf _ _ _ _=>
 match goal with H:Mem.store _ _ _ _ _=Some mf|-_=>
 eapply Mem.store_valid_access_1;[exact H|prior_store_access]end end].
Ltac prior_store_load :=
 first [assumption|
 match goal with |-Mem.load _ ?mf _ _=Some _=>
 match goal with H:Mem.store _ _ _ _ _=Some mf|-_=>
 first[erewrite Mem.load_store_same by exact H;reflexivity|
 erewrite Mem.load_store_other by(exact H||(left;congruence)||(right;cbn;lia));prior_store_load]end end].
Definition integration_context (tail:statement) : statement :=
 Ssequence source_pos_step(Ssequence source_speed_step
 (Ssequence(pos_conversion S._x)(Ssequence(pos_conversion S._y)
 (Ssequence source_pos_add(Ssequence source_speed_add tail))))).
Definition actual_post_integration : statement :=
 match fn_body S.f_gh_update_ref_from_speed_sp with
 |Ssequence _ (Ssequence _ (Ssequence _ (Ssequence _ (Ssequence _ (Ssequence _ tail)))))=>tail
 |_=>Sskip end.
Lemma integration_context_shape :
 fn_body S.f_gh_update_ref_from_speed_sp=integration_context actual_post_integration.
Proof. reflexivity. Qed.
Ltac run_prefix E :=eapply star_trans with(t1:=E0)(t2:=E0);[eapply statement_prefix_path;exact E| |reflexivity].
Lemma source_integration_exec : forall s e m bg bp bs bu dx dy,
 e!S._gh_ref=None -> Genv.find_symbol ge S._gh_ref=Some bg ->
 e!S._pos_step=Some(bp,vt) -> e!S._speed_step=Some(bs,vt) -> e!S._pos_update=Some(bu,it) ->
 bg<>bp -> bg<>bs -> bg<>bu -> bp<>bs -> bp<>bu -> bs<>bu ->
 repr s m bg -> writable m bg ->
 Mem.valid_access m Mfloat32 bp 0 Writable -> Mem.valid_access m Mfloat32 bp 4 Writable ->
 Mem.valid_access m Mfloat32 bs 0 Writable -> Mem.valid_access m Mfloat32 bs 4 Writable ->
 Mem.valid_access m Mint64 bu 0 Writable -> Mem.valid_access m Mint64 bu 8 Writable ->
 pos_increment(speed_x s)(dt s)=Some dx -> pos_increment(speed_y s)(dt s)=Some dy ->
 exists mf before mx my ms,
 (forall tail out final,
 Cstrategy.exec_stmt ge e mf tail E0 final out ->
 Cstrategy.exec_stmt ge e m(integration_context tail)E0 final out) /\
 (forall f k tail,star Csem.step ge(State f(integration_context tail)k e m)E0(State f tail k e mf)) /\
 repr(integrated s dx dy)mf bg /\ writable mf bg /\ access_preserved m mf /\
 stores_to(fun b=>b=bp \/ b=bs \/ b=bu)m before /\
 Mem.store Mint64 before bg 16(Vlong(Int64.add(pos_x s)dx))=Some mx /\
 Mem.store Mint64 mx bg 24(Vlong(Int64.add(pos_y s)dy))=Some my /\
 Mem.store Mfloat32 my bg 8(Vsingle(Float32.add(speed_x s)(Float32.mul(accel_x s)(dt s))))=Some ms /\
 Mem.store Mfloat32 ms bg 12(Vsingle(Float32.add(speed_y s)(Float32.mul(accel_y s)(dt s))))=Some mf.
Proof.
 intros s e m bg bp bs bu dx dy ENV SYM LP LS LU DGP DGS DGU DPS DPU DSU REP W AP0 AP4 AS0 AS4 AU0 AU8 CX CY.
 destruct(source_pos_step_exec s e m bg bp ENV SYM LP DGP REP W AP0 AP4)
 as[m1[E1[R1[W1[PX1[PY1[p1[SPX SPY]]]]]]]].
 assert(AS01:Mem.valid_access m1 Mfloat32 bs 0 Writable)by prior_store_access.
 assert(AS41:Mem.valid_access m1 Mfloat32 bs 4 Writable)by prior_store_access.
 destruct(source_speed_step_exec s e m1 bg bs ENV SYM LS DGS R1 W1 AS01 AS41)
 as[m2[E2[R2[W2[SX2[SY2[p2[SSX SSY]]]]]]]].
 assert(PX2:Mem.load Mfloat32 m2 bp 0=Some(Vsingle(Float32.mul(speed_x s)(dt s))))by prior_store_load.
 assert(PY2:Mem.load Mfloat32 m2 bp 4=Some(Vsingle(Float32.mul(speed_y s)(dt s))))by prior_store_load.
 assert(AU02:Mem.valid_access m2 Mint64 bu 0 Writable)by prior_store_access.
 assert(AU82:Mem.valid_access m2 Mint64 bu 8 Writable)by prior_store_access.
 unfold pos_increment in CX,CY.
 destruct(source_pos_conversion_exec s e m2 bg bp bu _ _ dx dy LP LU DGU DPU R2 W2 PX2 PY2 CX CY AU02 AU82)
 as[m3[E3[R3[W3[UX3[UY3[p3[SUX SUY]]]]]]]].
 destruct(source_pos_add_exec s e m3 bg bu dx dy ENV SYM LU DGU R3 W3 UX3 UY3)
 as[m4[E4[R4[W4[p4[SGPX SGPY]]]]]].
 assert(SX4:Mem.load Mfloat32 m4 bs 0=Some(Vsingle(Float32.mul(accel_x s)(dt s))))by prior_store_load.
 assert(SY4:Mem.load Mfloat32 m4 bs 4=Some(Vsingle(Float32.mul(accel_y s)(dt s))))by prior_store_load.
 destruct(source_speed_add_exec _ e m4 bg bs _ _ ENV SYM LS DGS R4 W4 SX4 SY4)
 as[m5[E5[R5[W5[p5[SGSX SGSY]]]]]].
 change(repr(integrated s dx dy)m5 bg)in R5.
 assert(HISTORY:stores_to(fun b=>b=bg \/ b=bp \/ b=bs \/ b=bu)m m5).
 { eapply stores_to_step;[right;left;reflexivity|exact SPX|].
   eapply stores_to_step;[right;left;reflexivity|exact SPY|].
   eapply stores_to_step;[right;right;left;reflexivity|exact SSX|].
   eapply stores_to_step;[right;right;left;reflexivity|exact SSY|].
   eapply stores_to_step;[right;right;right;reflexivity|exact SUX|].
   eapply stores_to_step;[right;right;right;reflexivity|exact SUY|].
   eapply stores_to_step;[left;reflexivity|exact SGPX|].
   eapply stores_to_step;[left;reflexivity|exact SGPY|].
   eapply stores_to_step;[left;reflexivity|exact SGSX|].
   eapply stores_to_step;[left;reflexivity|exact SGSY|constructor]. }
 exists m5,m3,p4,m4,p5;split.
 - intros tail out final TAIL;unfold integration_context.
   destruct(sequence_normal_inv ge e _ _ _ _ E3)as[mc[EX EY]].
   eapply sequence_normal;[exact E1|]. eapply sequence_normal;[exact E2|].
   eapply sequence_normal;[exact EX|]. eapply sequence_normal;[exact EY|].
   eapply sequence_normal;[exact E4|]. eapply sequence_normal;[exact E5|exact TAIL].
 - split.
 {   intros f k tail;unfold integration_context.
   destruct(sequence_normal_inv ge e _ _ _ _ E3)as[mc[EX EY]].
   run_prefix E1. run_prefix E2. run_prefix EX. run_prefix EY. run_prefix E4.
   eapply statement_prefix_path;exact E5.
 }
 split;[exact R5|]. split;[exact W5|]. split;[eapply stores_to_access;exact HISTORY|].
   split.
   + eapply stores_to_step;[left;reflexivity|exact SPX|].
     eapply stores_to_step;[left;reflexivity|exact SPY|].
     eapply stores_to_step;[right;left;reflexivity|exact SSX|].
     eapply stores_to_step;[right;left;reflexivity|exact SSY|].
     eapply stores_to_step;[right;right;reflexivity|exact SUX|].
     eapply stores_to_step;[right;right;reflexivity|exact SUY|constructor].
   + repeat split;assumption.
Qed.
Print Assumptions source_integration_exec.
Definition error_component(coord:ident):statement :=
 Sdo(Eassign(local_field S._speed_err coord vt tfloat)
 (Ebinop Osub(f_read(global_vector_field S._speed coord vt tfloat))
 (f_read(local_field S._speed_sp coord vt tfloat))tfloat)tfloat).
Definition raw_component(coord:ident):statement :=
 Sdo(Eassign(local_field S._accel_sp coord vt tfloat)
 (Ebinop Omul(f_read(local_field S._speed_err coord vt tfloat))
 (Eunop Oneg(f_read(global_field S._inv_tau tfloat))tfloat)tfloat)tfloat).
Definition error_pair:=Ssequence(error_component S._x)(error_component S._y).
Definition raw_pair:=Ssequence(raw_component S._x)(raw_component S._y).
Definition raw_context(tail:statement):statement:=Ssequence error_pair(Ssequence raw_pair tail).
Definition actual_saturation_tail:statement:=
 match actual_post_integration with Ssequence _ (Ssequence _ tail)=>tail|_=>Sskip end.
Lemma raw_context_shape:actual_post_integration=raw_context actual_saturation_tail.
Proof. reflexivity. Qed.
Lemma read_local_vector : forall e m id b coord ofs x,
 e!id=Some(b,vt) -> (coord=S._x /\ ofs=0 \/ coord=S._y /\ ofs=4) ->
 Mem.load Mfloat32 m b ofs=Some(Vsingle x) ->
 Cstrategy.eval_simple_rvalue ge e m(f_read(local_field id coord vt tfloat))(Vsingle x).
Proof.
 intros e m id b coord ofs x LOOK OFF LOAD.
 eapply read_at_single with(b:=b)(ofs:=ofs).
 - eapply local_vector_location;eauto.
 - reflexivity.
 - destruct OFF as[[-> ->]|[-> ->]];vm_compute;intuition discriminate.
 - exact LOAD.
Qed.
Lemma read_inv_tau : forall s e m bg,
 e!S._gh_ref=None -> Genv.find_symbol ge S._gh_ref=Some bg -> repr s m bg ->
 Cstrategy.eval_simple_rvalue ge e m(f_read(global_field S._inv_tau tfloat))(Vsingle(inv_tau s)).
Proof.
 intros s e m bg ENV SYM REP.
 eapply read_at_single with(b:=bg)(ofs:=56).
 - eapply global_scalar_location;[exact ENV|exact SYM|intuition congruence].
 - reflexivity.
 - vm_compute;intuition discriminate.
 - unfold repr in REP;tauto.
Qed.
Lemma two_singles_bytes : forall m b,
 Mem.valid_access m Mfloat32 b 0 Writable -> Mem.valid_access m Mfloat32 b 4 Writable ->
 exists bytes,Mem.loadbytes m b 0 8=Some bytes.
Proof.
 intros m b A0 A4;apply Mem.range_perm_loadbytes;intros ofs R.
 destruct(Z_lt_ge_dec ofs 4).
 - eapply Mem.perm_implies;[apply(proj1 A0);cbn;lia|constructor].
 - eapply Mem.perm_implies;[apply(proj1 A4);cbn;lia|constructor].
Qed.
Lemma source_raw_accel_exec : forall s sp e m bg param be ba,
 e!S._gh_ref=None -> Genv.find_symbol ge S._gh_ref=Some bg ->
 e!S._speed_sp=Some(param,vt) ->e!S._speed_err=Some(be,vt) ->e!S._accel_sp=Some(ba,vt) ->
 bg<>be -> bg<>ba ->param<>be ->param<>ba ->be<>ba ->
 repr s m bg ->writable m bg ->
 Mem.load Mfloat32 m param 0=Some(Vsingle(vx sp)) ->Mem.load Mfloat32 m param 4=Some(Vsingle(vy sp)) ->
 Mem.valid_access m Mfloat32 be 0 Writable ->Mem.valid_access m Mfloat32 be 4 Writable ->
 Mem.valid_access m Mfloat32 ba 0 Writable ->Mem.valid_access m Mfloat32 ba 4 Writable ->
 exists mf,
 (forall tail out final,Cstrategy.exec_stmt ge e mf tail E0 final out ->
 Cstrategy.exec_stmt ge e m(raw_context tail)E0 final out) /\
 (forall f k tail,star Csem.step ge(State f(raw_context tail)k e m)E0(State f tail k e mf)) /\
 repr s mf bg /\writable mf bg /\access_preserved m mf /\
 stores_to(fun b=>b=be \/b=ba)m mf /\
 Mem.load Mfloat32 mf ba 0=Some(Vsingle(vx(raw_speed_accel s sp))) /\
 Mem.load Mfloat32 mf ba 4=Some(Vsingle(vy(raw_speed_accel s sp))) /\
 exists bytes,Mem.loadbytes mf ba 0 8=Some bytes.
Proof.
 intros s sp e m bg param be ba ENV SYM LP LE LA DGE DGA DPE DPA DEA REP W LX LY AE0 AE4 AA0 AA4.
 set(ex:=Float32.sub(speed_x s)(vx sp)). set(ey:=Float32.sub(speed_y s)(vy sp)).
 set(ax:=Float32.mul ex(Float32.neg(inv_tau s))). set(ay:=Float32.mul ey(Float32.neg(inv_tau s))).
 destruct(Mem.valid_access_store m Mfloat32 be 0(Vsingle ex) AE0)as[m1 SEX].
 assert(R1:repr s m1 bg)by(eapply (repr_store_other s m bg Mfloat32 be 0 (Vsingle ex) m1);eauto).
 assert(W1:writable m1 bg)by(eapply writable_store_other;eauto).
 assert(AE41:Mem.valid_access m1 Mfloat32 be 4 Writable)by prior_store_access.
 assert(LY1:Mem.load Mfloat32 m1 param 4=Some(Vsingle(vy sp)))by prior_store_load.
 destruct(Mem.valid_access_store m1 Mfloat32 be 4(Vsingle ey) AE41)as[m2 SEY].
 assert(R2:repr s m2 bg)by(eapply (repr_store_other s m1 bg Mfloat32 be 4 (Vsingle ey) m2);eauto).
 assert(W2:writable m2 bg)by(eapply writable_store_other;eauto).
 assert(AA02:Mem.valid_access m2 Mfloat32 ba 0 Writable)by prior_store_access.
 assert(LEX2:Mem.load Mfloat32 m2 be 0=Some(Vsingle ex))by prior_store_load.
 destruct(Mem.valid_access_store m2 Mfloat32 ba 0(Vsingle ax) AA02)as[m3 SAX].
 assert(R3:repr s m3 bg)by(eapply (repr_store_other s m2 bg Mfloat32 ba 0 (Vsingle ax) m3);eauto).
 assert(W3:writable m3 bg)by(eapply writable_store_other;eauto).
 assert(AA43:Mem.valid_access m3 Mfloat32 ba 4 Writable)by prior_store_access.
 assert(LEY3:Mem.load Mfloat32 m3 be 4=Some(Vsingle ey))by prior_store_load.
 destruct(Mem.valid_access_store m3 Mfloat32 ba 4(Vsingle ay) AA43)as[m4 SAY].
 assert(EX:Cstrategy.exec_stmt ge e m(error_component S._x)E0 m1 Out_normal).
 { unfold error_component;eapply write_at_single with(b:=be)(ofs:=0)(x:=ex).
   - eapply local_vector_location;[exact LE|intuition congruence].
   - reflexivity.
   - reflexivity.
   - reflexivity.
   - reflexivity.
   - unfold ex;eapply Cstrategy.esr_binop.
     + eapply read_speed_component;[exact ENV|exact SYM|exact REP|intuition congruence].
     + eapply read_local_vector;[exact LP|intuition congruence|exact LX].
     + reflexivity.
   - vm_compute;intuition discriminate.
   - exact SEX. }
 assert(EY:Cstrategy.exec_stmt ge e m1(error_component S._y)E0 m2 Out_normal).
 { unfold error_component;eapply write_at_single with(b:=be)(ofs:=4)(x:=ey).
   - eapply local_vector_location;[exact LE|intuition congruence].
   - reflexivity.
   - reflexivity.
   - reflexivity.
   - reflexivity.
   - unfold ey;eapply Cstrategy.esr_binop.
     + eapply read_speed_component;[exact ENV|exact SYM|exact R1|intuition congruence].
     + eapply read_local_vector;[exact LP|intuition congruence|exact LY1].
     + reflexivity.
   - vm_compute;intuition discriminate.
   - exact SEY. }
 assert(AX:Cstrategy.exec_stmt ge e m2(raw_component S._x)E0 m3 Out_normal).
 { unfold raw_component;eapply write_at_single with(b:=ba)(ofs:=0)(x:=ax).
   - eapply local_vector_location;[exact LA|intuition congruence].
   - reflexivity.
   - reflexivity.
   - reflexivity.
   - reflexivity.
   - unfold ax;eapply Cstrategy.esr_binop.
     + eapply read_local_vector;[exact LE|intuition congruence|exact LEX2].
     + eapply Cstrategy.esr_unop;[eapply read_inv_tau;[exact ENV|exact SYM|exact R2]|reflexivity].
     + reflexivity.
   - vm_compute;intuition discriminate.
   - exact SAX. }
 assert(AY:Cstrategy.exec_stmt ge e m3(raw_component S._y)E0 m4 Out_normal).
 { unfold raw_component;eapply write_at_single with(b:=ba)(ofs:=4)(x:=ay).
   - eapply local_vector_location;[exact LA|intuition congruence].
   - reflexivity.
   - reflexivity.
   - reflexivity.
   - reflexivity.
   - unfold ay;eapply Cstrategy.esr_binop.
     + eapply read_local_vector;[exact LE|intuition congruence|exact LEY3].
     + eapply Cstrategy.esr_unop;[eapply read_inv_tau;[exact ENV|exact SYM|exact R3]|reflexivity].
     + reflexivity.
   - vm_compute;intuition discriminate.
   - exact SAY. }
 assert(HISTORY:stores_to(fun b=>b=be \/b=ba)m m4).
 { eapply stores_to_step;[left;reflexivity|exact SEX|].
   eapply stores_to_step;[left;reflexivity|exact SEY|].
   eapply stores_to_step;[right;reflexivity|exact SAX|].
   eapply stores_to_step;[right;reflexivity|exact SAY|constructor]. }
 exists m4;split.
 - intros tail out final TAIL;unfold raw_context,error_pair,raw_pair.
   eapply sequence_normal;[eapply sequence_normal;[exact EX|exact EY]|].
   eapply sequence_normal;[eapply sequence_normal;[exact AX|exact AY]|exact TAIL].
 - split.
 {   intros f k tail;unfold raw_context.
   assert(ERR:Cstrategy.exec_stmt ge e m error_pair E0 m2 Out_normal).
   { unfold error_pair;eapply sequence_normal;[exact EX|exact EY]. }
   assert(RAW:Cstrategy.exec_stmt ge e m2 raw_pair E0 m4 Out_normal).
   { unfold raw_pair;eapply sequence_normal;[exact AX|exact AY]. }
   run_prefix ERR. eapply statement_prefix_path;exact RAW.
 }
 split;[eapply repr_store_other;eauto|].
   split;[eapply writable_store_other;eauto|].
   split;[eapply stores_to_access;exact HISTORY|].
   split;[exact HISTORY|]. split.
   + change(Mem.load Mfloat32 m4 ba 0=Some(Vsingle ax));prior_store_load.
   + split.
     * change(Mem.load Mfloat32 m4 ba 4=Some(Vsingle ay));prior_store_load.
     * apply two_singles_bytes;prior_store_access.
Qed.
Print Assumptions source_raw_accel_exec.
Definition saturation_function_type:=Tfunction((tptr vt)::nil)tvoid cc_default.
Definition saturation_call:statement:=Sdo(Ecall
 (Evalof(Evar S._gh_saturate_accel saturation_function_type)saturation_function_type)
 (Econs(Eaddrof(Evar S._accel_sp vt)(tptr vt))Enil)tvoid).
Definition after_saturation:statement:=match actual_saturation_tail with Ssequence _ tail=>tail|_=>Sskip end.
Lemma saturation_tail_shape:actual_saturation_tail=Ssequence saturation_call after_saturation.
Proof. reflexivity. Qed.
Definition saturation_block:block:=
 match Genv.find_symbol ge S._gh_saturate_accel with Some b=>b|None=>1%positive end.
Lemma saturation_symbol:Genv.find_symbol ge S._gh_saturate_accel=Some saturation_block.
Proof. reflexivity. Qed.
Lemma saturation_funct:Genv.find_funct ge(Vptr saturation_block Ptrofs.zero)=Some(Internal S.f_gh_saturate_accel).
Proof. reflexivity. Qed.
Lemma saturation_call_original_path:forall e m ba f k tail,
 e!S._gh_saturate_accel=None ->e!S._accel_sp=Some(ba,vt) ->
 exists kc,star Csem.step ge(State f(Ssequence saturation_call tail)k e m)E0
 (Callstate(Internal S.f_gh_saturate_accel)[Vptr ba Ptrofs.zero]kc m).
Proof.
 intros e m ba f k tail EH LA.
 exists(Kcall f e(fun x=>x)tvoid(Kdo(Kseq tail k))).
 eapply star_step with(t1:=E0)(t2:=E0);[right;apply Csem.step_seq| |reflexivity].
 unfold saturation_call.
 eapply star_step with(t1:=E0)(t2:=E0);[right;apply Csem.step_do_1| |reflexivity].
 apply plus_star;apply Cstrategy.step_simulation;left.
 change(Cstrategy.estep ge
 (ExprState f((fun x=>x)(Ecall
 (Evalof(Evar S._gh_saturate_accel saturation_function_type)saturation_function_type)
 (Econs(Eaddrof(Evar S._accel_sp vt)(tptr vt))Enil)tvoid))(Kdo(Kseq tail k))e m)
 E0(Callstate(Internal S.f_gh_saturate_accel)[Vptr ba Ptrofs.zero]
 (Kcall f e(fun x=>x)tvoid(Kdo(Kseq tail k)))m)).
 eapply Cstrategy.step_call with(vf:=Vptr saturation_block Ptrofs.zero).
 - constructor.
 - reflexivity.
 - eapply Cstrategy.esr_rvalof.
   + eapply Cstrategy.esl_var_global;[exact EH|exact saturation_symbol].
   + reflexivity.
   + reflexivity.
   + apply deref_loc_reference;reflexivity.
 - econstructor.
   + eapply Cstrategy.esr_addrof;apply Cstrategy.esl_var_local;exact LA.
   + reflexivity.
   + constructor.
 - exact saturation_funct.
 - reflexivity.
Qed.
Print Assumptions saturation_call_original_path.
