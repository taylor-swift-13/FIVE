From Stdlib Require Import List ZArith Reals.
From compcert Require Import Integers Floats AST Values Memory Memdata Events Csem Smallstep.
From Flocq Require Import IEEE754.Binary.
Require FiveLowpassUpdate.Execution FiveLowpassUpdateCase.Contract.
From FiveLowpassRoundoffSupport Require Import Recurrence.
Import ListNotations.
Local Open Scope R_scope.
Module U:=FiveLowpassUpdateCase.Contract.
Definition real32(f:float32):R:=B2R 24 128 f.
Definition finite32(f:float32):Prop:=is_finite 24 128 f=true.
Definition delta:R:=1/1048576.
Definition Admissible(c:float32)(x:nat->float32)(y0:float32):Prop:=
 finite32 c /\ 1<=real32 c<=2 /\
 finite32 y0 /\ Rabs(real32 y0)<=1 /\
 forall n,finite32(x n) /\ Rabs(real32(x n))<=1.
Fixpoint actual(c:float32)(x:nat->float32)(y0:float32)(n:nat):float32:=
 match n with O=>y0 | S k=>U.output c (x k)(actual c x y0 k)(x(S k)) end.
Definition ideal(c:float32)(x:nat->float32)(y0:float32)(n:nat):R:=
 reference(real32 c)(fun k=>real32(x k))(real32 y0)n.
Definition NumericInvariant:Prop:=forall c x y0,Admissible c x y0->
 forall n,finite32(actual c x y0 n) /\ Rabs(real32(actual c x y0 n))<=2.
Definition LocalRoundoff:Prop:=forall c x y0,Admissible c x y0->
 forall n,Rabs(real32(actual c x y0(S n))-
 reference_step(real32 c)(real32(x(S n)))(real32(x n))(real32(actual c x y0 n)))<=delta.
Definition ArbitraryHorizon:Prop:=forall c x y0,Admissible c x y0->
 forall n,Rabs(real32(actual c x y0 n)-ideal c x y0 n)<=envelope delta n /\
 Rabs(real32(actual c x y0 n)-ideal c x y0 n)<=1/524288.

Definition Call(b:block)(p:ptrofs)(input:float32)(m:mem)(t:trace)(r:val)(mf:mem):Prop:=
 star Csem.step FiveLowpassUpdate.Execution.ge
 (FiveLowpassUpdate.Execution.entry[Vptr b p;Vsingle input]m)t(Returnstate r Kstop mf).
Inductive Calls(b:block)(p:ptrofs)(x:nat->float32):nat->mem->mem->list val->Prop:=
 | calls_zero:forall m,Calls b p x O m m []
 | calls_succ:forall n m0 m1 m2 rs t r,
 Calls b p x n m0 m1 rs ->
 Call b p (x(S n)) m1 t r m2 ->
 Calls b p x (S n) m0 m2(rs++[r]).
Definition Returns(c:float32)(x:nat->float32)(y0:float32)(n:nat):list val:=
 map(fun k=>Vsingle(actual c x y0(S k)))(seq O n).
Definition Observed(c:float32)(x:nat->float32)(y0:float32)(n:nat)
 (b:block)(p:ptrofs)(m0 mf:mem):Prop:=
 U.Initialized mf b p c (x n)(actual c x y0 n) /\
 Mem.loadbytes mf b(Ptrofs.unsigned p)4=Mem.loadbytes m0 b(Ptrofs.unsigned p)4 /\
 U.Frame m0 mf b p /\
 ((0<n)%nat->
 Mem.loadbytes mf b(Ptrofs.unsigned p+4)4=Some(encode_val Mfloat32(Vsingle(x n))) /\
 Mem.loadbytes mf b(Ptrofs.unsigned p+8)4=Some(encode_val Mfloat32(Vsingle(actual c x y0 n)))).
Definition ExecutionExists:Prop:=forall c x y0 m b p,
 Admissible c x y0->U.Initialized m b p c(x O)y0->
 forall n,exists mf,Calls b p x n m mf(Returns c x y0 n) /\
 Observed c x y0 n b p m mf.
Definition EveryExecution:Prop:=forall c x y0 m b p,
 Admissible c x y0->U.Initialized m b p c(x O)y0->
 forall n mf rs,Calls b p x n m mf rs->
 rs=Returns c x y0 n /\ Observed c x y0 n b p m mf /\
 Rabs(real32(actual c x y0 n)-ideal c x y0 n)<=envelope delta n /\
 finite32(actual c x y0 n) /\ Rabs(real32(actual c x y0 n))<=2.
Definition Nonvacuity:Prop:=
 (exists c x y0,Admissible c x y0) /\
 (forall c x y0,Admissible c x y0->exists m b p,U.Initialized m b p c(x O)y0).
From Stdlib Require Import List ZArith Reals Psatz.
From compcert Require Import Integers Floats Values Memory.
From FiveLowpassRoundoff Require Import Spec.
From FiveLowpassRoundoffSupport Require Import Recurrence Cycles Numerical.
Require FiveLowpassUpdateCase.Witness.
Local Open Scope R_scope.
Module Spec:=FiveLowpassRoundoff.Spec.
Module N:=FiveLowpassRoundoffSupport.Numerical.

Lemma original_step:forall c li lo x,U.output c li lo x=N.step c li lo x.
Proof. reflexivity. Qed.
Theorem numeric_invariant:Spec.NumericInvariant.
Proof.
 unfold Spec.NumericInvariant;intros c x y0 [FC[HC[FY[HY HX]]]] n.
 induction n as[|n[FN HN]].
 - cbn[Spec.actual];split;[exact FY|lra].
 - destruct(HX n)as[FL HL];destruct(HX(S n))as[FX HV].
   cbn[Spec.actual];rewrite original_step.
   pose proof(N.step_bound_local c (x n)(Spec.actual c x y0 n)(x(S n))
     FC HC FL HL FN HN FX HV)as[F[B E]];split;assumption.
Qed.
Theorem local_roundoff:Spec.LocalRoundoff.
Proof.
 unfold Spec.LocalRoundoff;intros c x y0 A n.
 pose proof(numeric_invariant c x y0 A n)as[FY HY].
 destruct A as[FC[HC[F0[H0 HX]]]].
 destruct(HX n)as[FL HL];destruct(HX(S n))as[FX HV].
 cbn[Spec.actual];rewrite original_step.
 pose proof(N.step_bound_local c (x n)(Spec.actual c x y0 n)(x(S n))
     FC HC FL HL FY HY FX HV)as[F[B E]];exact E.
Qed.
Theorem arbitrary_horizon:Spec.ArbitraryHorizon.
Proof.
 unfold Spec.ArbitraryHorizon;intros c x y0 A n.
 assert(E:Rabs(Spec.real32(Spec.actual c x y0 n)-Spec.ideal c x y0 n)<=envelope Spec.delta n).
 { unfold Spec.ideal;apply (arbitrary_horizon_roundoff (Spec.real32 c)(fun k=>Spec.real32(x k))(Spec.real32 y0)(fun k=>Spec.real32(Spec.actual c x y0 k)) Spec.delta).
   - exact(proj1(proj2 A)).
   - unfold Spec.delta;lra.
   - reflexivity.
   - exact(local_roundoff c x y0 A). }
 split;[exact E|].
 pose proof(envelope_bounds Spec.delta n ltac:(unfold Spec.delta;lra))as[LOW HIGH].
 unfold Spec.delta in *;lra.
Qed.
Theorem execution_exists:Spec.ExecutionExists.
Proof.
 unfold Spec.ExecutionExists;intros c x y0 m b p A INIT n.
 destruct(repeated_exists c x y0 m b p INIT n)as[mf[RUN[OBS VALID]]].
 exists mf;auto.
Qed.
Theorem every_execution:Spec.EveryExecution.
Proof.
 unfold Spec.EveryExecution;intros c x y0 m b p A INIT n mf rs RUN.
 destruct(calls_observed b p x n m mf rs RUN c y0 INIT)as[RET[OBS VALID]].
 pose proof(arbitrary_horizon c x y0 A n)as[E UNIFORM].
 pose proof(numeric_invariant c x y0 A n)as[F B].
 split;[exact RET|];split;[exact OBS|];split;[exact E|];split;assumption.
Qed.
Theorem nonvacuity:Spec.Nonvacuity.
Proof.
 unfold Spec.Nonvacuity;split.
 - exists N.one,(fun _=>Float32.zero),Float32.zero.
   unfold Spec.Admissible;split;[exact N.one_finite|].
   split;[change(1<=N.r32 N.one<=2);rewrite N.one_real;lra|].
   assert(F:Spec.finite32 Float32.zero)by reflexivity.
   assert(R:Spec.real32 Float32.zero=0)by reflexivity.
   split;[exact F|];split;[rewrite R,Rabs_R0;lra|].
   intros n;split;[exact F|rewrite R,Rabs_R0;lra].
 - intros c x y0 A.
   destruct(FiveLowpassUpdateCase.Witness.initialized_inhabited c(x O)y0)as[m[b INIT]].
   exists m,b,Ptrofs.zero;exact INIT.
Qed.
Print Assumptions numeric_invariant.
Print Assumptions local_roundoff.
Print Assumptions arbitrary_horizon.
Print Assumptions execution_exists.
Print Assumptions every_execution.
Print Assumptions nonvacuity.

Example nonzero_roundoff_example_bits:
 Float32.to_bits(U.output
 (Float32.of_bits(Int.repr 1073741824)) Float32.zero Float32.zero N.one)
 =Int.repr 1051372203.
Proof. vm_compute;reflexivity. Qed.
