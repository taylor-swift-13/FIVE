1835:Theorem loadbytes_alloc_unchanged:
1836-  forall b' ofs n,
1837-  valid_block m1 b' ->
1838-  loadbytes m2 b' ofs n = loadbytes m1 b' ofs n.
1839-Proof.
1840-  intros. unfold loadbytes.
1841-  destruct (range_perm_dec m1 b' ofs (ofs + n) Cur Readable).
1842-  rewrite pred_dec_true.
1843-  injection ALLOC; intros A B. rewrite <- B; simpl.
1844-  rewrite PMap.gso. auto. rewrite A. eauto with mem.
1845-  red; intros. eapply perm_alloc_1; eauto.
1846-  rewrite pred_dec_false; auto.
1847-  red; intros; elim n0. red; intros. eapply perm_alloc_4; eauto. eauto with mem.
1848-Qed.
