1850:Theorem loadbytes_alloc_same:
1851-  forall n ofs bytes byte,
1852-  loadbytes m2 b ofs n = Some bytes ->
1853-  In byte bytes -> byte = Undef.
1854-Proof.
1855-  unfold loadbytes; intros. destruct (range_perm_dec m2 b ofs (ofs + n) Cur Readable); inv H.
1856-  revert H0.
1857-  injection ALLOC; intros A B. rewrite <- A; rewrite <- B; simpl. rewrite PMap.gss.
1858-  generalize (Z.to_nat n) ofs. induction n0; simpl; intros.
1859-  contradiction.
1860-  rewrite ZMap.gi in H0. destruct H0; eauto.
1861-Qed.
