From Stdlib Require Import List ZArith.
From compcert Require Import Integers Floats AST Values Memory Memdata Events Csem Smallstep.
Require FiveLowpassReset.Execution FiveLowpassGet.Execution FiveLowpassGetCase.Contract.
From FiveLowpassSupport Require Import LowpassMemory.
Import ListNotations.
Local Open Scope Z_scope.
Definition Reset(m:mem)(b:block)(p:ptrofs)(value:float32)(t:trace)(result:val)(mr:mem):Prop:=
 star Csem.step FiveLowpassReset.Execution.ge(FiveLowpassReset.Execution.entry[Vptr b p;Vsingle value]m)t(Returnstate result Kstop mr).
Definition Get(mr:mem)(b:block)(p:ptrofs)(t:trace)(result:val)(mf:mem):Prop:=
 star Csem.step FiveLowpassGet.Execution.ge(FiveLowpassGet.Execution.entry[Vptr b p]mr)t(Returnstate result Kstop mf).
Definition Bits(v:val):option int:=match v with Vsingle f=>Some(Float32.to_bits f)|_=>None end.
Definition Observations(m mr mf:mem)(b:block)(p:ptrofs):Prop:=
 Mem.loadbytes mr b(Ptrofs.unsigned p)4=Mem.loadbytes m b(Ptrofs.unsigned p)4 /\
 Mem.loadbytes mf b(Ptrofs.unsigned p)4=Mem.loadbytes m b(Ptrofs.unsigned p)4 /\
 FiveLowpassGetCase.Contract.Frame mr mf /\
 (forall q z n,Mem.valid_block m q->
 q<>b \/ z+n<=Ptrofs.unsigned p+4 \/ Ptrofs.unsigned p+12<=z->
 Mem.loadbytes mr q z n=Mem.loadbytes m q z n).
Definition NormalCompletion:Prop:=forall m b p(value:float32),writable12 m b p->
 exists tr mr tg mf,Reset m b p value tr(Vsingle value)mr /\Get mr b p tg(Vsingle value)mf /\Observations m mr mf b p.
Definition AllReturns:Prop:=forall m b p(value:float32),writable12 m b p->
 forall tr rr mr tg rg mf,Reset m b p value tr rr mr->Get mr b p tg rg mf->
 rr=Vsingle value /\rg=Vsingle value /\rr=rg /\
 Bits rr=Some(Float32.to_bits value) /\Bits rg=Some(Float32.to_bits value) /\Observations m mr mf b p.
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Integers Floats AST Values Memory Memdata Csem Smallstep.
From FiveLowpassReadback Require Import Spec.
From FiveLowpassSupport Require Import LowpassMemory FieldBytes.
Require FiveLowpassResetFunctional.Proof FiveLowpassGetFunctional.Proof FiveLowpassGetCase.Contract.
Module Spec:=FiveLowpassReadback.Spec.
Import ListNotations.
Local Open Scope Z_scope.
Lemma reset_establishes_readable:forall m b p value,
 writable12 m b p->
 Mem.loadbytes m b(Ptrofs.unsigned p+4)8=Some(encode_val Mfloat32(Vsingle value)++encode_val Mfloat32(Vsingle value))->
 FiveLowpassGetCase.Contract.ReadableOut m b p value.
Proof.
 intros m b p value P BYTES;destruct(encoded_two m b(Ptrofs.unsigned p+4)value value BYTES)as[L4 L8].
 replace(Ptrofs.unsigned p+4+4)with(Ptrofs.unsigned p+8)in L8 by lia.
 destruct P as[AL[NW RP]];repeat split;auto.
 apply encoded_load;[destruct AL as[k K];exists(k+2);lia|exact L8].
Qed.
Lemma observations:forall m mr mf b p,
 writable12 m b p->writable12 mr b p->
 (forall q z n,Mem.valid_block m q->q<>b \/z+n<=Ptrofs.unsigned p+4\/Ptrofs.unsigned p+12<=z->Mem.loadbytes mr q z n=Mem.loadbytes m q z n)->
 FiveLowpassGetCase.Contract.Frame mr mf->Spec.Observations m mr mf b p.
Proof.
 intros m mr mf b p P PR RESET GET.
 assert(VM:Mem.valid_block m b)by(eapply Mem.valid_access_valid_block;eapply Mem.valid_access_implies;[apply(field_access m b p 8 P ltac:(simpl;auto))|constructor]).
 assert(VR:Mem.valid_block mr b)by(eapply Mem.valid_access_valid_block;eapply Mem.valid_access_implies;[apply(field_access mr b p 8 PR ltac:(simpl;auto))|constructor]).
 assert(TC:Mem.loadbytes mr b(Ptrofs.unsigned p)4=Mem.loadbytes m b(Ptrofs.unsigned p)4)by(apply RESET;[exact VM|right;left;lia]).
 unfold Spec.Observations;split;[exact TC|]. split;[rewrite GET by exact VR;exact TC|]. split;assumption.
Qed.
Theorem normal_completion:Spec.NormalCompletion.
Proof.
 unfold Spec.NormalCompletion;intros m b p value P.
 destruct(FiveLowpassResetFunctional.Proof.normal_completion m b p value P)as[tr[mr[RESET[PR[BYTES FRAME]]]]].
 pose proof(reset_establishes_readable mr b p value PR BYTES)as R.
 destruct(FiveLowpassGetFunctional.Proof.normal_completion mr b p value R)as[tg[mf[GET[READ GF]]]].
 exists tr,mr,tg,mf;split;[exact RESET|]. split;[exact GET|].
 eapply observations;eauto.
Qed.
Theorem all_returns:Spec.AllReturns.
Proof.
 unfold Spec.AllReturns;intros m b p value P tr rr mr tg rg mf RESET GET.
 destruct(FiveLowpassResetFunctional.Proof.all_returns m b p value P tr rr mr RESET)as[RR[PR[BYTES FRAME]]].
 pose proof(reset_establishes_readable mr b p value PR BYTES)as R.
 destruct(FiveLowpassGetFunctional.Proof.all_returns mr b p value R tg rg mf GET)as[RG[READ GF]].
 subst rr rg;split;[reflexivity|]. split;[reflexivity|]. split;[reflexivity|]. split;[reflexivity|]. split;[reflexivity|].
 eapply observations;eauto.
Qed.
Print Assumptions normal_completion.
Print Assumptions all_returns.
From Stdlib Require Import List ZArith.
From compcert Require Import AST Values Memory Events Ctypes Csyntax Csem Cexec Smallstep.
From FiveShared.verification Require Import Obligations.
From FiveLowpassGet Require Import Source Execution.
From FiveGuidanceSemantics Require Import SourceClosure.
From FiveLowpassGetExecutionCorrespondence Require Import Closure.
Import ListNotations.
Definition source_state := Closure.SS.
Definition closed_step := Closure.closed_step.
Definition domain_preservation_goal:Prop := forall args m,
 Execution.entry args m=Callstate(Internal Source.f_get_first_order_low_pass)args Kstop m /\ source_state(Execution.entry args m).
Definition reachable_step_goal:Prop := forall args m t reached tr next,
 star Csem.step Execution.ge(Execution.entry args m)t reached ->
 (closed_step tt reached tr next <-> Csem.step Execution.ge reached tr next).
Definition floating_point_correspondence_goal := reachable_step_goal.
Definition machine_integer_correspondence_goal := reachable_step_goal.
Definition memory_access_correspondence_goal := reachable_step_goal.
Definition control_and_exhaustion_correspondence_goal:Prop := forall args m t final,
 star closed_step tt(Execution.entry args m)t final <->
 star Csem.step Execution.ge(Execution.entry args m)t final.
Definition normal_result_and_memory_correspondence_goal:Prop := forall args m t v mf b ofs n,
 (star closed_step tt(Execution.entry args m)t(Returnstate v Kstop mf) <->
 star Csem.step Execution.ge(Execution.entry args m)t(Returnstate v Kstop mf)) /\
 Execution.observe_bytes mf b ofs n=Mem.loadbytes mf b ofs n.
Definition invalid_operation_correspondence_goal:Prop := forall args m t reached,
 star Csem.step Execution.ge(Execution.entry args m)t reached ->
 (Execution.source_error reached <-> ~Execution.normal_return reached /\ nostep closed_step tt reached).
Definition whole_execution_correspondence_goal := control_and_exhaustion_correspondence_goal.
From FiveLowpassGetExecutionCorrespondence Require Import Spec.
From FiveLowpassGetExecutionCorrespondence Require Import Closure.
Theorem domain_preservation:Spec.domain_preservation_goal.
Proof. intros;split;[reflexivity|apply Closure.entry_source]. Qed.
Lemma reachable_step:Spec.reachable_step_goal.
Proof.
 intros args m t reached tr next PATH.
 apply (Closure.one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world).
 eapply Closure.source_reachable;eauto.
Qed.
Theorem floating_point_correspondence:Spec.floating_point_correspondence_goal.
Proof. exact reachable_step. Qed.
Theorem machine_integer_correspondence:Spec.machine_integer_correspondence_goal.
Proof. exact reachable_step. Qed.
Theorem memory_access_correspondence:Spec.memory_access_correspondence_goal.
Proof. exact reachable_step. Qed.
Theorem control_and_exhaustion_correspondence:Spec.control_and_exhaustion_correspondence_goal.
Proof. exact Closure.whole_execution_correspondence. Qed.
Theorem normal_result_and_memory_correspondence:Spec.normal_result_and_memory_correspondence_goal.
Proof. intros;split;[apply Closure.whole_execution_correspondence|reflexivity]. Qed.
Theorem invalid_operation_correspondence:Spec.invalid_operation_correspondence_goal.
Proof. exact Closure.invalid_operation_correspondence. Qed.
Theorem whole_execution_correspondence:Spec.whole_execution_correspondence_goal.
Proof. exact Closure.whole_execution_correspondence. Qed.
Print Assumptions domain_preservation.
Print Assumptions floating_point_correspondence.
Print Assumptions machine_integer_correspondence.
Print Assumptions memory_access_correspondence.
Print Assumptions control_and_exhaustion_correspondence.
Print Assumptions normal_result_and_memory_correspondence.
Print Assumptions invalid_operation_correspondence.
Print Assumptions whole_execution_correspondence.
