49:Definition state_eval (ge:genv) (S:Csem.state): option (val*mem) :=
50-  match S with
51-  | State f s k e m =>
52-      match stmt_eval ge e (fn_return f) s m with
53-      | Some (out,m') => cont_eval ge e (fn_return f) k out m' | None => None end
54-  | ExprState f a k e m =>
55-      match k with
56-      | Kdo k => match atomic_eval ge e m a with
57-          | Some (_,m') => cont_eval ge e (fn_return f) k Nnormal m' | None => None end
58-      | Kifthenelse s1 s2 k =>
59-          match pure_rval ge e m a with
60-          | Some v => match bool_val v (typeof a) m with
61-            | Some b => match stmt_eval ge e (fn_return f) (if b then s1 else s2) m with
62-              | Some (out,m') => cont_eval ge e (fn_return f) k out m'
63-              | None => None end
64-            | None => None end
65-          | None => None end
66-      | Kreturn k =>
67-          match pure_rval ge e m a with
68-          | Some v => match sem_cast v (typeof a) (fn_return f) m with
69-              | Some v' => cont_eval ge e (fn_return f) k (Nreturn v') m | None => None end
70-          | None => None end
71-      | _ => None end
72-  | Callstate (Internal f) args k m =>
73-      match Cexec.do_alloc_variables ge empty_env m (fn_params f ++ fn_vars f) with
74-      | (e,m') => match Cexec.sem_bind_parameters ge quiet_world e m' (fn_params f) args with
75-          | Some m'' => match stmt_eval ge e (fn_return f) (fn_body f) m'' with
76-              | Some (out,m''') => cont_eval ge e (fn_return f) k out m''' | None => None end
77-          | None => None end end
78-  | Returnstate v Kstop m => Some (v,m)
79-  | _ => None
80-  end.
81-
82-Fixpoint normal_stmt (s:statement): bool :=
83-  match s with
84-  | Sskip | Sreturn None => true
85-  | Sdo a => atomic_expr a
86-  | Sreturn (Some a) => simple a
87-  | Ssequence s1 s2 => normal_stmt s1 && normal_stmt s2
88-  | Sifthenelse a s1 s2 => simple a && normal_stmt s1 && normal_stmt s2
89-  | _ => false end.
From Stdlib Require Import List Bool.
From compcert Require Import AST Values Memory Events Globalenvs Ctypes Csyntax Csem Cexec Smallstep.
From FiveLowpassGet Require Import Source Execution.
From FiveGuidanceSemantics Require Import SemanticsSupport SourceClosure.
Import ListNotations.
Definition ge := Csem.globalenv Source.prog.
Definition allowed (fd:Csyntax.fundef):Prop := fd=Internal Source.f_get_first_order_low_pass.
Definition budget (_:type)(_:Csyntax.fundef):Prop := True.
Definition SS := SourceClosure.source_state ge allowed budget.
Lemma entry_body_core:SourceClosure.core_stmt ge allowed budget(fn_body Source.f_get_first_order_low_pass).
Proof. cbn [fn_body Source.f_get_first_order_low_pass SourceClosure.core_stmt SourceClosure.core_expr SourceClosure.core_exprlist SourceClosure.nv];repeat split;reflexivity. Qed.
Lemma internal_body:forall f,allowed(Internal f) -> SourceClosure.core_stmt ge allowed budget(fn_body f).
Proof. intros f H;unfold allowed in H;inversion H;subst;apply entry_body_core. Qed.
Lemma external_supported:forall ef args ret cc,allowed(External ef args ret cc) -> executable_builtin ef=true.
Proof. intros;unfold allowed in H;discriminate. Qed.
Theorem entry_source:forall args m,SS(Execution.entry args m).
Proof. intros;split;[reflexivity|constructor]. Qed.
Theorem source_step_invariant:forall s t s',SS s -> Csem.step ge s t s' -> t=E0 /\ SS s'.
Proof. exact(SourceClosure.source_step_invariant ge allowed budget internal_body external_supported). Qed.
Theorem one_step_correspondence:forall cb asm w s t s',SS s ->
 ((exists rule,In(TR rule t s')(Cexec.do_step ge cb asm w s)) <-> Csem.step ge s t s').
Proof. exact(SourceClosure.source_do_step_exact ge allowed budget internal_body external_supported). Qed.
Definition closed_step := Execution.model_step Execution.no_external Execution.no_external Execution.quiet_world.
Theorem source_reachable:forall args m t reached,
 star Csem.step ge(Execution.entry args m)t reached -> SS reached.
Proof.
 intros args m t reached PATH.
 pose proof(entry_source args m) as INIT.
 induction PATH;auto;apply IHPATH;exact(proj2(source_step_invariant _ _ _ INIT H)).
Qed.
Theorem whole_execution_correspondence:forall args m t final,
 star closed_step tt(Execution.entry args m)t final <->
 star Csem.step ge(Execution.entry args m)t final.
Proof.
 intros args m t final;split;intro PATH;
 pose proof(entry_source args m) as INIT;
 revert INIT;induction PATH;intros INV;[constructor| |constructor|].
 - pose proof(proj1(one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world _ _ _ INV)H)as STEP.
   eapply star_step;[exact STEP|apply IHPATH;exact(proj2(source_step_invariant _ _ _ INV STEP))|assumption].
 - eapply star_step.
   + apply(proj2(one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world _ _ _ INV));exact H.
   + apply IHPATH;exact(proj2(source_step_invariant _ _ _ INV H)).
   + assumption.
Qed.
Theorem invalid_operation_correspondence:forall args m t reached,
 star Csem.step ge(Execution.entry args m)t reached ->
 (Execution.source_error reached <->
 ~Execution.normal_return reached /\ nostep closed_step tt reached).
Proof.
 intros args m t reached PATH.
 pose proof(source_reachable _ _ _ _ PATH)as INV.
 unfold Execution.source_error;split;intros[N STOP];split;auto;intros tr nxt STEP;apply(STOP tr nxt).
 - apply(proj1(one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world _ _ _ INV));exact STEP.
 - apply(proj2(one_step_correspondence Execution.no_external Execution.no_external Execution.quiet_world _ _ _ INV));exact STEP.
Qed.
Print Assumptions one_step_correspondence.
Print Assumptions whole_execution_correspondence.
Print Assumptions invalid_operation_correspondence.
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Integers Floats AST Values Memory Memdata Csem Smallstep.
From FiveLowpassGet Require Import Source Execution.
From FiveLowpassGetCase Require Import Contract GetSites.
From FiveLowpassSupport Require Import LowpassMemory FieldBytes CbmcBits.
From FiveGuidanceCbmcAdapters Require Import BitsAdapter.
Import ListNotations.
Local Open Scope Z_scope.
Module Source:=FiveLowpassGet.Source.
Module Execution:=FiveLowpassGet.Execution.
Definition Initial(m:mem)(b:block)(p:ptrofs)(tc vi vo:float32):Prop:=
 writable12 m b p /\
 Mem.loadbytes m b(Ptrofs.unsigned p)4=Some(encode_val Mfloat32(Vsingle tc)) /\
 Mem.loadbytes m b(Ptrofs.unsigned p+4)4=Some(encode_val Mfloat32(Vsingle vi)) /\
 Mem.loadbytes m b(Ptrofs.unsigned p+8)4=Some(encode_val Mfloat32(Vsingle vo)).
Definition FieldCheck(m mf:mem)(b:block)(p:ptrofs)(delta:Z)(v:float32):Prop:=
 Mem.loadbytes mf b(Ptrofs.unsigned p+delta)4=Mem.loadbytes m b(Ptrofs.unsigned p+delta)4 /\
 Mem.load Mfloat32 mf b(Ptrofs.unsigned p+delta)=Some(Vsingle v) /\
 CopiedBitsEqualBothOrders Execution.ge v v mf.
Definition P_memcpy_pointer_arithmetic_1:Prop:=CbmcBits.memcpy_guard_id 3%nat.
Definition P_memcpy_pointer_1:Prop:=CbmcBits.memcpy_guard_id 1%nat.
Definition P_memcpy_pointer_arithmetic_2:Prop:=CbmcBits.memcpy_guard_id 2%nat.
Definition P_memcpy_pointer_arithmetic_3:Prop:=CbmcBits.memcpy_guard_id 6%nat.
Definition P_memcpy_pointer_2:Prop:=CbmcBits.memcpy_guard_id 4%nat.
Definition P_memcpy_pointer_arithmetic_4:Prop:=CbmcBits.memcpy_guard_id 5%nat.
Definition P_bits_precondition_instance_1:Prop:=CbmcBits.bits_guard_id 1%nat.
Definition P_bits_precondition_instance_2:Prop:=CbmcBits.bits_guard_id 2%nat.
Definition P_bits_precondition_instance_3:Prop:=CbmcBits.bits_guard_id 3%nat.
Definition P_get_first_order_low_pass_pointer_dereference_1:Prop:=GetSites.SiteProperty 0%nat.
Definition P_get_first_order_low_pass_pointer_dereference_2:Prop:=GetSites.SiteProperty 1%nat.
Definition P_get_first_order_low_pass_pointer_dereference_3:Prop:=GetSites.SiteProperty 2%nat.
Definition P_get_first_order_low_pass_pointer_dereference_4:Prop:=GetSites.SiteProperty 3%nat.
Definition P_get_first_order_low_pass_pointer_dereference_5:Prop:=GetSites.SiteProperty 4%nat.
Definition P_get_first_order_low_pass_pointer_dereference_6:Prop:=GetSites.SiteProperty 5%nat.
Definition P_main_assertion_1:Prop:=forall m b p tc vi vo,Initial m b p tc vi vo->
 (exists t mf,star Csem.step Execution.ge(Execution.entry(Args b p)m)t(Returnstate(Vsingle vo)Kstop mf)) /\
 (forall t result mf,star Csem.step Execution.ge(Execution.entry(Args b p)m)t(Returnstate result Kstop mf)->result=Vsingle vo /\ CopiedBitsEqualBothOrders Execution.ge vo vo mf).
Definition P_main_assertion_2:Prop:=forall m b p tc vi vo,Initial m b p tc vi vo->
 (exists t mf,star Csem.step Execution.ge(Execution.entry(Args b p)m)t(Returnstate(Vsingle vo)Kstop mf)) /\
 (forall t result mf,star Csem.step Execution.ge(Execution.entry(Args b p)m)t(Returnstate result Kstop mf)->FieldCheck m mf b p 0 tc).
Definition P_main_assertion_3:Prop:=forall m b p tc vi vo,Initial m b p tc vi vo->
 (exists t mf,star Csem.step Execution.ge(Execution.entry(Args b p)m)t(Returnstate(Vsingle vo)Kstop mf)) /\
 (forall t result mf,star Csem.step Execution.ge(Execution.entry(Args b p)m)t(Returnstate result Kstop mf)->FieldCheck m mf b p 4 vi).
Definition P_main_assertion_4:Prop:=forall m b p tc vi vo,Initial m b p tc vi vo->
 (exists t mf,star Csem.step Execution.ge(Execution.entry(Args b p)m)t(Returnstate(Vsingle vo)Kstop mf)) /\
 (forall t result mf,star Csem.step Execution.ge(Execution.entry(Args b p)m)t(Returnstate result Kstop mf)->FieldCheck m mf b p 8 vo).
