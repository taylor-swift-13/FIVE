unfold Spec.FieldCheck;split;[apply FRAME;exact(object_valid m b p P)|]. split;[|apply copied_bits_equal;reflexivity].
 apply encoded_load.
 + exact(proj2(field_access m b p 4 P ltac:(simpl;auto))).
