      "argv": [
        "python3",
        "-c",
        "\nfrom pathlib import Path\nimport json,hashlib,shutil\nroot=Path.cwd();c=root/'paparazzi/models/update_first_order_low_pass';hist=root/'paparazzi/report/lowpass_update_readback/evidence/history'\ndef sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()\ndef dump(p,x):p.write_text(json.dumps(x,indent=2)+chr(10))\nfor p in [c/'align/model/spec-map-final.json',c/'rocq/spec-recheck.json',c/'align/handoff.json',c/'rocq/handoff.json']:shutil.copyfile(p,hist/(p.parent.name+'-'+p.name))\nb=json.loads((c/'cbmc/handoff.json').read_text())['cbmc_evidence'];meta=json.loads((root/b['run']/'run.json').read_text());cmd=next(x for x in meta['commands']if x['id']==b['command_id']);m=json.loads((c/'align/model/spec-map-final.json').read_text());m.update(cbmc_run=b['run'],cbmc_command_id=b['command_id'],cbmc_json=b['json'])\nfor p in m['properties']:p['scope']['command_scope']={'run':b['run'],'command_id':b['command_id'],'argv':cmd['argv']}\ndump(c/'align/model/spec-map-final.json',m)\nl=json.loads((c/'rocq/spec-recheck.json').read_text());l.update(cbmc_run=b['run'],cbmc_command_id=b['command_id'],cbmc_json=b['json'])\nfor x,p in zip(l['properties'],m['properties']):assert x['property_id']==p['property_id'];x['scope']=p['scope']\ndump(c/'rocq/spec-recheck.json',l)\nfor stage in ['align','rocq']:\n h=json.loads((c/stage/'handoff.json').read_text())\n for x in h['outputs']:\n  p=c/x['path']\n  if p.is_file():x['sha256']=sha(p)\n if stage=='align':h['input_handoff']='cbmc/handoff.json';h['input_handoff_sha256']=sha(c/'cbmc/handoff.json')\n dump(c/stage/'handoff.json',h)\nassert len(m['properties'])==36;print('Currentmap/ledger/handoffs bindactualnewCBMC; allproofinputs unchanged; oldmetadata preserved.')\n"
