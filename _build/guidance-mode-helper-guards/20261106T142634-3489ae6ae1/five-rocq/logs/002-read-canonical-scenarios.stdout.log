#include "../prepare/source/gh_update_ref_from_speed_sp.c"
#include <string.h>
#include <limits.h>
extern float nondet_float(void);
extern int64_t nondet_i64(void);
extern int nondet_int(void);
static uint32_t bits(float x) { uint32_t u; memcpy(&u,&x,4); return u; }
void main(void) {
 gh_ref.accel.x=2.0f;
 gh_ref.accel.y=0.0f;
 gh_ref.speed.x=1.0f;
 gh_ref.speed.y=0.0f;
 gh_ref.tau=nondet_float();
 gh_ref.omega=nondet_float();
 gh_ref.zeta=nondet_float();
 gh_ref.max_speed=nondet_float();
 gh_ref.zeta_omega=nondet_float();
 gh_ref.omega_2=nondet_float();
 gh_ref.inv_tau=2.0f;
 gh_ref.dt=0x1p-9f;
 gh_ref.pos.x=nondet_i64(); gh_ref.pos.y=nondet_i64();
 struct GuidanceHRef old=gh_ref;
 if(nondet_int()!=0){
 struct FloatVect2 input={1.0f,0.0f};
 float scaled_x=(old.speed.x*old.dt)*(1LL<<GH_POS_REF_FRAC);
 __CPROVER_assume(scaled_x>-0x1p63f && scaled_x<0x1p63f);
 int64_t delta_x=scaled_x;
 __CPROVER_assume(delta_x>=0 ? old.pos.x<=INT64_MAX-delta_x : old.pos.x>=INT64_MIN-delta_x);
 float speed_x=old.speed.x+old.accel.x*old.dt;
 float scaled_y=(old.speed.y*old.dt)*(1LL<<GH_POS_REF_FRAC);
 __CPROVER_assume(scaled_y>-0x1p63f && scaled_y<0x1p63f);
 int64_t delta_y=scaled_y;
 __CPROVER_assume(delta_y>=0 ? old.pos.y<=INT64_MAX-delta_y : old.pos.y>=INT64_MIN-delta_y);
 float speed_y=old.speed.y+old.accel.y*old.dt;
 struct FloatVect2 expected;
 expected.x=(speed_x-input.x)*(-old.inv_tau);
 expected.y=(speed_y-input.y)*(-old.inv_tau);
 float norm2=expected.x*expected.x+expected.y*expected.y;
 if(norm2>gh_max_accel*gh_max_accel){ float factor=gh_max_accel/sqrtf(norm2); expected.x=expected.x*factor; expected.y=expected.y*factor; }
 gh_update_ref_from_speed_sp((struct FloatVect2){1.0f,0.0f});
 __CPROVER_assert(gh_ref.pos.x==old.pos.x+delta_x,"position x integration [unsaturated]");
 __CPROVER_assert(bits(gh_ref.speed.x)==bits(speed_x),"speed x source order bits [unsaturated]");
 __CPROVER_assert(bits(gh_ref.accel.x)==bits(expected.x),"acceleration x saturation bits [unsaturated]");
 __CPROVER_assert(gh_ref.pos.y==old.pos.y+delta_y,"position y integration [unsaturated]");
 __CPROVER_assert(bits(gh_ref.speed.y)==bits(speed_y),"speed y source order bits [unsaturated]");
 __CPROVER_assert(bits(gh_ref.accel.y)==bits(expected.y),"acceleration y saturation bits [unsaturated]");
 __CPROVER_assert(bits(gh_ref.tau)==bits(old.tau) && bits(gh_ref.omega)==bits(old.omega) && bits(gh_ref.zeta)==bits(old.zeta) && bits(gh_ref.max_speed)==bits(old.max_speed) && bits(gh_ref.zeta_omega)==bits(old.zeta_omega) && bits(gh_ref.omega_2)==bits(old.omega_2) && bits(gh_ref.inv_tau)==bits(old.inv_tau) && bits(gh_ref.dt)==bits(old.dt),"all eight parameter fields bit frame [unsaturated]");
 }else{
 struct FloatVect2 input={6.0f,0.0f};
 float scaled_x=(old.speed.x*old.dt)*(1LL<<GH_POS_REF_FRAC);
 __CPROVER_assume(scaled_x>-0x1p63f && scaled_x<0x1p63f);
 int64_t delta_x=scaled_x;
 __CPROVER_assume(delta_x>=0 ? old.pos.x<=INT64_MAX-delta_x : old.pos.x>=INT64_MIN-delta_x);
 float speed_x=old.speed.x+old.accel.x*old.dt;
 float scaled_y=(old.speed.y*old.dt)*(1LL<<GH_POS_REF_FRAC);
 __CPROVER_assume(scaled_y>-0x1p63f && scaled_y<0x1p63f);
 int64_t delta_y=scaled_y;
 __CPROVER_assume(delta_y>=0 ? old.pos.y<=INT64_MAX-delta_y : old.pos.y>=INT64_MIN-delta_y);
 float speed_y=old.speed.y+old.accel.y*old.dt;
 struct FloatVect2 expected;
 expected.x=(speed_x-input.x)*(-old.inv_tau);
 expected.y=(speed_y-input.y)*(-old.inv_tau);
 float norm2=expected.x*expected.x+expected.y*expected.y;
 if(norm2>gh_max_accel*gh_max_accel){ float factor=gh_max_accel/sqrtf(norm2); expected.x=expected.x*factor; expected.y=expected.y*factor; }
 gh_update_ref_from_speed_sp((struct FloatVect2){6.0f,0.0f});
 __CPROVER_assert(gh_ref.pos.x==old.pos.x+delta_x,"position x integration [saturated]");
 __CPROVER_assert(bits(gh_ref.speed.x)==bits(speed_x),"speed x source order bits [saturated]");
 __CPROVER_assert(bits(gh_ref.accel.x)==bits(expected.x),"acceleration x saturation bits [saturated]");
 __CPROVER_assert(gh_ref.pos.y==old.pos.y+delta_y,"position y integration [saturated]");
 __CPROVER_assert(bits(gh_ref.speed.y)==bits(speed_y),"speed y source order bits [saturated]");
 __CPROVER_assert(bits(gh_ref.accel.y)==bits(expected.y),"acceleration y saturation bits [saturated]");
 __CPROVER_assert(bits(gh_ref.tau)==bits(old.tau) && bits(gh_ref.omega)==bits(old.omega) && bits(gh_ref.zeta)==bits(old.zeta) && bits(gh_ref.max_speed)==bits(old.max_speed) && bits(gh_ref.zeta_omega)==bits(old.zeta_omega) && bits(gh_ref.omega_2)==bits(old.omega_2) && bits(gh_ref.inv_tau)==bits(old.inv_tau) && bits(gh_ref.dt)==bits(old.dt),"all eight parameter fields bit frame [saturated]");
 }
}
