FILE safety/SubtractionObservation.v
From Stdlib Require Import List Bool ZArith.
From compcert Require Import Coqlib Maps AST Integers Values Memory Events Ctypes Cop Csyntax Csyntaxdefs Csem Cstrategy.
From FiveGuidanceSemantics Require Import SourceClosure.
From FiveGuidanceAllOrder Require Import PureSyntax PureDenotation PureProgress.
From PidPositionSafety Require Import GetterAssignmentShell TaggedCallee.
From CoreCBMC Require Import NumericBounds ArithmeticTree ArithmeticAtomic.
Fixpoint no_ready_binary(a:expr):bool:=match a with
| Eval _ _|Evar _ _|Eloc _ _ _ _|Esizeof _ _|Ealignof _ _=>true
| Evalof a _|Ederef a _|Eaddrof a _|Efield a _ _|Eunop _ a _|Ecast a _|Epostincr _ a _|Eparen a _ _=>no_ready_binary a
| Ebinop _ a b _=>negb(literal RV a&&literal RV b)&&no_ready_binary a&&no_ready_binary b
| Eassign a b _|Eassignop _ a b _ _|Eseqand a b _|Eseqor a b _|Ecomma a b _=>no_ready_binary a&&no_ready_binary b
| Econdition c a b _=>no_ready_binary c&&no_ready_binary a&&no_ready_binary b
| Ecall a al _=>no_ready_binary a&&no_ready_binary_list al
| Ebuiltin _ _ al _=>no_ready_binary_list al
end
with no_ready_binary_list(al:exprlist):bool:=match al with
| Enil=>true|Econs a al=>no_ready_binary a&&no_ready_binary_list al end.
Lemma no_ready_context_mut:
 (forall from to C,context from to C ->forall a,
 no_ready_binary(C a)=true ->no_ready_binary a=true) /\
 (forall from C,contextlist from C ->forall a,
 no_ready_binary_list(C a)=true ->no_ready_binary a=true).
Proof.
 apply SourceClosure.context_contextlist_ind;cbn[no_ready_binary no_ready_binary_list];intros;core_unpack;eauto.
Qed.
Lemma no_ready_context:forall from to C,context from to C ->forall a,
 no_ready_binary(C a)=true ->no_ready_binary a=true.
Proof. exact(proj1 no_ready_context_mut). Qed.
Theorem getter_pre_no_ready:
 forall ghid refid vectid nedid axis iref icomponent ierr igh igetter
 berr bparam bgh bgetter dref dcomponent daxis reference ls rs fs,
 no_ready_binary(GetterAssignmentShell.pre_expr ghid refid vectid nedid axis iref icomponent ierr igh igetter
 berr bparam bgh bgetter dref dcomponent daxis reference ls rs fs)=true.
Proof. intros;destruct ls,rs,fs;reflexivity. Qed.
Definition subtraction_observation(ge:genv)(caller:function)(s:Csem.state):Prop:=
 match s with
 | ExprState f a k e m=>f=caller ->forall C x y,
 context RV RV C ->a=C(Ebinop Osub(Eval(Vint x)tint)(Eval(Vint y)tint)tint) ->
 NumericBounds.signed32(Int.signed x-Int.signed y)
 | _=>True end.
Lemma no_ready_subtraction_observation:forall ge caller f a k e m,
 no_ready_binary a=true ->subtraction_observation ge caller(ExprState f a k e m).
Proof.
 intros ge caller f a k e m NR FF C x y CT EQ;subst a.
 pose proof(no_ready_context RV RV C CT _ NR)as BAD;discriminate BAD.
Qed.
Lemma arithmetic_subtraction_observation:forall ge caller f a k e m,
 arithmetic_tree ge e m a ->subtraction_observation ge caller(ExprState f a k e m).
Proof.
 intros ge caller f a k e m TREE FF C x y CT EQ;subst a.
 pose proof(arithmetic_observed_binary ge e m RV C Osub(Vint x)tint(Vint y)tint tint CT eq_refl TREE)as SAFE.
 cbn[binary_safe]in SAFE;rewrite dec_eq_true in SAFE;exact SAFE.
Qed.
Lemma scope_subtraction_observation:forall ge caller leaf s,
 leaf<>caller ->function_scope leaf s ->subtraction_observation ge caller s.
Proof.
 intros ge caller leaf s DIFF SC;destruct s;cbn[function_scope subtraction_observation]in*;try exact I.
 intros EQ;congruence.
Qed.
Lemma atomic_subtraction_observation:forall ge caller e k mf result s,
 arithmetic_atomic_invariant ge caller e k mf result s ->subtraction_observation ge caller s.
Proof.
 intros ge caller e k mf result s INV;destruct s;try exact I.
 apply arithmetic_subtraction_observation;eapply arithmetic_atomic_observation;exact INV.
Qed.
Print Assumptions getter_pre_no_ready.
Print Assumptions atomic_subtraction_observation.

FILE safety/ObservedPhases.v
MISSING
FILE safety/ObservedReadonly.v
From Stdlib Require Import Classical.
From compcert Require Import Values Memory Events Csem.
From FiveGuidanceAllOrder Require Import PhaseComposition.
Section READONLY.
Variable ge:genv.
Variables L R F:Type.
Variable pre:L->R->F->Csem.state.
Variable call:L->R->Csem.state.
Variable frame:L->R->cont.
Variable post:L->R->Csem.state.
Variable initial target:Csem.state.
Variable observe:Csem.state->Prop.
Hypothesis initial_observed:observe initial.
Hypothesis pre_observed:forall l r f,observe(pre l r f).
Variable result:val.
Variable m:mem.
Variable l0:L.
Variable r0:R.
Variable f0:F.
Definition pre_or_call(s:Csem.state):Prop:=
 (exists l r f,s=pre l r f)\/(exists l r,s=call l r).
Hypothesis pre_progress:forall l r f,exists t next,
 Csem.step ge(pre l r f)t next /\pre_or_call next.
Hypothesis pre_all_successors:forall l r f t next,
 Csem.step ge(pre l r f)t next ->pre_or_call next.
Hypothesis initial_unique:unique_transition ge initial(pre l0 r0 f0).
Hypothesis callees:forall l r,exists P,
 certificate ge P(Returnstate result(frame l r)m) /\P(call l r)/\(forall s,P s->observe s).
Hypothesis returns:forall l r,
 unique_transition ge(Returnstate result(frame l r)m)(post l r).
Hypothesis postphases:forall l r,exists Q,certificate ge Q target /\Q(post l r)/\(forall s,Q s->observe s).
Definition active_callee(s:Csem.state):Prop:=
 exists l r P,certificate ge P(Returnstate result(frame l r)m) /\P(call l r)/\(forall z,P z->observe z)/\P s.
Definition active_post(s:Csem.state):Prop:=
 exists l r Q,certificate ge Q target /\Q(post l r)/\(forall z,Q z->observe z)/\Q s.
Definition invariant(s:Csem.state):Prop:=
 s=initial\/(exists l r f,s=pre l r f)\/active_callee s\/active_post s.
Lemma enter_callee:forall l r,active_callee(call l r).
Proof. intros;destruct(callees l r)as[P[C[I OBS]]];exists l,r,P;auto. Qed.
Lemma enter_post:forall l r,active_post(post l r).
Proof. intros;destruct(postphases l r)as[Q[C[I OBS]]];exists l,r,Q;auto. Qed.
Lemma classify_pre:forall s,pre_or_call s ->
 (exists l r f,s=pre l r f)\/active_callee s.
Proof.
 intros s[PRE|[l[r EQ]]];auto;subst;right;apply enter_callee.
Qed.
Theorem readonly_assignment_certificate:certificate ge invariant target.
Proof.
 split.
 - intros s[START|[PRE|[CALLEE|POST]]].
   + subst;right;exists E0,(pre l0 r0 f0);split;[exact(proj1 initial_unique)|].
     right;left;exists l0,r0,f0;reflexivity.
   + destruct PRE as[l[r[f EQ]]];subst s.
     destruct(pre_progress l r f)as[t[next[STEP CL]]].
     right;exists t,next;split;auto;destruct(classify_pre _ CL)as[P|C].
     * right;left;exact P.
     * right;right;left;exact C.
   + destruct CALLEE as[l[r[P[C[INCUR[OBS IN]]]]]].
     destruct(proj1 C s IN)as[EQ|[t[next[STEP PN]]]].
     * subst;right;exists E0,(post l r);split;[exact(proj1(returns l r))|].
       right;right;right;apply enter_post.
     * right;exists t,next;split;auto;right;right;left;exists l,r,P;auto.
   + destruct POST as[l[r[Q[C[QI[OBS IN]]]]]].
     destruct(proj1 C s IN)as[EQ|[t[next[STEP QN]]]];[auto|].
     right;exists t,next;split;auto;right;right;right;exists l,r,Q;auto.
 - intros s t next[START|[PRE|[CALLEE|POST]]]NF STEP.
   + subst;destruct(proj2 initial_unique t next STEP)as[TT EQ];subst.
     right;left;exists l0,r0,f0;reflexivity.
   + destruct PRE as[l[r[f EQ]]];subst.
     destruct(classify_pre _ (pre_all_successors l r f t next STEP))as[P|C].
     * right;left;exact P.
     * right;right;left;exact C.
   + destruct CALLEE as[l[r[P[C[INCUR[OBS IN]]]]]].
     destruct(classic(s=Returnstate result(frame l r)m))as[EQ|NE].
     * subst;destruct(proj2(returns l r)t next STEP)as[TT EQ];subst.
       right;right;right;apply enter_post.
     * right;right;left;exists l,r,P;split;[exact C|];split;[exact INCUR|];split;[exact OBS|].
       eapply(proj2 C);eauto.
   + destruct POST as[l[r[Q[C[QI[OBS IN]]]]]];right;right;right;exists l,r,Q.
     split;[exact C|];split;[exact QI|];split;[exact OBS|];eapply(proj2 C);eauto.
Qed.
Theorem initial_member:invariant initial.
Proof. left;reflexivity. Qed.
Theorem observations:forall s,invariant s ->observe s.
Proof.
 intros s[START|[PRE|[CAL|POST]]].
 - subst;exact initial_observed.
 - destruct PRE as[l[r[f EQ]]];subst;apply pre_observed.
 - destruct CAL as[l[r[P[C[PI[OBS IN]]]]]];apply OBS;exact IN.
 - destruct POST as[l[r[Q[C[QI[OBS IN]]]]]];apply OBS;exact IN.
Qed.
End READONLY.
Print Assumptions readonly_assignment_certificate.

