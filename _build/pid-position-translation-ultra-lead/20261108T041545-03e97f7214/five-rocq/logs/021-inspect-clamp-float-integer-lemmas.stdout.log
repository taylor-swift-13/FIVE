Float.cmp_swap:
  forall (c : comparison) (x y : float),
  Float.cmp (swap_comparison c) x y = Float.cmp c y x
Float.cmp_ne_eq:
  forall f1 f2 : float, Float.cmp Cne f1 f2 = negb (Float.cmp Ceq f1 f2)
Float32.cmp_double:
  forall (f1 f2 : float32) (c : comparison),
  Float32.cmp c f1 f2 =
  Float.cmp c (Float32.to_double f1) (Float32.to_double f2)
Float.cmp_le_lt_eq:
  forall f1 f2 : float,
  Float.cmp Cle f1 f2 = (Float.cmp Clt f1 f2 || Float.cmp Ceq f1 f2)%bool
Float.cmp_ge_gt_eq:
  forall f1 f2 : float,
  Float.cmp Cge f1 f2 = (Float.cmp Cgt f1 f2 || Float.cmp Ceq f1 f2)%bool
Float.cmp_gt_eq_false:
  forall x y : float,
  Float.cmp Cgt x y = true -> Float.cmp Ceq x y = true -> False
Float.cmp_lt_gt_false:
  forall f1 f2 : float,
  Float.cmp Clt f1 f2 = true -> Float.cmp Cgt f1 f2 = true -> False
Float.cmp_lt_eq_false:
  forall f1 f2 : float,
  Float.cmp Clt f1 f2 = true -> Float.cmp Ceq f1 f2 = true -> False
Float.to_intu_to_int_1:
  forall (x : float) (n : int),
  Float.cmp Clt x (Float.of_intu Float.ox8000_0000) = true ->
  Float.to_intu x = Some n -> Float.to_int x = Some n
Float.to_intu_to_int_2:
  forall (x : float) (n : int),
  Float.cmp Clt x (Float.of_intu Float.ox8000_0000) = false ->
  Float.to_intu x = Some n ->
  Float.to_int (Float.sub x (Float.of_intu Float.ox8000_0000)) =
  Some (Int.sub n Float.ox8000_0000)
