Mem.storev =
fun (chunk : AST.memory_chunk) (m : mem) (addr v : Values.val) =>
match addr with
| Values.Vptr b ofs =>
    if
     Coqlib.zle
       (BinInt.Z.add (Integers.Ptrofs.unsigned ofs) (size_chunk chunk))
       Integers.Ptrofs.modulus
    then Mem.store chunk m b (Integers.Ptrofs.unsigned ofs) v
    else None
| _ => None
end
     : AST.memory_chunk -> mem -> Values.val -> Values.val -> option mem

Arguments Mem.storev chunk m addr v
Mem.loadv =
fun (chunk : AST.memory_chunk) (m : mem) (addr : Values.val) =>
match addr with
| Values.Vptr b ofs =>
    if
     Coqlib.zle
       (BinInt.Z.add (Integers.Ptrofs.unsigned ofs) (size_chunk chunk))
       Integers.Ptrofs.modulus
    then Mem.load chunk m b (Integers.Ptrofs.unsigned ofs)
    else None
| _ => None
end
     : AST.memory_chunk -> mem -> Values.val -> option Values.val

Arguments Mem.loadv chunk m addr
