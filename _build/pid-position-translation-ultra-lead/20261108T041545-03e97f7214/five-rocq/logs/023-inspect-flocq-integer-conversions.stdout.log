Float.of_int =
fun n : Integers.Int.int =>
BofZ
  (BinInt.Z.pos
     (BinNums.xI
        (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))
  (BinInt.Z.pos
     (BinNums.xO
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
  eq_refl eq_refl (Integers.Int.signed n)
     : Integers.Int.int -> float

Arguments Float.of_int n
Float.to_int =
fun f : float =>
Coqlib.option_map Integers.Int.repr
  (ZofB_range
     (BinInt.Z.pos
        (BinNums.xI
           (BinNums.xO (BinNums.xI (BinNums.xO (BinNums.xI BinNums.xH))))))
     (BinInt.Z.pos
        (BinNums.xO
           (BinNums.xO
              (BinNums.xO
                 (BinNums.xO
                    (BinNums.xO
                       (BinNums.xO
                          (BinNums.xO
                             (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))))))))
     f Integers.Int.min_signed Integers.Int.max_signed)
     : float -> option Integers.Int.int

