  Binary.B2R prec emax (BofZ prec emax prec_gt_0_ prec_lt_emax_ n) =
  Generic_fmt.round Zaux.radix2 (SpecFloat.fexp prec emax)
    (BinarySingleNaN.round_mode BinarySingleNaN.mode_NE) 
    (Rdefinitions.IZR n) /\
  Binary.is_finite prec emax (BofZ prec emax prec_gt_0_ prec_lt_emax_ n) =
  true /\
