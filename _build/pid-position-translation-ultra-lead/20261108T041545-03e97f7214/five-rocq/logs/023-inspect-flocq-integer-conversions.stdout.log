BofZ_correct:
  forall (prec emax : BinNums.Z) (prec_gt_0_ : FLX.Prec_gt_0 prec)
    (prec_lt_emax_ : BinarySingleNaN.Prec_lt_emax prec emax) 
    (n : BinNums.Z),
  if
   Raux.Rlt_bool
     (Rbasic_fun.Rabs
        (Generic_fmt.round Zaux.radix2 (SpecFloat.fexp prec emax)
           (BinarySingleNaN.round_mode BinarySingleNaN.mode_NE)
           (Rdefinitions.IZR n)))
     (Raux.bpow Zaux.radix2 emax)
  then
   Binary.B2R prec emax (BofZ prec emax prec_gt_0_ prec_lt_emax_ n) =
   Generic_fmt.round Zaux.radix2 (SpecFloat.fexp prec emax)
     (BinarySingleNaN.round_mode BinarySingleNaN.mode_NE)
     (Rdefinitions.IZR n) /\
   Binary.is_finite prec emax (BofZ prec emax prec_gt_0_ prec_lt_emax_ n) =
   true /\
   Binary.Bsign prec emax (BofZ prec emax prec_gt_0_ prec_lt_emax_ n) =
   BinInt.Z.ltb n BinNums.Z0
  else
   Binary.B2FF prec emax (BofZ prec emax prec_gt_0_ prec_lt_emax_ n) =
   Binary.binary_overflow prec emax BinarySingleNaN.mode_NE
     (BinInt.Z.ltb n BinNums.Z0)
