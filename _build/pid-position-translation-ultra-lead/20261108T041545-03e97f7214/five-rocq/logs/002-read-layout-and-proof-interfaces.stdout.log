From Stdlib Require Import List ZArith.
From compcert Require Import Errors Maps AST Integers Values Memory Globalenvs Ctypes Csem.
From PidPositionRunPos Require Import Source Execution.
Import ListNotations.
Open Scope Z_scope.
Module Source := PidPositionRunPos.Source.
Module Execution := PidPositionRunPos.Execution.
Definition ce := Source.prog.(prog_comp_env).
Definition composite_member (sid fid:ident) (is_union:bool) : option(type*Z) :=
 match PTree.get sid ce with
 | None=>None
 | Some co=>match field_type fid (co_members co) with
   | Error _=>None
   | OK ty=>if is_union then Some(ty,0) else
     match field_offset ce fid (co_members co) with
     | OK (ofs,_)=>Some(ty,ofs) | Error _=>None end
   end
 end.
Definition one_member (ty:type) (fid:ident) : option(type*Z) :=
 match ty with
 | Tstruct sid _=>composite_member sid fid false
 | Tunion sid _=>composite_member sid fid true
 | _=>None end.
Fixpoint path_info (ty:type) (path:list ident) {struct path} : option(type*Z) :=
 match path with
 | []=>Some(ty,0)
 | f::fs=>match one_member ty f with
   | None=>None | Some(next,ofs)=>match path_info next fs with
     | None=>None | Some(final,tail)=>Some(final,ofs+tail) end end end.
Definition gh_type := Tstruct Source._HorizontalGuidance noattr.
Definition state_type := Tstruct Source._State noattr.
Definition pid_type := Tstruct Source._GuidancePID noattr.
Definition sp_type := Tstruct Source._StabilizationSetpoint noattr.
Definition vec_type := Tstruct Source._Int32Vect2 noattr.
Definition store_path (chunk:memory_chunk) (m:mem) (b:block) (ty:type) (path:list ident) (v:val) : option mem :=
 match path_info ty path with None=>None | Some(_,ofs)=>Mem.store chunk m b ofs v end.
Definition load_path (chunk:memory_chunk) (m:mem) (b:block) (ty:type) (path:list ident) : option val :=
 match path_info ty path with None=>None | Some(_,ofs)=>Mem.load chunk m b ofs end.
Definition store_global (chunk:memory_chunk) (m:mem) (id:ident) (ty:type) (path:list ident) (v:val) : option mem :=
 match Genv.find_symbol Execution.ge id with
 | None=>None | Some b=>store_path chunk m b ty path v end.
Definition load_global (chunk:memory_chunk) (m:mem) (id:ident) (ty:type) (path:list ident) : option val :=
 match Genv.find_symbol Execution.ge id with
 | None=>None | Some b=>load_path chunk m b ty path end.
From Stdlib Require Import ZArith Lia.
Open Scope Z_scope.
Definition signed32 (z:Z) : Prop := -2147483648 <= z <= 2147483647.
Definition physical_translation (r p d:Z) : Prop :=
 signed32 r /\ signed32 p /\ signed32 d /\ signed32 (r+d) /\ signed32 (p+d) /\ signed32 (r-p).
Definition trim (bound x:Z) : Z :=
 if Z.ltb bound x then bound else if Z.ltb x (-bound) then -bound else x.
Theorem common_translation_difference (r p d:Z) :
 (r+d)-(p+d)=r-p.
Proof. lia. Qed.
Theorem physical_translation_preserves_representable_error (r p d:Z) :
 physical_translation r p d ->
 signed32 ((r+d)-(p+d)) /\ (r+d)-(p+d)=r-p.
Proof. unfold physical_translation; intros H.
 rewrite common_translation_difference. tauto. Qed.
Theorem common_translation_trimmed_error (r p d bound:Z) :
 trim bound ((r+d)-(p+d))=trim bound (r-p).
Proof. rewrite common_translation_difference; reflexivity. Qed.
Theorem nonzero_physical_translation_witness :
 exists r p d:Z, physical_translation r p d /\ d<>0 /\ r-p<>0 /\ r-p=512 /\ r+d=28160 /\ p+d=27648.
Proof. exists 2560,2048,25600.
 unfold physical_translation,signed32; repeat split; lia. Qed.
From Stdlib Require Import List ZArith.
From compcert Require Import Coqlib Errors Maps AST Integers Values Memory Events Globalenvs Ctypes Cop Csyntax Csyntaxdefs Csem Cstrategy Smallstep.
From PidPositionRunPos Require Import Source Execution.
From FiveGuidanceEntry Require Import BigstepSupport.
From PidPositionTranslationSupport Require Import MemoryLayout.
Import ListNotations.
Open Scope Z_scope.
Module Source := PidPositionRunPos.Source.
Module Execution := PidPositionRunPos.Execution.
Definition state_expr := Evalof(Evar Source._state state_type) state_type.
Definition cache_expr (field:ident) :=
 Eunop Onotbool
 (Ebinop Oand (Ebinop Oshr (Evalof(Efield state_expr field tushort)tushort)
 (Eval(Vint Int.one)tint)tint) (Eval(Vint Int.one)tint)tint)tint.
Definition ned_ptr := tptr(Tstruct Source._NedCoor_i noattr).
Definition getter_address (field:ident) := Eaddrof(Efield state_expr field (Tstruct Source._NedCoor_i noattr)) ned_ptr.
Lemma cached_mask_shift : forall flags,
 Int.and flags (Int.repr 2)=Int.repr 2 -> Int.and(Int.shr flags Int.one) Int.one=Int.one.
Proof.
 intros flags H.
 pose proof(Int.and_shr flags (Int.repr 2) Int.one) as S.
 rewrite H in S.
 change(Int.and(Int.shr flags Int.one)Int.one=Int.one)in S;exact S.
Qed.
Section SYMBOLIC.
Variable m:mem.
Variable b:block.
Variable co:composite.
Hypothesis SYM:Genv.find_symbol Execution.ge Source._state=Some b.
Hypothesis CO:PTree.get Source._State (genv_cenv Execution.ge)=Some co.
Lemma state_pointer_value : eval_simple_rvalue Execution.ge empty_env m state_expr (Vptr b Ptrofs.zero).
Proof.
 unfold state_expr;eapply esr_rvalof.
 - apply esl_var_global;[reflexivity|exact SYM].
 - reflexivity.
 - reflexivity.
 - apply deref_loc_copy;reflexivity.
Qed.
Lemma state_field_address : forall field fty delta,
 field_offset Execution.ge field (co_members co)=OK(delta,Full) ->
 eval_simple_lvalue Execution.ge empty_env m (Efield state_expr field fty) b (Ptrofs.repr delta) Full.
Proof.
 intros field fty delta OFF.
 replace(Ptrofs.repr delta)with(Ptrofs.add Ptrofs.zero(Ptrofs.repr delta))by(apply Ptrofs.add_zero_l).
 eapply esl_field_struct;[exact state_pointer_value|reflexivity|exact CO|exact OFF].
Qed.
Lemma cache_expression_false : forall field flags statusofs,
 field_offset Execution.ge field (co_members co)=OK(statusofs,Full) ->
 Mem.loadv Mint16unsigned m (Vptr b(Ptrofs.repr statusofs))=Some(Vint flags) ->
 Int.and flags (Int.repr 2)=Int.repr 2 ->
 eval_simple_rvalue Execution.ge empty_env m (cache_expr field) (Vint Int.zero).
Proof.
 intros field flags statusofs OFF LOAD VALID;unfold cache_expr.
 eapply esr_unop with(v1:=Vint Int.one).
 - eapply esr_binop with(v1:=Vint(Int.shr flags Int.one))(v2:=Vint Int.one).
   + eapply esr_binop with(v1:=Vint flags)(v2:=Vint Int.one).
     * eapply BigstepSupport.read_scalar with(b:=b)(ofs:=Ptrofs.repr statusofs)(chunk:=Mint16unsigned).
       -- apply state_field_address;exact OFF.
       -- reflexivity.
       -- reflexivity.
       -- reflexivity.
       -- exact LOAD.
     * constructor.
     * reflexivity.
   + constructor.
   + change(Some(Vint(Int.and(Int.shr flags Int.one)Int.one))=Some(Vint Int.one)).
     rewrite(cached_mask_shift flags VALID);reflexivity.
 - reflexivity.
Qed.
Lemma getter_return_expression : forall field delta,
 field_offset Execution.ge field (co_members co)=OK(delta,Full) ->
 eval_simple_rvalue Execution.ge empty_env m (getter_address field) (Vptr b(Ptrofs.repr delta)).
Proof. intros;apply esr_addrof;apply state_field_address;assumption. Qed.
Theorem original_position_getter_cached_normal : forall flags delta,
 field_offset Execution.ge Source._pos_status (co_members co)=OK(2,Full) ->
 field_offset Execution.ge Source._ned_pos_i (co_members co)=OK(delta,Full) ->
 Mem.load Mint16unsigned m b 2=Some(Vint flags) ->
 Int.and flags (Int.repr 2)=Int.repr 2 ->
 star Csem.step Execution.ge (Callstate(Internal Source.f_stateGetPositionNed_i)[] Kstop m) E0
 (Returnstate(Vptr b(Ptrofs.repr delta))Kstop m).
Proof.
 intros flags delta STATUS POS LOAD VALID.
 apply BigstepSupport.funcall_original_normal.
 eapply Cstrategy.eval_funcall_internal with(e:=empty_env)(m1:=m)(m2:=m)(m3:=m)
 (out:=Out_return(Some(Vptr b(Ptrofs.repr delta),ned_ptr))).
 - constructor.
 - constructor.
 - constructor.
 - cbn[Source.f_stateGetPositionNed_i fn_body].
   eapply BigstepSupport.sequence_normal.
   + eapply Cstrategy.exec_Sifthenelse with(v1:=Vint Int.zero)(b:=false)(m1:=m)(t1:=E0)(t2:=E0).
     * apply BigstepSupport.simple_expression;[eapply cache_expression_false with(flags:=flags)(statusofs:=2);eassumption|reflexivity].
     * reflexivity.
     * constructor.
   + apply Cstrategy.exec_Sreturn_some.
     apply BigstepSupport.simple_expression;[apply getter_return_expression;exact POS|reflexivity].
 - cbn[Cstrategy.outcome_result_value Source.f_stateGetPositionNed_i fn_return].
   split;[discriminate|reflexivity].
 - reflexivity.
Qed.
Theorem original_speed_getter_cached_normal : forall flags statusofs delta,
 field_offset Execution.ge Source._speed_status (co_members co)=OK(statusofs,Full) ->
 field_offset Execution.ge Source._ned_speed_i (co_members co)=OK(delta,Full) ->
 Mem.loadv Mint16unsigned m (Vptr b(Ptrofs.repr statusofs))=Some(Vint flags) ->
 Int.and flags (Int.repr 2)=Int.repr 2 ->
 star Csem.step Execution.ge (Callstate(Internal Source.f_stateGetSpeedNed_i)[] Kstop m) E0
 (Returnstate(Vptr b(Ptrofs.repr delta))Kstop m).
Proof.
 intros flags statusofs delta STATUS POS LOAD VALID.
 apply BigstepSupport.funcall_original_normal.
 eapply Cstrategy.eval_funcall_internal with(e:=empty_env)(m1:=m)(m2:=m)(m3:=m)
 (out:=Out_return(Some(Vptr b(Ptrofs.repr delta),ned_ptr))).
 - constructor.
 - constructor.
 - constructor.
 - cbn[Source.f_stateGetSpeedNed_i fn_body].
   eapply BigstepSupport.sequence_normal.
   + eapply Cstrategy.exec_Sifthenelse with(v1:=Vint Int.zero)(b:=false)(m1:=m)(t1:=E0)(t2:=E0).
     * apply BigstepSupport.simple_expression;[eapply cache_expression_false with(flags:=flags)(statusofs:=statusofs);eassumption|reflexivity].
     * reflexivity.
     * constructor.
   + apply Cstrategy.exec_Sreturn_some.
     apply BigstepSupport.simple_expression;[apply getter_return_expression;exact POS|reflexivity].
 - cbn[Cstrategy.outcome_result_value Source.f_stateGetSpeedNed_i fn_return].
   split;[discriminate|reflexivity].
 - reflexivity.
Qed.
End SYMBOLIC.
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Errors Maps Integers Floats AST Values Memory Events Globalenvs Ctypes Cop Csyntax Csem Cstrategy Smallstep.
Import ListNotations.
Local Open Scope Z_scope.

(** Generic construction lemmas for real Cstrategy executions.  These do not
    replace or alter the generated Csyntax, and make no assumption of a return. *)
Fixpoint source_simple (a : expr) : bool :=
 match a with
 | Eval _ _ | Evar _ _ | Esizeof _ _ | Ealignof _ _=>true
 | Ederef r _ | Efield r _ _ | Eaddrof r _ | Eunop _ r _ | Ecast r _=>source_simple r
 | Evalof l _=>source_simple l && negb(type_is_volatile(typeof l))
 | Ebinop _ r s _=>source_simple r && source_simple s
 | _=>false end.
Lemma simple_eval_expr_refl : forall ge e m,
 (forall a v, Cstrategy.eval_simple_rvalue ge e m a v -> source_simple a=true ->
   Cstrategy.eval_expr ge e m RV a E0 m a) /\
 (forall a b ofs bf, Cstrategy.eval_simple_lvalue ge e m a b ofs bf -> source_simple a=true ->
   Cstrategy.eval_expr ge e m LV a E0 m a).
Proof.
 intros ge e m;apply Cstrategy.eval_simple_rvalue_lvalue_ind;
 intros; simpl in *;
 repeat match goal with H : _ && _ =true |- _ => apply andb_true_iff in H;destruct H end;
 try discriminate;
 try solve [constructor;auto];
 try solve [replace E0 with (E0**E0) by reflexivity; eapply Cstrategy.eval_binop;eauto];
 try solve [eapply Cstrategy.eval_valof;[|eauto];apply negb_true_iff in H0;exact H0].
 all: eapply Cstrategy.eval_valof;[match goal with H: negb _=true |- _=>apply negb_true_iff in H;exact H end|eauto].
Qed.
Lemma simple_expression : forall ge e m a v,
 Cstrategy.eval_simple_rvalue ge e m a v -> source_simple a=true ->
 Cstrategy.eval_expression ge e m a E0 m v.
Proof.
 intros ge e m a v EV SI;eapply Cstrategy.eval_expression_intro;
 [eapply(proj1(simple_eval_expr_refl ge e m));eauto|exact EV].
Qed.
Lemma atomic_assign : forall ge e m l r ty b ofs bf v vc v' mf,
 Cstrategy.eval_simple_lvalue ge e m l b ofs bf -> source_simple l=true ->
 Cstrategy.eval_simple_rvalue ge e m r v -> source_simple r=true ->
 sem_cast v (typeof r) (typeof l) m=Some vc ->
 assign_loc ge (typeof l) m b ofs bf vc E0 mf v' -> ty=typeof l ->
 Cstrategy.exec_stmt ge e m (Sdo(Eassign l r ty)) E0 mf Out_normal.
Proof.
 intros ge e m l r ty b ofs bf v vc v' mf LL SL RR SR CAST STORE TY.
 eapply Cstrategy.exec_Sdo.
 eapply Cstrategy.eval_expression_intro with (a':=Eval v' ty);[|constructor].
 replace E0 with (E0**E0**E0) by reflexivity.
 eapply Cstrategy.eval_assign;
 [eapply(proj2(simple_eval_expr_refl ge e m));eauto|
 eapply(proj1(simple_eval_expr_refl ge e m));eauto|exact LL|exact RR|exact CAST|exact STORE|exact TY].
Qed.
Lemma atomic_assignop : forall ge e m op l r tyres ty b ofs bf vl vr vop vc v' mf,
 Cstrategy.eval_simple_lvalue ge e m l b ofs bf -> source_simple l=true ->
 Cstrategy.eval_simple_rvalue ge e m r vr -> source_simple r=true ->
 deref_loc ge (typeof l) m b ofs bf E0 vl ->
 sem_binary_operation ge op vl (typeof l) vr (typeof r) m=Some vop ->
 sem_cast vop tyres (typeof l) m=Some vc ->
 assign_loc ge (typeof l) m b ofs bf vc E0 mf v' -> ty=typeof l ->
 Cstrategy.exec_stmt ge e m (Sdo(Eassignop op l r tyres ty)) E0 mf Out_normal.
Proof.
 intros ge e m op l r tyres ty b ofs bf vl vr vop vc v' mf LL SL RR SR LOAD OP CAST STORE TY.
 eapply Cstrategy.exec_Sdo.
 eapply Cstrategy.eval_expression_intro with (a':=Eval v' ty);[|constructor].
 replace E0 with (E0**E0**E0**E0) by reflexivity.
 eapply Cstrategy.eval_assignop;
 [eapply(proj2(simple_eval_expr_refl ge e m));eauto|
 eapply(proj1(simple_eval_expr_refl ge e m));eauto|exact LL|exact LOAD|exact RR|exact OP|exact CAST|exact STORE|exact TY].
Qed.
Lemma sequence_normal : forall ge e a b m ma mf out,
 Cstrategy.exec_stmt ge e m a E0 ma Out_normal ->
 Cstrategy.exec_stmt ge e ma b E0 mf out ->
 Cstrategy.exec_stmt ge e m (Ssequence a b) E0 mf out.
Proof. intros;replace E0 with (E0**E0) by reflexivity;eapply Cstrategy.exec_Sseq_1;eauto. Qed.
Lemma read_scalar : forall ge e m l ty chunk b ofs v,
 Cstrategy.eval_simple_lvalue ge e m l b ofs Full ->
 ty=typeof l -> type_is_volatile ty=false -> access_mode ty=By_value chunk ->
 Mem.loadv chunk m (Vptr b ofs)=Some v ->
 Cstrategy.eval_simple_rvalue ge e m (Evalof l ty) v.
Proof. intros; eapply Cstrategy.esr_rvalof;eauto;eapply deref_loc_value;eauto. Qed.
Lemma assign_scalar : forall ge m ty chunk b ofs v mf,
 type_is_volatile ty=false -> access_mode ty=By_value chunk ->
 Mem.storev chunk m (Vptr b ofs) v=Some mf ->
 assign_loc ge ty m b ofs Full v E0 mf v.
Proof. intros;eapply assign_loc_value;eauto. Qed.
Print Assumptions simple_eval_expr_refl.
Print Assumptions atomic_assignop.
Lemma strategy_star_csem : forall ge a t b,
 star Cstrategy.step ge a t b -> star Csem.step ge a t b.
Proof.
 intros ge a t b H;induction H.
 - constructor.
 - eapply star_trans;[apply plus_star;eapply Cstrategy.step_simulation;exact H|exact IHstar|exact H1].
Qed.
Lemma funcall_original_normal : forall ge m fd args t mf res,
 Cstrategy.eval_funcall ge m fd args t mf res ->
 star Csem.step ge (Callstate fd args Kstop m) t (Returnstate res Kstop mf).
Proof.
 intros;apply strategy_star_csem;eapply Cstrategy.eval_funcall_to_steps;[exact H|exact I].
Qed.
Print Assumptions funcall_original_normal.
Definition access_preserved (m mf:mem) : Prop := forall ch b ofs p,
 Mem.valid_access m ch b ofs p -> Mem.valid_access mf ch b ofs p.
Inductive stores_to (allowed:block->Prop) : mem->mem->Prop :=
 | stores_to_refl : forall m, stores_to allowed m m
 | stores_to_step : forall m ma mf ch b ofs v,
 allowed b -> Mem.store ch m b ofs v=Some ma -> stores_to allowed ma mf -> stores_to allowed m mf.
Lemma stores_to_trans : forall P m ma mf,
 stores_to P m ma -> stores_to P ma mf -> stores_to P m mf.
Proof. intros P m ma mf H;induction H;intros;[assumption|eapply stores_to_step;eauto]. Qed.
Lemma stores_to_access : forall P m mf, stores_to P m mf -> access_preserved m mf.
Proof.
 intros P m mf H;induction H;unfold access_preserved in *;intros;[assumption|].
 apply IHstores_to;eapply Mem.store_valid_access_1;eauto.
Qed.
Lemma stores_to_load_frame : forall P m mf, stores_to P m mf ->
 forall ch b ofs, ~P b -> Mem.load ch mf b ofs=Mem.load ch m b ofs.
Proof.
 intros P m mf H;induction H;intros ch0 b0 ofs0 NP;[reflexivity|].
 rewrite IHstores_to by exact NP.
 erewrite Mem.load_store_other by(exact H0||(left;intro;subst;contradiction));reflexivity.
Qed.
Lemma sequence_normal_inv : forall ge e a b m mf,
 Cstrategy.exec_stmt ge e m(Ssequence a b)E0 mf Out_normal ->
 exists ma, Cstrategy.exec_stmt ge e m a E0 ma Out_normal /\
 Cstrategy.exec_stmt ge e ma b E0 mf Out_normal.
Proof.
 intros ge e a b m mf H;inversion H;subst;try contradiction.
 match goal with EQ:?x ** ?y=E0 |- _=>change(x++y=[])in EQ;apply app_eq_nil in EQ as [-> ->] end.
 eexists;split;eassumption.
Qed.
Print Assumptions stores_to_load_frame.
Lemma statement_prefix_path : forall ge e m a mf,
 Cstrategy.exec_stmt ge e m a E0 mf Out_normal -> forall f k tail,
 star Csem.step ge(State f(Ssequence a tail)k e m)E0(State f tail k e mf).
Proof.
 intros ge e m a mf EVAL f k tail.
 destruct(Cstrategy.exec_stmt_to_steps ge e m a E0 mf Out_normal EVAL f(Kseq tail k))as[reached[PATH END]].
 inversion END;subst reached.
 eapply star_step with(t1:=E0)(t2:=E0);[right;apply Csem.step_seq| |reflexivity].
 eapply star_trans with(t1:=E0)(t2:=E0).
 - apply strategy_star_csem;exact PATH.
 - apply star_one;right;apply Csem.step_skip_seq.
 - reflexivity.
Qed.
Print Assumptions statement_prefix_path.
Lemma stores_to_weaken : forall P Q m mf,
 (forall b,P b ->Q b) ->stores_to P m mf ->stores_to Q m mf.
Proof.
 intros P Q m mf INC H;induction H;[constructor|eapply stores_to_step;eauto].
Qed.
#!/usr/bin/env python3
"""Recheck established auxiliaries; requested main Csem goals remain pending."""
from pathlib import Path
import argparse,hashlib,json,subprocess,sys
root=Path(__file__).resolve().parents[5]
attempt=Path(__file__).resolve().parent
parser=argparse.ArgumentParser();parser.add_argument('--auxiliary',action='store_true');args=parser.parse_args()
prov=json.loads((attempt/'provenance.json').read_text())
for relative,expected in prov['inputs'].items():
 p=root/relative
 if not p.is_file() or hashlib.sha256(p.read_bytes()).hexdigest()!=expected:
  raise SystemExit('Input hash mismatch: '+relative)
flags=[]
for path,namespace in [('paparazzi/models/guidance_pid_h_run_pos/align/model','PidPositionRunPos'),('paparazzi/relations/guidance_mode/support/semantics','FiveGuidanceSemantics'),('paparazzi/relations/guidance_mode/support/entry','FiveGuidanceEntry'),('paparazzi/relations/pid_position_translation/support','PidPositionTranslationSupport'),('paparazzi/relations/pid_position_translation/problem','PidPositionTranslationProblem'),('paparazzi/relations/pid_position_translation/attempts/001','PidPositionTranslationAttempt'),('paparazzi/models/guidance_pid_h_run_pos/rocq/no_error/problem','PidPositionNoError'),('paparazzi/models/guidance_pid_h_run_pos/rocq/termination/problem','PidPositionTermination')]:flags+=['-Q',path,namespace]
files=['paparazzi/models/guidance_pid_h_run_pos/align/model/Source.v','paparazzi/models/guidance_pid_h_run_pos/align/model/Execution.v','paparazzi/relations/guidance_mode/support/semantics/SemanticsSupport.v','paparazzi/relations/guidance_mode/support/entry/BigstepSupport.v']
files+=['paparazzi/relations/pid_position_translation/support/'+x for x in ['TranslationArithmetic.v','QuietWalk.v','MemoryLayout.v','WitnessSetup.v','RawWitness.v','GetterSemantics.v']]
files+=['paparazzi/relations/pid_position_translation/problem/Spec.v','paparazzi/relations/pid_position_translation/attempts/001/Proof.v','paparazzi/relations/pid_position_translation/attempts/001/evidence/GetterBinding.v','paparazzi/relations/pid_position_translation/attempts/001/evidence/EstablishedAssumptions.v','paparazzi/models/guidance_pid_h_run_pos/rocq/no_error/problem/Spec.v','paparazzi/models/guidance_pid_h_run_pos/rocq/termination/problem/Spec.v']
for f in files:subprocess.run(['rocq','compile','-q',*flags,f],cwd=root,check=True)
subprocess.run(['rocq','check',*flags,'PidPositionTranslationAttempt.Proof','PidPositionTranslationAttempt.evidence.GetterBinding','PidPositionTranslationSupport.QuietWalk'],cwd=root,check=True)
print(json.dumps({'auxiliary_kernel_checks':'passed','original_getter_normal_returns':'proved under stated symbolic premises','main_requested_goals':'pending','cbmc_independent_rocq_recheck':'0/124 proved'}))
raise SystemExit(0 if args.auxiliary else 1)
