FILE core/PreciseFrame.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib AST Integers Values Memory.
From PidPositionTranslationCore Require Import CoreMemory CoreSemantics CoreClamp FlightSemantics ControllerPrefix.
Import ListNotations.
Open Scope Z_scope.
Definition misses_bytes(b:block)(ofs n:Z)(u:scalar_update):Prop:=
 let '(cu,bu,ou,v):=u in b<>bu \/ofs+n<=ou \/ou+size_chunk cu<=ofs.
Lemma replay_stores_bytes_frame:forall updates m mf b ofs n,
 replay_stores m updates=Some mf ->Forall(misses_bytes b ofs n)updates ->
 0<=n ->Mem.loadbytes mf b ofs n=Mem.loadbytes m b ofs n.
Proof.
 induction updates as[|[[[cu bu]ou]v]us IH];intros m mf b ofs n RUN MISS N;cbn[replay_stores]in RUN.
 - injection RUN as<-;reflexivity.
 - destruct(Mem.store cu m bu ou v)as[ma|]eqn:ST;[|discriminate].
   inversion MISS as[|u tail HEAD TAIL];subst;rewrite(IH ma mf b ofs n RUN TAIL N).
   eapply Mem.loadbytes_store_other;[exact ST|].
   destruct HEAD as[D|[LO|HI]];[left;exact D|right;right;left;exact LO|right;right;right;exact HI].
Qed.
Definition controller_region(bx bpy bp bi:block)(u:scalar_update):Prop:=
 let '(cu,bu,ou,v):=u in
 bu=bx \/bu=bpy \/(bu=bp /\32<=ou /\ou+size_chunk cu<=40) \/
 (bu=bi /\0<=ou /\ou+size_chunk cu<=8).
Ltac update_in_controller_region:=
 cbn[controller_region];first[
 left;reflexivity|right;left;reflexivity|
 right;right;left;repeat split;try reflexivity;cbn;lia|
 right;right;right;repeat split;try reflexivity;cbn;lia].
Ltac every_controller_region:=
 lazymatch goal with
 | |-Forall _ []=>constructor
 | |-Forall _ (_::_)=>constructor;[update_in_controller_region|every_controller_region]end.
Lemma controller_updates_regions:forall bx bpy bp bi flight kp kd ki kv ka pex pey sex sey rsx rsy rax ray ix iy traj total,
 Forall(controller_region bx bpy bp bi)
 (controller_updates flight bx bpy bp bi kp kd ki kv ka pex pey sex sey rsx rsy rax ray ix iy traj total).
Proof.
 intros;cbv beta iota zeta delta[controller_updates first_four_updates clamp_updates flight_updates app];
 destruct flight;every_controller_region.
Qed.
Lemma controller_region_misses:forall bx bpy bp bi b ofs n,
 b<>bx ->b<>bpy ->
 (b<>bp \/ofs+n<=32 \/40<=ofs) ->
 (b<>bi \/ofs+n<=0 \/8<=ofs) ->
 forall u,controller_region bx bpy bp bi u ->misses_bytes b ofs n u.
Proof.
 intros bx bpy bp bi b ofs n BX BY BP BI[[[cu bu]ou]v]AL;cbn[controller_region]in AL;cbn[misses_bytes].
 destruct AL as[EQ|[EQ|[[EQ[LO HI]]|[EQ[LO HI]]]]];subst bu.
 - left;exact BX.
 - left;exact BY.
 - destruct BP as[NE|[LOW|HIGH]];[left;exact NE|right;left;lia|right;right;lia].
 - destruct BI as[NE|[LOW|HIGH]];[left;exact NE|right;left;lia|right;right;lia].
Qed.
Print Assumptions controller_updates_regions.

FILE core/ControllerPrefix.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Errors Maps AST Integers Values Memory Events Globalenvs Ctypes Cop Csyntax Csyntaxdefs Csem Cstrategy Smallstep.
From PidPositionRunPos Require Import Source Execution.
From FiveGuidanceEntry Require Import BigstepSupport.
From PidPositionTranslationSupport Require Import MemoryLayout.
From PidPositionTranslationCore Require Import FactoryMemory FactorySemantics CoreMemory CoreSemantics ClampSemantics CoreClamp FlightSemantics CoreTail.
Import ListNotations.
Open Scope Z_scope.
Definition after_feedforward(kp kd kv ka pe se rs ra traj:int):int:=
 clip_bits(feedforward_bits(pd_bits kp kd pe se)kv rs ka ra)traj.
Definition controller_command(f:bool)(kp kd ki kv ka pe se rs ra i traj total:int):int:=
 clip_bits(next_command f(after_feedforward kp kd kv ka pe se rs ra traj)(next_integral f i ki(pd_bits kp kd pe se)traj))total.
Definition controller_updates(f:bool)(bx bpy bp bi:block)(kp kd ki kv ka pex pey sex sey rsx rsy rax ray ix iy traj total:int):list scalar_update:=
 first_four_updates bx bpy bp kp kd kv ka pex pey sex sey rsx rsy rax ray++
 clamp_updates bp(feedforward_bits(pd_bits kp kd pex sex)kv rsx ka rax)(feedforward_bits(pd_bits kp kd pey sey)kv rsy ka ray)traj++
 flight_updates f bi bp(pd_bits kp kd pex sex)(pd_bits kp kd pey sey)ki ix iy
 (after_feedforward kp kd kv ka pex sex rsx rax traj)(after_feedforward kp kd kv ka pey sey rsy ray traj)traj++
 clamp_updates bp
 (next_command f(after_feedforward kp kd kv ka pex sex rsx rax traj)(next_integral f ix ki(pd_bits kp kd pex sex)traj))
 (next_command f(after_feedforward kp kd kv ka pey sey rsy ray traj)(next_integral f iy ki(pd_bits kp kd pey sey)traj))total.
Ltac miss_update :=
 cbn[misses_chunk size_chunk];
 lazymatch goal with |- (?b <> ?bu) \/ (?a <= ?c) \/ (?d <= ?f) =>
 tryif constr_eq b bu then
 (let ok:=eval vm_compute in(orb(Z.leb a c)(Z.leb d f))in
  lazymatch ok with true=>right;lia|false=>fail 1 "overlapping field"end)
 else(left;first[assumption|apply not_eq_sym;assumption])end.
Ltac each_update := lazymatch goal with|-Forall _ []=>constructor| |-Forall _ (_::_)=>constructor;[miss_update|each_update]end.

Ltac trace_frame :=
 repeat match goal with
 | RUN:replay_stores ?before ?updates=Some ?after |- context[Mem.load ?ch ?after ?b ?ofs]=>
   rewrite(replay_stores_load_frame updates before after ch b ofs RUN)by(
    cbv beta iota zeta delta[first_four_updates clamp_updates flight_updates];
    repeat match goal with|-context[if ?f then _ else _]=>destruct f end;
    each_update)
 end.
Ltac trace_access :=
 lazymatch goal with|-Mem.valid_access ?after ?ch ?b ?ofs ?perm=>
 first[assumption|
 match goal with RUN:replay_stores ?before ?updates=Some after |- _=>
 eapply(replay_stores_access updates before after ch b ofs perm RUN);trace_access end]end.
Theorem original_controller_prefix_normal:forall e m bp be bs gh bg bx bpy bi bt bu bf
 (flight:bool)kp kd ki kv ka pex pey sex sey rsx rsy rax ray ix iy traj total,
 e!S._pd_x=Some(bx,tint) ->e!S._pd_y=Some(bpy,tint) ->e!S._gh=Some(bg,tptr gh_type) ->e!S._in_flight=Some(bf,tbool) ->
 e!S._guidance_pid=None ->e!S._guidance_pid_pos_err=None ->e!S._guidance_pid_speed_err=None ->
 e!S._guidance_pid_trim_att_integrator=None ->e!S._traj_max_bank=None ->e
FILE core/FlightSemantics.v
Definition flight_updates(f:bool)(bi bp:block)(pdx pdy ki ix iy cx cy maximum:int):list scalar_update:=
 if f then [(Mint32,bi,0,Vint(Int.add ix(Int.mul ki pdx)));
 (Mint32,bi,4,Vint(Int.add iy(Int.mul ki pdy)));
 (Mint32,bi,0,Vint(next_integral true ix ki pdx maximum));
 (Mint32,bi,4,Vint(next_integral true iy ki pdy maximum));
 (Mint32,bp,32,Vint(next_command true cx(next_integral true ix ki pdx maximum)));
 (Mint32,bp,36,Vint(next_command true cy(next_integral true iy ki pdy maximum)))]
 else [(Mint32,bi,0,Vint Int.zero);(Mint32,bi,4,Vint Int.zero)].
Ltac raw_scalar_load := lazymatch goal with|-Mem.loadv ?c ?mm(Vptr ?bb ?oo)=Some ?vv=>
 let ox:=eval vm_compute in(Ptrofs.unsigned oo)in change(Mem.load c mm bb ox=Some vv);scalar_frame;first[eassumption|reflexivity]end.
Ltac flight_add EX EY NP SP NI SI NM SM STORE:=
 eapply atomic_assignop;
 [core_lv EX EY I NP I I SP I I NI SI NM SM|reflexivity|
  core_rv EX EY I NP I I SP I I NI SI NM SM|reflexivity|
  eapply deref_loc_value;[reflexivity|reflexivity|raw_scalar_load]|
  reflexivity|reflexivity|
  eapply assign_loc_value;[reflexivity|reflexivity|exact STORE]|reflexivity].
Ltac flight_clamp EX EY NP SP NI SI NM SM STORE:=
 eapply atomic_assign_expression;
 [core_lv EX EY I NP I I SP I I NI SI NM SM|reflexivity|
  eapply int32_clamp_expression;[reflexivity|reflexivity|reflexivity|reflexivity|
    core_rv EX EY I NP I I SP I I NI SI NM SM|core_rv EX EY I NP I I SP I I NI SI NM SM]|
  reflexivity|eapply assign_loc_value;[reflexivity|reflexivity|exact STORE]|reflexivity].
Theorem original_flight_integrator_normal:forall e m bx bpy bp bi bm bf(flight:bool)pdx pdy ki ix iy cx cy maximum,
 e!S._pd_x=Some(bx,tint) ->e!S._pd_y=Some(bpy,tint) ->e!S._in_flight=Some(bf,tbool) ->
 e!S._guidance_pid=None ->Genv.find_symbol ge S._guid
