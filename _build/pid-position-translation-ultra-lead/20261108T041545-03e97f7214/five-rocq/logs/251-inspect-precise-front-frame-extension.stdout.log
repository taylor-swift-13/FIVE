FILE PrefixFields.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Errors Maps AST Integers Values Memory Events Globalenvs Ctypes Cop Csyntax Csyntaxdefs Csem Cstrategy Smallstep.
From PidPositionRunPos Require Import Source Execution.
From FiveGuidanceEntry Require Import BigstepSupport.
From PidPositionTranslationSupport Require Import MemoryLayout.
From PidPositionTranslationCore Require Import FactoryMemory FactorySemantics.
From PidPositionSafety Require Import PidTermination.
From PidPositionTranslationAttempt002 Require Import EntryPrefix.
Import ListNotations.
Open Scope Z_scope.
Module S := PidPositionRunPos.Source.
Module E := PidPositionRunPos.Execution.
Local Transparent E.ge.
Lemma prefix_ge_ce : genv_cenv E.ge=ce.
Proof. unfold E.ge,Csem.globalenv,ce. cbv beta iota zeta delta [genv_cenv]. reflexivity. Qed.
Local Opaque E.ge.
Ltac p_cenv :=
 lazymatch goal with |- PTree.get ?id _ = Some ?co =>
 unify co (FactorySemantics.co_for id);rewrite prefix_ge_ce;
 apply FactorySemantics.co_for_lookup;vm_compute;reflexivity end.
Ltac p_field := rewrite prefix_ge_ce;vm_compute;reflexivity.
Ltac p_rv :=
 lazymatch goal with
 | |- eval_simple_rvalue _ _ _ (Eval _ _) _ => constructor
 | |- eval_simple_rvalue _ _ _ (Evalof ?l ?ty) _ =>
   let mode := eval hnf in (access_mode ty) in
   lazymatch mode with
   | By_copy=>eapply esr_rvalof;[p_lv|reflexivity|reflexivity|apply deref_loc_copy;reflexivity]
   | By_value ?ch=>eapply read_scalar with(chunk:=ch);
      [p_lv|reflexivity|reflexivity|reflexivity|
       lazymatch goal with |- Mem.loadv ?c ?mm (Vptr ?bb ?oo)=Some ?vv =>
       let ox := eval vm_compute in (Ptrofs.unsigned oo) in
       change(Mem.load c mm bb ox=Some vv);eassumption end]
   end
 | |- eval_simple_rvalue _ _ _ (Eaddrof _ _) _ => apply esr_addrof;p_lv
 end
with p_lv :=
 lazymatch goal with
 | |- eval_simple_lvalue _ _ _ (Evar _ _) _ _ _ =>
   first[eapply esl_var_local;eassumption|eapply esl_var_global;eassumption]
 | |- eval_simple_lvalue _ _ _ (Ederef _ _) _ _ _ => eapply esl_deref;p_rv
 | |- eval_simple_lvalue _ _ _ (Efield ?r _ _) _ _ _ =>
   let rt := eval cbv beta iota zeta delta [typeof] in(typeof r)in
   lazymatch rt with
   | Tstruct _ _=>eapply esl_field_struct;[p_rv|reflexivity|p_cenv|p_field]
   | Tunion _ _=>eapply esl_field_union;[p_rv|reflexivity|idtac|p_cenv];p_field
   end
 end.

Lemma reference_x_read : forall e m bg gh v,
 e!S._gh=Some(bg,tptr gh_type) ->
 Mem.load Mint64 m bg 0=Some(Vptr gh Ptrofs.zero) ->
 load_path Mint32 m gh gh_type[S._ref;S._pos;S._x]=Some(Vint v) ->
 eval_simple_rvalue E.ge e m(ref_position_expr S._x)(Vint v).
Proof.
 intros e m bg gh v ENV PTR FIELD.
 change(Mem.load Mint32 m gh 44=Some(Vint v))in FIELD.
 unfold ref_position_expr,gh_ref_expr,gh_expr,vec_type,gh_type;p_rv.
Qed.
Lemma reference_y_read : forall e m bg gh v,
 e!S._gh=Some(bg,tptr gh_type) ->
 Mem.load Mint64 m bg 0=Some(Vptr gh Ptrofs.zero) ->
 load_path Mint32 m gh gh_type[S._ref;S._pos;S._y]=Some(Vint v) ->
 eval_simple_rvalue E.ge e m(ref_position_expr S._y)(Vint v).
Proof.
 intros e m bg gh v ENV PTR FIELD.
 change(Mem.load Mint32 m gh 48=Some(Vint v))in FIELD.
 unfold ref_position_expr,gh_ref_expr,gh_expr,vec_type,gh_type;p_rv.
Qed.
Lemma cached_measured_x_read : forall e m sb v,
 Mem.load Mint32 m sb 100=Some(Vint v) ->
 eval_simple_rvalue E.ge e m
 (measured_axis_expr(Eval(Vptr sb(Ptrofs.repr 100))GetterSemantics.ned_ptr)S._x)(Vint v).
Proof.
 intros;unfold measured_axis_expr,GetterSemantics.ned_ptr;p_rv.
Qed.
Lemma cached_measured_y_read : forall e m sb v,
 Mem.load Mint32 m sb 104=Some(Vint v) ->
 eval_simple_rvalue E.ge e m
 (measured_axis_expr(Eval(Vptr sb(Ptrofs.repr 100))GetterSemantics.ned_ptr)S._y)(Vint v).
Proof.
 intros;unfold measured_axis_expr,GetterSemantics.ned_ptr;p_rv.
Qed.
Lemma position_error_x_lvalue : forall e m pb,
 e!S._guidance_pid_pos_err=None ->
 Genv.find_symbol E.ge S._guidance_pid_pos_err=Some pb ->
 eval_simple_lvalue E.ge e m(pid_axis_lvalue S._guidance_pid_pos_err S._x)pb Ptrofs.zero Full.
Proof.
 intros;unfold pid_axis_lvalue,pid_vec_expr,vec_type.
 change(eval_simple_lvalue E.ge e m
 (Efield(Evalof(Evar S._guidance_pid_pos_err(Tstruct S._Int32Vect2 noattr))(Tstruct S._Int32Vect2 noattr))S._x tint)
 pb(Ptrofs.add Ptrofs.zero(Ptrofs.repr 0))Full).
 p_lv.
Qed.
Lemma position_error_y_lvalue : forall e m pb,
 e!S._guidance_pid_pos_err=None ->
 Genv.find_symbol E.ge S._guidance_pid_pos_err=Some pb ->
 eval_simple_lvalue E.ge e m(pid_axis_lvalue S._guidance_pid_pos_err S._y)pb(Ptrofs.repr 4)Full.
Proof.
 intros;unfold pid_axis_lvalue,pid_vec_expr,vec_type.
 change(eval_simple_lvalue E.ge e m
 (Efield(Evalof(Evar S._guidance_pid_pos_err(Tstruct S._Int32Vect2 noattr))(Tstruct S._Int32Vect2 noattr))S._y tint)
 pb(Ptrofs.add Ptrofs.zero(Ptrofs.repr 4))Full).
 p_lv.
Qed.
Print Assumptions reference_x_read.

Local Transparent PidTermination.ge PidTermination.ast_prog.
Lemma concrete_position_getter_target :
 exists fb,
 Genv.find_symbol E.ge S._stateGetPositionNed_i=Some fb /\
 Genv.find_funct E.ge(Vptr fb Ptrofs.zero)=Some(Internal S.f_stateGetPositionNed_i).
Proof.
 exists(PidTermination.symbol_block S._stateGetPositionNed_i);split.
 - change(Genv.find_symbol(genv_genv PidTermination.ge)S._stateGetPositionNed_i=Some(PidTermination.symbol_block S._stateGetPositionNed_i)).
   rewrite PidTermination.ge_base;vm_compute;reflexivity.
 - change(Genv.find_funct_ptr(genv_genv PidTermination.ge)(PidTermination.symbol_block S._stateGetPositionNed_i)=Some(Internal S.f_stateGetPositionNed_i)).
   rewrite PidTermination.ge_base;vm_compute;reflexivity.
Qed.
Local Opaque PidTermination.ge.

Lemma actual_cached_position_call : forall e m sb flags,
 e!S._stateGetPositionNed_i=None ->
 Genv.find_symbol E.ge S._state=Some sb ->
 Mem.load Mint16unsigned m sb 2=Some(Vint flags) ->
 Int.and flags(Int.repr 2)=Int.repr 2 ->
 Cstrategy.eval_expr E.ge e m RV pos_getter_call E0 m
 (Eval(Vptr sb(Ptrofs.repr 100))GetterSemantics.ned_ptr).
Proof.
 intros e m sb flags LOCAL STATE LOAD VALID.
 destruct concrete_position_getter_target as[fb[SYM FUN]].
 eapply original_position_call_evaluates with(fb:=fb)(co:=FactorySemantics.co_for S._State)(flags:=flags).
 - exact LOCAL.
 - exact SYM.
 - exact FUN.
 - exact STATE.
 - p_cenv.
 - p_field.
 - p_field.
 - exact LOAD.
 - exact VALID.
Qed.

Theorem original_two_position_assignments : forall e m bg gh pb sb rx ry px py flags,
 e!S._gh=Some(bg,tptr gh_type) ->
 e!S._guidance_pid_pos_err=None ->
 e!S._stateGetPositionNed_i=None ->
 Genv.find_symbol E.ge S._guidance_pid_pos_err=Some pb ->
 Genv.find_symbol E.ge S._state=Some sb ->
 bg<>pb -> gh<>pb ->sb<>pb ->
 Mem.load Mint64 m bg 0=Some(Vptr gh Ptrofs.zero) ->
 load_path Mint32 m gh gh_type[S._ref;S._pos;S._x]=Some(Vint rx) ->
 load_path Mint32 m gh gh_type[S._ref;S._pos;S._y]=Some(Vint ry) ->
 Mem.load Mint32 m sb 100=Some(Vint px) ->
 Mem.load Mint32 m sb 104=Some(Vint py) ->
 Mem.load Mint16unsigned m sb 2=Some(Vint flags) ->
 Int.and flags(Int.repr 2)=Int.repr 2 ->
 Mem.range_perm m pb 0 8 Cur Writable ->
 exists mf,
 Cstrategy.exec_stmt E.ge e m
 (Ssequence(original_position_assignment S._x)(original_position_assignment S._y))E0 mf Out_normal /\
 Mem.load Mint32 mf pb 0=Some(Vint(Int.sub rx px)) /\
 Mem.load Mint32 mf pb 4=Some(Vint(Int.sub ry py)) /\
 raw_writes(fun b=>b=pb)m mf.
Proof.
 intros e m bg gh pb sb rx ry px py flags ENV LOCAL GET SYM STATE DBG DGH DS PTR RX RY PX PY CACHE VALID WRITE.
 assert(A0:Mem.valid_access m Mint32 pb 0 Writable).
 { apply scalar_access_inside with(n:=8);try exact WRITE;try change(4|0);try(exists 0;reflexivity);cbn;lia. }
 destruct(Mem.valid_access_store m Mint32 pb 0(Vint(Int.sub rx px))A0)as[m1 ST0].
 assert(A4:Mem.valid_access m1 Mint32 pb 4 Writable).
 { eapply Mem.store_valid_access_1;[exact ST0|].
   apply scalar_access_inside with(n:=8);try exact WRITE;try change(4|4);try(exists 1;reflexivity);cbn;lia. }
 destruct(Mem.valid_access_store m1 Mint32 pb 4(Vint(Int.sub ry py))A4)as[mf ST4].
 exists mf;split.
 - eapply sequence_normal with(ma:=m1).
   + eapply original_position_assignment_exec with(ra:=rx)(pa:=px)(sb:=sb)(delta:=100).
     * apply position_error_x_lvalue;[exact LOCAL|exact SYM].
     * eapply reference_x_read;eassumption.
     * eapply actual_cached_position_call;eassumption.
     * apply cached_measured_x_read;exact PX.
     * change(Mem.store Mint32 m pb 0(Vint(Int.sub rx px))=Some m1);exact ST0.
   + eapply original_position_assignment_exec with(ra:=ry)(pa:=py)(sb:=sb)(delta:=100).
     * apply position_error_y_lvalue;[exact LOCAL|exact SYM].
     * eapply reference_y_read;[exact ENV| |].
       -- erewrite Mem.load_store_other;[exact PTR|exact ST0|left;exact DBG].
       -- change(Mem.load Mint32 m1 gh 48=Some(Vint ry)).
          erewrite Mem.load_store_other;[exact RY|exact ST0|left;exact DGH].
     * eapply actual_cached_position_call;try eassumption.
       erewrite Mem.load_store_other;[exact CACHE|exact ST0|left;exact DS].
     * apply cached_measured_y_read.
       erewrite Mem.load_store_other;[exact PY|exact ST0|left;exact DS].
     * change(Mem.store Mint32 m1 pb 4(Vint(Int.sub ry py))=Some mf);exact ST4.
 - split.
   + rewrite(Mem.load_store_other Mint32 m1 pb 4(Vint(Int.sub ry py))mf ST4 Mint32 pb 0)
      by(right;left;cbn;lia).
     rewrite(Mem.load_store_same Mint32 m pb 0(Vint(Int.sub rx px))m1 ST0);reflexivity.
   + split.
     * rewrite(Mem.load_store_same Mint32 m1 pb 4(Vint(Int.sub ry py))mf ST4);reflexivity.
     * eapply raw_writes_store;[reflexivity|exact ST0|].
       eapply raw_writes_store;[reflexivity|exact ST4|constructor].
Qed.
Print Assumptions original_two_position_assignments.

FILE ClampCombination.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Errors Maps AST Integers Floats Values Memory Events Globalenvs Ctypes Cop Csyntax Csyntaxdefs Csem Cstrategy Smallstep.
From PidPositionRunPos Require Import Source Execution.
From FiveGuidanceEntry Require Import BigstepSupport.
From PidPositionTranslationSupport Require Import MemoryLayout.
From PidPositionTranslationCore Require Import FactoryMemory FactorySemantics.
From PidPositionTranslationAttempt002 Require Import EntryPrefix ClampSemantics PrefixFields.
Import ListNotations.
Open Scope Z_scope.
Module S := PidPositionRunPos.Source.
Module E := PidPositionRunPos.Execution.
Local Opaque E.ge.

Lemma global_axis_x_lvalue : forall e m id pb,
 e!id=None ->Genv.find_symbol E.ge id=Some pb ->
 eval_simple_lvalue E.ge e m(pid_axis_lvalue id S._x)pb Ptrofs.zero Full.
Proof.
 intros;unfold pid_axis_lvalue,pid_vec_expr,vec_type.
 change(eval_simple_lvalue E.ge e m
 (Efield(Evalof(Evar id(Tstruct S._Int32Vect2 noattr))(Tstruct S._Int32Vect2 noattr))S._x tint)
 pb(Ptrofs.add Ptrofs.zero(Ptrofs.repr 0))Full).
 p_lv.
Qed.
Lemma global_axis_y_lvalue : forall e m id pb,
 e!id=None ->Genv.find_symbol E.ge id=Some pb ->
 eval_simple_lvalue E.ge e m(pid_axis_lvalue id S._y)pb(Ptrofs.repr 4)Full.
Proof.
 intros;unfold pid_axis_lvalue,pid_vec_expr,vec_type.
 change(eval_simple_lvalue E.ge e m
 (Efield(Evalof(Evar id(Tstruct S._Int32Vect2 noattr))(Tstruct S._Int32Vect2 noattr))S._y tint)
 pb(Ptrofs.add Ptrofs.zero(Ptrofs.repr 4))Full).
 p_lv.
Qed.
Definition global_clamp_assignment(id axis:ident)(shift:Z):=
 Sdo(Eassign(pid_axis_lvalue id axis)(source_clamp(Evalof(pid_axis_lvalue id axis)tint)shift)tint).

Theorem original_two_global_clamps : forall e m id pb x y shift bound,
 e!id=None ->Genv.find_symbol E.ge id=Some pb ->
 Mem.load Mint32 m pb 0=Some(Vint x) ->
 Mem.load Mint32 m pb 4=Some(Vint y) ->
 Mem.range_perm m pb 0 8 Cur Writable ->
 (forall e' m',eval_simple_rvalue E.ge e' m'(source_bound shift)(Vfloat(Float.of_int bound))) ->
 Float.neg(Float.of_int bound)=Float.of_int(Int.neg bound) ->
 exists mf,
 Cstrategy.exec_stmt E.ge e m
 (Ssequence(global_clamp_assignment id S._x shift)(global_clamp_assignment id S._y shift))E0 mf Out_normal /\
 Mem.load Mint32 mf pb 0=Some(Vint(clamp_bits x bound)) /\
 Mem.load Mint32 mf pb 4=Some(Vint(clamp_bits y bound)) /\
 raw_writes(fun b=>b=pb)m mf.
Proof.
 intros e m id pb x y shift bound LOCAL SYM X Y WRITE BOUND NEG.
 assert(A0:Mem.valid_access m Mint32 pb 0 Writable).
 { apply scalar_access_inside with(n:=8);try exact WRITE;try change(4|0);try(exists 0;reflexivity);cbn;lia. }
 destruct(source_clamp_assignment_exact_exists e m(pid_axis_lvalue id S._x)x shift bound pb Ptrofs.zero
 eq_refl eq_refl ltac:(apply global_axis_x_lvalue;assumption)ltac:(change(Mem.load Mint32 m pb 0=Some(Vint x));exact X)
 ltac:(exact A0)(BOUND e m)NEG)as[m1[EX[STX POSTX]]].
 pose proof(Mem.storev_store _ _ _ _ _ _ STX)as ST0.
 assert(A4:Mem.valid_access m1 Mint32 pb 4 Writable).
 { eapply Mem.store_valid_access_1;[exact ST0|].
   apply scalar_access_inside with(n:=8);try exact WRITE;try change(4|4);try(exists 1;reflexivity);cbn;lia. }
 assert(Y1:Mem.loadv Mint32 m1(Vptr pb(Ptrofs.repr 4))=Some(Vint y)).
 { change(Mem.load Mint32 m1 pb 4=Some(Vint y)).
   rewrite(Mem.load_store_other Mint32 m pb 0(Vint(clamp_bits x bound))m1 ST0 Mint32 pb 4)
   by(right;right;cbn;lia);exact Y. }
 destruct(source_clamp_assignment_exact_exists e m1(pid_axis_lvalue id S._y)y shift bound pb(Ptrofs.repr 4)
 eq_refl eq_refl ltac:(apply global_axis_y_lvalue;assumption)Y1
 ltac:(change(Mem.valid_access m1 Mint32 pb 4 Writable);exact A4)(BOUND e m1)NEG)as[mf[EY[STY POSTY]]].
 pose proof(Mem.storev_store _ _ _ _ _ _ STY)as ST4.
 exists mf;split.
 - apply sequence_normal with(ma:=m1);assumption.
 - split.
   + change(Mem.load Mint32 m1 pb 0=Some(Vint(clamp_bits x bound)))in POSTX.
     rewrite(Mem.load_store_other Mint32 m1 pb 4(Vint(clamp_bits y bound))mf ST4 Mint32 pb 0)
      by(right;left;cbn;lia);exact POSTX.
   + split.
     * change(Mem.load Mint32 mf pb 4=Some(Vint(clamp_bits y bound)))in POSTY;exact POSTY.
     * eapply raw_writes_store;[reflexivity|exact ST0|].
       eapply raw_writes_store;[reflexivity|exact ST4|constructor].
Qed.
Print Assumptions original_two_global_clamps.

FILE FrontSemantics.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Errors Maps AST Integers Values Memory Events Globalenvs Ctypes Cop Csyntax Csyntaxdefs Csem Cstrategy Smallstep.
From PidPositionRunPos Require Import Source Execution.
From FiveGuidanceEntry Require Import BigstepSupport.
From PidPositionTranslationSupport Require Import MemoryLayout.
From PidPositionTranslationCore Require Import FactoryMemory.
From PidPositionTranslationAttempt002 Require Import EntryPrefix SpeedEntryPrefix ClampSemantics PrefixFields SpeedPrefixFields ClampCombination.
Import ListNotations.
Open Scope Z_scope.
Module S := PidPositionRunPos.Source.
Module E := PidPositionRunPos.Execution.
Definition position_assign_pair:=Ssequence(original_position_assignment S._x)(original_position_assignment S._y).
Definition position_clamp_pair:=Ssequence(original_position_clamp S._x)(original_position_clamp S._y).
Definition speed_assign_pair:=Ssequence(original_speed_assignment S._x)(original_speed_assignment S._y).
Definition speed_clamp_pair:=Ssequence(original_speed_clamp S._x)(original_speed_clamp S._y).
Definition after_front:statement:=
 match fn_body S.f_guidance_pid_h_run_pos with
 | Ssequence _ (Ssequence _ (Ssequence _ (Ssequence _ tail)))=>tail|_=>Sskip end.
Lemma original_front_ast :
 fn_body S.f_guidance_pid_h_run_pos=
 Ssequence position_assign_pair(Ssequence position_clamp_pair(Ssequence speed_assign_pair(Ssequence speed_clamp_pair after_front))).
Proof. reflexivity. Qed.
Lemma original_front_path : forall e k m m1 m2 m3 mf,
 Cstrategy.exec_stmt E.ge e m position_assign_pair E0 m1 Out_normal ->
 Cstrategy.exec_stmt E.ge e m1 position_clamp_pair E0 m2 Out_normal ->
 Cstrategy.exec_stmt E.ge e m2 speed_assign_pair E0 m3 Out_normal ->
 Cstrategy.exec_stmt E.ge e m3 speed_clamp_pair E0 mf Out_normal ->
 star Csem.step E.ge(State S.f_guidance_pid_h_run_pos(fn_body S.f_guidance_pid_h_run_pos)k e m)E0
 (State S.f_guidance_pid_h_run_pos after_front k e mf).
Proof.
 intros e k m m1 m2 m3 mf A B C D;rewrite original_front_ast.
 eapply star_trans with(t1:=E0)(t2:=E0);[apply statement_prefix_path;exact A| |reflexivity].
 eapply star_trans with(t1:=E0)(t2:=E0);[apply statement_prefix_path;exact B| |reflexivity].
 eapply star_trans with(t1:=E0)(t2:=E0);[apply statement_prefix_path;exact C| |reflexivity].
 apply statement_prefix_path;exact D.
Qed.
Lemma front_writes_weaken : forall P Q m mf,
 (forall b,P b->Q b)->raw_writes P m mf->raw_writes Q m mf.
Proof.
 intros P Q m mf INC W;induction W;[constructor|eapply raw_writes_store;eauto|eapply raw_writes_bytes;eauto].
Qed.

Theorem original_front_constructive : forall e m bg gh pb vb sb rx ry px py sx sy vx vy flags sflags,
 e!S._gh=Some(bg,tptr gh_type) ->
 e!S._guidance_pid_pos_err=None ->e!S._guidance_pid_speed_err=None ->
 e!S._stateGetPositionNed_i=None ->e!S._stateGetSpeedNed_i=None ->
 Genv.find_symbol E.ge S._guidance_pid_pos_err=Some pb ->
 Genv.find_symbol E.ge S._guidance_pid_speed_err=Some vb ->
 Genv.find_symbol E.ge S._state=Some sb ->
 NoDup[bg;gh;pb;vb;sb] ->
 Mem.load Mint64 m bg 0=Some(Vptr gh Ptrofs.zero) ->
 load_path Mint32 m gh gh_type[S._ref;S._pos;S._x]=Some(Vint rx) ->
 load_path Mint32 m gh gh_type[S._ref;S._pos;S._y]=Some(Vint ry) ->
 load_path Mint32 m gh gh_type[S._ref;S._speed;S._x]=Some(Vint sx) ->
 load_path Mint32 m gh gh_type[S._ref;S._speed;S._y]=Some(Vint sy) ->
 Mem.load Mint32 m sb 100=Some(Vint px) ->Mem.load Mint32 m sb 104=Some(Vint py) ->
 Mem.load Mint32 m sb 296=Some(Vint vx) ->Mem.load Mint32 m sb 300=Some(Vint vy) ->
 Mem.load Mint16unsigned m sb 2=Some(Vint flags) ->
 Mem.load Mint16unsigned m sb 280=Some(Vint sflags) ->
 Int.and flags(Int.repr 2)=Int.repr 2 ->Int.and sflags(Int.repr 2)=Int.repr 2 ->
 Mem.range_perm m pb 0 8 Cur Writable ->Mem.range_perm m vb 0 8 Cur Writable ->
 exists mf,
 (forall k,star Csem.step E.ge(State S.f_guidance_pid_h_run_pos(fn_body S.f_guidance_pid_h_run_pos)k e m)E0
 (State S.f_guidance_pid_h_run_pos after_front k e mf)) /\
 Mem.load Mint32 mf pb 0=Some(Vint(clamp_bits(Int.sub rx px)(Int.repr 4096))) /\
 Mem.load Mint32 mf pb 4=Some(Vint(clamp_bits(Int.sub ry py)(Int.repr 4096))) /\
 Mem.load Mint32 mf vb 0=Some(Vint(clamp_bits(Int.sub sx vx)(Int.repr 8388608))) /\
 Mem.load Mint32 mf vb 4=Some(Vint(clamp_bits(Int.sub sy vy)(Int.repr 8388608))) /\
 raw_writes(fun b=>b=pb\/b=vb)m mf.
Proof.
 intros e m bg gh pb vb sb rx ry px py sx sy vx vy flags sflags
 ENV LP LV GP GV SP SV STATE ND PTR RX RY SX SY PX PY VX VY CACHE SCACHE VALID SVALID WP WV.
 assert(DIST:bg<>pb /\ gh<>pb /\ sb<>pb /\ bg<>vb /\ gh<>vb /\ sb<>vb /\ pb<>vb).
 { repeat rewrite NoDup_cons_iff in ND;cbn in ND;intuition congruence. }
 destruct DIST as[DBG[DGH[DS[DVBG[DVGH[DVS DPV]]]]]].
 destruct(original_two_position_assignments e m bg gh pb sb rx ry px py flags
 ENV LP GP SP STATE DBG DGH DS PTR RX RY PX PY CACHE VALID WP)as[m1[POS[X1[Y1 W1]]]].
 destruct(original_two_global_clamps e m1 S._guidance_pid_pos_err pb (Int.sub rx px)(Int.sub ry py)8(Int.repr 4096)
 LP SP X1 Y1 ltac:(eapply raw_writes_range;[exact W1|exact WP])source_bound_8 position_bound_neg)
 as[m2[PCL[X2[Y2 W2]]]].
 assert(WPOS:raw_writes(fun b=>b=pb)m m2)by(eapply raw_writes_trans;eauto).
 assert(PTR2:Mem.load Mint64 m2 bg 0=Some(Vptr gh Ptrofs.zero)).
 { rewrite(raw_writes_load_frame _ _ _ WPOS Mint64 bg 0)by(congruence);exact PTR. }
 assert(SX2:load_path Mint32 m2 gh gh_type[S._ref;S._speed;S._x]=Some(Vint sx)).
 { change(Mem.load Mint32 m2 gh 52=Some(Vint sx)).
   rewrite(raw_writes_load_frame _ _ _ WPOS Mint32 gh 52)by(congruence);exact SX. }
 assert(SY2:load_path Mint32 m2 gh gh_type[S._ref;S._speed;S._y]=Some(Vint sy)).
 { change(Mem.load Mint32 m2 gh 56=Some(Vint sy)).
   rewrite(raw_writes_load_frame _ _ _ WPOS Mint32 gh 56)by(congruence);exact SY. }
 assert(VX2:Mem.load Mint32 m2 sb 296=Some(Vint vx)).
 { rewrite(raw_writes_load_frame _ _ _ WPOS Mint32 sb 296)by(congruence);exact VX. }
 assert(VY2:Mem.load Mint32 m2 sb 300=Some(Vint vy)).
