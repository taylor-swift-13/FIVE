Genv.init_data_list_aligned =
fix init_data_list_aligned
  (p : BinNums.Z) (il : list AST.init_data) {struct il} : Prop :=
  match il with
  | nil => True
  | (i1 :: il0)%list =>
      BinInt.Z.divide (Genv.init_data_alignment i1) p /\
      init_data_list_aligned (BinInt.Z.add p (AST.init_data_size i1)) il0
  end
     : BinNums.Z -> list AST.init_data -> Prop

Arguments Genv.init_data_list_aligned p%_Z_scope il%_list_scope
Genv.init_data_alignment =
fun i : AST.init_data =>
match i with
| AST.Init_int16 _ => BinInt.Z.pos (BinNums.xO BinNums.xH)
| AST.Init_int64 _ => Archi.align_int64
| AST.Init_int32 _ | AST.Init_float32 _ =>
    BinInt.Z.pos (BinNums.xO (BinNums.xO BinNums.xH))
| AST.Init_float64 _ => Archi.align_float64
| AST.Init_addrof _ _ =>
    if Archi.ptr64
    then BinInt.Z.pos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))
    else BinInt.Z.pos (BinNums.xO (BinNums.xO BinNums.xH))
| _ => BinInt.Z.pos BinNums.xH
end
     : AST.init_data -> BinNums.Z

Arguments Genv.init_data_alignment i
Genv.read_as_zero =
fun (m : Memory.Mem.mem) (b : Values.block) (ofs len : BinNums.Z) =>
forall (chunk : AST.memory_chunk) (p : BinNums.Z),
BinInt.Z.le ofs p ->
BinInt.Z.le (BinInt.Z.add p (Memdata.size_chunk chunk))
  (BinInt.Z.add ofs len) ->
BinInt.Z.divide (Memdata.align_chunk chunk) p ->
Memory.Mem.load chunk m b p =
Some
  match chunk with
  | AST.Mint64 => Values.Vlong Integers.Int64.zero
  | AST.Mfloat32 => Values.Vsingle Floats.Float32.zero
  | AST.Mfloat64 => Values.Vfloat Floats.Float.zero
  | AST.Many32 | AST.Many64 => Values.Vundef
  | _ => Values.Vint Integers.Int.zero
  end
     : Memory.Mem.mem -> Values.block -> BinNums.Z -> BinNums.Z -> Prop

Arguments Genv.read_as_zero m b (ofs len)%_Z_scope
Genv.store_zeros_read_as_zero:
  forall (m : Memory.Mem.mem) (b : Values.block) [p : BinNums.Z]
    (n : BinNums.Z) [m' : Memory.Mem.mem],
  store_zeros m b p n = Some m' -> Genv.read_as_zero m' b p n
Genv.read_as_zero_unchanged:
  forall [P : Values.block -> BinNums.Z -> Prop] [m : Memory.Mem.mem]
    [b : Values.block] [ofs len : BinNums.Z] [m' : Memory.Mem.mem],
  Genv.read_as_zero m b ofs len ->
  Memory.Mem.unchanged_on P m m' ->
  (forall i : BinNums.Z,
   BinInt.Z.le ofs i /\ BinInt.Z.lt i (BinInt.Z.add ofs len) -> P b i) ->
  Genv.read_as_zero m' b ofs len
Genv.store_init_data_list_charact:
  forall [F V : Type] (ge : Genv.t F V) [b : Values.block]
    (il : list AST.init_data) [m : Memory.Mem.mem] 
    [p : BinNums.Z] [m' : Memory.Mem.mem],
  Genv.store_init_data_list ge m b p il = Some m' ->
  Genv.read_as_zero m b p (AST.init_data_list_size il) ->
  Genv.load_store_init_data ge m' b p il
(use "About" for full details on the implicit arguments of
 Genv.read_as_zero_unchanged and Genv.store_zeros_read_as_zero)
