Inductive
alloc_variables (ge : genv)
  : env ->
    Memory.Mem.mem ->
    list (AST.ident * Ctypes.type) -> env -> Memory.Mem.mem -> Prop :=
    alloc_variables_nil : forall (e : env) (m : Memory.Mem.mem),
                          alloc_variables ge e m nil e m
  | alloc_variables_cons : forall
                             (e : Maps.PTree.tree
                                    (Values.block * Ctypes.type))
                             (m : Memory.Mem.mem) 
                             (id : BinNums.positive) 
                             (ty : Ctypes.type)
                             (vars : list (AST.ident * Ctypes.type))
                             (m1 : Memory.Mem.mem') 
                             (b1 : Values.block) (m2 : Memory.Mem.mem)
                             (e2 : env),
                           Memory.Mem.alloc m BinNums.Z0
                             (Ctypes.sizeof ge ty) =
                           (m1, b1) ->
                           alloc_variables ge (Maps.PTree.set id (b1, ty) e)
                             m1 vars e2 m2 ->
                           alloc_variables ge e m ((id, ty) :: vars) e2 m2.

Arguments alloc_variables ge _ _ _%_list_scope _ _
Arguments alloc_variables_nil ge e m
Arguments alloc_variables_cons ge e m id%_positive_scope 
  ty vars%_list_scope m1 b1 m2 e2 _ _
Inductive
bind_parameters (ge : genv) (e : env)
  : Memory.Mem.mem ->
    list (AST.ident * Ctypes.type) ->
    list Values.val -> Memory.Mem.mem -> Prop :=
    bind_parameters_nil : forall m : Memory.Mem.mem,
                          bind_parameters ge e m nil nil m
  | bind_parameters_cons : forall (m : Memory.Mem.mem)
                             (id : BinNums.positive) 
                             (ty : Ctypes.type)
                             (params : list (AST.ident * Ctypes.type))
                             (v1 : Values.val) (vl : list Values.val)
                             (v1' : Values.val) (b : Values.block)
                             (m1 m2 : Memory.Mem.mem),
                           Maps.PTree.get id e = Some (b, ty) ->
                           assign_loc ge ty m b Integers.Ptrofs.zero
                             Ctypes.Full v1 Events.E0 m1 v1' ->
                           bind_parameters ge e m1 params vl m2 ->
                           bind_parameters ge e m 
                             ((id, ty) :: params) 
                             (v1 :: vl) m2.

Arguments bind_parameters ge e _ (_ _)%_list_scope _
Arguments bind_parameters_nil ge e m
Arguments bind_parameters_cons ge e m id%_positive_scope 
  ty params%_list_scope v1 vl%_list_scope v1' b m1 
  m2 _ _ _
Inductive
eval_simple_lvalue (ge : genv) (e : env) (m : Memory.Mem.mem)
  : Csyntax.expr ->
    Values.block -> Integers.Ptrofs.int -> Ctypes.bitfield -> Prop :=
    esl_loc : forall (b : Values.block) (ofs : Integers.Ptrofs.int)
                (ty : Ctypes.type) (bf : Ctypes.bitfield),
              eval_simple_lvalue ge e m (Csyntax.Eloc b ofs bf ty) b ofs bf
  | esl_var_local : forall (x : BinNums.positive) 
                      (ty : Ctypes.type) (b : Values.block),
                    Maps.PTree.get x e = Some (b, ty) ->
                    eval_simple_lvalue ge e m (Csyntax.Evar x ty) b
                      Integers.Ptrofs.zero Ctypes.Full
  | esl_var_global : forall (x : BinNums.positive) 
                       (ty : Ctypes.type) (b : Values.block),
                     Maps.PTree.get x e = None ->
                     Globalenvs.Genv.find_symbol ge x = Some b ->
                     eval_simple_lvalue ge e m (Csyntax.Evar x ty) b
                       Integers.Ptrofs.zero Ctypes.Full
  | esl_deref : forall (r : Csyntax.expr) (ty : Ctypes.type)
                  (b : Values.block) (ofs : Integers.Ptrofs.int),
                eval_simple_rvalue ge e m r (Values.Vptr b ofs) ->
                eval_simple_lvalue ge e m (Csyntax.Ederef r ty) b ofs
                  Ctypes.Full
  | esl_field_struct : forall (r : Csyntax.expr) (f : AST.ident)
                         (ty : Ctypes.type) (b : Values.block)
                         (ofs : Integers.Ptrofs.int) 
                         (id : AST.ident) (co : Ctypes.composite)
                         (a : Ctypes.attr) (delta : BinNums.Z)
                         (bf : Ctypes.bitfield),
                       eval_simple_rvalue ge e m r (Values.Vptr b ofs) ->
                       Csyntax.typeof r = Ctypes.Tstruct id a ->
                       Maps.PTree.get id ge = Some co ->
                       Ctypes.field_offset ge f (Ctypes.co_members co) =
                       Errors.OK (delta, bf) ->
                       eval_simple_lvalue ge e m (Csyntax.Efield r f ty) b
                         (Integers.Ptrofs.add ofs
                            (Integers.Ptrofs.repr delta))
                         bf
  | esl_field_union : forall (r : Csyntax.expr) (f : AST.ident)
                        (ty : Ctypes.type) (b : Values.block)
                        (ofs : Integers.Ptrofs.int) 
                        (id : AST.ident) (co : Ctypes.composite)
                        (a : Ctypes.attr) (delta : BinNums.Z)
                        (bf : Ctypes.bitfield),
                      eval_simple_rvalue ge e m r (Values.Vptr b ofs) ->
                      Csyntax.typeof r = Ctypes.Tunion id a ->
                      Ctypes.union_field_offset ge f (Ctypes.co_members co) =
                      Errors.OK (delta, bf) ->
                      Maps.PTree.get id ge = Some co ->
                      eval_simple_lvalue ge e m (Csyntax.Efield r f ty) b
                        (Integers.Ptrofs.add ofs (Integers.Ptrofs.repr delta))
                        bf
  with eval_simple_rvalue (ge : genv) (e : env) (m : Memory.Mem.mem)
         : Csyntax.expr -> Values.val -> Prop :=
    esr_val : forall (v : Values.val) (ty : Ctypes.type),
              eval_simple_rvalue ge e m (Csyntax.Eval v ty) v
  | esr_rvalof : forall (b : Values.block) (ofs : Integers.Ptrofs.int)
                   (bf : Ctypes.bitfield) (l : Csyntax.expr)
                   (ty : Ctypes.type) (v : Values.val),
                 eval_simple_lvalue ge e m l b ofs bf ->
                 ty = Csyntax.typeof l ->
                 Ctypes.type_is_volatile ty = false ->
                 deref_loc ge ty m b ofs bf Events.E0 v ->
                 eval_simple_rvalue ge e m (Csyntax.Evalof l ty) v
  | esr_addrof : forall (b : Values.block) (ofs : Integers.Ptrofs.int)
                   (l : Csyntax.expr) (ty : Ctypes.type),
                 eval_simple_lvalue ge e m l b ofs Ctypes.Full ->
                 eval_simple_rvalue ge e m (Csyntax.Eaddrof l ty)
                   (Values.Vptr b ofs)
  | esr_unop : forall (op : Cop.unary_operation) (r1 : Csyntax.expr)
                 (ty : Ctypes.type) (v1 v : Values.val),
               eval_simple_rvalue ge e m r1 v1 ->
               Cop.sem_unary_operation op v1 (Csyntax.typeof r1) m = Some v ->
               eval_simple_rvalue ge e m (Csyntax.Eunop op r1 ty) v
  | esr_binop : forall (op : Cop.binary_operation) 
                  (r1 r2 : Csyntax.expr) (ty : Ctypes.type)
                  (v1 v2 v : Values.val),
                eval_simple_rvalue ge e m r1 v1 ->
                eval_simple_rvalue ge e m r2 v2 ->
                Cop.sem_binary_operation ge op v1 
                  (Csyntax.typeof r1) v2 (Csyntax.typeof r2) m =
                Some v ->
                eval_simple_rvalue ge e m (Csyntax.Ebinop op r1 r2 ty) v
  | esr_cast : forall (ty : Ctypes.type) (r1 : Csyntax.expr)
                 (v1 v : Values.val),
               eval_simple_rvalue ge e m r1 v1 ->
               Cop.sem_cast v1 (Csyntax.typeof r1) ty m = Some v ->
               eval_simple_rvalue ge e m (Csyntax.Ecast r1 ty) v
  | esr_sizeof : forall ty1 ty : Ctypes.type,
                 eval_simple_rvalue ge e m (Csyntax.Esizeof ty1 ty)
                   (Values.Vptrofs
                      (Integers.Ptrofs.repr (Ctypes.sizeof ge ty1)))
  | esr_alignof : forall ty1 ty : Ctypes.type,
                  eval_simple_rvalue ge e m (Csyntax.Ealignof ty1 ty)
                    (Values.Vptrofs
                       (Integers.Ptrofs.repr (Ctypes.alignof ge ty1))).

