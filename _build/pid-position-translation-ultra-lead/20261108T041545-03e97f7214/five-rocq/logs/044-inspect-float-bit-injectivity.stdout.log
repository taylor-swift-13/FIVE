Float.to_of_bits:
  forall b : Integers.Int64.int, Float.to_bits (Float.of_bits b) = b
Float.of_to_bits: forall f : float, Float.of_bits (Float.to_bits f) = f
Float.eq_dec
     : forall f1 f2 : float, {f1 = f2} + {f1 <> f2}
Float.of_bits =
fun b : Integers.Int64.int => Bits.b64_of_bits (Integers.Int64.unsigned b)
