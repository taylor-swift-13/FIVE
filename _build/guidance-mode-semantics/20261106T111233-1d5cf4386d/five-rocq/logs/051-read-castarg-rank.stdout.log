194:Inductive cast_arguments (m: mem): exprlist -> list type -> list val -> Prop :=
195-  | cast_args_nil:
196-      cast_arguments m Enil nil nil
197-  | cast_args_cons: forall v ty el targ1 targs v1 vl,
198-      sem_cast v ty targ1 m = Some v1 -> cast_arguments m el targs vl ->
199-      cast_arguments m (Econs (Eval v ty) el) (targ1 :: targs) (v1 :: vl).
