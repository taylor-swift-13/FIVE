  k : cont
  e : env
  m : Memory.Mem.mem
  fd : Csyntax.fundef
  vargs : list val
  ty : type
  STEP :
    estep ge (ExprState f (C a) k e m) E0
      (Callstate fd vargs (Kcall f e C ty k) m)
  BUD : activation_rank fd + 2 < expression_rank a
  H : callred ge a m fd vargs ty
  H0 : context RV RV C
