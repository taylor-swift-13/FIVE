530:Fixpoint call_cont (k: cont) : cont :=
534:  | Kseq s k => call_cont k
535:  | Kifthenelse s1 s2 k => call_cont k
536:  | Kwhile1 e s k => call_cont k
537:  | Kwhile2 e s k => call_cont k
538:  | Kdowhile1 e s k => call_cont k
539:  | Kdowhile2 e s k => call_cont k
540:  | Kfor2 e2 e3 s k => call_cont k
541:  | Kfor3 e2 e3 s k => call_cont k
542:  | Kfor4 e2 e3 s k => call_cont k
543:  | Kswitch1 ls k => call_cont k
544:  | Kswitch2 k => call_cont k
545:  | Kreturn k => call_cont k
549:Definition is_call_cont (k: cont) : Prop :=
