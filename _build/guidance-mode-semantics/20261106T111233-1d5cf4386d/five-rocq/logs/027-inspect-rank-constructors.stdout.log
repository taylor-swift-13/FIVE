397-with contextlist: kind -> (expr -> exprlist) -> Prop :=
398-  | ctx_list_head: forall k C el,
399-      context k RV C -> contextlist k (fun x => Econs (C x) el)
400-  | ctx_list_tail: forall k C e1,
401-      contextlist k C -> contextlist k (fun x => Econs e1 (C x)).
402-
403-(** In a nondeterministic semantics, expressions can go wrong according
404-  to one reduction order while being defined according to another.
405-  Consider for instance [(x = 1) + (10 / x)] where [x] is initially [0].
406-  This expression goes wrong if evaluated right-to-left, but is defined
407-  if evaluated left-to-right.  Since our compiler is going to pick one
408-  particular evaluation order, we must make sure that all orders are safe,
409-  i.e. never evaluate a subexpression that goes wrong.
410-
411-  Being safe is a stronger requirement than just not getting stuck during
412-  reductions.  Consider [f() + (10 / x)], where [f()] does not terminate.
413-  This expression is never stuck because the evaluation of [f()] can make
414-  infinitely many transitions.  Yet it contains a subexpression [10 / x]
415-  that can go wrong if [x = 0], and the compiler may choose to evaluate
416-  [10 / x] first, before calling [f()].
417-
418-  Therefore, we must make sure that not only an expression cannot get stuck,
419-  but none of its subexpressions can either.  We say that a subexpression
420-  is not immediately stuck if it is a value (of the appropriate kind)
421-  or it can reduce (at head or within). *)
422-
423-Inductive imm_safe: kind -> expr -> mem -> Prop :=
424-  | imm_safe_val: forall v ty m,
425-      imm_safe RV (Eval v ty) m
426-  | imm_safe_loc: forall b ofs bf ty m,
427-      imm_safe LV (Eloc b ofs bf ty) m
428-  | imm_safe_lred: forall to C e m e' m',
429-      lred e m e' m' ->
430-      context LV to C ->
431-      imm_safe to (C e) m
432-  | imm_safe_rred: forall to C e m t e' m',
433-      rred e m t e' m' ->
434-      context RV to C ->
435-      imm_safe to (C e) m
436-  | imm_safe_callred: forall to C e m fd args ty,
437-      callred e m fd args ty ->
438-      context RV to C ->
439-      imm_safe to (C e) m.
440-
441-Definition not_stuck (e: expr) (m: mem) : Prop :=
442-  forall k C e' ,
443-  context k RV C -> e = C e' -> imm_safe k e' m.
444-
445-(** ** Derived forms. *)
446-
447-(** The following are admissible reduction rules for some derived forms
448-  of the CompCert C language.  They help showing that the derived forms
449-  make sense. *)
450-
451-Lemma red_selection:
452-  forall v1 ty1 v2 ty2 v3 ty3 ty m b v2' v3',
453-  ty <> Tvoid ->
454-  bool_val v1 ty1 m = Some b ->
455-  sem_cast v2 ty2 ty m = Some v2' ->
456-  sem_cast v3 ty3 ty m = Some v3' ->
457-  rred (Eselection (Eval v1 ty1) (Eval v2 ty2) (Eval v3 ty3) ty) m
458-    E0 (Eval (if b then v2' else v3') ty) m.
459-Proof.
460-  intros. unfold Eselection.
461-  set (t := typ_of_type ty).
