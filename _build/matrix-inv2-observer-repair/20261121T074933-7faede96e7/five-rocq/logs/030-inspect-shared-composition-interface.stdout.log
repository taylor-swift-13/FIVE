Local Open Scope Z_scope.
Record CopyPre(m:mem)(src dst:block):Prop := {
 copy_separated:src<>dst;
 copy_readable:Mem.range_perm m src 0 16 Cur Readable;
 copy_writable:Mem.range_perm m dst 0 16 Cur Writable
}.
Record MemcpySafety(m:mem)(src dst:block):Prop := {
 pointer_1:src<>dst;
 pointer_arithmetic_1:Mem.valid_pointer m src 0=true;
 pointer_arithmetic_2:Mem.weak_valid_pointer m dst 16=true;
 pointer_2:dst<>src;
 pointer_arithmetic_3:Mem.valid_pointer m dst 0=true;
 pointer_arithmetic_4:Mem.weak_valid_pointer m src 16=true;
 precondition_1:src<>dst \/ 0+16<=0 \/0+16<=0;
 precondition_2:Mem.range_perm m src 0 16 Cur Readable;
 precondition_3:Mem.range_perm m dst 0 16 Cur Writable
}.
Definition CopyFrame(m mf:mem)(dst:block):Prop :=forall b ofs n,
 b<>dst \/ofs+n<=0 \/16<=ofs ->Mem.loadbytes mf b ofs n=Mem.loadbytes m b ofs n.
Lemma copy_pre_safety:forall m src dst,CopyPre m src dst->MemcpySafety m src dst.
Proof.
 intros m src dst[NE RD WR];constructor;auto.
 - apply Mem.valid_pointer_nonempty_perm;eapply Mem.perm_implies;[apply RD;lia|constructor].
 - apply Mem.weak_valid_pointer_spec;right;apply Mem.valid_pointer_nonempty_perm;eapply Mem.perm_implies;[apply WR;change(0<=16-1<16);lia|constructor].
 - apply Mem.valid_pointer_nonempty_perm;eapply Mem.perm_implies;[apply WR;lia|constructor].
 - apply Mem.weak_valid_pointer_spec;right;apply Mem.valid_pointer_nonempty_perm;eapply Mem.perm_implies;[apply RD;change(0<=16-1<16);lia|constructor].
Qed.
Theorem copy16_exact:forall se m src dst,CopyPre m src dst->
 exists mf bytes,MemcpySafety m src dst /\Mem.loadbytes m src 0 16=Some bytes /\length bytes=16%nat /\
 Mem.storebytes m dst 0 bytes=Some mf /\
 extcall_memcpy_sem 16 1 se[Vptr dst Ptrofs.zero;Vptr src Ptrofs.zero]m E0 Vundef mf /\
 Mem.loadbytes mf dst 0 16=Some bytes /\CopyFrame m mf dst.
Proof.
 intros se m src dst P;destruct(Mem.range_perm_loadbytes m src 0 16(copy_readable _ _ _ P))as[bytes READ].
 pose proof(Mem.loadbytes_length _ _ _ _ _ READ)as LEN;change(length bytes=16%nat)in LEN.
 assert(W:Mem.range_perm m dst 0(0+Z.of_nat(length bytes))Cur Writable)by(rewrite LEN;exact(copy_writable _ _ _ P)).
 destruct(Mem.range_perm_storebytes _ _ _ _ W)as[mf STORE].
 exists mf,bytes;split;[apply copy_pre_safety;exact P|];split;[exact READ|];split;[exact LEN|];split;[exact STORE|];split.
 - econstructor;try rewrite Ptrofs.unsigned_zero;try exact READ;try exact STORE;try(left;reflexivity);try lia;try(exists 16;reflexivity);try(intros;exists 0;reflexivity);left;exact(copy_separated _ _ _ P).
 - split.
   + pose proof(Mem.loadbytes_storebytes_same _ _ _ _ _ STORE)as H;rewrite LEN in H;exact H.
   + intros b ofs n OUT;destruct(zle n 0).
     * repeat rewrite Mem.loadbytes_empty by assumption;reflexivity.
     * eapply Mem.loadbytes_storebytes_other;[exact STORE|lia|];rewrite LEN;exact OUT.
Qed.
Lemma copy16_preserves_pre:forall m mf changed src dst bytes,
 Mem.storebytes m changed 0 bytes=Some mf->src<>changed->dst<>changed->CopyPre m src dst->CopyPre mf src dst.
Proof. intros m mf changed src dst bytes ST SC DC[NE RD WR];constructor;auto.
 - intros z B;eapply Mem.perm_storebytes_1;[exact ST|apply RD;exact B].
 - intros z B;eapply Mem.perm_storebytes_1;[exact ST|apply WR;exact B]. Qed.
Theorem two_copy16_exact:forall se m sa da sb db,
 CopyPre m sa da->CopyPre m sb db->sb<>da->db<>da->
 exists ma mb ba bb,MemcpySafety m sa da /\MemcpySafety ma sb db /\
 Mem.loadbytes m sa 0 16=Some ba /\Mem.loadbytes ma sb 0 16=Some bb /\
 Mem.storebytes m da 0 ba=Some ma /\Mem.storebytes ma db 0 bb=Some mb /\
 extcall_memcpy_sem 16 1 se[Vptr da Ptrofs.zero;Vptr sa Ptrofs.zero]m E0 Vundef ma /\
 extcall_memcpy_sem 16 1 se[Vptr db Ptrofs.zero;Vptr sb Ptrofs.zero]ma E0 Vundef mb /\
 Mem.loadbytes mb da 0 16=Some ba /\Mem.loadbytes mb db 0 16=Some bb /\
 CopyFrame m ma da /\CopyFrame ma mb db.
Proof.
 intros se m sa da sb db PA PB SD DD.
 destruct(copy16_exact se m sa da PA)as[ma[ba[SAFEA[RA[LA[SA[CA[BA FA]]]]]]]].
 assert(PB':CopyPre ma sb db)by(eapply copy16_preserves_pre;eauto).
 destruct(copy16_exact se ma sb db PB')as[mb[bb[SAFEB[RB[LB[SB[CB[BB FB]]]]]]]].
 exists ma,mb,ba,bb;split;[exact SAFEA|];split;[exact SAFEB|];split;[exact RA|];split;[exact RB|];split;[exact SA|];split;[exact SB|];split;[exact CA|];split;[exact CB|];split.
 - rewrite(FB da 0 16 ltac:(left;congruence));exact BA.
 - split;[exact BB|];split;assumption.
Qed.
