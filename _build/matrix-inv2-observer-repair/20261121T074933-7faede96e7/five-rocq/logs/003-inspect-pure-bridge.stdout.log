 destruct(power_zeros(3*k)ltac:(lia))as[_[_[_[_[DZ[DN _]]]]]].
 rewrite DZ,DN;rewrite power_div by lia;replace(2*k-3*k)with(-k)by lia;reflexivity.
Qed.

