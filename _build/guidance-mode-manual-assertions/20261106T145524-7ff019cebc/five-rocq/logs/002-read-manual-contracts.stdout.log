From Stdlib Require Import List ZArith.
From compcert Require Import Integers Floats AST Values Memory Globalenvs Ctypes Csyntax Csem Smallstep.
From FivePaparazziState Require Import State.
From FiveGuidanceEntry Require Import Entry.
Require FiveGhSpeed.Source FiveGhSpeed.Execution.
Require FiveGhAccel.Source FiveGhAccel.Execution.
Import ListNotations.
Local Open Scope Z_scope.

Definition vector_bits (v : vector) : list int := [Float32.to_bits (vx v);Float32.to_bits (vy v)].
Definition argument_repr (v : vector) (m : mem) (b : block) (o : ptrofs) : Prop :=
 Mem.load Mfloat32 m b (Ptrofs.unsigned o)=Some(Vsingle(vx v)) /\
 Mem.load Mfloat32 m b (Ptrofs.unsigned o+4)=Some(Vsingle(vy v)) /\
 0 <= Ptrofs.unsigned o /\ Ptrofs.unsigned o+8 <= Ptrofs.max_unsigned /\
 exists bytes, Mem.loadbytes m b (Ptrofs.unsigned o) 8=Some bytes.
Definition Returns (ge : Csem.genv) (entry : list val -> mem -> Csem.state)
 (args : list val) (before : mem) (after : mem) : Prop :=
 exists t v, star Csem.step ge (entry args before) t (Returnstate v Kstop after).
Definition speed_call (m : mem) (b : block) (o : ptrofs) (mf : mem) : Prop :=
 Returns FiveGhSpeed.Execution.ge FiveGhSpeed.Execution.entry [Vptr b o] m mf.
Definition accel_call (m : mem) (b : block) (o : ptrofs) (mf : mem) : Prop :=
 Returns FiveGhAccel.Execution.ge FiveGhAccel.Execution.entry [Vptr b o] m mf.
Definition speed_initial (s : state) (sp : vector) (m : mem) (b bp : block) (o : ptrofs) : Prop :=
 repr s m b /\ writable m b /\ argument_repr sp m bp o /\ integration_safe s /\
 Genv.find_symbol FiveGhSpeed.Execution.ge FiveGhSpeed.Source._gh_ref=Some b /\
 exists bc, Genv.find_symbol FiveGhSpeed.Execution.ge FiveGhSpeed.Source._gh_max_accel=Some bc /\
 Mem.load Mfloat32 m bc 0=Some(Vsingle fixed_maximum).
Definition accel_initial (s : state) (a : vector) (m : mem) (b bp : block) (o : ptrofs) : Prop :=
 repr s m b /\ writable m b /\ argument_repr a m bp o /\ integration_safe s /\
 Genv.find_symbol FiveGhAccel.Execution.ge FiveGhAccel.Source._gh_ref=Some b /\
 exists bc, Genv.find_symbol FiveGhAccel.Execution.ge FiveGhAccel.Source._gh_max_accel=Some bc /\
 Mem.load Mfloat32 m bc 0=Some(Vsingle fixed_maximum).
Definition MatchingCommand (s : state) (sp a : vector) : Prop :=
 exists si, integrate s=Some si /\ vector_bits a=vector_bits(raw_speed_accel si sp).

Definition NormalCompletion : Prop := forall s sp a ma mb ba bb pa pb oa ob,
 speed_initial s sp ma ba pa oa -> accel_initial s a mb bb pb ob -> MatchingCommand s sp a ->
 exists fa fb sf, speed_call ma pa oa fa /\ accel_call mb pb ob fb /\
 speed_update fixed_maximum s sp=Some sf /\ repr sf fa ba /\ repr sf fb bb.
Definition AllFinalStateFormula : Prop := forall s sp a ma mb ba bb pa pb oa ob fa fb,
 speed_initial s sp ma ba pa oa -> accel_initial s a mb bb pb ob -> MatchingCommand s sp a ->
 speed_call ma pa oa fa -> accel_call mb pb ob fb ->
 exists sf, speed_update fixed_maximum s sp=Some sf /\ repr sf fa ba /\ repr sf fb bb.
Definition AllFinalNamedBits : Prop := forall s sp a ma mb ba bb pa pb oa ob fa fb sa sb,
 speed_initial s sp ma ba pa oa -> accel_initial s a mb bb pb ob -> MatchingCommand s sp a ->
 speed_call ma pa oa fa -> accel_call mb pb ob fb -> repr sa fa ba -> repr sb fb bb ->
 named_bits sa=named_bits sb.

(** Actual original-Csem prefix reaches the real saturation call with exactly
    the source-ordered command after both integration updates. *)
Definition SpeedPrelimit (s : state) (sp : vector) (m : mem) (bp : block) (o : ptrofs) : Prop :=
 exists si t k reached local ofs global,
 integrate s=Some si /\
 star Csem.step FiveGhSpeed.Execution.ge (FiveGhSpeed.Execution.entry [Vptr bp o]m)t
  (Callstate (Internal FiveGhSpeed.Source.f_gh_saturate_accel) [Vptr local ofs] k reached) /\
 argument_repr (raw_speed_accel si sp) reached local ofs /\
 Genv.find_symbol FiveGhSpeed.Execution.ge FiveGhSpeed.Source._gh_ref=Some global /\
 repr si reached global.
Definition ActualPrelimitExists : Prop := forall s sp ma ba pa oa,
 speed_initial s sp ma ba pa oa -> SpeedPrelimit s sp ma pa oa.
Definition BranchWitness (taken : bool) : Prop :=
 exists s sp a ma mb ba bb pa pb oa ob,
 speed_initial s sp ma ba pa oa /\ accel_initial s a mb bb pb ob /\
 MatchingCommand s sp a /\ saturation_branch fixed_maximum a=taken /\
 pos_increment (speed_x s)(dt s)<>Some Int64.zero /\
 Float32.to_bits(Float32.add(speed_x s)(Float32.mul(accel_x s)(dt s)))<>Float32.to_bits(speed_x s).
Definition NontrivialWitnesses : Prop := BranchWitness false /\ BranchWitness true.
From Stdlib Require Import List.
From compcert Require Import Integers Floats Values Events Csem.
From FivePaparazziState Require Import State.
From FiveGuidanceEntry Require Import Entry SpeedEntry AccelEntry.
From FiveGuidanceMode Require Import Spec.
Require FiveGuidanceEntry.SaturationBody FiveGuidanceEntry.SaturationBodyAccel.
Import ListNotations.
Lemma vector_bits_injective:forall a b,vector_bits a=vector_bits b ->a=b.
Proof.
 intros[x y][u v]H.
 assert(X:Float32.to_bits x=Float32.to_bits u)by exact(f_equal(fun xs=>hd Int.zero xs)H).
 assert(Y:Float32.to_bits y=Float32.to_bits v)by exact(f_equal(fun xs=>hd Int.zero(tl xs))H).
 apply float32_bits_inj in X;apply float32_bits_inj in Y;subst;reflexivity.
Qed.
Theorem normal_completion_given_software:
 FiveGuidanceEntry.SaturationBody.sqrt_call_contract ->
 FiveGuidanceEntry.SaturationBodyAccel.sqrt_call_contract ->NormalCompletion.
Proof.
 intros SPEEDSQ ACCELSQ;unfold NormalCompletion;intros s sp a ma mb ba bb pa pb oa ob IA IB MATCH.
 destruct MATCH as[si[INT BITS]].
 apply vector_bits_injective in BITS;subst a.
 destruct(speed_entry_normal SPEEDSQ s sp ma ba pa oa IA)
 as[sf[fa[UPDATESPEED[PATHS[RS RESTS]]]]].
 destruct(accel_entry_normal ACCELSQ s(raw_speed_accel si sp)mb bb pb ob IB)
 as[sg[fb[UPDATEACCEL[PATHA[RA RESTA]]]]].
 pose proof(matching_accel_after_integration fixed_maximum s si sp INT)as MATCHUPDATE.
 rewrite MATCHUPDATE,UPDATEACCEL in UPDATESPEED;injection UPDATESPEED as EQ;subst sg.
 exists fa,fb,sf;split.
 - unfold speed_call,Returns;exists E0,Vundef;exact PATHS.
 - split.
   + unfold accel_call,Returns;exists E0,Vundef;exact PATHA.
   + split;[rewrite MATCHUPDATE;exact UPDATEACCEL|auto].
Qed.
Print Assumptions normal_completion_given_software.
From Stdlib Require Import List ZArith.
From compcert Require Import Integers Floats AST Values Memory.
Import ListNotations.
Local Open Scope Z_scope.

(** Complete original GuidanceHRef named state, x86-64 Linux little endian.
    No padding observation and no restriction on floating-point bit patterns. *)
Record state : Type := mkstate {
  accel_x : float32; accel_y : float32;
  speed_x : float32; speed_y : float32;
  pos_x : int64; pos_y : int64;
  tau : float32; omega : float32; zeta : float32; max_speed : float32;
  zeta_omega : float32; omega_2 : float32; inv_tau : float32; dt : float32
}.
Definition repr (s : state) (m : mem) (b : block) : Prop :=
  Mem.load Mfloat32 m b 0 = Some (Vsingle (accel_x s)) /\
  Mem.load Mfloat32 m b 4 = Some (Vsingle (accel_y s)) /\
  Mem.load Mfloat32 m b 8 = Some (Vsingle (speed_x s)) /\
  Mem.load Mfloat32 m b 12 = Some (Vsingle (speed_y s)) /\
  Mem.load Mint64 m b 16 = Some (Vlong (pos_x s)) /\
  Mem.load Mint64 m b 24 = Some (Vlong (pos_y s)) /\
  Mem.load Mfloat32 m b 32 = Some (Vsingle (tau s)) /\
  Mem.load Mfloat32 m b 36 = Some (Vsingle (omega s)) /\
  Mem.load Mfloat32 m b 40 = Some (Vsingle (zeta s)) /\
  Mem.load Mfloat32 m b 44 = Some (Vsingle (max_speed s)) /\
  Mem.load Mfloat32 m b 48 = Some (Vsingle (zeta_omega s)) /\
  Mem.load Mfloat32 m b 52 = Some (Vsingle (omega_2 s)) /\
  Mem.load Mfloat32 m b 56 = Some (Vsingle (inv_tau s)) /\
  Mem.load Mfloat32 m b 60 = Some (Vsingle (dt s)).
Definition writable (m : mem) (b : block) : Prop :=
  Mem.range_perm m b 0 64 Cur Writable.
Definition omega_min : float32 := Float32.of_bits (Int.repr 1036831949).
Definition omega_max : float32 := Float32.of_bits (Int.repr 1084227584).
Definition zeta_min : float32 := Float32.of_bits (Int.repr 1060320051).
Definition zeta_max : float32 := Float32.of_bits (Int.repr 1067030938).
Definition bound (lo hi x : float32) : float32 :=
  if Float32.cmp Cgt x lo then
    if Float32.cmp Clt x hi then x else hi
  else lo.
Definition clamp_omega := bound omega_min omega_max.
Definition clamp_zeta := bound zeta_min zeta_max.
Definition set_omega (s : state) (o : float32) : state :=
  let O := clamp_omega o in
  mkstate (accel_x s) (accel_y s) (speed_x s) (speed_y s)
    (pos_x s) (pos_y s) (tau s) O (zeta s) (max_speed s)
    (Float32.mul (zeta s) O) (Float32.mul O O) (inv_tau s) (dt s).
Definition set_zeta (s : state) (z : float32) : state :=
  let Z := clamp_zeta z in
  mkstate (accel_x s) (accel_y s) (speed_x s) (speed_y s)
    (pos_x s) (pos_y s) (tau s) (omega s) Z (max_speed s)
    (Float32.mul Z (omega s)) (omega_2 s) (inv_tau s) (dt s).
Definition named_bits (s : state) : list val :=
  [Vint (Float32.to_bits (accel_x s)); Vint (Float32.to_bits (accel_y s));
   Vint (Float32.to_bits (speed_x s)); Vint (Float32.to_bits (speed_y s));
   Vlong (pos_x s); Vlong (pos_y s); Vint (Float32.to_bits (tau s));
   Vint (Float32.to_bits (omega s)); Vint (Float32.to_bits (zeta s));
   Vint (Float32.to_bits (max_speed s)); Vint (Float32.to_bits (zeta_omega s));
   Vint (Float32.to_bits (omega_2 s)); Vint (Float32.to_bits (inv_tau s));
   Vint (Float32.to_bits (dt s))].
Lemma setters_commute : forall s o z,
  set_zeta (set_omega s o) z = set_omega (set_zeta s z) o.
Proof. intros []; reflexivity. Qed.
Lemma repr_unique : forall a c m b, repr a m b -> repr c m b -> a=c.
Proof.
 intros [] [] m b A C; unfold repr in *; simpl in *.
 repeat match goal with H : _ /\ _ |- _ => destruct H end.
 repeat match goal with H : ?x = Some _, H1 : ?x = Some _ |- _ =>
   rewrite H in H1; injection H1 as H1; try subst; clear H1
 end.
 reflexivity.
Qed.
Print Assumptions setters_commute.
Print Assumptions repr_unique.
