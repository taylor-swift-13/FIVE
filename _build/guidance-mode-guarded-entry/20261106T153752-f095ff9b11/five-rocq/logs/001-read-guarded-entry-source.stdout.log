 repr sf mf bg /\writable mf bg /\
 Mem.loadbytes mf bg 0 4=Some(encode_val Mfloat32(Vsingle(accel_x sf))) /\
 Mem.loadbytes mf bg 4 4=Some(encode_val Mfloat32(Vsingle(accel_y sf))) /\
 Mem.loadbytes mf bg 16 8=Some(encode_val Mint64(Vlong(pos_x sf))) /\
 Mem.loadbytes mf bg 24 8=Some(encode_val Mint64(Vlong(pos_y sf))).
Proof.
 intros CONTRACT s sp m bg src o INIT.
 destruct INIT as(REP&W&ARG&SAFE&SYM&bc&CSYM&CONST).
 destruct ARG as(LXS&LYS&RANGE&HI&BYTES).
 destruct SAFE as(dx&dy&CX&CY&NX&NY).
 destruct(prepare_vector_entry ge(fn_vars S.f_gh_update_ref_from_accel_sp)S._accel_sp vt
 m s bg bc src o(vx sp)(vy sp)eq_refl eq_refl eq_refl
 ltac:(repeat constructor;simpl;intuition discriminate)REP W CONST LXS LYS)
 as(e&ma&mb&ba&AV&BIND&LP&LX&LY&REP1&W1&C1&SEP&NONE&ALL).
 destruct(ALL S._pos_step vt ltac:(simpl;intuition congruence))as(bp&LPS&FP&PP).
 destruct(ALL S._speed_step vt ltac:(simpl;intuition congruence))as(bs&LSS&FS&PS).
 destruct(ALL S._pos_update it ltac:(simpl;intuition congruence))as(bu&LPU&FU&PU).
 destruct(ALL S._accel_sp vt ltac:(simpl;intuition congruence))as(p2&LP2&FA&PA).
 rewrite LP in LP2;injection LP2 as EQ;subst p2.
 assert(VG:Mem.valid_block m bg).
 { eapply Mem.perm_valid_block with(ofs:=0)(k:=Cur)(p:=Writable);apply W;lia. }
 assert(VC:Mem.valid_block m bc)by(eapply loaded_valid_block;exact CONST).
 assert(DGP:bg<>bp)by(intro EQ;subst bp;apply FP;exact VG).
 assert(DGS:bg<>bs)by(intro EQ;subst bs;apply FS;exact VG).
 assert(DGU:bg<>bu)by(intro EQ;subst bu;apply FU;exact VG).
 assert(DGA:bg<>ba)by(intro EQ;subst ba;apply FA;exact VG).
 assert(DPS:bp<>bs)by(eapply environment_distinct;[exact SEP| |exact LPS|exact LSS];discriminate).
 assert(DPU:bp<>bu)by(eapply environment_distinct;[exact SEP| |exact LPS|exact LPU];discriminate).
 assert(DSU:bs<>bu)by(eapply environment_distinct;[exact SEP| |exact LSS|exact LPU];discriminate).
 assert(DAP:ba<>bp)by(eapply environment_distinct;[exact SEP| |exact LP|exact LPS];discriminate).
 assert(DAS:ba<>bs)by(eapply environment_distinct;[exact SEP| |exact LP|exact LSS];discriminate).
 assert(DAU:ba<>bu)by(eapply environment_distinct;[exact SEP| |exact LP|exact LPU];discriminate).
 assert(ENV:e!S._gh_ref=None)by(apply NONE;vm_compute;intuition discriminate).
 assert(EH:e!S._gh_saturate_accel=None)by(apply NONE;vm_compute;intuition discriminate).
 assert(LA:e!S._accel_sp=Some(ba,vt))by exact LP.
 change(Mem.range_perm mb bp 0 8 Cur Freeable)in PP.
 change(Mem.range_perm mb bs 0 8 Cur Freeable)in PS.
 change(Mem.range_perm mb bu 0 16 Cur Freeable)in PU.
 change(Mem.range_perm mb ba 0 8 Cur Freeable)in PA.
 destruct(source_integration_exec s e mb bg bp bs bu dx dy ENV SYM LPS LSS LPU
 DGP DGS DGU DPS DPU DSU REP1 W1
 (freeable_vector_access _ _ _ PP(or_introl eq_refl))(freeable_vector_access _ _ _ PP(or_intror eq_refl))
 (freeable_vector_access _ _ _ PS(or_introl eq_refl))(freeable_vector_access _ _ _ PS(or_intror eq_refl))
 (freeable_longvector_access _ _ _ PU(or_introl eq_refl))(freeable_longvector_access _ _ _ PU(or_intror eq_refl))CX CY)
 as(mr&before&mx&my&ms&CE&PATHI&RR&WR&KR&LOCAL&POSX&POSY&SPEEDX&SPEEDY).
 assert(HISTORY:stores_to(fun b=>b=bg \/b=bp \/b=bs \/b=bu)mb mr).
 { eapply stores_to_trans.
   - eapply stores_to_weaken;[|exact LOCAL];intros b H;cbn in H|-*;tauto.
   - eapply stores_to_step;[left;reflexivity|exact POSX|].
     eapply stores_to_step;[left;reflexivity|exact POSY|].
     eapply stores_to_step;[left;reflexivity|exact SPEEDX|].
     eapply stores_to_step;[left;reflexivity|exact SPEEDY|constructor]. }
 assert(RX:Mem.load Mfloat32 mr ba 0=Some(Vsingle(vx sp))).
 { rewrite(stores_to_load_frame _ _ _ HISTORY Mfloat32 ba 0)by(intuition congruence);exact LX. }
 assert(RY:Mem.load Mfloat32 mr ba 4=Some(Vsingle(vy sp))).
 { rewrite(stores_to_load_frame _ _ _ HISTORY Mfloat32 ba 4)by(intuition congruence);exact LY. }
 assert(BGBC:bg<>bc)by(vm_compute in SYM,CSYM;congruence).
 assert(MAXR:Mem.load Mfloat32 mr bc 0=Some(Vsingle fixed_maximum)).
 { rewrite(stores_to_load_frame _ _ _ HISTORY Mfloat32 bc 0)by(intuition congruence);exact C1. }
 assert(PXBY:Mem.loadbytes mr bg 16 8=Some(encode_val Mint64(Vlong(Int64.add(pos_x s)dx)))).
 { erewrite Mem.loadbytes_store_other by(exact SPEEDY||(right;right;right;cbn;lia)).
   erewrite Mem.loadbytes_store_other by(exact SPEEDX||(right;right;right;cbn;lia)).
   erewrite Mem.loadbytes_store_other by(exact POSY||(right;right;left;cbn;lia)).
   exact(Mem.loadbytes_store_same _ _ _ _ _ _ POSX). }
 assert(PYBY:Mem.loadbytes mr bg 24 8=Some(encode_val Mint64(Vlong(Int64.add(pos_y s)dy)))).
 { erewrite Mem.loadbytes_store_other by(exact SPEEDY||(right;right;right;cbn;lia)).
   erewrite Mem.loadbytes_store_other by(exact SPEEDX||(right;right;right;cbn;lia)).
   exact(Mem.loadbytes_store_same _ _ _ _ _ _ POSY). }
 destruct(accel_prefix_certificate e S.f_gh_update_ref_from_accel_sp mb mr CE Kstop
   (Ssequence saturation_call after_saturation))as[PPREFIX[CPREFIX IPREFIX]].
 assert(IPREFIXBODY:PPREFIX(State S.f_gh_update_ref_from_accel_sp(fn_body S.f_gh_update_ref_from_accel_sp)Kstop e mb)).
 { rewrite accel_phase_shape;exact IPREFIX. }
 clear IPREFIX;rename IPREFIXBODY into IPREFIX.
 set(si:=integrated s dx dy).
 set(raw:=sp).
 set(saturated:=saturate fixed_maximum raw).
 destruct(saturation_funcall_certificate mr ba bc raw fixed_maximum (Kcall S.f_gh_update_ref_from_accel_sp e(fun x=>x)tvoid(Kdo(Kseq after_saturation Kstop))) I CONTRACT CSYM MAXR RX RY
 (KR _ _ _ _(freeable_vector_access _ _ _ PA(or_introl eq_refl)))
 (KR _ _ _ _(freeable_vector_access _ _ _ PA(or_intror eq_refl))))
 as(msat&PSAT&CSAT&ISAT&SX&SY&KRS&SATFRAME&SATBYTES).
 assert(VGR:Mem.valid_block mr bg).
 { eapply Mem.perm_valid_block with(ofs:=0)(k:=Cur)(p:=Writable);apply WR;lia. }
 assert(RS:repr si msat bg).
 { unfold repr in *;repeat match goal with H:_ /\ _|-_=>destruct H end;
   repeat split;rewrite SATFRAME by(exact VGR||exact DGA);assumption. }
 assert(WS:writable msat bg).
 { unfold writable in *;eapply range_perm_access_preserved;[exact KRS|exact WR]. }
 destruct(final_copy_exec si saturated e msat bg ba ENV SYM LA DGA RS WS SX SY)
 as(mcopy&mcopyx&COPY&RCOPY&WCOPY&KCOPY&SCOPYX&SCOPYY&AXB&AYB).
 assert(FRESH:forall id b ty,e!id=Some(b,ty)->~Mem.valid_block m b).
 { intros id b ty LOOK;pose proof(allocated_environment_origin ge _ _ _ _ AV id b ty LOOK)as IN.
   destruct(ALL id ty IN)as(bx&LOOKX&FX&PERM);rewrite LOOK in LOOKX;injection LOOKX as EQ;subst bx;exact FX. }
 assert(FREEB:forall id b ty,e!id=Some(b,ty)->Mem.range_perm mb b 0(sizeof ge ty)Cur Freeable).
 { intros id b ty LOOK;pose proof(allocated_environment_origin ge _ _ _ _ AV id b ty LOOK)as IN.
   destruct(ALL id ty IN)as(bx&LOOKX&FX&PERM);rewrite LOOK in LOOKX;injection LOOKX as EQ;subst bx;exact PERM. }
 assert(KBODY:access_preserved mb mcopy).
 { unfold access_preserved in *;intros;apply KCOPY;apply KRS;apply KR;assumption. }
 assert(FREECOPY:forall id b ty,e!id=Some(b,ty)->Mem.range_perm mcopy b 0(sizeof ge ty)Cur Freeable).
 { intros id b ty LOOK;eapply range_perm_access_preserved;[exact KBODY|eapply FREEB;exact LOOK]. }
 destruct(free_environment ge e mcopy SEP FREECOPY)as[mf[FREE[FREEFRAME FREEACCESS]]].
 assert(OUTG:forall id ty,e!id=Some(bg,ty)->False)by(intros id ty LOOK;exact(FRESH id bg ty LOOK VG)).
 assert(RFINAL:repr(with_accel si saturated)mf bg).
 { unfold repr in *;repeat match goal with H:_ /\ _|-_=>destruct H end;
   repeat split;rewrite FREEFRAME by exact OUTG;assumption. }
 assert(WFINAL:writable mf bg).
 { unfold writable in *;eapply range_perm_access_preserved_block;[|exact W1].
   intros ch ofs p VA;apply FREEACCESS;[exact OUTG|apply KBODY;exact VA]. }
 destruct(saturation_call_certificate e mr ba S.f_gh_update_ref_from_accel_sp(Kseq after_saturation Kstop)msat PSAT EH LA CSAT ISAT)
  as[PCALL[CCALL ICALL]].
 destruct(normal_block_certificate ge S.f_gh_update_ref_from_accel_sp e Kstop msat after_saturation mcopy ltac:(reflexivity)COPY)
  as[PCOPY[CCOPY ICOPY]].
 destruct(sequence_certificate ge S.f_gh_update_ref_from_accel_sp e Kstop mr msat saturation_call after_saturation PCALL PCOPY _ CCALL ICALL CCOPY ICOPY)
  as[PTAIL[CTAIL ITAIL]].
 pose proof(join_certificate ge PPREFIX PTAIL _ _ CPREFIX CTAIL ITAIL)as CBODY.
 pose proof(cleanup_transition ge S.f_gh_update_ref_from_accel_sp Kstop e mcopy mf I FREE)as CLEAN.
 pose proof(singleton_bridge_certificate ge _ _ CLEAN)as CCLEAN.
 pose proof(join_certificate ge _ _ _ _ CBODY CCLEAN ltac:(left;reflexivity))as CFULLBODY.
 assert(DISPATCH:unique_transition ge(FiveGhAccel.Execution.entry[Vptr src o]m)
  (State S.f_gh_update_ref_from_accel_sp(fn_body S.f_gh_update_ref_from_accel_sp)Kstop e mb)).
 { unfold FiveGhAccel.Execution.entry;eapply internal_dispatch_transition;
   [repeat constructor;simpl;intuition discriminate|exact AV|exact BIND]. }
 destruct(prepend_transition ge _ _ _ _ DISPATCH CFULLBODY ltac:(left;left;exact IPREFIX))as[P[CP IP]].
 exists(with_accel si saturated),mf,P;split.
 - unfold accel_update,integrate;rewrite CX,CY;reflexivity.
 - split.
   + exact CP.
   + split;[exact IP|].
     split;[exact RFINAL|]. split;[exact WFINAL|]. split.
     * rewrite(free_environment_bytes_frame ge e mcopy mf FREE bg 0 4)by exact OUTG;exact AXB.
     * split.
       -- rewrite(free_environment_bytes_frame ge e mcopy mf FREE bg 4 4)by exact OUTG;exact AYB.
       -- split.
          ++ rewrite(free_environment_bytes_frame ge e mcopy mf FREE bg 16 8)by exact OUTG.
             erewrite Mem.loadbytes_store_other by(exact SCOPYY||(right;right;right;cbn;lia)).
             erewrite Mem.loadbytes_store_other by(exact SCOPYX||(right;right;right;cbn;lia)).
             rewrite SATBYTES by(exact VGR||exact DGA);exact PXBY.
          ++ rewrite(free_environment_bytes_frame ge e mcopy mf FREE bg 24 8)by exact OUTG.
             erewrite Mem.loadbytes_store_other by(exact SCOPYY||(right;right;right;cbn;lia)).
             erewrite Mem.loadbytes_store_other by(exact SCOPYX||(right;right;right;cbn;lia)).
             rewrite SATBYTES by(exact VGR||exact DGA);exact PYBY.
Qed.
Print Assumptions accel_entry_certificate.

paparazzi/relations/guidance_mode/support/cbmc_adapters/GuardedPhases.v
From Stdlib Require Import List.
From compcert Require Import Coqlib Maps Integers Floats AST Values Memory Events Globalenvs Ctypes Csyntax Csyntaxdefs Csem Cstrategy Smallstep.
From FiveGuidanceAllOrder Require Import BlockExecution PhaseComposition ConcretePhases StandaloneCallShell FactorShell.
From FiveGuidanceCbmcAdapters Require Import CallScope.
Import ListNotations.
Theorem guarded_phase_chain_certificate:forall ge f e blocks m mf,
 phase_chain ge f e blocks m mf ->forall leaf norm branch k tail,
 exists P,certificate ge P(State f tail k e mf) /\P(State f(phase_sequence blocks tail)k e m) /\
 forall s,P s->helper_call_ok leaf norm branch s.
Proof.
 intros ge f e blocks m mf CHAIN;induction CHAIN;intros leaf norm branch k tail.
 - exists(fun s=>s=State f tail k e m);split;[apply singleton_certificate|].
   split;[reflexivity|];intros s EQ;subst;apply state_call_ok.
 - destruct(IHCHAIN leaf norm branch k tail)as[REST[CERTREST[INITREST SAFEREST]]].
   set(base:=Kseq(phase_sequence rest tail)k).
   set(BLOCK:=block_context_invariant ge base f e ma).
   assert(CERTBLOCK:certificate ge BLOCK(State f Sskip base e ma)).
   { split;[apply block_context_progress|apply block_context_all_successors]. }
   assert(INITBLOCK:BLOCK(State f st base e m)).
   { eapply block_context_entry;[exact H|exact H0]. }
   pose proof(chain_certificate ge BLOCK REST(State f Sskip base e ma)
   (State f(phase_sequence rest tail)k e ma)(State f tail k e mf)
   CERTBLOCK CERTREST(skip_sequence_transition ge f _ k e ma)INITREST)as TAILCERT.
   exists(fun s=>s=State f(Ssequence st(phase_sequence rest tail))k e m \/BLOCK s \/REST s);split.
   + eapply chain_certificate;[apply singleton_certificate|exact TAILCERT|apply sequence_transition|left;exact INITBLOCK].
   + split;[left;reflexivity|]. intros s[EQ|[BL|RS]].
     * subst;apply state_call_ok.
     * eapply block_context_call_ok;exact BL.
     * apply SAFEREST;exact RS.
Qed.
Theorem guarded_speed_prefix_certificate:forall e f m mi mf,
 (forall tail out final,Cstrategy.exec_stmt Speed.ge e mi tail E0 final out ->Cstrategy.exec_stmt Speed.ge e m(Speed.integration_context tail)E0 final out) ->
 (forall tail out final,Cstrategy.exec_stmt Speed.ge e mf tail E0 final out ->Cstrategy.exec_stmt Speed.ge e mi(Speed.raw_context tail)E0 final out) ->
 forall leaf norm branch k tail,exists P,certificate Speed.ge P(State f tail k e mf) /\
 P(State f(phase_sequence speed_blocks tail)k e m) /\forall s,P s->helper_call_ok leaf norm branch s.
Proof.
 intros e f m mi mf INTEGRATE RAW leaf norm branch k tail;apply guarded_phase_chain_certificate.
 eapply execution_phase_chain;[apply speed_blocks_syntax|].
 change(Cstrategy.exec_stmt Speed.ge e m(Speed.integration_context(Speed.raw_context Sskip))E0 mf Out_normal).
 apply INTEGRATE;apply RAW;constructor.
Qed.
Theorem guarded_accel_prefix_certificate:forall e f m mf,
 (forall tail out final,Cstrategy.exec_stmt Accel.ge e mf tail E0 final out ->Cstrategy.exec_stmt Accel.ge e m(Accel.integration_context tail)E0 final out) ->
 forall leaf norm branch k tail,exists P,certificate Accel.ge P(State f tail k e mf) /\
 P(State f(phase_sequence accel_blocks tail)k e m) /\forall s,P s->helper_call_ok leaf norm branch s.
Proof.
 intros e f m mf INTEGRATE leaf norm branch k tail;apply guarded_phase_chain_certificate.
 eapply execution_phase_chain;[apply accel_blocks_syntax|].
 change(Cstrategy.exec_stmt Accel.ge e m(Accel.integration_context Sskip)E0 mf Out_normal).
 apply INTEGRATE;constructor.
Qed.

Theorem guarded_speed_saturation_call_certificate:forall e m ba f k mf P norm branch,
 e!SS._gh_saturate_accel=None ->e!SS._accel_sp=Some(ba,Speed.vt) ->
 certificate Speed.ge P(Returnstate Vundef(Kcall f e(fun x=>x)tvoid(Kdo k))mf) ->
 P(Callstate(Internal SS.f_gh_saturate_accel)[Vptr ba Ptrofs.zero](Kcall f e(fun x=>x)tvoid(Kdo k))m) ->
 (forall s,P s->helper_call_ok SS.f_five_sqrtf norm branch s) ->
 exists Q,certificate Speed.ge Q(State f Sskip k e mf) /\Q(State f Speed.saturation_call k e m) /\
 forall s,Q s->helper_call_ok SS.f_five_sqrtf norm branch s.
Proof.
 intros e m ba f k mf P norm branch EH LA CERT PI SAFE.
 exists(StandaloneCallShell.invariant e f k
  SS._gh_saturate_accel SS._accel_sp Speed.saturation_block ba Speed.vt m Vundef mf P);split.
 - eapply call_certificate;eauto using Speed.saturation_symbol,Speed.saturation_funct;reflexivity.
 - split;[apply initial_certificate|].
   intros s[START|[PRE|[CALLEE|[POST|DONE]]]].
   + subst;apply state_call_ok.
   + destruct PRE as[rs[ns EQ]];subst;apply expr_call_ok.
   + apply SAFE;exact CALLEE.
   + subst;apply expr_call_ok.
   + subst;apply state_call_ok.
Qed.

Theorem guarded_accel_saturation_call_certificate:forall e m ba f k mf P norm branch,
 e!AS._gh_saturate_accel=None ->e!AS._accel_sp=Some(ba,Accel.vt) ->
 certificate Accel.ge P(Returnstate Vundef(Kcall f e(fun x=>x)tvoid(Kdo k))mf) ->
 P(Callstate(Internal AS.f_gh_saturate_accel)[Vptr ba Ptrofs.zero](Kcall f e(fun x=>x)tvoid(Kdo k))m) ->
 (forall s,P s->helper_call_ok AS.f_five_sqrtf norm branch s) ->
 exists Q,certificate Accel.ge Q(State f Sskip k e mf) /\Q(State f Accel.saturation_call k e m) /\
 forall s,Q s->helper_call_ok AS.f_five_sqrtf norm branch s.
Proof.
 intros e m ba f k mf P norm branch EH LA CERT PI SAFE.
 exists(StandaloneCallShell.invariant e f k
  AS._gh_saturate_accel AS._accel_sp Accel.saturation_block ba Accel.vt m Vundef mf P);split.
 - eapply call_certificate;eauto using Accel.saturation_symbol,Accel.saturation_funct;reflexivity.
 - split;[apply initial_certificate|].
   intros s[START|[PRE|[CALLEE|[POST|DONE]]]].
   + subst;apply state_call_ok.
   + destruct PRE as[rs[ns EQ]];subst;apply expr_call_ok.
   + apply SAFE;exact CALLEE.
   + subst;apply expr_call_ok.
   + subst;apply state_call_ok.
Qed.

paparazzi/relations/guidance_mode/support/cbmc_adapters/GuardedSpeedPrefix.v
From Stdlib Require Import List ZArith Lia.
From compcert Require Import Coqlib Errors Maps Integers Floats AST Values Memory Memdata Events Globalenvs Ctypes Cop Csyntax Csyntaxdefs Csem Cexec Cstrategy Smallstep.
From FivePaparazziState Require Import State MemorySupport.
From FiveGuidanceEntry Require Import Entry BigstepSupport EffectfulSupport SymbolicPrefix.
Require FiveGhSpeed.Source FiveGhSpeed.Execution.
From FiveGuidanceAllOrder Require Import PhaseComposition ConcretePhases.
From FiveGuidanceCbmcAdapters Require Import CallScope GuardedPhases.
Import ListNotations.
Local Open Scope Z_scope.
Module S:=FiveGhSpeed.Source.
Theorem body_prelimit_guard_certificate :forall (leaf:function)(norm:float32)(branch:bool) s sp e m bg param bp bs bu be ba dx dy,
 e!S._gh_ref=None ->Genv.find_symbol ge S._gh_ref=Some bg ->e!S._gh_saturate_accel=None ->
 e!S._speed_sp=Some(param,vt) ->e!S._pos_step=Some(bp,vt) ->e!S._speed_step=Some(bs,vt) ->
 e!S._pos_update=Some(bu,it) ->e!S._speed_err=Some(be,vt) ->e!S._accel_sp=Some(ba,vt) ->
 bg<>bp ->bg<>bs ->bg<>bu ->bp<>bs ->bp<>bu ->bs<>bu ->
 param<>bg ->param<>bp ->param<>bs ->param<>bu ->
 bg<>be ->bg<>ba ->param<>be ->param<>ba ->be<>ba ->
 repr s m bg ->writable m bg ->
 Mem.load Mfloat32 m param 0=Some(Vsingle(vx sp)) ->Mem.load Mfloat32 m param 4=Some(Vsingle(vy sp)) ->
 Mem.valid_access m Mfloat32 bp 0 Writable ->Mem.valid_access m Mfloat32 bp 4 Writable ->
 Mem.valid_access m Mfloat32 bs 0 Writable ->Mem.valid_access m Mfloat32 bs 4 Writable ->
 Mem.valid_access m Mint64 bu 0 Writable ->Mem.valid_access m Mint64 bu 8 Writable ->
 Mem.valid_access m Mfloat32 be 0 Writable ->Mem.valid_access m Mfloat32 be 4 Writable ->
 Mem.valid_access m Mfloat32 ba 0 Writable ->Mem.valid_access m Mfloat32 ba 4 Writable ->
 pos_increment(speed_x s)(dt s)=Some dx ->pos_increment(speed_y s)(dt s)=Some dy ->
 exists mf P,
 certificate ge P(State S.f_gh_update_ref_from_speed_sp(Ssequence saturation_call after_saturation)Kstop e mf) /\
 P(State S.f_gh_update_ref_from_speed_sp(fn_body S.f_gh_update_ref_from_speed_sp)Kstop e m) /\
 repr(integrated s dx dy)mf bg /\writable mf bg /\access_preserved m mf /\
 Mem.load Mfloat32 mf ba 0=Some(Vsingle(vx(raw_speed_accel(integrated s dx dy)sp))) /\
 Mem.load Mfloat32 mf ba 4=Some(Vsingle(vy(raw_speed_accel(integrated s dx dy)sp))) /\
 (exists bytes,Mem.loadbytes mf ba 0 8=Some bytes) /\
 stores_to(fun b=>b=bg \/b=bp \/b=bs \/b=bu \/b=be \/b=ba)m mf /\
 Mem.loadbytes mf bg 16 8=Some(encode_val Mint64(Vlong(Int64.add(pos_x s)dx))) /\
 Mem.loadbytes mf bg 24 8=Some(encode_val Mint64(Vlong(Int64.add(pos_y s)dy))) /\
 (forall reached,P reached->helper_call_ok leaf norm branch reached).
Proof.
 intros leaf norm branch s sp e m bg param bp bs bu be ba dx dy ENV SYM EH LP LPS LSS LPU LE LA
 DGP DGS DGU DPS DPU DSU DPG DPP DPSP DPUA DGE DGA DPE DPA DEA
 REP W LX LY AP0 AP4 AS0 AS4 AU0 AU8 AE0 AE4 AA0 AA4 CX CY.
 destruct(source_integration_exec s e m bg bp bs bu dx dy ENV SYM LPS LSS LPU
 DGP DGS DGU DPS DPU DSU REP W AP0 AP4 AS0 AS4 AU0 AU8 CX CY)
 as[mi[before[mx[my[ms[CE[PATHI[RI[WI[AI[LOCAL[SX[SY[SSX SSY]]]]]]]]]]]]]].
 assert(HISTORY:stores_to(fun b=>b=bg \/b=bp \/b=bs \/b=bu)m mi).
 { eapply stores_to_trans.
   - eapply stores_to_weaken;[|exact LOCAL];intros b H;cbn in H |- *;tauto.
   - eapply stores_to_step;[left;reflexivity|exact SX|].
     eapply stores_to_step;[left;reflexivity|exact SY|].
     eapply stores_to_step;[left;reflexivity|exact SSX|].
     eapply stores_to_step;[left;reflexivity|exact SSY|constructor]. }
 assert(LXI:Mem.load Mfloat32 mi param 0=Some(Vsingle(vx sp))).
 { rewrite(stores_to_load_frame _ _ _ HISTORY Mfloat32 param 0)by(intuition congruence);exact LX. }
 assert(LYI:Mem.load Mfloat32 mi param 4=Some(Vsingle(vy sp))).
 { rewrite(stores_to_load_frame _ _ _ HISTORY Mfloat32 param 4)by(intuition congruence);exact LY. }
 destruct(source_raw_accel_exec (integrated s dx dy)sp e mi bg param be ba ENV SYM LP LE LA
 DGE DGA DPE DPA DEA RI WI LXI LYI (AI _ _ _ _ AE0)(AI _ _ _ _ AE4)(AI _ _ _ _ AA0)(AI _ _ _ _ AA4))
 as[mf[CR[PATHR[RF[WF[AR[RAW[AX[AY BYTES]]]]]]]]].
 assert(ALLHISTORY:stores_to(fun b=>b=bg \/b=bp \/b=bs \/b=bu \/b=be \/b=ba)m mf).
 { eapply stores_to_trans.
   - eapply stores_to_weaken;[|exact HISTORY];intros b H;cbn in H |- *;tauto.
   - eapply stores_to_weaken;[|exact RAW];intros b H;cbn in H |- *;tauto. }
 assert(POSXBYTES:Mem.loadbytes mf bg 16 8=Some(encode_val Mint64(Vlong(Int64.add(pos_x s)dx)))).
 { rewrite(stores_to_bytes_frame _ _ _ RAW bg 16 8)by(intuition congruence).
   erewrite Mem.loadbytes_store_other by(exact SSY||(right;right;right;cbn;lia)).
   erewrite Mem.loadbytes_store_other by(exact SSX||(right;right;right;cbn;lia)).
   erewrite Mem.loadbytes_store_other by(exact SY||(right;right;left;cbn;lia)).
   exact(Mem.loadbytes_store_same _ _ _ _ _ _ SX). }
 assert(POSYBYTES:Mem.loadbytes mf bg 24 8=Some(encode_val Mint64(Vlong(Int64.add(pos_y s)dy)))).
 { rewrite(stores_to_bytes_frame _ _ _ RAW bg 24 8)by(intuition congruence).
   erewrite Mem.loadbytes_store_other by(exact SSY||(right;right;right;cbn;lia)).
   erewrite Mem.loadbytes_store_other by(exact SSX||(right;right;right;cbn;lia)).
   exact(Mem.loadbytes_store_same _ _ _ _ _ _ SY). }
 destruct(guarded_speed_prefix_certificate e S.f_gh_update_ref_from_speed_sp m mi mf CE CR leaf norm branch Kstop
  (Ssequence saturation_call after_saturation))as[P[CP[IP GP]]].
 exists mf,P;split;[exact CP|]. split;[rewrite speed_phase_shape;exact IP|].
 split;[exact RF|]. split;[exact WF|]. split.
   + unfold access_preserved in *;intros;eauto.
   + repeat split;assumption.
Qed.
Print Assumptions body_prelimit_guard_certificate.

