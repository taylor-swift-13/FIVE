import sys,pathlib,json,shutil,datetime,importlib.util
root=pathlib.Path('/home/yangfp/five')
s=importlib.util.spec_from_file_location('e',root/'paparazzi/report/quat_rotation_paths/evidence_tools.py');e=importlib.util.module_from_spec(s);s.loader.exec_module(e)
maps={'FiveShared':'shared','FiveGuidanceSemantics':'paparazzi/relations/guidance_mode/support/semantics','FiveGuidanceAllOrder':'paparazzi/relations/guidance_mode/support/allorder','FiveGuidanceAllocation':'paparazzi/relations/guidance_mode/support/allocation','FiveGuidanceEntry':'paparazzi/relations/guidance_mode/support/entry','FiveLowpassSupport':'paparazzi/relations/lowpass_recovery/support','FiveMatInv3Case':'paparazzi/models/float_mat_inv_3d/rocq/support','FiveInv2Case':'paparazzi/models/float_mat_inv_2d/rocq/support','FivePprzFloatMatInv2d':'paparazzi/models/float_mat_inv_2d/align/model','FiveInv2Correspondence':'paparazzi/models/float_mat_inv_2d/rocq/execution_correspondence/problem','FiveInv2Termination':'paparazzi/models/float_mat_inv_2d/rocq/termination/problem','FiveInv2NoError':'paparazzi/models/float_mat_inv_2d/rocq/no_error/problem','FiveInv2Functional':'paparazzi/models/float_mat_inv_2d/rocq/functional/problem','FiveInv2Recheck':'paparazzi/models/float_mat_inv_2d/rocq/cbmc_recheck/problem','FiveMatrixInverseSupport':'paparazzi/relations/matrix_inverse_scale/support','FivePprzFloatMatInv3d':'paparazzi/models/float_mat_inv_3d/align/model'}
roots=sys.argv[1:];modules={}
for kind,ns in [('termination','FiveInv2Termination'),('execution_correspondence','FiveInv2Correspondence'),('no_error','FiveInv2NoError'),('functional','FiveInv2Functional'),('cbmc_recheck','FiveInv2Recheck')]:modules[ns+'.Proof']='paparazzi/models/float_mat_inv_2d/rocq/'+kind+'/attempts/001/Proof.v'
order=e.dependency_order(root,maps,modules,roots)
build=root/'_build/matrix-inv2-csem/development/current';build.mkdir(parents=True,exist_ok=True)
history=root/'_build/matrix-inv2-csem/development/history'/datetime.datetime.now().strftime('%Y%m%dT%H%M%S%f');history.mkdir(parents=True)
flags=[]
for name in maps:
 d=build/name;d.mkdir(exist_ok=True);flags+=['-Q',str(d),name]
rows=[];dirty={}
for name,src in order:
 prefix=max([n for n in maps if name.startswith(n+'.')],key=len);dst=build/prefix/pathlib.Path(*name[len(prefix)+1:].split('.')).with_suffix('.v');dst.parent.mkdir(parents=True,exist_ok=True)
 dependency_newer=False
 for child in e.imports(src):
  prefixes=[n for n in maps if child.startswith(n+'.')]
  if prefixes and dst.with_suffix('.vo').exists():
   cp=max(prefixes,key=len);cv=(build/cp/pathlib.Path(*child[len(cp)+1:].split('.'))).with_suffix('.vo')
   if cv.exists() and cv.stat().st_mtime_ns>dst.with_suffix('.vo').stat().st_mtime_ns:dependency_newer=True
 changed=dependency_newer or not dst.exists() or dst.read_bytes()!=src.read_bytes() or not dst.with_suffix('.vo').exists() or any(dirty.get(child,False) for child in e.imports(src))
 snapshot=history/dst.relative_to(build);snapshot.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(src,snapshot)
 if changed:shutil.copyfile(src,dst);rows.append((name,str(dst)))
 dirty[name]=changed
print(json.dumps({'flags':flags,'rows':rows,'build':str(build)}))
"""
try:
 c=r.command(['python3','-c',prepare,*sys.argv[1:]],'stage-development-closure',60,cwd=root)
 plan=json.loads((r.folder/c['stdout']).read_text());print(plan['build'],flush=True)
 for name,path in plan['rows']:
