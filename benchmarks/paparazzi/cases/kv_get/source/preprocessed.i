int kv_set(kv_store_t *kv, uint32_t key, const void *value) {
  size_t index;


  if (kv_find(kv, key, &index))
  {
    memcpy(&kv->values[index * kv->esize], value, kv->esize);
    return 0;
  }


  for (size_t i = 0; i < kv->capacity; i++)
  {
    if (!kv->used[i])
    {
      kv->used[i] = 1;
      kv->keys[i] = key;
      memcpy(&kv->values[i * kv->esize], value, kv->esize);
      return 0;
    }
  }

  return -1;
}
