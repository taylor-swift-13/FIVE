        img_buf[buf_loc + 2] = temp_color[2];
        img_buf[buf_loc + 3] = temp_color[3];
      }
    }

    xerr += delta_x;
    yerr += delta_y;
    if (xerr > distance) {
      xerr -= distance;
      startx += incx;
    }
    if (yerr > distance) {
      yerr -= distance;
