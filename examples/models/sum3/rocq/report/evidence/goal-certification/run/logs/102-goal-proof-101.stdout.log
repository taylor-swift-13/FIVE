     : forall (m : mem) (a b c : float32) (br bb : block) 
         (mf : mem) (v : val),
       HarnessPrefix m a b c br bb mf v ->
       ByteObservation br bb mf v /\
       (exists stored : mem,
          Mem.store Mfloat32 mf br 0 v = Some stored /\
          (forall (copied : mem) (t : trace) (ret : val),
           extcall_memcpy_sem 4 1 sum3_ge
             [Vptr bb Ptrofs.zero; Vptr br Ptrofs.zero] stored t ret copied ->
           Mem.load Mint32 copied bb 0 = Some (Vint Int.zero) /\
           star Csem.step sum3_ge
             (ExprState sum3_function bits_assertion Kstop 
                (bits_env bb) copied)
             E0
             (ExprState sum3_function (Eval (Vint Int.one) tint) Kstop
                (bits_env bb) copied)))
