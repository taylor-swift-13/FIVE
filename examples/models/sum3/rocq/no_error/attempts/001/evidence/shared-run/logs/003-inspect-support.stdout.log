#!/usr/bin/env python3
"""Rebuild and kernel-check the sum3 Rocq specifications in isolation."""
from pathlib import Path
import shutil,subprocess,tempfile
root=Path(__file__).resolve().parents[4]
case=root/'examples/models/sum3'
with tempfile.TemporaryDirectory(prefix='five-sum3-proof-') as tmp:
 b=Path(tmp); model=b/'model'; proof=b/'proof'; shared=b/'shared'
 model.mkdir();proof.mkdir()
 for f in ['Source.v','Execution.v','proof/Precondition.v','proof/Obligations.v']:
  p=model/f;p.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(case/'align/model'/f,p)
 shutil.copyfile(case/'rocq/support/SourceInvariant.v',proof/'SourceInvariant.v')
 for source, name in [('no_error/problem/Spec.v','NoErrorSpec.v'),('termination/problem/Spec.v','TerminationSpec.v'),('cbmc_recheck/problem/Spec.v','RecheckSpec.v')]:
  shutil.copyfile(case/'rocq'/source,proof/name)
 shutil.copytree(root/'shared',shared,ignore=shutil.ignore_patterns('*.vo','*.glob','*.vos','*.vok','__pycache__'))
 flags=['-Q',str(model),'FiveSum3','-Q',str(proof),'FiveSum3Proof','-Q',str(shared),'FiveShared']
 order=[shared/'pure_semantics/SemanticsSupport.v',shared/'verification/Obligations.v',model/'Source.v',model/'Execution.v',model/'proof/Precondition.v',model/'proof/Obligations.v',proof/'SourceInvariant.v',proof/'NoErrorSpec.v',proof/'TerminationSpec.v',proof/'RecheckSpec.v']
 for p in order:subprocess.run(['rocq','compile',*flags,str(p)],cwd=root,check=True)
 subprocess.run(['rocq','check','-silent',*flags,'FiveSum3Proof.NoErrorSpec','FiveSum3Proof.TerminationSpec','FiveSum3Proof.RecheckSpec'],cwd=root,check=True)
 print('Rebuilt and kernel-checked sum3 specifications.')
Core.v
Entry.v
Functional.v
Invariant.v
NoError.v
NormalCorrespondence.v
PureProgress.v
SourceInvariant.v
From Stdlib Require Import List String ZArith.
From compcert Require Import AST Integers Floats Values Memory Events Globalenvs
 Determinism Ctypes Csyntax Csem Cexec Smallstep.
From FiveSum3 Require Import Source.
From FiveShared.pure_semantics Require Import SemanticsSupport.
From FiveSum3Proof Require Import SourceInvariant.
From FiveSum3Proof.support Require Import NormalCorrespondence.
From FiveSum3Proof Require Import PureProgress.
From FiveSum3Proof Require Import Invariant.
From FiveSum3Proof Require Import Entry.
Import ListNotations.

(* A calling-interface precondition, not a numeric input restriction. *)
Definition sum3_pre(args:list val):Prop :=
 exists a b c:float32,args=[Vsingle a;Vsingle b;Vsingle c].
Definition entry(args:list val)(m:mem):Csem.state :=
 Callstate(Internal sum3_function)args Kstop m.

Theorem sum3_all_reachable_no_error : forall args m,
 sum3_pre args -> forall t reached,
 star Csem.step sum3_ge(entry args m)t reached -> ~source_error reached.
Proof.
 intros args m [a[b[c EQ]]]t reached PATH;subst args.
 apply invariant_excludes_error.
 eapply reachable_invariant;[apply typed_entry_establishes_invariant|exact PATH].
Qed.

Theorem sum3_all_bits_no_error : forall(a b c:int)m t reached,
 star Csem.step sum3_ge
  (entry[Vsingle(Float32.of_bits a);Vsingle(Float32.of_bits b);Vsingle(Float32.of_bits c)]m)
  t reached -> ~source_error reached.
Proof.
 intros;eapply sum3_all_reachable_no_error;[|eassumption].
 unfold sum3_pre;eauto 7.
Qed.

Theorem sum3_progress_at_every_reachable_state : forall args m,
 sum3_pre args -> forall t reached,
 star Csem.step sum3_ge(entry args m)t reached ->
 normal_return reached \/ exists u next,Csem.step sum3_ge reached u next.
Proof.
 intros args m [a[b[c EQ]]]t reached PATH;subst args.
 apply invariant_progress;eapply reachable_invariant;
 [apply typed_entry_establishes_invariant|exact PATH].
Qed.

Lemma stuck_is_error : source_error Stuckstate.
Proof.
 split.
 - intros[v[m EQ]];discriminate.
 - intros t s STEP;destruct STEP as [S|S];inversion S.
Qed.
Theorem sum3_never_reaches_stuck : forall args m,
 sum3_pre args -> forall t,
 ~star Csem.step sum3_ge(entry args m)t Stuckstate.
Proof.
 intros args m PRE t PATH.
 exact(sum3_all_reachable_no_error args m PRE t Stuckstate PATH stuck_is_error).
Qed.

(* The executable model retains the complete Cexec successor list. *)
Definition no_external (_:string) (_:signature) (_:Senv.t) (_:world)
 (_:list val) (_:mem):option(world*trace*val*mem):=None.
Definition transitions(s:Csem.state):list Cexec.transition :=
 Cexec.do_step sum3_ge no_external no_external quiet_world s.
Definition model_step(_:unit)(s:Csem.state)(t:trace)(s':Csem.state):Prop :=
 exists rule,In(TR rule t s')(transitions s).
Theorem step_exact : forall s t s',source_state s ->
 (model_step tt s t s' <-> Csem.step sum3_ge s t s').
Proof. intros;apply source_do_step_exact;assumption. Qed.

Lemma model_paths_are_source_paths : forall initial t reached,
 source_state initial -> star model_step tt initial t reached ->
 star Csem.step sum3_ge initial t reached.
Proof.
 intros initial t reached SOURCE PATH;revert SOURCE;induction PATH;intros SOURCE.
 - constructor.
 - apply step_exact in H;auto.
   eapply star_step;[exact H| |exact H0].
   apply IHPATH;exact(proj2(source_step_invariant _ _ _ _ SOURCE H)).
Qed.
Theorem sum3_executable_model_all_reachable_no_error : forall args m,
 sum3_pre args -> forall t reached,
 star model_step tt(entry args m)t reached -> ~source_error reached.
Proof.
 intros args m PRE t reached PATH.
 eapply sum3_all_reachable_no_error;[exact PRE|].
 eapply model_paths_are_source_paths;[unfold entry;split;reflexivity|exact PATH].
Qed.
Theorem sum3_model_has_successor_or_returns : forall args m,
 sum3_pre args -> forall t reached,
 star model_step tt(entry args m)t reached ->
 normal_return reached \/ transitions reached<>[].
Proof.
 intros args m PRE t reached PATH.
 pose proof(model_paths_are_source_paths (entry args m) t reached
  ltac:(unfold entry;split;reflexivity) PATH)as SOURCEPATH.
 destruct(sum3_progress_at_every_reachable_state args m PRE t reached SOURCEPATH)
  as [DONE|[u[next STEP]]];[left;exact DONE|right].
 assert(INV:source_state reached).
 { destruct PRE as [a[b[c EQ]]];subst args.
   pose proof(reachable_invariant _ _ _
    (typed_entry_establishes_invariant m a b c) SOURCEPATH)as I.
   exact(proj1 I). }
 apply step_exact in STEP;[|exact INV].
 destruct STEP as [rule IN];intro EMPTY;rewrite EMPTY in IN;contradiction.
Qed.

Theorem precondition_inhabited : sum3_pre[Vsingle Float32.zero;Vsingle Float32.zero;Vsingle Float32.zero].
Proof. unfold sum3_pre;eauto 7. Qed.

(* The raw execution entry still admits invalid calling states. *)
Theorem missing_arguments_error : source_error(entry [] Mem.empty).
Proof.
 split.
 - intros[v[m EQ]];discriminate.
 - intros t s STEP;destruct STEP as [ES|SS];[inversion ES|].
   inversion SS;subst.
   change(Csem.bind_parameters sum3_ge e m1
    [(Source._a,Ctypesdefs.tfloat);(Source._b,Ctypesdefs.tfloat);(Source._c,Ctypesdefs.tfloat)][]m2)in H7.
   inversion H7.
Qed.

Print Assumptions sum3_all_reachable_no_error.
Print Assumptions sum3_all_bits_no_error.
Print Assumptions sum3_executable_model_all_reachable_no_error.
Print Assumptions sum3_model_has_successor_or_returns.
Print Assumptions precondition_inhabited.
Print Assumptions missing_arguments_error.

Theorem invariant_preserved : forall s t s',
 execution_invariant s -> Csem.step sum3_ge s t s' -> execution_invariant s'.
Proof.
 intros s t s' [SOURCE[NORMAL[result EVAL]]] STEP.
 pose proof(proj2(source_step_invariant _ _ _ _ SOURCE STEP)) as SOURCE'.
 pose proof(proj1(normal_step_denotation _ _ _ _ SOURCE NORMAL STEP)) as NORMAL'.
 repeat split; auto. exists result. destruct STEP as [ES|SS].
 - destruct s as [f stmt k e m|f a k e m|fd args k m|v k m|]; try solve[inversion ES].
   exact(normal_estep_forward sum3_ge f a k e m t s' result SOURCE NORMAL EVAL ES).
 - rewrite <-(normal_sstep_denotation _ _ _ _ SOURCE NORMAL SS);exact EVAL.
Qed.

Lemma immediate_has_step : forall ge f a k e m,
 literal RV a=false -> imm_safe ge e RV a m ->
 exists t s',Csem.step ge (ExprState f a k e m) t s'.
Proof.
 intros ge f a k e m NL IS; inversion IS; subst; try discriminate.
 - eexists; eexists; left; eapply step_lred;eauto.
 - eexists; eexists; left; eapply step_rred;eauto.
 - eexists; eexists; left; eapply Csem.step_call;eauto.
Qed.

Lemma sum3_vars_unique :
 list_norepet(var_names(fn_params sum3_function)++var_names(fn_vars sum3_function)).
Proof.
 change(list_norepet [Source._a;Source._b;Source._c]).
 repeat(apply list_norepet_cons; [simpl;intuition discriminate|]).
 apply list_norepet_nil.
Qed.

Theorem invariant_progress : forall s,
 execution_invariant s -> normal_return s \/ exists t s',Csem.step sum3_ge s t s'.
Proof.
 intros s [SOURCE[NORMAL[result EVAL]]].
 destruct s as [f stmt k e m|f a k e m|fd args k m|v k m|];
 cbn [source_state] in SOURCE; cbn [normal_state] in NORMAL; try discriminate.
 - destruct SOURCE as [HF[CORE CK]]. core_unpack.
   destruct stmt; cbn [normal_stmt] in *; core_unpack;try discriminate.
   + destruct k; cbn [normal_cont] in *;core_unpack;try discriminate.
     * cbn [state_eval stmt_eval cont_eval] in EVAL.
       destruct(Mem.free_list m (blocks_of_env sum3_ge e))eqn:FREE;try discriminate.
       right; eexists;eexists;right;eapply step_skip_call;[exact I|exact FREE].
     * right;eexists;eexists;right;eapply step_skip_seq.
   + right;eexists;eexists;right;eapply step_do_1.
   + right;eexists;eexists;right;eapply step_seq.
   + destruct o as [a|].
     * right;eexists;eexists;right;eapply step_return_1.
     * cbn [state_eval stmt_eval] in EVAL. rewrite cont_eval_return in EVAL.
       destruct(Mem.free_list m (blocks_of_env sum3_ge e))eqn:FREE;try discriminate.
       right;eexists;eexists;right;eapply step_return_0;exact FREE.
 - destruct SOURCE as [HF[CORE CK]].
   destruct k; cbn [normal_state] in NORMAL;try discriminate;core_unpack.
   + destruct(literal RV a)eqn:LIT.
     * destruct(literal_r_inv _ LIT)as [v[ty EQ]];subst a.
       right;eexists;eexists;right;eapply step_do_2.
     * right;eapply immediate_has_step;eauto.
       cbn [state_eval] in EVAL;destruct(flat_eval sum3_ge e m a)as [[v mx]|]eqn:EV;
       try discriminate;eapply flat_immediate;eauto.
   + destruct(literal RV a)eqn:LIT.
     * destruct(literal_r_inv _ LIT)as [v[ty EQ]];subst a.
       change((match sem_cast v ty (fn_return f) m with
        | Some v2=>cont_eval sum3_ge e (fn_return f) k (Nreturn v2) m
        | None=>None end)=Some result) in EVAL.
       destruct(sem_cast v ty (fn_return f) m)eqn:CAST;try discriminate.
       rewrite cont_eval_return in EVAL.
       destruct(Mem.free_list m (blocks_of_env sum3_ge e))eqn:FREE;try discriminate.
       right;eexists;eexists;right;eapply step_return_2;eauto.
     * right;eapply immediate_has_step;eauto.
       cbn [state_eval] in EVAL;destruct(pure_rval sum3_ge e m a)eqn:EV;try discriminate.
       eapply simple_immediate;eauto;congruence.
 - destruct SOURCE as [FD K];subst fd k.
   cbn [state_eval] in EVAL.
   destruct(do_alloc_variables sum3_ge empty_env m
    (fn_params sum3_function++fn_vars sum3_function))as [e ma]eqn:ALLOC.
   destruct(sem_bind_parameters sum3_ge quiet_world e ma
    (fn_params sum3_function) args)eqn:BIND;try discriminate.
   right;eexists;eexists;right;eapply step_internal_function.
   + exact sum3_vars_unique.
   + pose proof(do_alloc_variables_sound sum3_ge
      (fn_params sum3_function++fn_vars sum3_function) empty_env m)as A.
     rewrite ALLOC in A;exact A.
   + eapply sem_bind_parameters_sound;exact BIND.
 - subst k;left;unfold normal_return;eauto.
Qed.

Theorem invariant_excludes_error : forall s,execution_invariant s -> ~source_error s.
Proof.
 intros s INV [NOTRETURN STOP]. destruct(invariant_progress _ INV)as [DONE|[t[s' STEP]]].
 - contradiction.
 - exact(STOP t s' STEP).
Qed.

Theorem reachable_invariant : forall initial t s,
 execution_invariant initial -> star Csem.step sum3_ge initial t s -> execution_invariant s.
Proof.
 intros initial t s INV PATH;revert INV;induction PATH;intros INV;auto.
 apply IHPATH;eapply invariant_preserved;eauto.
Qed.

